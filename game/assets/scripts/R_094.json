{"file":"R_094.eex","kind":"story","scenario_index":188,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":26,"sections":[{"index":0,"offset":28,"title":"女性大亂鬥結束","body_off":53,"body_end":131,"conditions":[{"op":2,"name":"comment","args":["女性大亂鬥結束"]},{"op":0,"name":"end","args":[]}],"body":[{"op":117,"name":"set_s_image","args":[800,27]},{"op":56,"name":"set_attr","args":[800,15,0,298]},{"op":1,"name":"if","args":[],"off":83,"cond":{"op":5,"name":"test_flags","args":[[1838],[502,560,1848]]},"end":9,"end_off":129},{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":36,"name":"play_sound","args":[255]},{"op":17,"name":"goto_scenario","args":[55]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":131,"sections":[{"index":0,"offset":133,"title":"石像鬼的結局","body_off":156,"body_end":6698,"conditions":[{"op":2,"name":"comment","args":["石像鬼的結局"]},{"op":0,"name":"end","args":[]}],"body":[{"op":119,"name":"int_var_op","args":[2,4051,2,0,0]},{"op":1,"name":"if","args":[],"off":182,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":271,"end_off":6696},{"op":56,"name":"set_attr","args":[782,15,0,449]},{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":36,"name":"play_sound","args":[18]},{"op":39,"name":"change_scene","args":[2,65535,65535,18,65535]},{"op":48,"name":"actor_appear","args":[138,35,56,1,0]},{"op":48,"name":"actor_appear","args":[58,50,56,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":24,"name":"title_text","args":["過河拆橋"]},{"op":23,"name":"place_name","args":["馬騰的營帳"]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["收服了石像鬼以後，\n馬騰軍無往不利，戰勝眾多諸侯，\n一躍成為西北的最強勢力。"]},{"op":22,"name":"info","args":["後來，諸多石像鬼成功產卵，\n按照馬騰預想的發展，新一代的石像鬼\n必定會大大的加強馬騰軍的實力。\n每想到此，他就笑得合不攏嘴。"]},{"op":52,"name":"actor_action","args":[138,3]},{"op":20,"name":"dialog","args":["&马腾\n哈哈，現在這裡反對我的敵人都消失了，\n我即將會是下一個西北霸主！"]},{"op":20,"name":"dialog","args":["&马腾\n將來等我徹底征服西北，\n便可一舉消滅曹操，那時咱們的榮華富貴\n就享之不盡啦！"]},{"op":20,"name":"dialog","args":["&马岱\n呵呵呵，真讓人期待……"]},{"op":36,"name":"play_sound","args":[21]},{"op":1,"name":"if","args":[],"off":757,"cond":{"op":2,"name":"comment","args":["破壞"]},"end":34,"end_off":880},{"op":9,"name":"delay","args":[6]},{"op":35,"name":"play_music","args":[7,1]},{"op":9,"name":"delay","args":[6]},{"op":35,"name":"play_music","args":[7,1]},{"op":9,"name":"delay","args":[12]},{"op":35,"name":"play_music","args":[7,1]},{"op":9,"name":"delay","args":[6]},{"op":35,"name":"play_music","args":[7,1]},{"op":9,"name":"delay","args":[12]},{"op":35,"name":"play_music","args":[38,1]},{"op":9,"name":"delay","args":[3]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[138,0]},{"op":51,"name":"actor_face","args":[58,0,1]},{"op":20,"name":"dialog","args":["&马腾\n這是什麼聲音？"]},{"op":1,"name":"if","args":[],"off":929,"cond":{"op":2,"name":"comment","args":["破壞"]},"end":50,"end_off":1052},{"op":9,"name":"delay","args":[6]},{"op":35,"name":"play_music","args":[7,1]},{"op":9,"name":"delay","args":[6]},{"op":35,"name":"play_music","args":[7,1]},{"op":9,"name":"delay","args":[12]},{"op":35,"name":"play_music","args":[7,1]},{"op":9,"name":"delay","args":[6]},{"op":35,"name":"play_music","args":[7,1]},{"op":9,"name":"delay","args":[12]},{"op":35,"name":"play_music","args":[38,1]},{"op":9,"name":"delay","args":[3]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&马岱\n好像是石頭破裂的聲音？"]},{"op":52,"name":"actor_action","args":[138,2]},{"op":20,"name":"dialog","args":["&马腾\n什麼？難道說……"]},{"op":9,"name":"delay","args":[3]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,59,65535]},{"op":48,"name":"actor_appear","args":[782,42,50,0,0]},{"op":48,"name":"actor_appear","args":[57,46,50,0,0]},{"op":48,"name":"actor_appear","args":[566,42,47,2,4]},{"op":48,"name":"actor_appear","a