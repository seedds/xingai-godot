,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[32,432,110]},{"op":44,"name":"caption","args":["刘备则奉命前往小沛。",1,0,1]},{"op":44,"name":"caption","args":["此时的长安……，",0,1,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[131,157,91]},{"op":41,"name":"op_29","args":[129,221,91]},{"op":44,"name":"caption","args":["势力日益衰落的李傕与郭汜，",1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":43,"name":"op_2b","args":[131]},{"op":43,"name":"op_2b","args":[129]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["最后被叛变的士兵所杀。",1,1,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":1704,"sections":[{"index":0,"offset":1706,"title":"许都  相府","body_off":1727,"body_end":3335,"conditions":[{"op":2,"name":"comment","args":["许都  相府"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[1,52,70,0,0]},{"op":48,"name":"actor_appear","args":[6,58,70,0,0]},{"op":48,"name":"actor_appear","args":[5,64,70,0,0]},{"op":48,"name":"actor_appear","args":[20,52,40,2,0]},{"op":48,"name":"actor_appear","args":[22,58,40,2,0]},{"op":48,"name":"actor_appear","args":[24,64,40,2,0]},{"op":48,"name":"actor_appear","args":[21,70,40,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[205,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&曹操\n听说李傕、郭汜被叛变的士兵杀了，\n这件事是真的吗？文若。\n&荀彧\n是的，主公。\n您打算如何处置这名士兵？"]},{"op":35,"name":"play_music","args":[205,255]},{"op":36,"name":"play_sound","args":[11]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":2130,"cond":{"op":18,"name":"choice","args":["赐给官职予以厚待\n斩杀不知忠义之徒",0]},"end":33,"end_off":2520},{"op":1,"name":"if","args":[],"off":2176,"cond":{"op":19,"name":"test_choice","args":[1]},"end":25,"end_off":2295},{"op":58,"name":"set_resource","args":[2,1,5]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n赠给他官位，\n正式就任长安守备之职，\n文若，马上去办！"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2295,"cond":{"op":19,"name":"test_choice","args":[2]},"end":32,"end_off":2518},{"op":58,"name":"set_resource","args":[2,2,5]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n不管什么理由，背叛杀害自己的主子，\n就是忘恩负义之辈。\n&曹操\n立即斩首！\n今后长安守备之职，\n由我军中挑选赴任。\n&曹操\n擢选之事就交给你了，文若。\n马上布置此事！"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n是。"]},{"op":48,"name":"actor_appear","args":[181,95,55,3,0]},{"op":20,"name":"dialog","args":["&士兵01\n报！"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":50,"name":"actor_move","args":[65535,181,0,48,55,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":20,"name":"dialog","args":["&士兵01\n主公，宛城的细作送来报告。\n&曹操\n宛城来的？\n&士兵01\n是的。\n&士兵01\n消息说张绣与荆州的刘表联手，\n似乎有图谋不轨的迹象。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n什么！？\n果真如此？\n&士兵01\n此事千真万确。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n主公，如此一来势态就严重了。"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[21,6,2]},{"op":20,"name":"dialog","args":["&程昱\n嗯。"]},{"op":51,"name":"actor_face","args":[21,0,2]},{"op":20,"name":"dialog","args":["&程昱\n刘表当年并未参加讨伐董卓，\n一心致力发展本国，是个唯我独尊之人。"]},{"op":20,"name":"dialog","args":["&程昱\n尤其还打败过孙坚，\n其部队实力之强可见一斑。"]},{"op":51,"name":"actor_face","args":[24,6,2]},{"op":20,"name":"dialog","args":["&荀攸\n我们应该先下手为强，\n立即进攻宛城。"]},{"op":51,"name":"actor_face","args":[24,0,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[20,6,2]},{"op":20,"name":"dialog","args":["&荀彧\n我也有同感。\n必须趁他羽翼未丰之前予以铲除。\n&曹操\n说得对……。"]},{"op":51,"name":"actor_face","args":[0,17,1]},{"op":20,"name":"dialog","args":["&曹操\n好！全军开往宛城。\n出发！"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[205,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":3335,"sections":[{"index":0,"offset":3337,"title":"军事会议  征讨张绣Ⅱ前","body_off":3370,"body_end":5328,"conditions":[{"op":2,"name":"comment","args":["军事会议  征讨张绣Ⅱ前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":3370,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":3,"end_off":3417},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,346,83]},{"op":44,"name":"caption","args":["见到宛城的张绣",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[143,248,144]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["呈现蠢蠢欲动的态势，",1,0,0]},{"op":9,"name":"delay","args":[7]},{"op":42,"name":"op_2a","args":[0,312,104]},{"op":9,"name":"delay","args":[7]},{"op":44,"name":"caption","args":["曹军再次进攻宛城。",1,1,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[15]},{"op":39,"name":"change_scene","args":[2,65535,65535,21,65535]},{"op":48,"name":"actor_appear","args":[0,49,67,0,0]},{"op":1,"name":"if","args":[],"off":3700,"cond":{"op":5,"name":"test_flags","args":[[710],[]]},"end":24,"end_off":3744},{"op":48,"name":"actor_appear","args":[15,38,48,1,0]},{"op":0,"name":"end","args":[]},{"op":48,"name":"actor_appear","args":[1,38,54,1,0]},{"op":48,"name":"actor_appear","args":[21,38,42,1,0]},{"op":48,"name":"actor_appear","args":[20,60,54,3,0]},{"op":48,"name":"actor_appear","args":[22,60,48,3,0]},{"op":48,"name":"actor_appear","args":[24,60,42,3,0]},{"op":48,"name":"actor_appear","args":[157,53,67,2,5]},{"op":1,"name":"if","args":[],"off":3900,"cond":{"op":5,"name":"test_flags","args":[[1270],[]]},"end":33,"end_off":3944},{"op":48,"name":"actor_appear","args":[16,38,48,1,0]},{"op":0,"name":"end","args":[]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["宛郊外  曹操军主营"]},{"op":20,"name":"dialog","args":["&曹操\n我们曾在宛城有过痛苦的经历，\n必须想个对策再进攻……\n文若，宛城的情况如何？"]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":20,"name":"dialog","args":["&荀彧\n并无较为特别的情形，\n不过四面城墙中的东墙，\n有一部分坏了。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n什么，东墙？\n&荀彧\n是的。"]},{"op":51,"name":"actor_face","args":[1,3,1]},{"op":20,"name":"dialog","args":["&夏侯惇\n孟德，那就没什么好犹豫的了，\n全军从东墙杀入吧。"]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n不，我们攻打西墙。"]},{"op":51,"name":"actor_face","args":[1,0,2]},{"op":20,"name":"dialog","args":["&夏侯惇\n什么？！为什么？"]},{"op":51,"name":"actor_face","args":[20,6,2]},{"op":20,"name":"dialog","args":["&荀彧\n这叫声东击西。\n&曹操\n嗯。"]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":20,"name":"dialog","args":["&夏侯惇\n什么是声东击西之计？"]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[20,0,3]},{"op":20,"name":"dialog","args":["&荀彧\n让张绣以为我们的攻击目标是西墙。\n&荀彧\n张绣当然会在西墙集中守军。\n&荀彧\n于是我们的精锐部队，\n就可趁此机会攻击守备薄弱的东墙。\n&夏侯惇\n原来是这样……。\n&曹操\n正是。"]},{"op":51,"name":"actor_face","args":[0,17,0]},{"op":20,"name":"dialog","args":["&曹操\n作战方案已定。\n出发！"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":1,"name":"if","args":[],