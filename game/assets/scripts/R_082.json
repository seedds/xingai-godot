]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":4138,"title":"玩家切换","body_off":4163,"body_end":4227,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[86]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&周泰\n快点出发吧。\n老子的刀已经等得不耐烦喽。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":4227,"title":"玩家切换","body_off":4252,"body_end":4344,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[89]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&陈武\n我的装备是「穿雲箭」，\n可以一次贯穿6名敌军。"]},{"op":20,"name":"dialog","args":["&周瑜\n挺好，挺好。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":4344,"title":"玩家切换","body_off":4369,"body_end":4591,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[95]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&太史慈\n等一下我会让敌军嚐嚐手戟的厲害。"]},{"op":20,"name":"dialog","args":["&甘宁\n哈哈，有了太史將軍，\n誰還需要凌統呢！"]},{"op":51,"name":"actor_face","args":[78,0,2]},{"op":20,"name":"dialog","args":["&鲁肃\n噓，真心話要放在心底啊。"]},{"op":51,"name":"actor_face","args":[78,0,3]},{"op":20,"name":"dialog","args":["&凌统\n哼！我都已經沒戲分了，\n居然還在背後酸我！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":4591,"title":"玩家切换","body_off":4616,"body_end":4890,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[83]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&徐盛\n我的「连环铠」很神奇。\n只要装备了它，每次攻击都能发出\n连击──包括反击。"]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n哈哈，那可真是不錯呢。"]},{"op":20,"name":"dialog","args":["&徐盛\n不過這個盔甲也有個缺點，\n那就是防禦力太低了。"]},{"op":52,"name":"actor_action","args":[77,17]},{"op":20,"name":"dialog","args":["&周瑜\n沒事。反正你的兵種是遠程，\n本來就不用站在前面。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":4890,"title":"玩家切换","body_off":4915,"body_end":5139,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[91]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&黄盖\n老身上次被張遼射了一箭，\n傷口現在都還沒完全癒合呢。"]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n沒事！只要我們拿下江陵，\n老將軍有的是時間休息呀。"]},{"op":20,"name":"dialog","args":["&黄盖\n(就連你上次在我身上打出的傷\n都還沒好呢……算了，不說了。)"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":5139,"title":"玩家切换","body_off":5164,"body_end":5512,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[94]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&韩当\n我的龍鱗鎧不光可以每回合恢復MP，\n還可以用MP代替血量使用呢。"]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n我的「孫子兵法」也能恢復MP，\n而且還有策略必中的效果，\n可說是謀士的神器喔。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&韩当\n此外，我騎的馬有神奇的力量，\n一回合可以行動兩次。"]},{"op":20,"name":"dialog","args":["&周瑜\n也只有這一關吧？"]},{"op":20,"name":"dialog","args":["&韩当\n…………"]},{"op":52,"name":"actor_action","args":[94,2]},{"op":20,"name":"dialog","args":["&韩当\n（好你個死中二！）"]},{"op":51,"name":"actor_face","args":[94,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":5512,"title":"玩家切换","body_off":5537,"body_end":5656,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[84]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&甘宁\n我的兵種是海盜，在水上的戰鬥力很高。\n而且被老子的刀砍到的對手都會降低防\n禦，更容易被我們打倒。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}