:[126,0,1]},{"op":20,"name":"dialog","args":["&陈宫\n曹操不久就会卷土重来……。\n&吕布\n嗯……不能大意呀。"]},{"op":51,"name":"actor_face","args":[126,0,3]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,126,0,48,54,3]},{"op":20,"name":"dialog","args":["&陈宫\n主公，那么我们这样办如何？\n如此这般……。\n&吕布\n好好……。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[203,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":747,"sections":[{"index":0,"offset":749,"title":"军事会议  濮阳之战Ⅱ前","body_off":782,"body_end":4608,"conditions":[{"op":2,"name":"comment","args":["军事会议  濮阳之战Ⅱ前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,21,65535]},{"op":48,"name":"actor_appear","args":[0,49,67,0,0]},{"op":48,"name":"actor_appear","args":[1,38,52,1,0]},{"op":48,"name":"actor_appear","args":[16,38,46,1,0]},{"op":48,"name":"actor_appear","args":[20,60,52,3,0]},{"op":48,"name":"actor_appear","args":[22,60,46,3,0]},{"op":48,"name":"actor_appear","args":[21,60,40,3,0]},{"op":48,"name":"actor_appear","args":[157,53,67,2,5]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["濮阳郊外  曹操军主营"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n可恶！吕布小儿真厉害！"]},{"op":51,"name":"actor_face","args":[22,0,2]},{"op":20,"name":"dialog","args":["&郭嘉\n吕布诚然是个可怕的对手，"]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":20,"name":"dialog","args":["&荀彧\n不过我们也不能因此放弃反攻。"]},{"op":51,"name":"actor_face","args":[21,0,2]},{"op":20,"name":"dialog","args":["&程昱\n是啊……。"]},{"op":48,"name":"actor_appear","args":[181,49,16,3,0]},{"op":20,"name":"dialog","args":["&士兵01\n报！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":51,"name":"actor_face","args":[22,0,3]},{"op":51,"name":"actor_face","args":[20,0,3]},{"op":51,"name":"actor_face","args":[21,0,3]},{"op":50,"name":"actor_move","args":[65535,181,0,49,52,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":20,"name":"dialog","args":["&士兵01\n主公，有一位住在濮阳的人求见您。"]},{"op":56,"name":"set_attr","args":[0,15,0,253]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n现在正召开军事会议，等会儿再说。\n&士兵01\n他说是为吕布的事而来的……。"]},{"op":36,"name":"play_sound","args":[12]},{"op":9,"name":"delay","args":[7]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n什么？……好吧，带他进来。\n&士兵01\n是。"]},{"op":52,"name":"actor_action","args":[181,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,181,0,49,16,0]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":48,"name":"actor_appear","args":[204,49,16,2,0]},{"op":20,"name":"dialog","args":["&商人\n在下失礼了。"]},{"op":50,"name":"actor_move","args":[65535,204,0,49,52,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[204,11]},{"op":20,"name":"dialog","args":["&曹操\n听说你是为了吕布的事而来。\n&商人\n是的，这里有一封我家主人的信。\n&曹操\n信？"]},{"op":50,"name":"actor_move","args":[65535,1,0,45,52,1]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[204,11]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[204,0,3]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[204,5,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,5]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[204,0,3]},{"op":50,"name":"actor_move","args":[65535,1,0,38,52,3]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[204,0,2]},{"op":50,"name":"actor_move","args":[65535,1,0,38,67,1]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,1,0,45,67,1]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,5]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[0,5,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[10]},{"op":50,"name":"actor_move","args":[65535,1,0,38,67,0]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,1,0,38,52,1]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[0,5,0]},{"op":20,"name":"dialog","args":["&曹操\n哦？「曹军攻击时，将在城中做内应」？\n嗯……………。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n为什么你们要做如此危险的事呢？\n如果事情败露，吕布会杀了你们的。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n照理说来商人都是唯利是图的，\n不是吗？"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n即使这个计策成功了，\n你们得到的利益也不如生命更宝贵。"]},{"op":51,"name":"actor_face","args":[204,11,2]},{"op":20,"name":"dialog","args":["&商人\n如今濮阳的商人们因为吕布身在城内，\n根本已经做不了生意了。\n&商人\n吕布横征暴敛、巧取豪夺，\n如同家常便饭。\n&商人\n如果曹大人不能重回濮阳，\n我们都活不下去了。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n原来是这么回事…\n这些事的确像是吕布干的勾当。"]},{"op":20,"name":"dialog","args":["&刘晔\n请等一下。"]},{"op":48,"name":"actor_appear","args":[18,49,16,2,0]},{"op":50,"name":"actor_move","args":[65535,18,0,49,44,2]},{"op":20,"name":"dialog","args":["&曹操\n哦，是子阳啊。\n让你到城内侦察，真是辛苦了。\n&刘晔\n主公，濮阳城禁止百姓出城，\n监视非常严密。\n&刘晔\n这个人居然能够出城来到我们营中，\n这封信恐怕是吕布的圈套……。"]},{"op":52,"name":"actor_action","args":[204,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[204,0,0]},{"op":20,"name":"dialog","args":["&商人\n这，这是因为…………\n是因为我家主人买通了守门的士兵。"]},{"op":51,"name":"actor_face","args":[204,0,2]},{"op":20,"name":"dialog","args":["&商人\n我……我没撒谎！全……全都是真的！\n&商人\n我得回去了，迟了主人会担心的，\n曹大人，请一定要相信我们！"]},{"op":50,"name":"actor_move","args":[65535,204,0,43,52,3]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,204,0,43,30,0]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,204,0,49,30,1]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,204,0,49,16,0]},{"op":49,"name":"actor_select","args":[65535,204,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,18,0,49,52,2]},{"op":20,"name":"dialog","args":["&刘晔\n主公，看来还是圈套吧……？\n&曹操\n可是如果是真的，\n这可是千载难逢的好机会。\n&曹操\n如今我们必须尽快夺回濮阳，\n子阳，你也参战吧。"]},{"op":52,"name":"actor_action","args":[18,6]},{"op":20,"name":"dialog","args":["&刘晔\n是。"]},{"op":59,"name":"join","args":[18,0,0]},{"op":36,"name":"play_sound","args":[15]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[18,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,18,0,49,40,0]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,18,0,38,40,1]},{"op":52,"name":"actor_action","args":[18,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":1,"name":"if","args":[],"off":3885,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":131,"end_off":3932},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3932,"cond":{"op":5,"name":"test_flags","args":[[794],[]]},"end":136,"end_off":3987},{"op":111,"name":"lose_item","args":[116]},{"op":111,"name":"lose_item","args":[116]},{"op":105,"name":"popup","args":["本關不可使用獨角獸。"]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,11,16,18,0,0,0,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,11,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"bat