dex":2,"offset":2344,"title":"玩家切换","body_off":2369,"body_end":3164,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[119]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&董卓\n呂布，擊退同盟軍的任務就交給你了。"]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n義父放心。我的武功天下無雙，\n他們在我的眼裡如同螻蟻！"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n哈哈，不愧是我的兒子。\n說得好！"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[847,4]},{"op":20,"name":"dialog","args":["&严氏\n嗚嗚。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,0,1]},{"op":20,"name":"dialog","args":["&吕布\n怎麼回事？妳哭什麼？"]},{"op":51,"name":"actor_face","args":[847,4,3]},{"op":20,"name":"dialog","args":["&严氏\n功夫再高，也怕菜刀。"]},{"op":20,"name":"dialog","args":["&严氏\n戰場如此凶險，\n即使夫君的武功真是天下無雙，\n也難保不會發生意外呀。"]},{"op":51,"name":"actor_face","args":[847,4,2]},{"op":20,"name":"dialog","args":["&严氏\n如果夫君有了閃失，\n我和女兒又該怎麼辦呢？"]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n哈哈，原來妳在擔心這個呀。\n沒事，老子的武功天下第一，\n誰能傷得了我？"]},{"op":20,"name":"dialog","args":["&吕布\n你放心，我一定會誓死保護你們母女！"]},{"op":51,"name":"actor_face","args":[847,0,3]},{"op":20,"name":"dialog","args":["&严氏\n夫君！"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n喔，奉先居然有女兒呀？真是讓人意外。\n改天把她帶來給我看看吧，哈哈哈哈！"]},{"op":51,"name":"actor_face","args":[119,0,3]},{"op":20,"name":"dialog","args":["&吕布\n！？"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":51,"name":"actor_face","args":[119,0,2]},{"op":51,"name":"actor_face","args":[847,0,2]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":3164,"title":"玩家切换","body_off":3189,"body_end":3395,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[132]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&李儒\n虎牢关非常險要，再加上有我和呂布\n將軍坐鎮，相國大可高枕無憂。"]},{"op":20,"name":"dialog","args":["&李儒\n再說了，相國可是有天命護體，\n怎懼那些小小賊寇！"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n哈哈，說得好！"]},{"op":20,"name":"dialog","args":["&李儒\n嘻嘻。"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":3395,"title":"玩家切换","body_off":3420,"body_end":3838,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[847]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[847,0,2]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n咦？哪裡來的美人？"]},{"op":51,"name":"actor_face","args":[847,5,2]},{"op":20,"name":"dialog","args":["&严氏\n！？"]},{"op":51,"name":"actor_face","args":[119,0,3]},{"op":20,"name":"dialog","args":["&吕布\n！！！！！！"]},{"op":52,"name":"actor_action","args":[847,6]},{"op":20,"name":"dialog","args":["&严氏\n小女子是呂布之妻。"]},{"op":20,"name":"dialog","args":["&董卓\n喔喔喔，原來奉先的妻子如此貌美，\n他可真是有福氣哇！哈哈哈哈哈哈！"]},{"op":20,"name":"dialog","args":["&严氏\n……多謝相國抬舉。"]},{"op":52,"name":"actor_action","args":[847,0]},{"op":52,"name":"actor_action","args":[127,0]},{"op":20,"name":"dialog","args":["&吕布\n………………"]},{"op":51,"name":"actor_face","args":[119,2,2]},{"op":20,"name":"dialog","args":["&吕布\n(哼，這個老色鬼該不會是在覬覦老子\n的老婆吧？老子得多留意著點。)"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":3838,"title":"玩家切换","body_off":3863,"body_end":4034,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[135]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&董卓\n話說回來，李肅你能夠從凶險的\n汜水關逃回來，真是不容易呢。"]},{"op":20,"name":"dialog","args":["&李肃\n哈哈，因為我命中注定是得活下去的呀。\n就算敵人真的殺死了我，老天也得讓我\n復活。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":4034,"title":"玩家切换","body_off":4059,"body_end":4186,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[128]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&张济\n我的兵種是西涼騎兵，和呂布將軍一樣。\n但是能力就比他差遠了。"]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n還用你說！？"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":4186,"title":"玩家切换","body_off":4211,"body_end":4260,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[129]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭汜\n我一定要報在汜水關的仇！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":4260,"title":"玩家切换","body_off":4285,"body_end":4345,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[130]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&徐荣\n我的裝備是手戟，\n可以增加攻擊範圍。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":4345,"title":"玩家切换","body_off":4370,"body_end":4417,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[131]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&李傕\n根據卦象顯示我軍必勝。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":4417,"title":"玩家切换","body_off":4442,"body_end":4540,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[133]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&樊稠\n我是弓騎兵，可以隔著一格打人。"]},{"op":20,"name":"dialog","args":["&徐荣\n(什麼呀，還不如我的手戟好用呢。)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}