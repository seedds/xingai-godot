{"file":"R_090.eex","kind":"story","scenario_index":180,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":22,"sections":[{"index":0,"offset":24,"title":"星落五丈原結束","body_off":49,"body_end":1771,"conditions":[{"op":2,"name":"comment","args":["星落五丈原結束"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":49,"cond":{"op":5,"name":"test_flags","args":[[589],[502]]},"end":59,"end_off":1769},{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":36,"name":"play_sound","args":[99]},{"op":11,"name":"set_flag","args":[1832,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,21,65535]},{"op":48,"name":"actor_appear","args":[816,49,67,0,0]},{"op":48,"name":"actor_appear","args":[819,38,54,1,0]},{"op":48,"name":"actor_appear","args":[117,38,48,1,0]},{"op":48,"name":"actor_appear","args":[817,60,54,3,0]},{"op":48,"name":"actor_appear","args":[818,60,48,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["五丈原 魏軍軍營"]},{"op":24,"name":"title_text","args":["星落五丈原"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[817,3,2]},{"op":20,"name":"dialog","args":["&司马师\n父親，剛才探子已經得到了確實的消息。\n諸葛亮的確已經死了，無庸置疑。"]},{"op":51,"name":"actor_face","args":[818,0,2]},{"op":20,"name":"dialog","args":["&司马昭\n哈哈，好一個諸葛亮！\n他都快死了還能讓我們這麼辛苦！\n哈哈哈哈哈哈！"]},{"op":20,"name":"dialog","args":["&司马懿1\n是啊，確實如此呢………"]},{"op":20,"name":"dialog","args":["&邓艾\n……………"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[816,0,2]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[816,4]},{"op":20,"name":"dialog","args":["&司马懿1\n唉！真是遺憾啊。"]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[817,0,2]},{"op":20,"name":"dialog","args":["&司马师\n父、父親！孔明已經死了，\n這對我們來說可是一件好事呀。\n您為何如此呢……？"]},{"op":52,"name":"actor_action","args":[816,0]},{"op":20,"name":"dialog","args":["&司马懿1\n唉，我在此刻的心情，\n你們又怎麼會明白呢？"]},{"op":51,"name":"actor_face","args":[816,0,0]},{"op":20,"name":"dialog","args":["&司马懿1\n一個了不起的人不光可以讓周圍的同伴\n們都信任他，讓天下人都崇拜他，\n甚至還能讓他的敵人敬佩他！"]},{"op":20,"name":"dialog","args":["&司马懿1\n諸葛亮就是這樣的一個人，\n即使他是我的敵人，我也敬佩他。"]},{"op":20,"name":"dialog","args":["&司马昭\n什麼……？"]},{"op":20,"name":"dialog","args":["&司马懿1\n我甚至還在想：假使我和他並不是敵人，\n而是互相合作同伴，那麼這個天下會\n朝什麼樣的方向發展呢？"]},{"op":20,"name":"dialog","args":["&司马昭\n啊？？？？"]},{"op":20,"name":"dialog","args":["&辛毗\n………………"]},{"op":20,"name":"dialog","args":["&邓艾\n(是宿敵，也是知己？\n這種關係還真是微妙呢。)"]},{"op":51,"name":"actor_face","args":[819,0,2]},{"op":20,"name":"dialog","args":["&邓艾\n(話說回來，我的宿敵又是誰呢？\n如果我將來也遇到了他，\n我是否能夠一樣的敬佩他？)"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[816,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[816,0,2]},{"op":20,"name":"dialog","args":["&司马懿1\n哈哈，永別了，諸葛亮。\n你的確是一個天下奇才！"]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["諸葛亮去世了，他的北伐也因此結束。\n一向與諸葛亮互相視為好敵手的魏國\n名將──司馬懿不禁對此感到落寞。"]},{"op":22,"name":"info","args":["只因諸葛亮對他來說不光是一個敵人，\n更是一個令他欽佩不已的好友、知音。"]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["孔明雖死，精神卻永遠留存在這個世上。\n即使是在1700多年以後，諸葛亮依然\n備受推崇著，直到永遠……"]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["本Mod的外傳模式已經結束，\n接下來進入其他模式。"]},{"op":36,"name":"play_sound","args":[255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":17,"name":"goto_scenario","args":[1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":1771,"sections":[{"index":0,"offset":1773,"title":"星落五丈原","body_off":1794,"body_end":2674,"conditions":[{"op":2,"name":"comment","args":["星落五丈原"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":36,"name":"play_sound","args":[15]},{"op":11,"name":"set_flag","args":[1832,1]},{"op":11,"name":"set_flag","args":[589,1]},{"op":53,"name":"set_r_image","args"