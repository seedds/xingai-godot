name":"dialog","args":["&庞德\n如果对前面情况不了解的话，\n还是叫我打头阵吧。\n&庞德\n我是步兵，虽然我速度慢了点，\n但是，对任何地形都是最适应的。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":7744,"title":"玩家切换","body_off":7769,"body_end":8013,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭嘉\n魔王看似聪明的举动，\n实在是白痴一个。\n&曹操\n哦？怎么讲？\n&郭嘉\n他把自己关在了地下洞穴，\n其实就是自掘坟墓啊……\n&曹操\n对啊……我怎么没想到。\n&郭嘉\n不过前提还是要保证我们能胜利才行。\n&曹操\n传令全军，一定不要再让孔明逃了！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":8013,"title":"玩家切换","body_off":8038,"body_end":8200,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[24]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀攸\n丞相放心，\n我新从长安调集了足够的粮草。\n&曹操\n这些年来，辛苦你了。\n&荀攸\n您客气了。\n看着每次作战的将士们都能吃饱饭，\n就是我最高兴的事情。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":8200,"title":"玩家切换","body_off":8225,"body_end":8295,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[21]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&程昱\n想想魔王所做的，真是死有余辜！！\n&关羽\n……。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":8295,"title":"玩家切换","body_off":8320,"body_end":8415,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[20]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀彧\n我军对地下战场的情况一无所知，\n只要小心谨慎，定能取得胜利。\n&曹操\n嗯。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":8415,"title":"玩家切换","body_off":8440,"body_end":8506,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[19]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&司马懿\n孔明……\n我真不想在这种情形下与你作战。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":8506,"title":"玩家切换","body_off":8531,"body_end":8686,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[23]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&贾诩\n为何孔明将祭坛建于地下呢？\n难道……\n&曹操\n……地下就是不见天日的地方，\n或许正是最适合死者出没之地。\n&贾诩\n看来主公得多加留意才是。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":8686,"title":"玩家切换","body_off":8711,"body_end":8775,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n什么都甭说了。\n胜利一定是属于咱们的。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":8775,"title":"玩家切换","body_off":8800,"body_end":8874,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[3]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&关羽\n只要赢了这场战事，\n就能够看到兄长托付关某的未来。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":8874,"title":"玩家切换","body_off":8899,"body_end":9301,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[17]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":20,"name":"dialog","args":["&貂蝉\n（父亲、母亲，请您拭目以待，\n这将是最后一战了。\n義父，奉先……请赐给我力量吧……）"]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n怎么了？貂蝉。"]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":20,"name":"dialog","args":["&貂蝉\n啊？"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n没，没什么。\n丞相，请下令吧。"]},{"op":1,"name":"if","args":[],"off":9136,"cond":{"op":5,"name":"test_flags","args":[[596],[]]},"end":19,"end_off":9279},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[804,0,2]},{"op":20,"name":"dialog","args":["&蔡琰\n………………"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[804,0,1]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&蔡琰\n(貂蟬至今仍沒忘記呂布那個爛人嗎？\n唉。)"]},{"op":0,"name":"end","args":[]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":9301,"title":"玩家切换","body_off":9326,"body_end":9577,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[804]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[804,6,2]},{"op":20,"name":"dialog","args":["&蔡琰\n貂蟬，這麼多年來都是妳在支持著我，\n謝謝你。"]},{"op":51,"name":"actor_face","args":[17,6,0]},{"op":20,"name":"dialog","args":["&貂蝉\n哪裡，我才要謝謝妳一直帶給我勇氣呢。"]},{"op":51,"name":"actor_face","args":[804,0,2]},{"op":51,"name":"actor_face","args":[17,0,0]},{"op":20,"name":"dialog","args":["&蔡琰\n貂蟬………"]},{"op":51,"name":"actor_face","args":[17,3,0]},{"op":20,"name":"dialog","args":["&貂蝉\n昭姬！"]},{"op":51,"name":"actor_face","args":[804,0,1]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}