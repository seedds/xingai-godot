,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[41,0,3]},{"op":51,"name":"actor_face","args":[32,0,0]},{"op":20,"name":"dialog","args":["&糜竺\n我想請問一下張將軍：\n您的那些馬真的是買來的嗎？"]},{"op":20,"name":"dialog","args":["&张飞\n！！！！"]},{"op":52,"name":"actor_action","args":[33,3]},{"op":20,"name":"dialog","args":["&张飞\n哈哈，這是當然的啊！\n如果不是買來的，難道還會是搶來的啊？\n哈哈哈哈哈哈………"]},{"op":52,"name":"actor_action","args":[33,0]},{"op":20,"name":"dialog","args":["&刘备\n！！！！！"]},{"op":20,"name":"dialog","args":["&刘备\n三弟，難道你……？"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":7114,"title":"玩家切换","body_off":7139,"body_end":7542,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[42]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&糜芳\n對了，曹操好像會派援軍來\n幫助我們。"]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n真的嗎？那真是太好了！"]},{"op":20,"name":"dialog","args":["&糜芳\n除此之外，我也將呂布入侵的事\n告訴董梁、趙何他們了，\n他們說會帶人過來幫忙。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&刘备\n啊！？"]},{"op":20,"name":"dialog","args":["&糜芳\n請問主公是怎麼了嗎？"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&刘备\n喔，沒有，沒什麼……"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[32,0,2]},{"op":20,"name":"dialog","args":["&刘备\n(咦？這種悲哀的感覺是怎麼回事？\n為何我忽然想起李明和藩宮了？)"]},{"op":51,"name":"actor_face","args":[32,0,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":7542,"title":"玩家切换","body_off":7567,"body_end":7697,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[43]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&简雍\n我雖然是弓箭手，\n但是我卻更擅長端茶水。\n有誰需要吃補品就來找我吧。\n&刘备\n(…………好吧，有總比沒有好吧。)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":7697,"title":"玩家切换","body_off":7722,"body_end":7798,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[40]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&孙乾\n我是辎重队，最擅长补给，\n后勤的事情就交给我处理吧。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}