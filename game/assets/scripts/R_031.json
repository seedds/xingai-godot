:0,"name":"end","args":[]}]},{"index":3,"offset":4540,"title":"玩家切换","body_off":4565,"body_end":4868,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[12]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹操\n子廉。\n&曹洪\n主公，我很抱歉。\n都是因為我，潼關才會……"]},{"op":20,"name":"dialog","args":["&曹操\n什麼都不用說了。\n勝敗乃兵家常事，我原諒你。"]},{"op":20,"name":"dialog","args":["&曹操\n今後要更加謹慎，\n不可輕易被情緒沖昏頭。"]},{"op":52,"name":"actor_action","args":[12,6]},{"op":20,"name":"dialog","args":["&曹洪\n是！多謝主公的寬恕！"]},{"op":20,"name":"dialog","args":["&曹操\n總之，你和徐晃迂回到西凉军后方。\n明白吗？\n&曹洪\n遵命！"]},{"op":51,"name":"actor_face","args":[12,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":4868,"title":"玩家切换","body_off":4893,"body_end":4965,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许褚\n我的拳脚都等得发痒了。\n请主公务必让我大战马超。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":4965,"title":"玩家切换","body_off":4990,"body_end":5301,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n「西凉锦马超」？\n好像不怎么样嘛。\n真的很厉害吗？\n&贾诩\n马超的刚勇是无可置疑的。\n&夏侯惇\n是吗……？\n&曹操\n听说他还生得相当英挺俊秀。\n要是见到元让的相貌，\n我看女人都全吓跑了。\n&夏侯惇\n孟德！！"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。\n说笑，说笑嘛。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":5301,"title":"玩家切换","body_off":5326,"body_end":5789,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[23]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&贾诩\n主公，武艺高超的不只马超一人。\n&贾诩\n马超的堂弟马岱，还有庞德，\n都是勇冠三军的猛将。"]},{"op":1,"name":"if","args":[],"off":5427,"cond":{"op":5,"name":"test_flags","args":[[1270],[1278]]},"end":5,"end_off":5475},{"op":20,"name":"dialog","args":["&典韦\n庞德？真想会会。\n"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":5475,"cond":{"op":5,"name":"test_flags","args":[[1270,1278],[]]},"end":15,"end_off":5781},{"op":20,"name":"dialog","args":["&典韦\n庞德？你是說那個身披重甲的傢伙嗎？"]},{"op":20,"name":"dialog","args":["&典韦\n我上次已經和他交手過了，\n他的確有兩下子呢。\n"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n喔？既然典韋都這麼說了，\n那麼他肯定是個優秀的將領吧。"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":51,"name":"actor_face","args":[16,0,2]},{"op":20,"name":"dialog","args":["&典韦\n是的！\n我甚至覺得他的實力可能不下於馬超呢。"]},{"op":51,"name":"actor_face","args":[16,0,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":5789,"title":"玩家切换","body_off":5814,"body_end":5936,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[24]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀攸\n这个时候天气容易转坏，\n使用策略时必须注意。"]},{"op":20,"name":"dialog","args":["&荀攸\n(好在我的策略都是補血和加Buff，\n所以沒差。)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}