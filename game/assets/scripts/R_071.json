{"file":"R_071.eex","kind":"story","scenario_index":142,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":30,"sections":[{"index":0,"offset":32,"title":"曹操形象","body_off":51,"body_end":127,"conditions":[{"op":2,"name":"comment","args":["曹操形象"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,0]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":1,"name":"if","args":[],"off":71,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":99},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":127,"sections":[{"index":0,"offset":129,"title":"落鳳坡結束","body_off":150,"body_end":1109,"conditions":[{"op":2,"name":"comment","args":["落鳳坡結束"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":150,"cond":{"op":5,"name":"test_flags","args":[[570],[578]]},"end":36,"end_off":1107},{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":36,"name":"play_sound","args":[36]},{"op":11,"name":"set_flag","args":[1832,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,21,65535]},{"op":48,"name":"actor_appear","args":[32,49,67,0,0]},{"op":48,"name":"actor_appear","args":[43,38,54,1,0]},{"op":48,"name":"actor_appear","args":[37,38,48,1,0]},{"op":48,"name":"actor_appear","args":[36,38,42,1,0]},{"op":48,"name":"actor_appear","args":[40,38,36,1,0]},{"op":48,"name":"actor_appear","args":[45,60,54,3,0]},{"op":48,"name":"actor_appear","args":[47,60,48,3,0]},{"op":48,"name":"actor_appear","args":[49,60,42,3,0]},{"op":48,"name":"actor_appear","args":[46,49,52,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["雒城外  劉備军主营"]},{"op":35,"name":"play_music","args":[79,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&关平\n主公……副軍師身中數百支毒箭，\n他早已回天乏術了……請您節哀。"]},{"op":20,"name":"dialog","args":["&刘备\n別再說了……"]},{"op":52,"name":"actor_action","args":[32,4]},{"op":20,"name":"dialog","args":["&刘备\n嗚嗚嗚……水鏡先生當年跟我說過，\n臥龍鳳雛，得一可安天下，\n怎麼現在變成這樣？"]},{"op":52,"name":"actor_action","args":[32,9]},{"op":20,"name":"dialog","args":["&刘备\n我的命好苦哇……"]},{"op":35,"name":"play_music","args":[80,1]},{"op":21,"name":"unit_say","args":[176,176,"怪我喽？\n我又不是作者，你是從什麼時候開始\n產生了我講的話就是故事設定的錯覺？"]},{"op":21,"name":"unit_say","args":[90,90,"唉，真是太可惜了。\n如果我沒死的話，荊州就不會丟。\n荊州不會丟，主公就能完成夢想了。"]},{"op":20,"name":"dialog","args":["&许子将\n好了，龐統你已經死了！\n快點下去吧，你早就沒戲份啦。"]},{"op":22,"name":"info","args":["因為副軍師龐統的死去，\n劉備不得不重新擬定攻取西川的計畫，\n最終攻陷了西川，建立了自己的大業。"]},{"op":35,"name":"play_music","args":[80,255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":17,"name":"goto_scenario","args":[155]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":1109,"sections":[{"index":0,"offset":1111,"title":"呂蒙的盤算","body_off":1132,"body_end":2735,"conditions":[{"op":2,"name":"comment","args":["呂蒙的盤算"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":36,"name":"play_sound","args":[43]},{"op":9,"name":"delay","args":[3]},{"op":53,"name":"set_r_image","args":[840,29]},{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":56,"name":"set_attr","args":[834,15,0,1]},{"op":53,"name":"set_r_image","args":[834,204]},{"op":48,"name":"actor_appear","args":[80,34,55,1,12]},{"op":48,"name":"actor_appear","args":[81,52,40,2,0]},{"op":48,"name":"actor_appear","args":[82,52,70,0,0]},{"op":48,"name":"actor_appear","args":[822,58,70,0,0]},{"op":48,"name":"actor_appear","args":[840,58,52,3,0]},{"op":48,"name":"actor_appear","args":[42,58,58,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":24,"name":"title_text","args":["武聖悲歌"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[80,3]},{"op":20,"name":"dialog","args":["&吕蒙\n哈哈，我們終於打敗名聞天下的關羽了。\n糜芳，傅士仁，你倆功不可沒！"]},{"op":52,"name":"actor_action","args":[840,11]},{"op":20,"name":"dialog","args":["&傅士仁\n哈哈，多謝呂蒙都督賞識。\n能為都督效力，是末將的光榮！"]},{"op":20,"name":"dialog","args":["&糜芳\n…………"]},{"op":20,"name":"dialog","args":["&陆逊\n(呵呵。)"]},{"op":20,"name":"dialog","args":["&吕蒙\n你們放心，等我秉告吳侯你倆的功績，\n好處當然是少不了的。"]},{"op":20,"name":"dialog","args":["&傅士仁\n嘿嘿，多謝，多謝。"]},{"op":20,"name":"dialog","args":["&糜芳\n…………"]},{"op":52,"name":"actor_action","args":[80,0]},{"op":20,"name":"dialog","args":["&吕蒙\n好了，你們先退下吧。"]},{"op":20,"name":"dialog","args":["&傅士仁\n遵命！"]},{"op":52,"name":"actor_action","args":[840,0]},{"op":50,"name":"actor_move","args":[65535,840,0,96,52,1]},{"op":50,"name":"actor_move","args":[65535,42,0,96,58,1]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,840,0,98,52,1]},{"op":50,"name":"actor_move","args":[65535,42,0,98,58,1]},{"op":49,"name":"actor_select","args":[65535,840,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,42,0,0,0,0,65535]},{"op":9,"name":"delay","args":[8]},{"op":52,"name":"actor_action","args":[80,2]},{"op":20,"name":"dialog","args":["&吕蒙\n哼，傅士仁這個不知羞恥的小人，\n留著他一點用處也沒有。\n糜芳還知道一點廉恥。"]},{"op":52,"name":"actor_action","args":[80,0]},{"op":9,"name":"delay","args":[2]},{"op":52,"name":"actor_action","args":[81,6]},{"op":20,"name":"dialog","args":["&陆逊\n呂蒙大人，眼下還是設法擒拿關羽吧。"]},{"op":20,"name":"dialog","args":["&陆逊\n現在麥城雖然已經被包圍得水洩不通，\n但是咱們的對手可是身經百戰的關羽，\n我們千萬不能掉以輕心。"]},{"op":52,"name":"actor_action","args":[80,3]},{"op":20,"name":"dialog","args":["&吕蒙\n哈哈，伯言所言極是！"]},{"op":52,"name":"actor_action","args":[81,0]},{"op":9,"name":"delay","args":[2]},{"op":52,"name":"actor_action","args":[80,0]},{"op":20,"name":"dialog","args":["&吕蒙\n潘璋，你現在就在麥城的逃亡路上\n佈下伏兵，千萬不能讓關羽跑了！"]},{"op":51,"name":"actor_face","args":[82,11,3]},{"op":51,"name":"actor_face","args":[822,11,3]},{"op":20,"name":"dialog","args":["&潘璋\n是。定生擒關羽。"]},{"op":51,"name":"actor_face","args":[82,0,1]},{"op":51,"name":"actor_face","args":[822,0,1]},{"op":50,"name":"actor_move","args":[65535,822,0,98,70,1]},{"op":50,"name":"actor_move","args":[65535,82,0,96,70,1]},{"op":30,"name":"wait_frame","args":[]},{"op":49,"name":"actor_select","args":[65535,822,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,82,0,98,70,1]},{"op":49,"name":"actor_select","args":[65535,82,0,0,0,0,65535]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&吕蒙\n哼哼，關雲長，今日你是插翅也難飛啦！"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":2735,"sections":[{"index":0,"offset":2737,"title":"廖化求援","body_off":2756,"body_end":5809,"conditions":[{"op":2,"name":"comment","args":["廖化求援"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,6,65535]},{"op":48,"name":"actor_appear","args":[45,70,55,3,0]},{"op":48,"name":"actor_appear","args":[65,54,72,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[43]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["上庸 劉封公馆"]},{"op":48,"name":"actor_appear","args":[44,10,55,1,0]},{"op":20,"name":"dialog","args":["&廖化\n劉封公子！"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[65535,44,0,54,55,1]},{"op":52,"name":"actor_action","args":[44,0]},{"op":52,"name":"actor_action","args":[45,17]},{"op":20,"name":"dialog","args":["&刘封\n哦，是廖化，什么風把你吹來了？"]},{"op":52,"name":"actor_action","args":[45,0]},{"op":52,"name":"actor_action","args":[44,4]},{"op":20,"name":"dialog","args":["&廖化\n劉封公子！荊州已經失陷，\n關二將軍現在被圍困在麥城動彈不得，\n還請公子速速派出援軍救援哪！"]},{"op":52,"name":"actor_action","args":[45,17]},{"op":20,"name":"dialog","args":["&刘封\n這…這還得了？\n我現在就去做好增援的準備！"]},{"op":52,"name":"actor_action","args":[44,11]},{"op":20,"name":"dialog","args":["&廖化\n多謝公子！我先在此謝過了！"]},{"op":52,"name":"actor_action","args":[45,0]},{"op":20,"name":"dialog","args":["&孟达\n且慢！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[44,0,2]},{"op":20,"name":"dialog","args":["&廖化\n孟達大人，這是……？"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&孟达\n現在荊州已經失陷，敗局已定，\n光憑上庸的這點兵力根本不可能\n改變什麼。"]},{"op":20,"name":"dialog","args":["&孟达\n如果我們貿然出兵，不但救不出關羽\n將軍，甚至連這座上庸城都保不住呀。"]},{"op":52,"name":"actor_action","args":[44,3]},{"op":20,"name":"dialog","args":["&廖化\n！！！！！"]},{"op":20,"name":"dialog","args":["&刘封\n這、這個……"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[44,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[44,4]},{"op":20,"name":"dialog","args":["&廖化\n拜託了，請二位不要見死不救呀！\n現在上庸的援軍已經是我們最後的\n希望，"]},{"op":20,"name":"dialog","args":["&廖化\n如果二位袖手旁觀，那麼關二將軍\n就真的非死不可啦！"]},{"op":20,"name":"dialog","args":["&刘封\n…………"]},{"op":9,"name":"delay","args":[6]},{"op":52,"name":"actor_action","args":[45,6]},{"op":20,"name":"dialog","args":["&刘封\n廖化，你就先下去歇息吧，\n我會再和孟達談談的。"]},{"op":52,"name":"actor_action","args":[45,0]},{"op":52,"name":"actor_action","args":[44,0]},{"op":20,"name":"dialog","args":["&廖化\n這……"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[44,0,3]},{"op":20,"name":"dialog","args":["&廖化\n唉！"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,44,0,5,55,3]},{"op":49,"name":"actor_select","args":[65535,44,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[8]},{"op":50,"name":"actor_move","args":[65535,65,0,39,72,3]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,65,0,54,55,1]},{"op":52,"name":"actor_action","args":[65,0]},{"op":52,"name":"actor_action","args":[45,17]},{"op":20,"name":"dialog","args":["&刘封\n孟達！你到底在做什麼？\n關羽是我的叔父，我怎能對他\n見死不救？"]},{"op":52,"name":"actor_action","args":[45,0]},{"op":20,"name":"dialog","args":["&孟达\n哼哼，你把他當叔父，\n他把你當侄子了嗎？"]},{"op":20,"name":"dialog","args":["&刘封\n！！！！！"]},{"op":20,"name":"dialog","args":["&孟达\n你可別忘了：漢中王本來也考慮過讓你\n當世子，就是這個關羽在從中作梗。"]},{"op":20,"name":"dialog","args":["&孟达\n現在你不但當不成世子，\n還被派到上庸這個鳥不拉屎的地方，\n你難道一點都不恨他嗎？"]},{"op":20,"name":"dialog","args":["&刘封\n……………………"]},{"op":52,"name":"actor_action","args":[65,11]},{"op":20,"name":"dialog","args":["&孟达\n從現在荊州的戰況來說，我們能否能夠\n自保都是個問題，更別說是救援關羽了\n，那根本就是以卵擊石。"]},{"op":20,"name":"dialog","args":["&孟达\n最糟糕的狀況就是我們不光沒能\n救出關羽，甚至連這個上庸都保\n不住。"]},{"op":20,"name":"dialog","args":["&孟达\n更何況關羽又從來都沒把你當侄子，\n你又何必為了他冒險犯難呢？"]},{"op":51,"name":"actor_face","args":[45,0,1]},{"op":20,"name":"dialog","args":["&刘封\n這……這倒也是事實呀。我……"]},{"op":48,"name":"actor_appear","args":[44,10,55,1,0]},{"op":20,"name":"dialog","args":["&廖化\n太可惡了！"]},{"op":51,"name":"actor_face","args":[65,0,3]},{"op":51,"name":"actor_face","args":[45,17,3]},{"op":20,"name":"dialog","args":["&刘封\n啊？廖化？"]},{"op":52,"name":"actor_action","args":[45,0]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[65535,44,0,32,55,1]},{"op":52,"name":"actor_action","args":[44,2]},{"op":20,"name":"dialog","args":["&廖化\n都什麼時候了，你們居然還在計較\n這些私人恩怨！"]},{"op":20,"name":"dialog","args":["&刘封\n你…你都聽到了？"]},{"op":20,"name":"dialog","args":["&廖化\n對！我剛才什麼都聽到了！"]},{"op":52,"name":"actor_action","args":[44,17]},{"op":20,"name":"dialog","args":["&廖化\n一句話：你們到底要不要派援軍！？\n快給我一個痛快！"]},{"op":20,"name":"dialog","args":["&刘封\n這……我……"]},{"op":51,"name":"actor_face","args":[65,0,2]},{"op":20,"name":"dialog","args":["&孟达\n哼，不派，就是這麼簡單。"]},{"op":20,"name":"dialog","args":["&孟达\n理由我們已經說了：\n就算我們想要幫忙，也是愛莫能助。\n你還是到別的地方去請援軍吧。"]},{"op":52,"name":"actor_action","args":[44,3]},{"op":20,"name":"dialog","args":["&廖化\n你…你們難道就不怕我去跟漢中王\n告狀嗎！？"]},{"op":51,"name":"actor_face","args":[65,2,3]},{"op":20,"name":"dialog","args":["&孟达\n切，隨你的便吧。"]},{"op":51,"name":"actor_face","args":[65,0,3]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[44,2,1]},{"op":20,"name":"dialog","args":["&廖化\n劉封公子，你也是這麼想的嗎！？"]},{"op":20,"name":"dialog","args":["&刘封\n…………………"]},{"op":52,"name":"actor_action","args":[45,17]},{"op":20,"name":"dialog","args":["&刘封\n該說的話孟達都已經說了，\n我們上庸已經是自身難保了，\n你還是去別的地方求援吧。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[44,2,1]},{"op":20,"name":"dialog","args":["&廖化\n哼！"]},{"op":52,"name":"actor_action","args":[45,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[44,4,3]},{"op":20,"name":"dialog","args":["&廖化\n關二將軍啊！廖化未能完成使命啊！"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,44,0,5,55,3]},{"op":49,"name":"actor_select","args":[65535,44,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&刘封\n………………………"]},{"op":20,"name":"dialog","args":["&刘封\n(………我這樣做真的對嗎？)"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":5809,"sections":[{"index":0,"offset":5811,"title":"军事会议 逃亡","body_off":5835,"body_end":7026,"conditions":[{"op":2,"name":"comment","args":["军事会议 逃亡"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":36,"name":"play_sound","args":[36]},{"op":11,"name":"set_flag","args":[571,1]},{"op":11,"name":"set_flag","args":[559,0]},{"op":53,"name":"set_r_image","args":[0,202]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":39,"name":"change_scene","args":[2,65535,65535,13,65535]},{"op":48,"name":"actor_appear","args":[3,73,55,1,0]},{"op":48,"name":"actor_appear","args":[53,52,42,2,0]},{"op":48,"name":"actor_appear","args":[66,46,42,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["麥城"]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[46,5,55,1,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&关平\n父親……"]},{"op":50,"name":"actor_move","args":[65535,46,0,55,55,1]},{"op":52,"name":"actor_action","args":[46,0]},{"op":20,"name":"dialog","args":["&关羽\n…………上庸的援軍還沒有到嗎？"]},{"op":20,"name":"dialog","args":["&关平\n沒有……\n上庸那邊完全沒有派出援軍的跡象。"]},{"op":20,"name":"dialog","args":["&关兴\n莫非是廖化出事了嗎？\n還是說劉封和孟達對我們見死不救？"]},{"op":20,"name":"dialog","args":["&关索\n可恨！"]},{"op":20,"name":"dialog","args":["&关兴\n看來我們今日真的要死在麥城了……"]},{"op":20,"name":"dialog","args":["&关羽\n………………"]},{"op":51,"name":"actor_face","args":[3,0,3]},{"op":52,"name":"actor_action","args":[3,17]},{"op":20,"name":"dialog","args":["&关羽\n孩兒們，你們千萬別洩氣！\n今夜你們就出城逃亡，爹掩護你們！"]},{"op":52,"name":"actor_action","args":[46,0]},{"op":20,"name":"dialog","args":["&关平\n！！！！！"]},{"op":51,"name":"actor_face","args":[53,0,1]},{"op":51,"name":"actor_face","args":[66,0,1]},{"op":20,"name":"dialog","args":["&关兴\n父親何出此言？我們要與您並肩作戰！"]},{"op":20,"name":"dialog","args":["&关索\n沒錯！我們是一家人，\n就算要死也要死在一塊兒！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n別再說了，荊州是我丟的，\n你們沒必要跟我一起陪葬。"]},{"op":20,"name":"dialog","args":["&关索\n爹……"]},{"op":52,"name":"actor_action","args":[3,2]},{"op":20,"name":"dialog","args":["&关羽\n聽著，今夜你們就出城，\n你們都要活下去！這是爹下的\n最後一道命令，不准違抗！"]},{"op":52,"name":"actor_action","args":[53,0]},{"op":20,"name":"dialog","args":["&关兴\n父親……永別了。"]},{"op":51,"name":"actor_face","args":[3,0,1]},{"op":20,"name":"dialog","args":["&关羽\n(這樣就行了。荊州是我丟的，\n如果真的有人得付出代價，\n那人也應該是我。)"]},{"op":20,"name":"dialog","args":["&关羽\n(大哥…翼德…我先走一步了。)"]},{"op":9,"name":"delay","args":[3]},{"op":8,"name":"set_menu","args":[0]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]}]}]}