"op":39,"name":"change_scene","args":[0,169,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[10]},{"op":44,"name":"caption","args":["董卓殘暴無度，",0,1,0]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["人人憤恨，",1,0,0]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["最終死於王允和呂布發動的政變。",1,0,1]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["想當年，董卓曾收買呂布殺害丁原，",1,1,1]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["自己也得到同樣的下場，",1,0,0]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["可說是因果循環，",1,1,1]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["報應不爽！",1,0,1]},{"op":9,"name":"delay","args":[10]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":717,"sections":[{"index":0,"offset":719,"title":"军事会议  孫堅中伏之戰以前","body_off":756,"body_end":2004,"conditions":[{"op":2,"name":"comment","args":["军事会议  孫堅中伏之戰以前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":36,"name":"play_sound","args":[15]},{"op":11,"name":"set_flag","args":[1832,1]},{"op":11,"name":"set_flag","args":[576,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,54,65535]},{"op":48,"name":"actor_appear","args":[99,53,37,2,0]},{"op":48,"name":"actor_appear","args":[100,53,60,0,0]},{"op":48,"name":"actor_appear","args":[77,42,68,1,0]},{"op":48,"name":"actor_appear","args":[91,42,60,1,0]},{"op":48,"name":"actor_appear","args":[94,67,60,3,0]},{"op":48,"name":"actor_appear","args":[98,67,68,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":[" 孫堅军主营"]},{"op":24,"name":"title_text","args":["孫堅中伏"]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["本關是「孫堅中伏」，\n我們將以孫堅軍的視角遊玩，\n勝利條件是掩護孫堅脫離險境。"]},{"op":22,"name":"info","args":["如果成功擊退劉表，\n可獲得寶物「白銀盾」。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[100,6]},{"op":20,"name":"dialog","args":["&孙策\n父亲，咱们终于又要与刘表交手了。\n这场战会是个硬仗，我们绝不可大意。"]},{"op":52,"name":"actor_action","args":[100,0]},{"op":20,"name":"dialog","args":["&孙坚\n伯符说得是。但是我是江东猛虎，\n绝对不可在此退缩！"]},{"op":52,"name":"actor_action","args":[77,1]},{"op":20,"name":"dialog","args":["&周瑜\n美丽又丑陋的命运之神哪，\n你那沉默的多言呀。"]},{"op":52,"name":"actor_action","args":[77,11]},{"op":20,"name":"dialog","args":["&周瑜\n吾主即将洗涤江东的灵魂，\n这是何等纯淨的污浊！何等仁厚的残酷！"]},{"op":20,"name":"dialog","args":["&孙坚\n……………………"]},{"op":20,"name":"dialog","args":["&孙坚\n(這小子又在胡說些什麼呀？)"]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n如何？在下的詩是不是很美呀？\n各位不用拘謹，儘管讚嘆我的文采吧。"]},{"op":20,"name":"dialog","args":["&黄盖\n……………………"]},{"op":20,"name":"dialog","args":["&韩当\n(这种无病呻吟能算是诗吗？)"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&孙坚\n………准备出征。"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&黄盖\n(是我的錯覺嗎？\n我怎麼覺得這一仗應該\n是在董卓死前發生的呢？)"]},{"op":9,"name":"delay","args":[3]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,2,1,0,0,0,0,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":2004,"sections":[{"index":0,"offset":2006,"title":"玩家切换","body_off":2027,"body_end":2388,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&孙坚\n出发。捍衛我的玉璽！"]