{"file":"R_022.eex","kind":"story","scenario_index":44,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":46,"sections":[{"index":0,"offset":48,"title":"曹操形象","body_off":67,"body_end":143,"conditions":[{"op":2,"name":"comment","args":["曹操形象"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,0]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":1,"name":"if","args":[],"off":87,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":115},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":143,"sections":[{"index":0,"offset":145,"title":"黎阳  曹操军撤兵","body_off":172,"body_end":1069,"conditions":[{"op":2,"name":"comment","args":["黎阳  曹操军撤兵"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":56,"name":"set_attr","args":[1,15,0,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,21,65535]},{"op":48,"name":"actor_appear","args":[0,49,67,0,0]},{"op":48,"name":"actor_appear","args":[1,38,54,1,0]},{"op":48,"name":"actor_appear","args":[15,38,48,1,0]},{"op":48,"name":"actor_appear","args":[24,38,42,1,0]},{"op":48,"name":"actor_appear","args":[20,60,54,3,0]},{"op":48,"name":"actor_appear","args":[22,60,48,3,0]},{"op":48,"name":"actor_appear","args":[21,60,42,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["等待内讧"]},{"op":23,"name":"place_name","args":["黎阳  曹操军主营"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,2]},{"op":56,"name":"set_attr","args":[0,15,0,253]},{"op":20,"name":"dialog","args":["&曹操\n可恶，这些臭小子，\n居然集结那么多兵马。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":51,"name":"actor_face","args":[21,0,2]},{"op":20,"name":"dialog","args":["&程昱\n这回真是有点轻敌了。"]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":20,"name":"dialog","args":["&荀彧\n想不到袁绍还留下这么多兵马……"]},{"op":51,"name":"actor_face","args":[22,0,2]},{"op":20,"name":"dialog","args":["&郭嘉\n是啊……\n主公，我们先撤回许都吧。"]},{"op":51,"name":"actor_face","args":[1,3,1]},{"op":20,"name":"dialog","args":["&夏侯惇\n撤兵？\n难道就这样放弃河北？"]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[22,0,3]},{"op":20,"name":"dialog","args":["&郭嘉\n不！河北早晚是我们的。"]},{"op":52,"name":"actor_action","args":[24,6]},{"op":20,"name":"dialog","args":["&荀攸\n是的，我也想看出好戏，\n等着袁氏兄弟内讧呢。\n&荀攸\n这样我军也可以少些损失。"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯，好吧。\n&曹操\n元让。传令全军，撤回许都。"]},{"op":51,"name":"actor_face","args":[1,0,2]},{"op":20,"name":"dialog","args":["&夏侯惇\n是。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":1069,"sections":[{"index":0,"offset":1071,"title":"袁谭  去南皮","body_off":1094,"body_end":2240,"conditions":[{"op":2,"name":"comment","args":["袁谭  去南皮"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,67,65535]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["此时袁谭和郭图二人……"]},{"op":23,"name":"place_name","args":["黎阳  郊外山路"]},{"op":48,"name":"actor_appear","args":[113,44,98,1,0]},{"op":48,"name":"actor_appear","args":[103,54,98,0,0]},{"op":50,"name":"actor_move","args":[65535,113,0,44,30,0]},{"op":50,"name":"actor_move","args":[65535,103,0,54,30,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[113,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[113,2]},{"op":20,"name":"dialog","args":["&袁谭\n可恶，袁尚这个可恶的家伙！\n如果他当初早来一步，\n我就可以打败曹操了！"]},{"op":51,"name":"actor_face","args":[103,0,3]},{"op":20,"name":"dialog","args":["&袁谭\n我明明是他的兄长，\n为什么他却当继承人，\n如此随意驱使我！！"]},{"op":52,"name":"actor_action","args":[103,6]},{"op":20,"name":"dialog","args":["&郭图\n袁大公子……\n这也是主公的遗言啊……"]},{"op":51,"name":"actor_face","args":[113,0,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[113,0,1]},{"op":20,"name":"dialog","args":["&袁谭\n遗言？胡说八道！！"]},{"op":52,"name":"actor_action","args":[113,2]},{"op":20,"name":"dialog","args":["&袁谭\n那是父亲神智不清时乱说的，\n这种草率的戏言能当真吗！\n&郭图\n是……是。\n不能当真。"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":20,"name":"dialog","args":["&袁谭\n郭图，我不返回邺城了。"]},{"op":52,"name":"actor_action","args":[103,0]},{"op":20,"name":"dialog","args":["&郭图\n哦，那么公子上哪去……？"]},{"op":52,"name":"actor_action","args":[113,2]},{"op":20,"name":"dialog","args":["&袁谭\n我心里很不痛快，\n不想回袁尚那里！"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[113,0,0]},{"op":20,"name":"dialog","args":["&袁谭\n去南皮吧！\n那里的士兵都听我的指挥！"]},{"op":52,"name":"actor_action","args":[113,3]},{"op":20,"name":"dialog","args":["&袁谭\n我才是父亲的继承人！\n可恶的袁尚等着瞧吧！\n到时候让你知道厉害！\n&郭图\n嗯，有志气！\n袁大公子，小人永远追随你。"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":50,"name":"actor_move","args":[65535,113,0,47,5,0]},{"op":50,"name":"actor_move","args":[65535,103,0,57,5,0]},{"op":49,"name":"actor_select","args":[65535,113,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,103,0,0,0,0,65535]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":2240,"sections":[{"index":0,"offset":2242,"title":"王允  大汉的忠臣","body_off":2269,"body_end":4242,"conditions":[{"op":2,"name":"comment","args":["王允  大汉的忠臣"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":2269,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":98,"end_off":4240},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[17]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[2,65535,65535,61,65535]},{"op":48,"name":"actor_appear","args":[0,55,61,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["许都 相府花园"]},{"op":48,"name":"actor_appear","args":[17,90,61,3,0]},{"op":50,"name":"actor_move","args":[65535,17,0,61,61,3]},{"op":52,"name":"actor_action","args":[17,0]},{"op":20,"name":"dialog","args":["&貂蝉\n主公。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n您在想什么？"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"off":2527,"cond":{"op":5,"name":"test_flags","args":[[1286],[]]},"end":33,"end_off":2804},{"op":51,"name":"actor_face","args":[0,5,1]},{"op":20,"name":"dialog","args":["&曹操\n貂蟬，妳看这是什么？"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[0,5,1]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,17,0,59,61,3]},{"op":52,"name":"actor_action","args":[17,0]},{"op":9,"name":"delay","args":[7]},{"op":52,"name":"actor_action","args":[17,5]},{"op":20,"name":"dialog","args":["&貂蝉\n义父……。"]},{"op":20,"name":"dialog","args":["&曹操\n當年王司徒將這把刀交給我，\n希望我能運用它除掉董卓。"]},{"op":20,"name":"dialog","args":["&曹操\n當日之事，真叫人記憶猶新啊……"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2804,"cond":{"op":5,"name":"test_flags","args":[[],[1286]]},"end":41,"end_off":3018},{"op":20,"name":"dialog","args":["&曹操\n也不知道是為什麼，\n我忽然想起了妳的義父王允。"]},{"op":20,"name":"dialog","args":["&貂蝉\n義父？"]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n當年王司徒將七星刀交給我，\n希望我能運用它除掉董卓。"]},{"op":20,"name":"dialog","args":["&曹操\n當日之事，真叫人記憶猶新啊……"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n是啊……嗚嗚，義父。"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":50,"name":"actor_move","args":[65535,0,0,50,61,3]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n哎！！\n事过境迁，王司徒真大汉的忠臣。"]},{"op":1,"name":"if","args":[],"off":3191,"cond":{"op":5,"name":"test_flags","args":[[1286],[]]},"end":59,"end_off":3409},{"op":20,"name":"dialog","args":["&貂蝉\n可能是义父在天之灵，\n对丞相的帮助吧……"]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n丞相这把七星宝刀不光锋利，\n还有其他作用。把它交给\n郭军师最合适了。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n是吗？……那好吧。"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[0,17,1]},{"op":20,"name":"dialog","args":["&曹操\n貂蟬，妳至今仍懷念著王大人嗎？"]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n是的……"]},{"op":20,"name":"dialog","args":["&貂蝉\n自從義父過世以後，\n我沒有一天不懷念他。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n貂蟬……"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"off":3610,"cond":{"op":5,"name":"test_flags","args":[[1286],[]]},"end":73,"end_off":3660},{"op":50,"name":"actor_move","args":[65535,17,0,63,61,1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3660,"cond":{"op":5,"name":"test_flags","args":[[],[1286]]},"end":76,"end_off":3710},{"op":50,"name":"actor_move","args":[65535,17,0,65,61,1]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[17,0]},{"op":9,"name":"delay","args":[6]},{"op":1,"name":"if","args":[],"off":3728,"cond":{"op":5,"name":"test_flags","args":[[1286],[]]},"end":81,"end_off":3843},{"op":20,"name":"dialog","args":["&貂蝉\n儘管如此，我現在又見到了這把刀，\n有如再次見到義父。\n我也應該要放下過去，繼續向前走了。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3843,"cond":{"op":5,"name":"test_flags","args":[[],[1286]]},"end":84,"end_off":3950},{"op":20,"name":"dialog","args":["&貂蝉\n儘管如此，我感覺得到義父依然在\n天上保佑著我。我也應該放下過去，\n繼續向前走了。"]},{"op":0,"name":"end","args":[]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n好，相信王大人也希望看見這樣的妳。"]},{"op":51,"name":"actor_face","args":[17,6,3]},{"op":20,"name":"dialog","args":["&貂蝉\n是！"]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[17,0]},{"op":20,"name":"dialog","args":["&貂蝉\n(義父，謝謝您的在天之靈。\n對我來說，您依然活在我的心裡。)"]},{"op":20,"name":"dialog","args":["&貂蝉\n(而且，我現在身邊也有這麼多\n關心我的人，我並不孤獨。)"]},{"op":9,"name":"delay","args":[5]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":4242,"sections":[{"index":0,"offset":4244,"title":"南皮  与曹操结盟","body_off":4271,"body_end":5903,"conditions":[{"op":2,"name":"comment","args":["南皮  与曹操结盟"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,289,83]},{"op":41,"name":"op_29","args":[115,353,30]},{"op":9,"name":"delay","args":[8]},{"op":41,"name":"op_29","args":[113,353,110]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["黎阳之战后，袁谭",0,0,0]},{"op":9,"name":"delay","args":[8]},{"op":44,"name":"caption","args":["并未返回袁尚所在的邺城，",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[113,459,110]},{"op":42,"name":"op_2a","args":[113,459,21]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["反而前去南皮，驻扎该地。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,42,65535]},{"op":48,"name":"actor_appear","args":[113,54,70,0,0]},{"op":48,"name":"actor_appear","args":[103,35,56,1,0]},{"op":48,"name":"actor_appear","args":[112,71,50,2,0]},{"op":48,"name":"actor_appear","args":[117,71,56,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["南皮  袁谭公馆"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[113,3]},{"op":20,"name":"dialog","args":["&袁谭\n我是袁家的长子，\n我才是继承人！"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":20,"name":"dialog","args":["&袁谭\n所以无论如何都要赶走袁尚，\n让袁家的实权掌握在我手中！\n大家有什么意见？"]},{"op":52,"name":"actor_action","args":[103,6]},{"op":20,"name":"dialog","args":["&郭图\n是。"]},{"op":52,"name":"actor_action","args":[103,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[112,6]},{"op":20,"name":"dialog","args":["&辛评\n属下一定心悦诚服为主公效力。"]},{"op":52,"name":"actor_action","args":[112,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[117,6]},{"op":20,"name":"dialog","args":["&辛毗\n…………"]},{"op":52,"name":"actor_action","args":[117,0]},{"op":20,"name":"dialog","args":["&袁谭\n问题是该怎么对付袁尚……"]},{"op":52,"name":"actor_action","args":[103,6]},{"op":20,"name":"dialog","args":["&郭图\n回禀主公。\n正面作战我们虽然可以取胜，\n但是会损失相当多的兵力。\n&郭图\n我看……我们与曹操结盟吧？\n&袁谭\n什么？\n要与那老贼一起作战？\n&郭图\n不，让曹操单独与袁尚他们作战。\n&袁谭\n嗯………\n&郭图\n等到袁尚他们被消灭之后，\n我们利用这个同盟积蓄力量，\n再回过头来击败曹操。\n&袁谭\n好，真是一石二鸟之计。\n&郭图\n谢主公。"]},{"op":52,"name":"actor_action","args":[103,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[113,3]},{"op":20,"name":"dialog","args":["&袁谭\n哈哈哈！\n好！马上派使者前去与曹操结盟。"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[117,6]},{"op":20,"name":"dialog","args":["&辛毗\n主公，请让我担任使者吧？\n&袁谭\n哦，辛毗？\n嗯。不过……\n只许成功不许失败。\n&辛毗\n是……是………\n（唉，只知争权夺利，\n却不知天下大势。）\n&辛毗\n（再跟着这样的人，恐怕不会有前途。）"]},{"op":20,"name":"dialog","args":["&袁谭\n好吧！你马上出发。\n&辛毗\n是………"]},{"op":52,"name":"actor_action","args":[117,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[112,0,65535]},{"op":20,"name":"dialog","args":["&辛评\n为了主公，\n一定要成功结盟。"]},{"op":52,"name":"actor_action","args":[113,3]},{"op":20,"name":"dialog","args":["&袁谭\n哈哈哈！\n袁尚！竟敢与大哥作对？\n真是愚蠢啊，哈哈哈！\n&辛毗\n…………"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":5,"offset":5903,"sections":[{"index":0,"offset":5905,"title":"曹操  接受同盟","body_off":5930,"body_end":9565,"conditions":[{"op":2,"name":"comment","args":["曹操  接受同盟"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[1,52,70,0,0]},{"op":48,"name":"actor_appear","args":[15,58,70,0,0]},{"op":48,"name":"actor_appear","args":[2,64,70,0,0]},{"op":48,"name":"actor_appear","args":[23,70,70,0,0]},{"op":48,"name":"actor_appear","args":[20,52,40,2,0]},{"op":48,"name":"actor_appear","args":[22,58,40,2,0]},{"op":48,"name":"actor_appear","args":[24,64,40,2,0]},{"op":48,"name":"actor_appear","args":[21,70,40,2,0]},{"op":48,"name":"actor_appear","args":[117,48,55,3,6]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&曹操\n哦，想与我同盟……？\n&辛毗\n是的。\n&曹操\n嗯…………"]},{"op":52,"name":"actor_action","args":[117,0]},{"op":20,"name":"dialog","args":["&辛毗\n不过即使结盟，\n也不是真心的。"]},{"op":56,"name":"set_attr","args":[0,15,0,252]},{"op":20,"name":"dialog","args":["&曹操\n什么？\n&辛毗\n袁谭只是想利用您消灭袁尚。\n&辛毗\n既然不是真心结盟，\n早晚就会毁约攻击丞相的。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":20,"name":"dialog","args":["&曹操\n住口！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n辛毗，你可是袁谭的家臣？"]},{"op":20,"name":"dialog","args":["&辛毗\n在下不承认有这样的主子。\n&辛毗\n兄弟彼此只知争权夺利，\n一点也不理会老百姓的疾苦，\n为那种人效力太愚蠢了。\n&曹操\n原来如此…………"]},{"op":20,"name":"dialog","args":["&曹操\n好，我与袁谭结盟。\n&辛毗\n啊？"]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":51,"name":"actor_face","args":[0,3,1]},{"op":20,"name":"dialog","args":["&曹操\n袁谭难得施展计谋，\n我就上一回当吧。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&辛毗\n可是…………"]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":20,"name":"dialog","args":["&曹操\n我也想利用这个同盟。\n&曹操\n辛毗，进攻袁尚所在的邺城，\n我还需要你的力量，\n希望你能帮助我。"]},{"op":52,"name":"actor_action","args":[117,6]},{"op":20,"name":"dialog","args":["&辛毗\n是！在下遵命……"]},{"op":52,"name":"actor_action","args":[117,0]},{"op":20,"name":"dialog","args":["&曹操\n很好。\n文若，派使者去跟袁谭结盟，\n请他发兵一起夹击袁尚。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n是，属下立刻去办。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[117,0,0]},{"op":20,"name":"dialog","args":["&辛毗\n他不会发兵参战的。\n&荀彧\n哈哈哈，大概是吧。\n&辛毗\n那么为什么丞相还……？"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。"]},{"op":51,"name":"actor_face","args":[117,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":20,"name":"dialog","args":["&曹操\n他不愿意出兵的话，\n我就有借口打他了。\n&辛毗\n啊……？（如此高深的智谋，\n连已故的袁绍主公也遥不可及，\n更别说他的儿子们了。）"]},{"op":35,"name":"play_music","args":[200,255]},{"op":36,"name":"play_sound","args":[18]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[8,95,55,3,0]},{"op":20,"name":"dialog","args":["&曹丕\n父亲！"]},{"op":51,"name":"actor_face","args":[117,0,1]},{"op":50,"name":"actor_move","args":[65535,117,0,48,60,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[117,0,0]},{"op":50,"name":"actor_move","args":[65535,8,0,48,55,3]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&曹操\n子桓，什么事？\n&曹丕\n父亲，这次战斗请让孩儿参加吧。\n&曹操\n你？\n&曹丕\n是的。\n我学会了父亲所著《孟德新书》的兵法，\n因此请父亲务必派孩儿出战。\n&曹操\n你身边带着《孟德新书》了吗？\n&曹丕\n是的。\n&曹操\n嗯………"]},{"op":36,"name":"play_sound","args":[11]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":7890,"cond":{"op":18,"name":"choice","args":["答应参战\n时机尚早",0]},"end":80,"end_off":8600},{"op":1,"name":"if","args":[],"off":7920,"cond":{"op":19,"name":"test_choice","args":[1]},"end":73,"end_off":8119},{"op":58,"name":"set_resource","args":[2,2,2]},{"op":36,"name":"play_sound","args":[18]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n嗯，好吧。\n就让你上战场见识见识。\n&曹丕\n是，多谢父亲。\n&曹操\n子桓，要好好表现。\n与袁绍的儿子们，\n在战场一较高下。\n&曹丕\n是，一定不辱没父亲盛名。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":8119,"cond":{"op":19,"name":"test_choice","args":[2]},"end":79,"end_off":8598},{"op":58,"name":"set_resource","args":[2,1,2]},{"op":36,"name":"play_sound","args":[18]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n不行啊！\n你现在就上战场还太早。\n&曹丕\n可是，父亲………\n&曹操\n够了！\n你也不过是学会一点粗略的兵法，\n战场上可不是闹着玩的！\n&曹丕\n…………\n&程昱\n我能了解主公的心情，\n难得子桓公子有此志向，\n主公应该予以成全才是。\n&荀彧\n是啊，如果嫡子曹丕出战，\n士兵的斗志也会大受鼓舞。\n&曹操\n哦？\n好吧，既然你们这么说，\n我就让这孩子出战。\n&曹丕\n啊？多谢父亲。\n&曹操\n不过，这可是你自愿参战，\n在战场上不能给我丢脸。\n&曹丕\n是！孩儿谨记父亲的教诲。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。"]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":59,"name":"join","args":[8,0,0]},{"op":1,"name":"if","args":[],"off":8693,"cond":{"op":18,"name":"choice","args":["曹丕當都督，程昱當軍師\n曹丕當皇帝，程昱當都督",0]},"end":125,"end_off":9343},{"op":1,"name":"if","args":[],"off":8751,"cond":{"op":19,"name":"test_choice","args":[1]},"end":91,"end_off":8804},{"op":11,"name":"set_flag","args":[1813,0]},{"op":105,"name":"popup","args":["曹丕與程昱的兵種不變。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":8804,"cond":{"op":19,"name":"test_choice","args":[2]},"end":124,"end_off":9341},{"op":11,"name":"set_flag","args":[1813,1]},{"op":20,"name":"dialog","args":["&曹操\n程昱，從今天開始你就擔任都督，\n輔佐子桓吧。"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n是。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":1,"name":"if","args":[],"off":8917,"cond":{"op":2,"name":"comment","args":["曹丕的兵種"]},"end":103,"end_off":9010},{"op":117,"name":"set_s_image","args":[8,196]},{"op":119,"name":"int_var_op","args":[2,4081,2,0,1]},{"op":82,"name":"op_52","args":[8,78]},{"op":119,"name":"int_var_op","args":[2,4081,2,0,0]},{"op":0,"name":"end","args":[]},{"op":105,"name":"popup","args":["曹丕的兵種為皇帝。"]},{"op":1,"name":"if","args":[],"off":9033,"cond":{"op":2,"name":"comment","args":["程昱的兵種"]},"end":122,"end_off":9316},{"op":59,"name":"join","args":[21,255,0]},{"op":59,"name":"join","args":[21,1,101]},{"op":117,"name":"set_s_image","args":[21,284]},{"op":62,"name":"set_equipment","args":[21,1,0,1,0,1]},{"op":119,"name":"int_var_op","args":[2,4081,2,0,1]},{"op":120,"name":"data_transfer","args":[401,0,21,18]},{"op":1,"name":"if","args":[],"off":9162,"cond":{"op":121,"name":"test_int_var","args":[4,401,2,0,15]},"end":114,"end_off":9204},{"op":82,"name":"op_52","args":[21,48]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":9204,"cond":{"op":121,"name":"test_int_var","args":[4,401,1,0,15]},"end":117,"end_off":9246},{"op":82,"name":"op_52","args":[21,49]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":9246,"cond":{"