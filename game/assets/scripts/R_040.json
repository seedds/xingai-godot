":48,"name":"actor_appear","args":[34,42,52,1,0]},{"op":48,"name":"actor_appear","args":[50,42,58,1,0]},{"op":48,"name":"actor_appear","args":[69,42,64,1,0]},{"op":48,"name":"actor_appear","args":[194,53,53,0,6]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":105,"name":"popup","args":["此时……"]},{"op":23,"name":"place_name","args":["剑阁  刘禅军主营"]},{"op":20,"name":"dialog","args":["&诸葛亮\n是吗，孙权答应恢复邦交了？\n&文官03\n是的。\n他说希望两国齐心协力打败曹魏。"]},{"op":52,"name":"actor_action","args":[194,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n嗯。\n这趟任务有劳你了，\n下去歇息吧。"]},{"op":52,"name":"actor_action","args":[194,6]},{"op":20,"name":"dialog","args":["&文官03\n是。"]},{"op":52,"name":"actor_action","args":[194,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,194,0,53,95,2]},{"op":49,"name":"actor_select","args":[65535,194,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&诸葛亮\n见到魏国兴盛强大，\n孙权也有些紧张吧。"]},{"op":52,"name":"actor_action","args":[69,6]},{"op":20,"name":"dialog","args":["&姜维\n至少这样东吴就不会从背后袭击我们了。"]},{"op":52,"name":"actor_action","args":[69,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n好，\n接着只要在剑阁挡住魏军就可以了。"]},{"op":51,"name":"actor_face","args":[53,0,0]},{"op":20,"name":"dialog","args":["&关兴\n可是丞相，\n魏军先前在阳平关的损失也相当惨重，\n他们真的会来进攻此地吗？\n&诸葛亮\n一定会的。\n曹操相当谙熟进攻的时机，\n现在已经离此不远了吧。"]},{"op":51,"name":"actor_face","args":[66,0,0]},{"op":20,"name":"dialog","args":["&关索\n不会来得这么快吧？"]},{"op":52,"name":"actor_action","args":[50,3]},{"op":20,"name":"dialog","args":["&马谡\n啧，啧，啧，你太天真了。\n魏军的确已经离此不远。"]},{"op":52,"name":"actor_action","args":[50,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[53,0,3]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[66,0,3]},{"op":20,"name":"dialog","args":["&关索\n嗯"]},{"op":48,"name":"actor_appear","args":[183,53,90,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&士兵03\n报。"]},{"op":20,"name":"dialog","args":["&士兵03\n魏军在城外数里的平原上扎营。"]},{"op":52,"name":"actor_action","args":[35,17]},{"op":20,"name":"dialog","args":["&诸葛亮\n来了！\n大家坚守自己的岗位，\n迎击魏军。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n（刘备主公，\n您将蜀国托付给我孔明，\n我一定要打败魏军。）"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":7416,"title":"玩家切换","body_off":7441,"body_end":7544,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[20]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀彧\n正面有一座巨大的关隘，\n真不愧是孔明亲手构筑的要塞。\n&曹操\n嗯，孔明也挺厉害的。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":7544,"title":"玩家切换","body_off":7569,"body_end":7675,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[19]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&司马懿\n根据细作的报告，\n想要攻下这里进军成都，\n必须突破两座关口。\n&曹操\n嗯，两座关口？"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":7675,"title":"玩家切换","body_off":7700,"body_end":7818,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[2]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&张辽\n主公，吕布的事情，我也不清楚。\n请您惩罚。\n&曹操\n没关系了，你也不要自责。\n该出现的，总会出现。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":7818,"title":"玩家切换","body_off":7843,"body_end":7894,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[17]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&貂蝉\n听说蜀道是非常艰险的山路。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":7894,"title":"玩家切换","body_off":7919,"body_end":7972,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[5]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹仁\n敌军死守，吕布又不知去向……"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":7972,"title":"玩家切换","body_off":7997,"body_end":8138,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹操\n许褚，你怎么坐立不安的样子？\n&许褚\n啊？屁股有点痒。\n&貂蝉\n讨厌，怎么这样嘛。\n求求你别再抓了！\n&许褚\n可是我忍不住……"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":8138,"title":"玩家切换","body_off":8163,"body_end":8276,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[21]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&程昱\n想不到事关国家存亡的战斗，\n刘禅本人竟然不出面督战……\n&曹操\n哼，看来跟他的父亲差太远了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":8276,"title":"玩家切换","body_off":8301,"body_end":8373,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n这里尽是崇山峻岭的，\n士兵们都开始怀念家乡了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}