name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[113,0,1]},{"op":20,"name":"dialog","args":["&袁谭\n啊！父亲？"]},{"op":50,"name":"actor_move","args":[65535,114,0,52,69,1]},{"op":20,"name":"dialog","args":["&袁熙\n您醒醒，父亲！"]},{"op":20,"name":"dialog","args":["&袁绍\n我已经走不动了。\n看来我气数已尽……。"]},{"op":50,"name":"actor_move","args":[65535,115,0,62,71,2]},{"op":20,"name":"dialog","args":["&袁尚\n您振作一点！\n如果父亲倒在这里，\n我们的国家该怎么办？\n&袁尚\n如果去邺城的话，\n我们还可以重整旗鼓。\n&袁熙\n父亲！\n&袁绍\n我…我的位子就……\n交由……显甫继承……\n&袁尚\n啊？"]},{"op":52,"name":"actor_action","args":[113,3]},{"op":20,"name":"dialog","args":["&袁谭\n您，您说什么！\n怎么可以这样！！"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":20,"name":"dialog","args":["&袁熙\n……父亲……。"]},{"op":52,"name":"actor_action","args":[101,1]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[101,1,2]},{"op":20,"name":"dialog","args":["&袁绍\n可恨的曹瞒小儿……\n&袁绍\n我……我就快………\n得到天下了啊！！\n&袁绍\n呜呼！"]},{"op":52,"name":"actor_action","args":[101,10]},{"op":20,"name":"dialog","args":["&袁熙\n父亲！！\n&袁谭\n（……怎么会这样！传位给袁尚！？\n我不承认，我绝不承认！！\n我……我是长子，继承人应该是我！）\n&袁尚\n……父亲。"]},{"op":22,"name":"info","args":["最有希望夺取天下的袁绍死了，\n留下了三个各怀心事的儿子，\n在充满隔阂的情况下撤向邺城。"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":1923,"sections":[{"index":0,"offset":1925,"title":"军事会议  穰山之战前","body_off":1956,"body_end":5286,"conditions":[{"op":2,"name":"comment","args":["军事会议  穰山之战前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":1956,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":3,"end_off":2003},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[15]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[2,65535,65535,21,65535]},{"op":48,"name":"actor_appear","args":[0,