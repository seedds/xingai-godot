"args":[53,0,1]},{"op":20,"name":"dialog","args":["&刘备\n(關興賢侄一定又在思念雲長了，\n這也難怪了，朕也好想他啊。)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":6569,"title":"玩家切换","body_off":6594,"body_end":6678,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[839]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&傅彤\n(奇怪，為什麼忽然有一股寒意？\n難道要發生什麼不好的事了嗎？)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":6678,"title":"玩家切换","body_off":6703,"body_end":7319,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[50]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[32,0,1]},{"op":20,"name":"dialog","args":["&刘备\n"]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[32,0,0]},{"op":20,"name":"dialog","args":["&刘备\n"]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[32,0,3]},{"op":20,"name":"dialog","args":["&刘备\n"]},{"op":9,"name":"delay","args":[7]},{"op":51,"name":"actor_face","args":[32,0,0]},{"op":20,"name":"dialog","args":["&刘备\n"]},{"op":9,"name":"delay","args":[8]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n奇怪，馬良上哪兒去了？"]},{"op":52,"name":"actor_action","args":[50,2]},{"op":20,"name":"dialog","args":["&马谡\n(什麼啊，陛下只注意哥哥，\n卻完全不看我這個天才一眼。)"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[50,6]},{"op":20,"name":"dialog","args":["&马谡\n秉告陛下：哥哥把現在的佈陣狀況\n畫成了地圖，他說要給丞相過目。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&刘备\n什麼？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[32,0,1]},{"op":20,"name":"dialog","args":["&刘备\n馬良到底在想什麼呢？\n難道他覺得朕的佈陣哪裡不妥嗎？"]},{"op":52,"name":"actor_action","args":[50,3]},{"op":20,"name":"dialog","ar