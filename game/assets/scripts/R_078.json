s":["然而曹仁和满宠遭到关羽的反击，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[5,255,140]},{"op":42,"name":"op_2a","args":[25,342,140]},{"op":42,"name":"op_2a","args":[25,319,140]},{"op":42,"name":"op_2a","args":[3,288,220]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["反而被围困在樊城。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[833,34,55,1,0]},{"op":48,"name":"actor_appear","args":[9,48,58,3,0]},{"op":48,"name":"actor_appear","args":[14,48,52,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":52,"name":"actor_action","args":[833,17]},{"op":20,"name":"dialog","args":["&曹操1\n文则，想必你也听说了，\n曹仁和满宠被关羽围困于樊城。\n&曹操1\n就凭他们还打不过关羽，\n所以你马上率领援军去樊城。"]},{"op":52,"name":"actor_action","args":[14,6]},{"op":20,"name":"dialog","args":["&于禁\n是。"]},{"op":52,"name":"actor_action","args":[833,0]},{"op":52,"name":"actor_action","args":[14,0]},{"op":20,"name":"dialog","args":["&曹操1\n令明，你任副将协助文则。"]},{"op":52,"name":"actor_action","args":[9,6]},{"op":20,"name":"dialog","args":["&庞德\n是。"]},{"op":52,"name":"actor_action","args":[9,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[14,0,2]},{"op":20,"name":"dialog","args":["&于禁\n派遣庞德将军？\n&曹操1\n嗯，怎么了？"]},{"op":51,"name":"actor_face","args":[14,0,3]},{"op":20,"name":"dialog","args":["&于禁\n不……没什么。\n那么我这就去准备。\n请恕末将告退。"]},{"op":50,"name":"actor_move","args":[65535,14,0,95,52,1]},{"op":49,"name":"actor_select","args":[65535,14,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[9,0,1]},{"op":20,"name":"dialog","args":["&庞德\n看来于将军还不完全信任我。"]},{"op":51,"name":"actor_face","args":[9,0,3]},{"op":20,"name":"dialog","args":["&庞德\n既然深知我的过去，\n这也是无可奈何的事。"]},{"op":52,"name":"actor_action","args":[833,17]},{"op":20,"name":"dialog","args":["&曹操1\n令明，这些传闻我也曾经听说，\n不过我还是非常相信你，\n所以才命你前去增援樊城。"]},{"op":52,"name":"actor_action","args":[833,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[9,6]},{"op":20,"name":"dialog","args":["&庞德\n多谢丞相。\n那么末将也去准备出兵的事宜。"]},{"op":52,"name":"actor_action","args":[9,0]},{"op":50,"name":"actor_move","args":[65535,9,0,85,58,1]},{"op":52,"name":"actor_action","args":[9,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[9,0,3]},{"op":20,"name":"dialog","args":["&庞德\n主公。\n&曹操1\n什么事？"]},{"op":52,"name":"actor_action","args":[9,6]},{"op":20,"name":"dialog","args":["&庞德\n主公交给末将如此重要的任务，\n我非常感谢。\n&庞德\n就算拼了这条命，\n也要完成救援樊城的任务。\n&庞德\n……我一定会办到的！\n&曹操1\n令明，不要急于立功。\n&庞德\n……那么末将告退。"]},{"op":52,"name":"actor_action","args":[9,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,9,0,95,58,1]},{"op":49,"name":"actor_select","args":[65535,9,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操1\n看来已经头脑发热了，这怎么行呢？\n作战讲求的就是冷静，\n否则会丢掉性命的。\n&曹操1\n这样下去令明可危险了，\n关羽是个智勇双全的猛将，\n无法冷静以对是胜不了他的。"]},{"op":51,"name":"actor_face","args":[833,0,2]},{"op":20,"name":"dialog","args":["&曹操1\n可是如今庞德这个样子，\n只怕也听不进我的话了，\n只好让于禁稳住庞德吧。"]},{"op":51,"name":"actor_face","args":[833,0,1]},{"op":20,"name":"dialog","args":["&曹操1\n……庞德，千万别冲动啊。\n我可不想失去你……"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":2887,"sections":[{"index":0,"offset":2889,"title":"吕蒙  着手进攻荆州","body_off":2918,"body_end":3936,"conditions":[{"op":2,"name":"comment","args":["吕蒙  着手进攻荆州"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[5,271,145]},{"op":41,"name":"op_29","args":[3,271,225]},{"op":9,"name":"delay","args":[3]},{"op":41,"name":"op_29","args":[14,283,47]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["于禁和",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[9,347,89]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["庞德",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[14,207,47]},{"op":42,"name":"op_2a","args":[14,207,145]},{"op":42,"name":"op_2a","args":[9,335,145]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["率领援军奔赴曹仁被困的樊城。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,51,65535]},{"op":48,"name":"actor_appear","args":[76,53,29,2,0]},{"op":48,"name":"actor_appear","args":[88,41,48,1,0]},{"op":48,"name":"actor_appear","args":[79,41,54,1,0]},{"op":48,"name":"actor_appear","args":[80,65,48,3,0]},{"op":48,"name":"actor_appear","args":[194,65,54,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["建业  孙权公馆"]},{"op":20,"name":"dialog","args":["&孙权\n子明，你应该已经知道……\n魏将曹仁被关羽围困樊城的事吧？"]},{"op":52,"name":"actor_action","args":[80,6]},{"op":20,"name":"dialog","args":["&吕蒙\n是。\n这正是我们千载难逢的好机会。"]},{"op":52,"name":"actor_action","args":[80,0]},{"op":20,"name":"dialog","args":["&孙权\n没错。\n我们必须趁机取得整个荆州。\n&孙权\n子明，命你前往夺取荆州。\n一切就看你的了！"]},{"op":52,"name":"actor_action","args":[80,6]},{"op":20,"name":"dialog","args":["&吕蒙\n是。请主公放心。"]},{"op":52,"name":"actor_action","args":[80,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[80,0,2]},{"op":20,"name":"dialog","args":["&吕蒙\n看来关羽这家伙……\n好像不懂得什么叫「见好就收」。\n&吕蒙\n这场胜利将是我东吴的了。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":1,"name":"if","args":[],"off":3