},"end":121,"end_off":2886},{"op":117,"name":"set_s_image","args":[9,259]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2890,"cond":{"op":5,"name":"test_flags","args":[[1828],[]]},"end":137,"end_off":3063},{"op":105,"name":"popup","args":["龐德的騎馬S造型要寫實版還是Q版？"]},{"op":1,"name":"if","args":[],"off":2943,"cond":{"op":18,"name":"choice","args":["寫實版S造型\nQ版S造型1\nQ版S造型2",0]},"end":136,"end_off":3061},{"op":1,"name":"if","args":[],"off":2987,"cond":{"op":19,"name":"test_choice","args":[1]},"end":129,"end_off":3011},{"op":117,"name":"set_s_image","args":[9,65]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3011,"cond":{"op":19,"name":"test_choice","args":[2]},"end":132,"end_off":3035},{"op":117,"name":"set_s_image","args":[9,257]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3035,"cond":{"op":19,"name":"test_choice","args":[3]},"end":135,"end_off":3059},{"op":117,"name":"set_s_image","args":[9,258]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":3075,"sections":[{"index":0,"offset":3077,"title":"衣服","body_off":3092,"body_end":3860,"conditions":[{"op":2,"name":"comment","args":["衣服"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,39,65535]},{"op":48,"name":"actor_appear","args":[24,58,69,0,0]},{"op":48,"name":"actor_appear","args":[25,58,55,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[205,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["汉中  满宠公馆"]},{"op":20,"name":"dialog","args":["&荀攸\n现在我军的实力是越来越大了，\n作为粮草官的我们，责任更大了。\n&满宠\n是啊……不过我从心里的高兴。\n&荀攸\n最近新收的庞德，伯宁看可靠吗？"]},{"op":50,"name":"actor_move","args":[0,25,0,53,55,3]},{"op":52,"name":"actor_action","args":[25,0]},{"op":20,"name":"dialog","args":["&满宠\n现在说什么都为时过早，\n看看再说吧。\n&荀攸\n……看看再说,希望主公是正确的。"]},{"op":9,"name":"delay","args":[10]},{"op":50,"name":"actor_move","args":[0,24,0,58,65,0]},{"op":52,"name":"actor_action","args":[24,0]},{"op":20,"name":"dialog","args":["&荀攸\n最近我在清点自己家中的物品的时候，\n意外的发现了一件旧衣服。"]},{"op":51,"name":"actor_face","args":[25,0,2]},{"op":20,"name":"dialog","args":["&满宠\n是商人收购的那种吗？\n&荀攸\n是啊！咱们可以捐献给主公，\n好统一卖掉。\n&满宠\n咱们？\n&荀攸\n我是这样想的，一会儿一起去通知文若\n他们，大家都一起找找自己的箱子底，\n看自己还有没有没有坏的旧衣服。\n&满宠\n好主意。\n没准我家里也有呢……"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[205,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":3860,"sections":[{"index":0,"offset":3862,"title":"孔明的计策  鼓动东吴","body_off":3893,"body_end":5210,"conditions":[{"op":2,"name":"comment","args":["孔明的计策  鼓动东吴"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,9,65535]},{"op":48,"name":"actor_appear","args":[32,32,54,1,0]},{"op":48,"name":"actor_appear","args":[35,50,41,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["成都  刘备公馆"]},{"op":48,"name":"actor_appear","args":[182,90,54,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&士兵02\n报。"]},{"op":50,"name":"actor_move","args":[65535,182,0,52,54,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[182,11]},{"op":20,"name":"dialog","args":["&士兵02\n启禀主公，曹操进攻汉中，\n已经占领了汉中。"]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n什……什么！？\n曹操攻占汉中？\n糟了，这可不妙。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n张鲁怎么了？\n曹操杀张鲁了吗？"]},{"op":20,"name":"dialog","args":["&士兵02\n没有，张鲁一族都受到厚遇，\n而且还授与了官位。\n&诸葛亮\n是吗，曹操厚待张鲁？\n不愧是曹操，深知收买人心之道。"]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n孔明，现在不是佩服他的时候，\n汉中可说是蜀国的咽喉，\n也就相当于我们的弱点啊。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n主公不必担心，\n曹操虽然得到了汉中，\n但是不会进攻我蜀国的。\n&刘备\n为什么呢？\n曹操下一个攻击目标，\n一定是我们不会错的。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":35,"name":"play_music","args":[200,255]},{"op":20,"name":"dialog","args":["&诸葛亮\n是的。"]},{"op":9,"name":"delay","args":[5]},{"op":36,"name":"play_sound","args":[12]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&诸葛亮\n所以我们要让曹操改主意。"]},{"op":20,"name":"dialog","args":["&刘备\n改变主意……？\n让他攻打东吴？\n&诸葛亮\n是的，孙权对合淝还没有死心。\n&诸葛亮\n如果让东吴发兵进攻合淝，\n曹操应该就不会进攻我国了。\n&刘备\n可是，东吴会发兵吗？"]},{"op":52,"name":"actor_action","args":[35,11]},{"op":20,"name":"dialog","args":["&诸葛亮\n把荆州四郡中的三郡归还孙权，\n他一定会发兵的。\n&刘备\n归还荆州是吗………"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n主公，请下定决心吧！\n切莫执意占据荆州，\n使我蜀国濒临灭亡啊！\n&刘备\n嗯，好吧。\n孔明，这事交由你去办。\n看你的了。"]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n请主公安心。\n孔明即刻派人出使东吴。"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":5210,"sections":[{"index":0,"offset":5212,"title":"孙权  再次进攻合淝","body_off":5241,"body_end":6326,"conditions":[{"op":2,"name":"comment","args":["孙权  再次进攻合淝"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,51,65535]},{"op":48,"name":"actor_appear","args":[76,53,29,2,0]},{"op":48,"name":"actor_appear","args":[193,53,48,0,6]},{"op":48,"name":"actor_appear","args":[88,41,48,1,0]},{"op":48,"name":"actor_appear","args":[78,41,54,1,0]},{"op":48,"name":"actor_appear","args":[192,65,48,3,0]},{"op":48,"name":"actor_appear","args":[194,65,54,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["建业  孙权公馆"]},{"op":20,"name":"dialog","args":["&孙权\n哦，希望我吴国进攻合淝？\n&文官02\n是的。\n&文官02\n如果大人首肯，\n敝国随即归还荆州三郡。\n&孙权\n嗯，好吧。\n不过，归还之后我才发兵。\n&孙权\n等我确认贵国的荆州守军，\n已经完全撤离之后，\n我军才会攻打合淝，如何？\n&文官02\n是。\n就遵照大人的意思办吧。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,162,73]},{"op":41,"name":"op_29","args":[140,98,73]},{"op":44,"name":"caption","args":["曹操击败张鲁，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":43,"name":"op_2b","args":[140]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[0,130,73]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["占领了汉中。",1,0,0]},{"op":9,"name":"delay","args":[8]},{"op":41,"name":"op_29","args":[32,25,171]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["刘备感到危机四伏，",1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[3,302,235]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[3,263,193]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["便以割让荆州三郡为条件，请东吴攻打合淝。",1,0,0]},{"op":9,"name":"delay","args":[10]},{"op":41,"name":"op_29","args":[78,327,238]},{"op":41,"name":"op_29","args":[76,511,212]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["孙权确认接收了荆州三郡之后，",1,1,0]},{"op":9,"name":"delay","args":[10]},{"op":41,"name":"op_29","args":[2,422,142]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["再次进攻",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[76,486,183]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["张辽镇守的合淝。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]}]}]},{"index":5,"offset":6326,"sections":[{"index":0,"offset":6328,"title":"曹操  给张辽送去书信","body_off":6359,"body_end":7591,"conditions":[{"op":2,"name":"comment","args":["曹操  给张辽送去书信"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,44,65535]},{"op":48,"name":"actor_appear","args":[0,52,34,2,0]},{"op":48,"name":"actor_appear","args":[1,69,52,3,0]},{"op":48,"name":"actor_appear","args":[8,69,58,3,0]},{"op":48,"name":"actor_appear","args":[13,69,70,3,0]},{"op":48,"name":"actor_appear","args":[20,39,52,1,0]},{"op":48,"name":"actor_appear","args":[19,39,58,1,0]},{"op":48,"name":"actor_appear","args":[23,39,64,1,0]},{"op":48,"name":"actor_appear","args":[21,39,70,1,0]},{"op":48,"name":"actor_appear","args":[181,52,52,0,11]},{"op":1,"name":"if","args":[],"off":6615,"cond":{"op":5,"name":"test_flags","args":[[1280],[]]},"end":13,"end_off":6659},{"op":48,"name":"actor_appear","args":[119,69,64,3,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6659,"cond":{"op":5,"name":"test_flags","args":[[1290],[]]},"end":16,"end_off":6703},{"op":48,"name":"actor_appear","args":[15,69,64,3,0]},{"op":0,"name":"end","args":[]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["汉中  临时相府"]},{"op":20,"name":"dialog","args":["&曹操\n东吴向合淝进攻了？\n&士兵01\n是的。"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n孙权竟然趁我们进攻汉中的时候……"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&曹操\n我看这不会是孙权的想法，\n恐怕是孔明唆使东吴发兵的。\n&曹操\n他们的目的就是想牵制我们，\n以保蜀国的安全，\n这恐怕又是诸葛亮的计谋吧。\n&司马懿\n孔明是吗……？"]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n不过张辽曾经击退东吴的攻势，\n这次应该也会守得住吧？"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":20,"name":"dialog","args":["&曹操\n不，孙权一定会记取上次的教训，\n恐怕文远也很难轻易取胜。"]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n我们现在就算想派出援军，\n大军也动弹不得啊。"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":20,"name":"dialog","args":["&曹操\n我就是担心会有这样的事，\n所以事先准备了援军。"]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n援军？\n在哪里？"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,5]},{"op":20,"name":"dialog","args":["&曹操\n在这里。\n这封信就是百万援军。"]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n喂喂，孟德。\n一封信怎么会是援军呢？\n&曹操\n马上把这封信送交文远，\n无论如何要在开战前送到！\n&士兵01\n是。"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":20,"name":"dialog","args":["&夏侯惇\n孟德，你到底在想什么啊？"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":6,"offset":7591,"sections":[{"index":0,"offset":7593,"title":"军事会议  逍遥津之战前(有蔡文姬)","body_off":7636,"body_end":11533,"conditions":[{"op":2,"name":"comment","args":["军事会议  逍遥津之战前(有蔡文姬)"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":7636,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":3,"end_off":7683},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":7683,"cond":{"op":2,"name":"comment","args":["甄宓能力刷新2"]},"end":68,"end_off":8810},{"op":1,"name":"if","args":[],"off":7705,"cond":{"op":5,"name":"test_flags","args":[[530],[1280]]},"end":67,"end_off":8808},{"op":119,"name":"int_var_op","args":[2,4076,2,0,0]},{"op":119,"name":"int_var_op","args":[2,200,2,0,137]},{"op":1,"name":"if","args":[],"off":7775,"cond":{"op":2,"name":"comment","args":["甄宓能力+裝備記錄"]},"end":31,"end_off":8223},{"op":120,"name":"data_transfer","args":[201,0,{"var":200},18]},{"op":120,"name":"data_transfer","args":[202,0,{"var":200},19]},{"op