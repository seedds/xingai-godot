1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n孟德，假使將來得到了呂布的武器，\n可以讓我裝備嗎？"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n呵呵，這就要看你的表現喽。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[1,0]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":7453,"title":"玩家切换","body_off":7478,"body_end":7652,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[6]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯渊\n董卓都還沒被消滅，\n袁紹他們居然就想就此收手。\n真是叫人失望。\n&曹操\n嗯，看來反董同盟已經名存實亡了。\n&夏侯渊\n無所謂，反正咱們本來就沒指望\n他們幫忙。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":7652,"title":"玩家切换","body_off":7677,"body_end":7784,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[5]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹仁\n嘿！董卓也没有什么大不了的。\n&曹操\n喂喂、你上次也是這麼講的，\n千万不可大意呀……。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":7784,"title":"玩家切换","body_off":7809,"body_end":7881,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[12]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹洪\n呂布有勇無謀，如果我們善用計略，\n定可將他擊敗！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":7881,"title":"玩家切换","body_off":7906,"body_end":8000,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[10]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&乐进\n上次我們小看了李儒，導致損失慘重。\n這一次務必充分緊戒，不可麻痺大意。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":8000,"title":"玩家切换","body_off":8025,"body_end":8105,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[11]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&李典\n長安易守難攻，又是董卓的大本營，\n此戰絕對是一場硬仗啊。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":8105,"title":"玩家切换","body_off":8130,"body_end":8386,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[157]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n您好，您現在玩的遊戲版本是\n新改曹操傳6.6，作者是jimmy200570\n也許以後會做進一步的更新。"]},{"op":20,"name":"dialog","args":["&蔡琰\n咦？為什麼您會忽然講這個呀？"]},{"op":20,"name":"dialog","args":["&许子将\n沒什麼，稍微講一下而已。\n呵、呵、呵。"]},{"op":20,"name":"dialog","args":["&蔡琰\n(玩家又無法觸發這個對話，\n這樣做有意義嗎？)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}