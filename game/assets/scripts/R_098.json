[157,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[1,3,2]},{"op":20,"name":"dialog","args":["&夏侯惇\n喔？孟德你認識這個老人？"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":20,"name":"dialog","args":["&曹操\n嗯，他以前曾幫我看相呢。"]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":1,"name":"if","args":[],"off":2331,"cond":{"op":5,"name":"test_flags","args":[[1270],[]]},"end":125,"end_off":2590},{"op":52,"name":"actor_action","args":[16,16]},{"op":20,"name":"dialog","args":["&典韦\n嘿，我想起來了！\n你就是幫助我和許胖子的人嘛！"]},{"op":51,"name":"actor_face","args":[157,6,3]},{"op":20,"name":"dialog","args":["&许子将\n是啊。久違了，典韋將軍。"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n原來你們碰到的神秘老人就是許先生啊，\n這也難怪了。"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[16,0]},{"op":51,"name":"actor_face","args":[157,0,2]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n許劭先生，這到底是怎麼回事？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[157,6,2]},{"op":20,"name":"dialog","args":["&许子将\n曹操大人，相信您也知道魔王的事了。\n我就暫時不重複說明了。"]},{"op":20,"name":"dialog","args":["&许子将\n其實釋放出魔王的人是一個叫左慈的人，\n此人對您恨之入骨，不惜想藉由魔王的\n力量來打倒你，我們必須阻止他！"]},{"op":56,"name":"set_attr","args":[0,15,0,256]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n有這回事？簡直太瘋狂了！"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[157,0]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n不久前我和昭姬、徐庶先生、許劭先生\n暫時擊退了左慈，可是左慈很快又會捲\n土重來，我們必須阻止他！"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯！我們當然要這麼做。\n問題是……左慈現在在哪兒呢？"]},{"op":20,"name":"dialog","args":["&许子将\n許都。"]},{"op":56,"name":"set_attr","args":[0,15,0,256]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n許都！？我們怎麼來得及趕去呢？"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[157,3]},{"op":20,"name":"dialog","args":["&许子将\n哈哈，曹大人不必擔憂。\n貧道會法術「瞬間移動」，\n可以立刻帶各位趕往許都。"]},{"op":52,"name":"actor_action","args":[157,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n呼，那就有勞許劭先生了。"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":1,"name":"if","args":[],"off":3436,"cond":{"op":5,"name":"test_flags","args":[[1320],[]]},"end":157,"end_off":3522},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&郭嘉\n（瞬間移動？這倒挺有意思的，\n真希望我也能學會。）"]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[157,6]},{"op":20,"name":"dialog","args":["&许子将\n我想提供一些軍用物資，請笑納。"]},{"op":1,"name":"if","args":[],"off":3583,"cond":{"op":2,"name":"comment","args":["設置地雷"]},"end":183,"end_off":4127},{"op":119,"name":"int_var_op","args":[2,4089,2,0,0]},{"op":1,"name":"if","args":[],"off":3626,"cond":{"op":5,"name":"test_flags","args":[[1041],[]]},"end":166,"end_off":3696},{"op":119,"name":"int_var_op","args":[2,4090,2,0,1]},{"op":119,"name":"int_var_op","args":[2,4091,2,0,2]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4092,2,0,4]},{"op":119,"name":"int_var_op","args":[2,4093,2,0,1]},{"op":61,"name":"get_item","args":[200,2,0,65535]},{"op":61,"name":"get_item","args":[203,0,0,65535]},{"op":61,"name":"get_item","args":[206,0,0,65535]},{"op":61,"name":"get_item","args":[207,0,0,65535]},{"op":61,"name":"get_item","args":[208,2,0,65535]},{"op":61,"name":"get_item","args":[209,0,0,65535]},{"op":61,"name":"get_item","args":[210,0,0,65535]},{"op":61,"name":"get_item","args":[211,0,0,65535]},{"op":61,"name":"get_item","args":[212,0,0,65535]},{"op":61,"name":"get_item","args":[213,0,0,65535]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["注意：擁有「穿越移動」技能或道具\n的武將必須慎重移動。"]},{"op":22,"name":"info","arg