0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀彧\n建业城十分巨大，\n城墙有四重结构，\n城中也设置了栅栏。\n&曹操\n不愧是孙家建造的城池，\n不过还是得设法攻下。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":5528,"title":"玩家切换","body_off":5553,"body_end":5621,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[3]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&关羽\n关某一定会消灭吴军，\n为死去的结义兄弟复仇。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":5621,"title":"玩家切换","body_off":5646,"body_end":5741,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[19]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&司马懿\n（赤壁的祭坛……？\n记得以前在一本古文书上，\n好像见过类似的东西……）"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":5741,"title":"玩家切换","body_off":5766,"body_end":5873,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n我突然有点怀念孙坚，\n又想起当年讨伐董卓时的情景。\n&夏侯惇\n他的儿子的确不可小视。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":5873,"title":"玩家切换","body_off":5898,"body_end":5980,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[23]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&贾诩\n周瑜似乎尚未完全揭露底牌。\n&贾诩\n一定还暗藏着什么诡计吧。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":5980,"title":"玩家切换","body_off":6005,"body_end":6552,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[16]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[16,0,0]},{"op":20,"name":"dialog","args":["&典韦\n嘿，许胖子。"]},{"op":51,"name":"actor_face","args":[15,0,2]},{"op":20,"name":"dialog","args":["&许褚\n做什么？\n&典韦\n听说你在做诗。\n&许褚\n已经放弃了。\n&典韦\n我来帮你，咱们一人一句吧。\n&许褚\n可以吗？\n&典韦\n没问题！\n我先来……昨天起床，看见饿狼\n&许褚\n饿狼寻摸，要找小羊\n&典韦\n小羊不在，挺饿得荒\n&许褚\n回头一看，大羊成行"]},{"op":52,"name":"actor_action","args":[15,3]},{"op":20,"name":"dialog","args":["&许褚\n哈哈。"]},{"op":52,"name":"actor_action","args":[16,16]},{"op":20,"name":"dialog","args":["&典韦\n哈哈哈。"]},{"op":51,"name":"actor_face","args":[16,0,1]},{"op":51,"name":"actor_face","args":[15,0,1]},{"op":20,"name":"dialog","args":["&许褚\n军师们，我们水平怎样？\n&典韦\n实话实说，不要客气。\n&贾诩\n这……很好啊。\n&荀彧\n确实好诗。\n&典韦\n怎么样，看到了吧，我们有天赋的！\n&许褚\n啊，原来我们也是读书的料啊。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":6552,"title":"玩家切换","body_off":6577,"body_end":6676,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭嘉\n奉孝和司马懿正在查阅古书，\n看看上面能否记载关于祭坛的事情。\n&曹操\n辛苦了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":6676,"title":"玩家切换","body_off":6701,"body_end":6786,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许褚\n攻城战全在陆地上，\n这样我就放心了。\n&许褚\n请务必让许褚出战！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}