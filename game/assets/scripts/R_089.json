"args":[589,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,54,65535]},{"op":48,"name":"actor_appear","args":[816,53,37,2,0]},{"op":48,"name":"actor_appear","args":[817,42,60,1,0]},{"op":48,"name":"actor_appear","args":[818,42,68,1,0]},{"op":48,"name":"actor_appear","args":[819,67,60,3,0]},{"op":48,"name":"actor_appear","args":[117,67,68,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["五丈原 魏軍軍營"]},{"op":24,"name":"title_text","args":["出師未捷"]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["本關是「星落五丈原」，\n我們將以司馬懿的視角遊玩，\n勝利條件是死守營寨20回合，\n或者直接擊退諸葛亮。"]},{"op":22,"name":"info","args":["假如成功擊退諸葛亮過關，\n可以得到寶物「諸葛巾」。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&司马懿1\n各位聽著：\n根據星象顯示孔明的壽命將盡，\n我軍勝利的時刻終於要到來了。"]},{"op":20,"name":"dialog","args":["&司马懿1\n然而孔明依然不是一個好對付的對手，\n在他病死之前我們的戰略都是堅守不出，\n明白了嗎？"]},{"op":51,"name":"actor_face","args":[817,6,0]},{"op":20,"name":"dialog","args":["&司马师\n遵命，父親！"]},{"op":51,"name":"actor_face","args":[818,6,0]},{"op":20,"name":"dialog","args":["&司马昭\n一切就交給我們吧！"]},{"op":51,"name":"actor_face","args":[817,0,1]},{"op":51,"name":"actor_face","args":[818,0,1]},{"op":52,"name":"actor_action","args":[816,0]},{"op":20,"name":"dialog","args":["&邓艾\n(這可是很好的學習機會，\n我一定要更加努力才行。)"]},{"op":9,"name":"delay","args":[3]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,2,1,0,0,0,0,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":1302,"sections":[{"index":0,"offset":1304,"title":"玩家切换","body_off":1325,"body_end":1469,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&司马懿1\n三軍將士們，繼續防守！\n不管敵軍如何挑釁，\n我們都要堅守不出！"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":1469,"title":"玩家切换","body_off":1494,"body_end":1741,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[816]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n跳過本關嗎？"]},{"op":1,"name":"if","args":[],"off":1525,"cond":{"op":18,"name":"choice","args":["跳過本關\n不跳過",816]},"end":17,"end_off":1733},{"op":1,"name":"if","args":[],"off":1553,"cond":{"op":19,"name":"test_choice","args":[1]},"end":13,"end_off":1686},{"op":8,"name":"set_menu","args":[0]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":20,"name":"dialog","args":["&许子将\n好的，那就跳過本關。"]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,255]},{"op":17,"name":"goto_scenario","args":[179]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1686,"cond":{"op":19,"name":"test_choice","args":[2]},"end":16,"end_off":1731},{"op":20,"name":"dialog","args":["&许子将\n呵呵，明智的選擇。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":1741,"title":"玩家切换","body_off":1766,"body_end":2023,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[117]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[117,6,0]},{"op":20,"name":"dialog","args":["&辛毗\n我的兵種是神醫，而且裝備了四神寶玉，\n所以每回合都可以施放一次「白虎」。"]},{"op":20,"name":"dialog","args":["&司马懿1\n妙！這樣後勤就仰仗你了。"]},{"op":20,"name":"dialog","args":["&辛毗\n司馬懿大人裝備的「黑羽扇」也是\n神器中的神器。只要有了它，\n策士在前線砍人都不成問題。"]},{"op":51,"name":"actor_face","args":[117,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":2023,"title":"玩家切换","body_off":2048,"body_end":3008,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[819]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[819,11,0]},{"op":20,"name":"dialog","args":["&邓艾\n我…我叫鄧…鄧艾，字…士…士載…\n載……我…我的……兵…兵種……"]},{"op":20,"name":"dialog","args":["&司马昭\n(這人說話怎麼老是斷斷續續的呀？)"]},{"op":20,"name":"dialog","args":["&司马师\n(唉，聽他講完這些諸葛亮早死了。)"]},{"op":20,"name":"dialog","args":["&司马懿1\n好吧。為了節省時間，\n我就暫時幫他治好結巴的毛病吧。\n變！！！"]},{"op":20,"name":"dialog","args":["&邓艾\n我叫鄧艾，字士載。"]},{"op":51,"name":"actor_face","args":[819,0,0]},{"op":20,"name":"dialog","args":["&邓艾\n哇！我的結巴毛病好了欸！\n真不愧是司馬懿大人！"]},{"op":20,"name":"dialog","args":["&司马懿1\n哈哈，你別謝我了。\n其實是作者打字有些不耐煩了。"]},{"op":51,"name":"actor_face","args":[819,11,0]},{"op":20,"name":"dialog","args":["&邓艾\n我叫鄧艾，字士載。\n我的兵種和司馬懿大人一樣是統軍，\n但是精神力就比大人要差遠了。"]},{"op":20,"name":"dialog","args":["&司马懿1\n哈哈，你太客氣了。\n反過來說，你的武力比我高得多，\n更適合在前線作戰啊。"]},{"op":20,"name":"dialog","args":["&邓艾\n非也。大人有神器「黑羽扇」，\n絕對比我更能站前線。"]},{"op":51,"name":"actor_face","args":[117,6,0]},{"op":20,"name":"dialog","args":["&辛毗\n對了，漢軍除了諸葛亮以外，\n還有一個叫姜維的年輕人很難對付。"]},{"op":20,"name":"dialog","args":["&魏延\n臥槽！忽視我嗎！？"]},{"op":20,"name":"dialog","args":["&辛毗\n此人的兵種也是統軍，而且智力\n與武力皆與鄧艾將軍在伯仲之間，\n不知你倆誰更厲害點？"]},{"op":51,"name":"actor_face","args":[819,0,2]},{"op":20,"name":"dialog","args":["&邓艾\n是這樣嗎？那可真叫人期待呢。"]},{"op":51,"name":"actor_face","args":[117,0,3]},{"op":51,"name":"actor_face","args":[819,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":3008,"title":"玩家切换","body_off":3033,"body_end":3427,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[818]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[818,0,1]},{"op":20,"name":"dialog","args":["&司马昭\n我的兵種是咒術士，\n父親與哥哥是統軍。"]},{"op":20,"name":"dialog","args":["&司马昭\n鄧艾也是統軍，辛毗則是神醫。"]},{"op":20,"name":"dialog","args":["&司马懿1\n你想說什麼？"]},{"op":51,"name":"actor_face","args":[818,0,0]},{"op":20,"name":"dialog","args":["&司马昭\n哇！我們每個人都會「大補給」和\n「援軍」，那麼後勤是不成問題了！"]},{"op":20,"name":"dialog","args":["&司马懿1\n呵呵，昭兒你可千萬別大意。\n接下來的戰鬥可能會比你想像中的\n要更艱苦呢。"]},{"op":51,"name":"actor_face","args":[818,6,0]},{"op":20,"name":"dialog","args":["&司马昭\n這是當然，我們的對手可是諸葛亮嘛。"]},{"op":51,"name":"actor_face","args":[818,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":3427,"title":"玩家切换","body_off":3452,"body_end":3754,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[817]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[817,6,0]},{"op":20,"name":"dialog","args":["&司马师\n父親，諸葛亮近日以來都在向我軍\n挑釁，我們只出去打一下應該不會\n怎麼樣吧？"]},{"op":20,"name":"dialog","args":["&司马懿1\n師兒，你難道忘記上方谷的教訓了嗎？\n心急是吃不了熱豆腐的。現在我們的\n戰略只有兩個字──忍耐。"]},{"op":20,"name":"dialog","args":["&司马师\n是……師兒明白了。"]},{"op":52,"name":"actor_action","args":[816,0]},{"op":20,"name":"dialog","args":["&司马懿1\n呵呵，那就好。"]},{"op":51,"name":"actor_face","args":[817,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}