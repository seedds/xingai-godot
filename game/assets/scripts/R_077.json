":52,"name":"actor_action","args":[23,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n子建，待天下统一之后，\n我再上铜雀台吧，\n现在还不是时候。"]},{"op":51,"name":"actor_face","args":[159,0,3]},{"op":20,"name":"dialog","args":["&曹植\n孩儿明白了。"]},{"op":51,"name":"actor_face","args":[159,0,0]},{"op":20,"name":"dialog","args":["&曹植\n那么荀彧先生，请。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n是。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3109,"cond":{"op":5,"name":"test_flags","args":[[],[309]]},"end":88,"end_off":3994},{"op":20,"name":"dialog","args":["&曹操\n子建，听说你建了铜雀台？\n建造铜雀台的费用，\n是从施政资金支取的吧。"]},{"op":56,"name":"set_attr","args":[0,15,0,257]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n国家的资金不能用于私事，\n难道你不明白吗！\n&曹植\n父亲您别生气。\n孩儿并未动用官资，\n这全是荀彧先生的……"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n主公，建造铜雀台的费用，\n全是来自属下的私产。\n这点请主公放心。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":20,"name":"dialog","args":["&荀彧\n主公，世子是没有过错的，\n一切责任就由文若承担吧。"]},{"op":9,"name":"delay","args":[10]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n唔，也就是说没有罪过喽？\n好了，退下吧！\n这回就不追究了，下不为例。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n是，谢主公。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n主公，该如何处置铜雀台？\n拆掉吗？"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":20,"name":"dialog","args":["&曹操\n既然已经建好，也没办法了。\n就这么放着吧。\n不过我突然有个想法。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n文和，通知各地诸侯，\n就说铜雀台竣工了。\n这回要尽量办得风光一点。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&贾诩\n啊？"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n原来如此。是！属下明白。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[159,0]},{"op":9,"name":"delay","args":[3]},{"op":0,"name":"end","args":[]},{"op":50,"name":"actor_move","args":[65535,20,0,52,34,0]},{"op":50,"name":"actor_move","args":[65535,23,0,58,34,0]},{"op":50,"name":"actor_move","args":[65535,159,0,58,55,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,20,0,80,34,1]},{"op":50,"name":"actor_move","args":[65535,23,0,80,34,1]},{"op":50,"name":"actor_move","args":[65535,159,0,98,55,1]},{"op":49,"name":"actor_select","args":[65535,159,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,20,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,23,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操\n仲德，听说刘备夺取了荆州。"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n是的。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n刘备这家伙自从有了军师孔明，\n似乎如鱼得水，越发壮大了。\n孔明也真有一手！"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&程昱\n主公不可轻视刘备的存在，\n否则只有百害而无一益。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n我知道。\n对了，周瑜后来怎么样了？\n如今还卧病不起吗？"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n不，似乎已经回到军中了。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n好，我就祝贺周瑜的康复，\n让他出任荆州江夏的太守吧。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&程昱\n封周瑜官职……？哦，原来如此。\n赐给周瑜官职，好让他对付孔明！"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":20,"name":"dialog","args":["&曹操\n不错。\n即刻上奏朝廷。"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n是！"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,21,0,95,40,1]},{"op":49,"name":"actor_select","args":[65535,21,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操\n周瑜和孔明……\n这两个人太危险了。\n必须先除掉其中一个。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":5103,"sections":[{"index":0,"offset":5105,"title":"荀攸  献计利用马腾","body_off":5134,"body_end":7573,"conditions":[{"op":2,"name":"comment","args":["荀攸  献计利用马腾"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,336,98]},{"op":41,"name":"op_29","args":[32,274,228]},{"op":41,"name":"op_29","args":[76,567,217]},{"op":44,"name":"caption","args":["曹操请示朝廷，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[77,338,228]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["任命周瑜为江夏太守。",1,0,0]},{"op":9,"name":"delay","args":[8]},{"op":44,"name":"caption","args":["刘备和孙权的荆州争夺战遂愈演愈烈。",1,1,0]},{"op":9,"name":"delay","args":[8]},{"op":44,"name":"caption","args":["双方争斗的结果",1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":43,"name":"op_2b","args":[77]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["周瑜殒命，",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["刘备完全控制了荆州。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[24,52,40,2,0]},{"op":48,"name":"actor_appear","args":[21,58,40,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[24,6]},{"op":20,"name":"dialog","args":["&荀攸\n由于孔明足智多谋，\n刘备最后取得荆州争夺战的胜利。"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n周瑜也在这期间吐血而死。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&曹操\n是吗……\n原来孔明还是比周瑜技高一筹。"]},{"op":35,"name":"play_music","args":[201,255]},{"op":36,"name":"play_sound","args":[11]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":5890,"cond":{"op":18,"name":"choice","args":["有点感到意外\n果然不出所料",0]},"end":60,"end_off":6192},{"op":1,"name":"if","args":[],"off":5928,"cond":{"op":19,"name":"test_choice","args":[1]},"end":52,"end_off":6076},{"op":58,"name":"set_resource","args":[2,2,2]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n有点让人感到意外。\n&荀彧\n主公一直以为周瑜较强是吗？\n&曹操\n嗯，\n我也有看错的时候。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6076,"cond":{"op":19,"name":"test_choice","args":[2]},"end":59,"end_off":6190},{"op":58,"name":"set_resource","args":[2,1,2]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n嗯，果然和我想的一样。\n最令人害怕的还是孔明啊。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[24,6]},{"op":20,"name":"dialog","args":["&荀攸\n听说庞统也出任了刘备的副军师。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,256]},{"op":20,"name":"dialog","args":["&曹操\n什么？庞统！\n&荀攸\n不能再放任刘备了，\n必须马上对付他。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":20,"name":"dialog","args":["&曹操\n嗯。"]},{"op":48,"name":"actor_appear","args":[181,90,55,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&士兵01\n报。"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":20,"name":"dialog","args":["&士兵01\n主公，西凉马腾求见主公，\n现在正在外面等候。\n&曹操\n马腾？\n哦，让他进来。\n&士兵01\n是。"]},{"op":52,"name":"actor_action","args":[181,0]},{"op":9,"name":"delay","args":[3]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&程昱\n马腾是西凉军的统帅，\n为什么来都城……"]},{"op":48,"name":"actor_appear","args":[138,90,55,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&马腾\n参见丞相。"]},{"op":50,"name":"actor_move","args":[65535,138,0,52,55,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[138,6]},{"op":20,"name":"dialog","args":["&马腾\n在下马腾。\n&曹操\n我乃曹孟德。\n马腾将军来得正好。\n&马腾\n是。\n听说丞相的铜雀台竣工，\n在下特地前来祝贺。\n&曹操\n是吗？\n多谢将军抬爱，\n我马上设宴为将军洗尘。\n&马腾\n马腾不胜感激。\n不过接受丞相款待之前，\n马腾希望前去谒见陛下。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n哦，曹某一时失察。\n我马上为将军禀明陛下。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n届时会为将军安排接见之处，\n还请将军稍待片刻。\n&马腾\n是。\n那么在下告辞。"]},{"op":52,"name":"actor_action","args":[138,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,138,0,95,55,1]},{"op":49,"name":"actor_select","args":[65535,138,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":52,"name":"actor_action","args":[24,6]},{"op":20,"name":"dialog","args":["&荀攸\n主公，让马腾讨伐刘备如何？"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":20,"name":"dialog","args":["&曹操\n让马腾去……？\n不，现在还不能信任他。\n&曹操\n仲德，你去准备马腾谒见的事宜，\n不过要布下耳目留意他的举动。"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n是。"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":20,"name":"dialog","args":["&荀攸\n您打算监视马腾吗？\n&曹操\n我可不认为他是为了庆贺铜雀台，\n才专程从西凉千里迢迢赶来许都的。"]},{"op":9,"name":"delay","args":[3]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":7573,"sections":[{"index":0,"offset":7575,"title":"献帝  恳请马腾除掉曹操","body_off":7608,"body_end":9578,"conditions":[{"op":2,"name":"comment","args":["献帝  恳请马腾除掉曹操"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[12]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[2,65535,65535,15,65535]},{"op":48,"name":"actor_appear","args":[149,27,55,1,0]},{"op":48,"name":"actor_appear","args":[138,46,55,3,6]},{"op":48,"name":"actor_appear","args":[192,46,43,2,0]},{"op":48,"name":"actor_appear","args":[193,52,43,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["许都  宫廷"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n陛下，西凉马腾进见。"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":20,"name":"dialog","args":["&献帝\n哦，马爱卿！\n你终于来了。\n朕已经等候多时。\n&马腾\n是，陛下。"]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n马将军，自从来到许都，\n陛下从来没有开心过。"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":20,"name":"dialog","args":["&献帝\n刘皇叔远在荆州不便前来，\n诸侯又毫无忠君爱国之心，\n朕也只有寄望名门马家了。"]},{"op":52,"name":"actor_action","args":[138,0]},{"op":20,"name":"dialog","args":["&马腾\n陛下何出此言，难道曹操……\n&献帝\n嗯，最初朕也很相信他，\n可是见他多年的所作所为，\n总是在东征西讨。\n曹操的势力越来越大，难保以后……"]},{"op":52,"name":"actor_action","args":[138,6]},{"op":20,"name":"dialog","args":["&马腾\n臣明白了。\n臣心意已决。"]},{"op":52,"name":"actor_action","args":[138,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[193,6]},{"op":20,"name":"dialog","args":["&文官02\n马将军可有什么主意？"]},{"op":52,"name":"actor_action","args":[193,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[138,0,0]},{"op":20,"name":"dialog","args":["&马腾\n是的。\n马腾体察圣意，早已准备行动。"]},{"op":52,"name":"actor_action","args":[192,3]},{"op":20,"name":"dialog","args":["&文官01\n哦！\n马将军是说……"]},{"op":52,"name":"actor_action","args":[138,6]},{"op":20,"name":"dialog","args":["&马腾\n是的。\n臣决心铲除曹操，解救陛下。"]},{"op":52,"name":"actor_action","args":[138,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[192,0]},{"op":20,"name":"dialog","args":["&文官01\n可……可是将军真能铲除曹操吗？\n万一失败………\n&马腾\n不必担心。\n曹操尚不知我心中的想法。"]},{"op":52,"name":"actor_action","args":[138,3]},{"op":20,"name":"dialog","args":["&马腾\n只须唤来留守西凉的部队，\n届时内外同时举兵夹击，\n曹操根本不是对手。"]},{"op":52,"name":"actor_action","args":[138,0]},{"op":20,"name":"dialog","args":["&文官02\n原来如此。"]},{"op":51,"name":"actor_face","args":[192,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n陛……陛下！我们终于得偿所望了……\n&献帝\n马腾！\n希望你能解救朕脱离曹操之手。"]},{"op":51,"name":"actor_face","args":[138,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[138,6]},{"op":20,"name":"dialog","args":["&马腾\n请陛下放心。\n&马腾\n那么臣即刻返回营中，\n准备举兵的事宜，\n请恕臣先行告退。\n&献帝\n嗯，全靠你了。马爱卿……"]},{"op":52,"name":"actor_action","args":[138,0]},{"op":52,"name":"actor_action","args":[192,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[192,0,2]},{"op":50,"name":"actor_move","args":[65535,138,0,95,55,1]},{"op":49,"name":"actor_select","args":[65535,138,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&献帝\n马腾真能除掉曹操吗……\n万一失败，朕………"]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n……陛下，您放心吧。"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":20,"name":"dialog","args":["&文官02\n啊，对了！\n马将军还不知道曹军内情呢……"]},{"op":52,"name":"actor_action","args":[193,6]},{"op":20,"name":"dialog","args":["&文官02\n陛下，臣马上去告诉马将军，\n有关曹军的详实内情吧。\n&献帝\n嗯，嗯。你快去吧。\n&文官02\n是。"]},{"op":52,"name":"actor_action","args":[193,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,193,0,76,43,1]},{"op":20,"name":"dialog","args":["&文官02\n（马腾果然心怀不轨……\n必须马上报告程昱先生。）"]},{"op":50,"name":"actor_move","args":[65535,193,0,90,43,1]},{"op":49,"name":"actor_select","args":[65535,193,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":5,"offset":9578,"sections":[{"index":0,"offset":9580,"title":"荀攸  献计利用马腾","body_off":9609,"body_end":11917,"conditions":[{"op":2,"name":"comment","args":["荀攸  献计利用马腾"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[20,52,40,2,0]},{"op":48,"name":"actor_appear","args":[23,58,40,2,0]},{"op":48,"name":"actor_appear","args":[24,64,40,2,0]},{"op":48,"name":"actor_appear","args":[21,70,40,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&曹操\n是吗？消灭我们才是马腾的目的？"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n是的。\n而且他想招来西凉军，\n到时候里外夹攻。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[24,6]},{"op":20,"name":"dialog","args":["&荀攸\n主公，我们必须马上采取行动。"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":20,"name":"dialog","args":["&曹操\n我知道。\n就是想套出这些隐藏的政敌，\n我才让文和大肆宣扬铜雀台的。"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n马腾果然也一如预料，\n落入了主公的圈套。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n可是如果让敌人里外夹攻，\n应付起来将会十分棘手啊。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n必须马上行动了。\n主公，捉拿马腾吧。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯………"]},{"op":35,"name":"play_music","args":[201,255]},{"op":36,"name":"play_sound","args":[11]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":10333,"cond":{"op":18,"name":"choice","args":["将马腾斩首\n让马腾下狱",0]},"end":81,"end_off":11899},{"op":1,"name":"if","args":[],"off":10367,"cond":{"op":19,"name":"test_choice","args":[1]},"end":58,"end_off":11080},{"op":11,"name":"set_flag","args":[311,1]},{"op":58,"name":"set_resource","args":[2,1,5]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":56,"name":"set_attr","args":[0,15,0,257]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n仲德，将马腾押赴午门斩首。\n不让他活在世上！\n至于陛下暂不追究。"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n是。\n属下马上去办。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,21,0,95,40,1]},{"op":49,"name":"actor_select","args":[65535,21,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操\n文和，你曾在长安打败马腾军，\n你对他的部队评价如何？"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n西凉部队的战斗力不可低估，\n尤其是马腾的儿子马超，\n有万夫莫敌之勇。\n&曹操\n马超这名字我也听说过，\n好像人称「西凉锦马超」，\n是个武艺高超的年轻武将。\n&贾诩\n是的。属下认为动用大军，\n与马超为主的西凉军作战，\n此举实为下策，还是智取为佳。\n&曹操\n好吧。\n全军进入备战状态。\n马超……啊！真是令人期待啊。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":11080,"cond":{"op":19,"name":"test_choice","args":[2]},"end":80,"end_off":11897},{"op":11,"name":"set_flag","args":[311,0]},{"op":58,"name":"set_resource","args":[2,2,5]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n程昱，将马腾投入大狱。"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n啊……？"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[21,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,21,0,76,40,1]},{"op":20,"name":"dialog","args":["&程昱\n（主公似乎没有发觉，\n马腾是个危险人物，\n应该斩草除根才是啊！）"]},{"op":50,"name":"actor_move","args":[65535,21,0,95,40,1]},{"op":49,"name":"actor_select","args":[65535,21,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":22,"name":"info","args":["结果程昱未将马腾关入大牢，\n反倒自作主张杀害了马腾。\n曹操得知这件事后十分懊悔，\n遂郑重地将马腾遗体送回西凉。"]},{"op":20,"name":"dialog","args":["&曹操\n文和，你曾在长安打败马腾军，\n你对他的部队评价如何？"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n西凉部队的战力不可低估，\n尤其是马腾的儿子马超，\n有万夫莫敌之勇。\n&曹操\n马超这名字我也听说过，\n好像人称「西凉锦马超」，\n是个武艺高超的年轻武将。\n&贾诩\n是的。属下认为动用大军，\n与马超为主的西凉军作战，\n此举实为下策，还是智取为佳。\n&曹操\n好吧。\n全军进入备战状态。\n马超……啊！真是令人期待啊。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":6,"offset":11917,"sections":[{"index":0,"offset":11919,"title":"马超  来袭","body_off":11940,"body_end":12383,"conditions":[{"op":2,"name":"comment","args":["马超  来袭"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[20,52,40,2,0]},{"op":48,"name":"actor_appear","args":[