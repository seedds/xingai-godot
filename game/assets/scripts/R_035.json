{"file":"R_035.eex","kind":"story","scenario_index":70,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":42,"sections":[{"index":0,"offset":44,"title":"曹操形象(老年)","body_off":69,"body_end":195,"conditions":[{"op":2,"name":"comment","args":["曹操形象(老年)"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,202]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":1,"name":"if","args":[],"off":89,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":117},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":1,"name":"if","args":[],"off":143,"cond":{"op":5,"name":"test_flags","args":[[1908],[]]},"end":10,"end_off":193},{"op":119,"name":"int_var_op","args":[2,4051,2,0,1]},{"op":17,"name":"goto_scenario","args":[15]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":195,"sections":[{"index":0,"offset":197,"title":"东吴请求停战","body_off":220,"body_end":2852,"conditions":[{"op":2,"name":"comment","args":["东吴请求停战"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":39,"name":"change_scene","args":[2,65535,65535,53,65535]},{"op":48,"name":"actor_appear","args":[0,54,80,0,0]},{"op":48,"name":"actor_appear","args":[1,44,64,1,0]},{"op":48,"name":"actor_appear","args":[9,44,58,1,0]},{"op":48,"name":"actor_appear","args":[20,64,64,3,0]},{"op":48,"name":"actor_appear","args":[19,64,58,3,0]},{"op":48,"name":"actor_appear","args":[21,64,52,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[208,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["同样的天空下"]},{"op":23,"name":"place_name","args":["濡须口  曹操军主营"]},{"op":1,"name":"if","args":[],"off":470,"cond":{"op":5,"name":"test_flags","args":[[734],[]]},"end":64,"end_off":1920},{"op":51,"name":"actor_face","args":[1,0,2]},{"op":20,"name":"dialog","args":["&夏侯惇\n孟德，这次虽然好不容易脱困，\n但是我军的损失比预期的更为严重。"]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n如果东吴军再发兵攻打，\n我们恐怕挡不住了！"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":20,"name":"dialog","args":["&曹操\n不必担心。"]},{"op":52,"name":"actor_action","args":[1,2]},{"op":20,"name":"dialog","args":["&夏侯惇\n什么！？\n你说什么啊？\n看看现在军中的情况吧……"]},{"op":20,"name":"dialog","args":["&曹操\n元让，现在魏吴蜀都有后顾之忧啊。"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":20,"name":"dialog","args":["&夏侯惇\n你是说谁也不敢全力一搏是吗？\n&曹操\n嗯。现在三国相互牵制，\n谁也不敢轻举妄动。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n只要有蜀国在，\n孙权就不敢和我们纠缠不休。"]},{"op":52,"name":"actor_action","args":[1,2]},{"op":20,"name":"dialog","args":["&夏侯惇\n那我们现在怎么办？"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n只有等待。\n等孙权派人来请求停战。"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":20,"name":"dialog","args":["&夏侯惇\n他会派人来吗……？"]},{"op":48,"name":"actor_appear","args":[181,54,22,2,0]},{"op":20,"name":"dialog","args":["&士兵01\n报！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":20,"name":"dialog","args":["&士兵01\n主公，东吴的使者前来。"]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":20,"name":"dialog","args":["&夏侯惇\n！！\n&曹操\n是吗？比预期的要早。\n好，传他进来。\n&士兵01\n是。"]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":48,"name":"actor_appear","args":[193,55,22,2,0]},{"op":20,"name":"dialog","args":["&文官02\n下官打扰了。"]},{"op":50,"name":"actor_move","args":[65535,193,0,54,64,2]},{"op":20,"name":"dialog","args":["&曹操\n我是汉丞相曹操，\n你是东吴的使者吧。\n有什么事？"]},{"op":52,"name":"actor_action","args":[193,6]},{"op":20,"name":"dialog","args":["&文官02\n是，主公命我前来请求停战。\n&曹操\n哦，停战？\n&文官02\n是的，主公希望双方撤军，\n此后加深友好的关系。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n孙权想得倒挺好的，\n当初挑起战端是好像是你们吧。\n&文官02\n是。\n大人虽然说得极是，\n但这次无论如何请您……"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n也罢！\n我就答应你们停战，\n你回去答复孙权吧。\n&文官02\n是，谢大人。\n那么下官先告退了！"]},{"op":52,"name":"actor_action","args":[193,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,193,0,54,22,0]},{"op":49,"name":"actor_select","args":[65535,193,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[208,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1920,"cond":{"op":5,"name":"test_flags","args":[[],[734]]},"end":85,"end_off":2332},{"op":51,"name":"actor_face","args":[19,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n东吴虽然总算退兵了，\n我军的损失也非比寻常。"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n再打下去也太勉强了。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯，没办法了。\n先撤回许都吧！\n&曹操\n文若，你担任使者前去东吴营中，\n与孙权商谈停战的事宜。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n是，属下这就出发。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":20,"name":"dialog","args":["&曹操\n好，只要停战一事谈妥，\n我们就班师回朝。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[208,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":41,"name":"op_29","args":[0,426,161]},{"op":41,"name":"op_29","args":[76,490,200]},{"op":28,"name":"fade_out","args":[]},{"op":44,"name":"caption","args":["濡须口的决战之后，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["曹操与孙权和睦相处，",1,0,0]},{"op":9,"name":"delay","args":[10]},{"op":42,"name":"op_2a","args":[0,337,100]},{"op":9,"name":"delay","args":[8]},{"op":42,"name":"op_2a","args":[76,507,218]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["两军各自撤兵回国。",1,1,1]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["于是……",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["魏国曹操、东吴孙权、",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[32,26,172]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["和蜀国刘备这三个国家，",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["各自巩固了统治的领地，",1,1,1]},{"op":9,"name":"delay","args":[10]},{"op":44,"name":"caption","args":["史无前例的三国鼎立时代到来了。",0,0,0]},{"op":9,"name":"delay","args":[20]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":2852,"sections":[{"index":0,"offset":2854,"title":"司马懿  看天空","body_off":2879,"body_end":4206,"conditions":[{"op":2,"name":"comment","args":["司马懿  看天空"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,28,65535]},{"op":48,"name":"actor_appear","args":[19,68,42,1,0]},{"op":48,"name":"actor_appear","args":[181,52,79,1,0]},{"op":48,"name":"actor_appear","args":[182,54,46,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府门前"]},{"op":48,"name":"actor_appear","args":[0,68,94,0,0]},{"op":50,"name":"actor_move","args":[65535,0,0,68,65,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":20,"name":"dialog","args":["&曹操\n辛苦了。"]},{"op":52,"name":"actor_action","args":[181,11]},{"op":52,"name":"actor_action","args":[182,11]},{"op":20,"name":"dialog","args":["&士兵01\n是。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯，那是仲达吗？\n&士兵02\n是的。军师从刚才就在那眺望天空。\n&士兵01\n以前也是那样，一动不动的……\n&曹操\n唉！\n这家伙还是老样子。"]},{"op":50,"name":"actor_move","args":[65535,0,0,68,50,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[181,0]},{"op":52,"name":"actor_action","args":[182,0]},{"op":20,"name":"dialog","args":["&曹操\n仲达。"]},{"op":51,"name":"actor_face","args":[19,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n啊？原来是主公。\n&曹操\n又在观察天象预测天下大势了吗？\n&司马懿\n这是我唯一的兴趣。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n兴趣是吗？\n天下虽大，像你这种把预测乱世动向，\n当成兴趣的人可说少之又少啊。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n不过这种兴趣可不能小觑。\n因为正如你先前所说的，\n天下已经分为三国了。\n&司马懿\n是的。\n不过这种局面不久将被打破。\n&曹操\n你是说三国鼎立的局势不久了？\n&司马懿\n是的。\n三国之中必有一国会一统天下。\n&曹操\n哪一国？\n是我魏国吗？\n&司马懿\n这点属下还不知道，\n不过……我相信会是魏国。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。\n天象如何昭示倒不要紧，\n只要努力实现霸业就行了。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[19,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[19,0,1]},{"op":20,"name":"dialog","args":["&司马懿\n主公，刘备的蜀国、孙权的吴国，\n都和我们在同一个天空下呀。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n蜀和吴是吗……？"]},{"op":9,"name":"delay","args":[10]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":4206,"sections":[{"index":0,"offset":4208,"title":"第四章  开始  决定继承人","body_off":4243,"body_end":6023,"conditions":[{"op":2,"name":"comment","args":["第四章  开始  决定继承人"]},{"op":0,"name":"end","args":[]}],"body":[{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,52,65535]},{"op":103,"name":"chapter_title","args":[4,"天下统一"]},{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[23,48,55,3,6]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[205,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["守住汉中"]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&贾诩\n主公，您找我是吗？\n&曹操\n哦，文和，我正等你呢。\n有件事要和你商量，你看曹丕如何？\n&贾诩\n啊？\n主公为何突来此言？\n&曹操\n你看他适合做我的继承人吗？\n&贾诩\n……为什么问属下这个问题？"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":1,"name":"if","args":[],"off":4613,"cond":{"op":5,"name":"test_flags","args":[[724],[]]},"end":17,"end_off":4769},{"op":20,"name":"dialog","args":["&曹操\n荀彧、郭嘉还有程昱他们太了解我的儿子们了，\n而且他们有各自偏爱的理由。\n&曹操\n司马懿来我这的日子又不长，\n所以这件事就只能问你了。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":4769,"cond":{"op":5,"name":"test_flags","args":[[],[724]]},"end":20,"end_off":4913},{"op":20,"name":"dialog","args":["&曹操\n荀彧和程昱太了解我的儿子们了，\n而且他们有各自偏爱的理由。\n&曹操\n司马懿来我这的日子又不长，\n所以这件事就只能问你了。"]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[23,0]},{"op":20,"name":"dialog","args":["&贾诩\n那么主公觉得谁合适呢？"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n嗯………"]},{"op":35,"name":"play_music","args":[205,255]},{"op":36,"name":"play_sound","args":[11]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":5015,"cond":{"op":18,"name":"choice","args":["曹丕合适\n曹植合适",0]},"end":59,"end_off":6005},{"op":1,"name":"if","args":[],"off":5045,"cond":{"op":19,"name":"test_choice","args":[1]},"end":43,"end_off":5538},{"op":58,"name":"set_resource","args":[2,1,5]},{"op":11,"name":"set_flag","args":[1450,1]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n嗯，\n我觉得还是该由嫡子曹丕继承。"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n哦，主公，我也赞成。\n自古都是由嫡子继承父亲的。\n&曹操\n嗯，我也这么想。\n不过，家臣之中也有人拥护曹植。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":20,"name":"dialog","args":["&贾诩\n这可万万不行，\n您忘记袁绍儿子们的事了吗？\n&贾诩\n就是因为袁绍指定三子为继承人，\n才导致袁家分崩离析灭亡的。"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n主公，不能重蹈袁绍的覆辙啊。\n&曹操\n嗯，你说得对。\n好吧，我决定了。\n我的事业就由曹丕继承。\n&贾诩\n是。"]},{"op":11,"name":"set_flag","args":[312,1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":5538,"cond":{"op":19,"name":"test_choice","args":[2]},"end":58,"end_off":6003},{"op":58,"name":"set_resource","args":[2,2,5]},{"op":11,"name":"set_flag","args":[1451,1]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n长子曹丕虽然颇有才干，\n不过欠缺统御众人的气魄。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n三子曹植有身为一国之主的才能，\n也许由他继承比较好吧。"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n主公，这可万万不行，\n您忘记袁绍的事吗？\n&贾诩\n就是因为袁绍指定三子为继承人，\n才导致袁家分崩离析灭亡的。\n&贾诩\n主公，不能重蹈袁绍的覆辙啊。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n嗯，你说得对。\n好吧，我决定了。\n我的事业就由曹丕继承。\n&贾诩\n是。"]},{"op":11,"name":"set_flag","args":[312,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[205,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":6023,"sections":[{"index":0,"offset":6025,"title":"汉中  援军","body_off":6046,"body_end":7480,"conditions":[{"op":2,"name":"comment","args":["汉中  援军"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":3