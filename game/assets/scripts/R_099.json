":"change_scene","args":[2,65535,65535,68,65535]},{"op":48,"name":"actor_appear","args":[597,47,62,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["華山 峭壁之上"]},{"op":24,"name":"title_text","args":["任我行之死"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&任我行\n(嘿嘿，所有妨礙老夫大業的人通通\n都死了，這下老夫是天下無敵了。)"]},{"op":35,"name":"play_music","args":[207,1]},{"op":9,"name":"delay","args":[10]},{"op":105,"name":"popup","args":["聖教主千秋萬載，一統江湖！"]},{"op":9,"name":"delay","args":[10]},{"op":105,"name":"popup","args":["聖教主千秋萬載，一統江湖！"]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&富豪03\n一生之中，最有意思的就是这几天了，\n咱们每天都能见到圣教主。"]},{"op":20,"name":"dialog","args":["&富豪03\n见圣教主一次，浑身有劲，\n心头火热，胜于苦练内功十年。"]},{"op":20,"name":"dialog","args":["&侍女01\n圣教主光照天下，犹似我日月神教泽\n被苍生，又如大旱天降下的甘霖，\n人人见了欢喜，心中感恩不尽。"]},{"op":20,"name":"dialog","args":["&百姓2\n感謝聖教主！是你讓天上有太陽！"]},{"op":20,"name":"dialog","args":["&百姓1\n感謝聖教主！\n是你讓我的爺爺擁有幸福的童年！"]},{"op":20,"name":"dialog","args":["&黄巾军02\n聖教主的劍術遠超諸葛亮，\n智謀遠超關羽，武功又勝孔夫子，\n堪稱聖賢！"]},{"op":20,"name":"dialog","args":["&黄巾军01\n咱们神教一统江湖之后，\n把天下文庙中的孔夫子神像搬出来，\n又把天下武庙中关王爷的神像请出来，"]},{"op":20,"name":"dialog","args":["&黄巾军01\n请他们两位让让位，\n供上咱们圣教主的长生禄位！"]},{"op":9,"name":"delay","args":[3]},{"op":35,"name":"play_music","args":[207,1]},{"op":9,"name":"delay","args":[10]},{"op":105,"name":"popup","args":["聖教主千秋萬載，一統江湖！"]},{"op":9,"name":"delay","args":[10]},{"op":105,"name":"popup","args":["聖教主千秋萬載，一統江湖！"]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&任我行\n(這幫傢伙到底在胡言亂語什麼？\n他們該不會是在諷刺我吧？)"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[597,0,1]},{"op":20,"name":"dialog","args":["&任我行\n(話說回來，其實他們講的也不無道理。)"]},{"op":20,"name":"dialog","args":["&任我行\n(诸葛亮武功固然非我敌手，\n他六出祁山，未建尺寸之功，\n说到智谋，难道又及得上我了？)"]},{"op":51,"name":"actor_face","args":[597,0,0]},{"op":20,"name":"dialog","args":["&任我行\n(关云长过五关、斩六将，固是神勇，\n可是若和我单打独斗，\n又怎能胜得我的「吸星大法」？)"]},{"op":20,"name":"dialog","args":["&任我行\n(孔夫子弟子不过三千，我属下教众\n何止三万？孔夫子的才智和我任我行\n相比，却又差得远了。)"]},{"op":9,"name":"delay","args":[3]},{"op":105,"name":"popup","args":["聖教主千秋萬載，一統江湖！"]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":35,"name":"play_music","args":[207,255]},{"op":36,"name":"play_sound","args":[21]},{"op":39,"name":"change_scene","args":[2,65535,65535,52,65535]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&任我行\n怎麼回事？為什麼忽然變得這麼黑呀？"]},{"op":20,"name":"dialog","args":["&任我行\n來人哪~~~~喂~~~~"]},{"op":35,"name":"play_music","args":[7,1]},{"op":20,"name":"dialog","args":["&关羽\n你覺得你的「吸星大法」能夠贏我？\n那你就下來，我們試試。"]},{"op":20,"name":"dialog","args":["&任我行\n哇啊啊啊啊~~~~"]},{"op":35,"name":"play_music","args":[22,1]},{"op":9,"name":"delay","args":[10]},{"op":105,"name":"popup","args":["任我行，卒。"]},{"op":20,"name":"dialog","args":["&任你飘\n好傢伙，原來老夫當年是這麼死的。\n關二爺果然厲害！"]},{"op":22,"name":"info","args":["任我行猝死後，他的靈魂穿越到\n三國時代，並且改名為「任你飄」，\n真正的與關羽一決勝負。"]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":35,"name":"play_music","args":[22,255]},{"op":36,"name":"play_sound","args":[255]},{"op":17,"name":"goto_scenario","args":[1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2289,"cond":{"op":5,"name":"test_flags","args":[[],[699]]},"end":84,"end_off":2874},{"op":36,"name":"play_sound","args":[15]},{"op":11,"name":"set_flag","args":[599,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,67,65535]},{"op":48,"name":"actor_appear","args":[594,48,45,2,0]},{"op":48,"name":"actor_appear","args":[595,48,51,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["華山 樹林裡"]},{"op":24,"name":"title_text","args":["番外 笑傲江湖"]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["本關是番外篇《笑傲江湖》之\n「思過崖決戰」，我們將以令狐沖、\n任盈盈的視角遊玩。"]},{"op":20,"name":"dialog","args":["&任你飘\n那我呢？我應該也很重要吧？哈哈！"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&令狐冲\n師父這次居然會邀請大家去看壁畫，\n他會不會又在策劃什麼陰謀了？"]},{"op":20,"name":"dialog","args":["&任盈盈\n當然，這個老狐狸肯定沒安好心，\n我們務必要小心行事。"]},{"op":20,"name":"dialog","args":["&令狐冲\n是啊。我本來以為師父是難得一見的\n濁世君子，想不到他居然是這種人。"]},{"op":20,"name":"dialog","args":["&任盈盈\n雖然前方必定有詐，\n可是我們也不能坐視不管，\n還是去石洞一探究竟吧。"]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,2,1,0,0,0,0,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":3090,"sections":[{"index":0,"offset":3092,"title":"玩家切换","body_off":3113,"body_end":3230,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&令狐冲\n走吧，盈盈。我們也去石洞看個究竟。"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":3230,"title":"玩家切换","body_off":3255,"body_end":3418,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[594]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&令狐冲\n奇怪，這個遊戲不是《曹操傳》嗎？\n為什麼我會出現在這裡？"]},{"op":20,"name":"dialog","args":["&作者\n歹勢啦，因為我心血來潮，\n想做一關不一樣的。"]},{"op":20,"name":"dialog","args":["&令狐冲\n…………好喔。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":3418,"title":"玩家切换","body_off":3443,"body_end":3513,"conditions":[{"