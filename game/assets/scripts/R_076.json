{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,255]},{"op":17,"name":"goto_scenario","args":[153]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2607,"cond":{"op":19,"name":"test_choice","args":[2]},"end":16,"end_off":2652},{"op":20,"name":"dialog","args":["&许子将\n呵呵，明智的選擇。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":2662,"title":"玩家切换","body_off":2687,"body_end":2890,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[100]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&孙策\n劉表有一個部將黃祖，\n此人似乎有點狡猾，不可低估。"]},{"op":20,"name":"dialog","args":["&孙坚\n喔？"]},{"op":51,"name":"actor_face","args":[77,17,1]},{"op":20,"name":"dialog","args":["&周瑜\n而且他還有獨特的戰場S形象，\n可見是名將。"]},{"op":51,"name":"actor_face","args":[77,0,1]},{"op":20,"name":"dialog","args":["&孙坚\n(有道理，你突破盲點了！)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":2890,"title":"玩家切换","body_off":2915,"body_end":3667,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[77]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[77,5,0]},{"op":20,"name":"dialog","args":["&周瑜\n抽刀斷水水更流，舉杯消愁愁更愁。"]},{"op":51,"name":"actor_face","args":[77,7,3]},{"op":20,"name":"dialog","args":["&周瑜\n散開的雲不會恢復，\n飄流的風沒有蹤跡。"]},{"op":51,"name":"actor_face","args":[77,11,2]},{"op":20,"name":"dialog","args":["&周瑜\n逝去的青春不會歸來，\n前方的夢想沒有盡頭。"]},{"op":51,"name":"actor_face","args":[77,3,1]},{"op":20,"name":"dialog","args":["&周瑜\n世界上最遠的距離不是天和地，\n而是你不知道我一直默默的看著你。"]},{"op":51,"name":"actor_face","args":[77,17,1]},{"op":20,"name":"dialog","args":["&周瑜\n嘿嘿嘿，又是一首好詩。\n讚嘆吧，崇拜吧，我是不會介意的喔。"]},{"op":20,"name":"dialog","args":["&韩当\n我想到一副對聯想送給公瑾，\n不知你意下如何？"]},{"op":51,"name":"actor_face","args":[77,6,1]},{"op":20,"name":"dialog","args":["&周瑜\n當然好呀，韓將軍請說出上聯吧！"]},{"op":51,"name":"actor_face","args":[77,0,1]},{"op":20,"name":"dialog","args":["&韩当\n聽你說話想睡覺，"]},{"op":20,"name":"dialog","args":["&周瑜\n這句話也太直白了吧？下聯呢？"]},{"op":20,"name":"dialog","args":["&韩当\n我想回家去洗澡。"]},{"op":20,"name":"dialog","args":["&周瑜\n敢問橫批是…？"]},{"op":20,"name":"dialog","args":["&韩当\n我會瘋掉！！！"]},{"op":51,"name":"actor_face","args":[77,3,1]},{"op":20,"name":"dialog","args":["&周瑜\n哈哈，好文采！妙對！"]},{"op":51,"name":"actor_face","args":[77,0,1]},{"op":20,"name":"dialog","args":["&韩当\n？？？？？"]},{"op":20,"name":"dialog","args":["&韩当\n(我剛剛講的東西能算對聯嗎？)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":3667,"title":"玩家切换","body_off":3692,"body_end":3795,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[91]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&黄盖\n老夫裝備著青囊書，\n不但可以提升HP最大值，\n而且每個回合都可以恢復HP，非常好用。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":3795,"title":"玩家切换","body_off":3820,"body_end":3919,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[94]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&韩当\n我裝備的盔甲是龍鱗鎧，\n它不光可以每回合恢復MP，\n還可以用MP代替血量使用呢。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":3919,"title":"玩家切换","body_off":3944,"body_end":4140,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[98]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&程普\n我装备的道具是护心镜，\n可以降低远程部队的造成的损伤。"]},{"op":20,"name":"dialog","args":["&孙坚\n喔？這麼說這是一件寶物了？"]},{"op":20,"name":"dialog","args":["&程普\n啟秉主公，這只是一個店貨，\n3000元就能買到了。"]},{"op":20,"name":"dialog","args":["&孙坚\n(……真寒酸。)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}