{"file":"R_034.eex","kind":"story","scenario_index":68,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":30,"sections":[{"index":0,"offset":32,"title":"曹操形象(老年)","body_off":57,"body_end":133,"conditions":[{"op":2,"name":"comment","args":["曹操形象(老年)"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,202]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":1,"name":"if","args":[],"off":77,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":105},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":133,"sections":[{"index":0,"offset":135,"title":"张辽  请求援军","body_off":160,"body_end":799,"conditions":[{"op":2,"name":"comment","args":["张辽  请求援军"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":39,"name":"change_scene","args":[2,65535,65535,53,65535]},{"op":48,"name":"actor_appear","args":[2,54,80,0,0]},{"op":48,"name":"actor_appear","args":[10,44,64,1,0]},{"op":48,"name":"actor_appear","args":[11,64,64,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":292,"cond":{"op":5,"name":"test_flags","args":[[311],[]]},"end":13,"end_off":319},{"op":24,"name":"title_text","args":["信义"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":319,"cond":{"op":5,"name":"test_flags","args":[[],[311]]},"end":16,"end_off":352},{"op":24,"name":"title_text","args":["程昱的自白"]},{"op":0,"name":"end","args":[]},{"op":23,"name":"place_name","args":["合淝  曹操军主营"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[11,0,2]},{"op":20,"name":"dialog","args":["&李典\n东吴有一个多月没动静了，\n大概已经放弃合淝了吧？"]},{"op":20,"name":"dialog","args":["&张辽\n不，孙权不会就这么回去的。\n&张辽\n对了，主公还在汉中吗？"]},{"op":51,"name":"actor_face","args":[10,0,2]},{"op":20,"name":"dialog","args":["&乐进\n不会吧，应该正在返回许都。\n&张辽\n好，立刻向主公求援吧，\n东吴的动向实在难以预测。"]},{"op":51,"name":"actor_face","args":[2,0,1]},{"op":20,"name":"dialog","args":["&张辽\n孙权这家伙也许在集结兵力，\n准备决一死战。\n&乐进\n那么我亲自去一趟许都，\n到时候一定搬来援军。"]},{"op":51,"name":"actor_face","args":[2,0,0]},{"op":20,"name":"dialog","args":["&张辽\n嗯，拜托将军了。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":799,"sections":[{"index":0,"offset":801,"title":"曹操  去增援","body_off":824,"body_end":2048,"conditions":[{"op":2,"name":"comment","args":["曹操  去增援"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[1,52,70,0,0]},{"op":48,"name":"actor_appear","args":[8,58,70,0,0]},{"op":48,"name":"actor_appear","args":[15,64,70,0,0]},{"op":48,"name":"actor_appear","args":[9,70,70,0,0]},{"op":48,"name":"actor_appear","args":[20,52,40,2,0]},{"op":48,"name":"actor_appear","args":[19,58,40,2,0]},{"op":48,"name":"actor_appear","args":[24,64,40,2,0]},{"op":48,"name":"actor_appear","args":[21,70,40,2,0]},{"op":48,"name":"actor_appear","args":[10,48,55,3,6]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&曹操\n是吗？\n东吴军有一个月没有进兵啦？\n&乐进\n是的。\n虽然我军曾经派人潜入探听，\n还是无法掌握东吴的动向。\n&乐进\n也许他们正在集结兵力，\n随时准备大战一场，\n所以我来请求主公增援。\n&曹操\n好吧，我亲自率军去合淝。\n&乐进\n是，谢主公。"]},{"op":35,"name":"play_music","args":[200,255]},{"op":36,"name":"play_sound","args":[18]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[24,6,3]},{"op":20,"name":"dialog","args":["&荀攸\n对了，丞相，我有好消息。\n&曹操\n哦？公达有什么消息？\n&荀攸\n丞相，前些天我在清理自己的衣服时，\n意外的发现自己还有一套没有破的\n旧衣服。所以……"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&荀攸\n所以我和几个同僚商量了一下，\n清查自己的衣物，把那些没有破的\n旧衣服捐赠出来。\n&曹操\n是那些可以被商人收购的旧衣服吗？\n&荀攸\n就是！赠出来由丞相统一卖给商人。\n&曹操\n太好了！收下！"]},{"op":1,"name":"if","args":[],"off":1758,"cond":{"op":5,"name":"test_flags","args":[[724],[]]},"end":33,"end_off":1920},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1920,"cond":{"op":5,"name":"test_flags","args":[[],[724]]},"end":40,"end_off":2028},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":61,"name":"get_item","args":[73,5,0,0]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[5]},{"op":36,"name":"play_sound","args":[255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":2048,"sections":[{"index":0,"offset":2050,"title":"军事会议  濡须口死斗前","body_off":2083,"body_end":7688,"conditions":[{"op":2,"name":"comment","args":["军事会议  濡须口死斗前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":2083,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":3,"end_off":2130},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2130,"cond":{"op":2,"name":"comment","args":["甄宓能力刷新2"]},"end":68,"end_off":3257},{"op":1,"name":"if","args":[],"off":2152,"cond":{"op":5,"name":"test_flags","args":[[530],[1280]]},"end":67,"end_off":3255},{"op":119,"nam