"dialog","args":["&典韦\n看你这么胖，就叫你许胖子吧……\n&许褚\n恶来、许胖子、恶来、许胖子……\n？\n&许褚\n怎么老觉得没有你的名字威武啊？"]},{"op":51,"name":"actor_face","args":[16,0,0]},{"op":20,"name":"dialog","args":["&典韦\n谁说的，差不多了。\n哈哈。"]},{"op":51,"name":"actor_face","args":[16,0,1]},{"op":51,"name":"actor_face","args":[15,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":12502,"title":"玩家切换","body_off":12527,"body_end":12585,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[16]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&典韦\n还是荀彧军师厉害。\n&荀彧\n哈哈哈。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":12585,"title":"玩家切换","body_off":12610,"body_end":12667,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n能吃饱饭了，士兵们也士气大振。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":12667,"title":"玩家切换","body_off":12692,"body_end":12752,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[20]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀彧\n主战场在濮阳城的西南部。\n&曹操\n嗯。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":12752,"title":"玩家切换","body_off":12777,"body_end":12849,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭嘉\n许褚将军是贼兵队，\n在荒地和山地会有出色的表现。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":12849,"title":"玩家切换","body_off":12874,"body_end":13104,"conditions"