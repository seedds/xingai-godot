,"name":"play_sound","args":[17]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[153,3]},{"op":20,"name":"dialog","args":["&王允\n什么？同盟军解散了！？"]},{"op":50,"name":"actor_move","args":[65535,181,0,40,60,1]},{"op":20,"name":"dialog","args":["&士兵01\n请大人务必要出席。"]},{"op":52,"name":"actor_action","args":[153,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[153,0,1]},{"op":20,"name":"dialog","args":["&王允\n……我岂有推辞之理？\n请转告丞相，我一定出席。\n&士兵01\n是。"]},{"op":50,"name":"actor_move","args":[65535,181,0,30,60,3]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,153,0,58,70,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[153,1]},{"op":20,"name":"dialog","args":["&王允\n同盟军……同盟军解散了……。"]},{"op":52,"name":"actor_action","args":[153,9]},{"op":20,"name":"dialog","args":["&王允\n呜呜呜……完了……。\n消灭董卓再也无望了，圣上……。"]},{"op":9,"name":"delay","args":[10]},{"op":48,"name":"actor_appear","args":[17,30,60,1,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&貂蝉\n爹。"]},{"op":50,"name":"actor_move","args":[65535,17,0,58,60,2]},{"op":20,"name":"dialog","args":["&貂蝉\n爹……。"]},{"op":51,"name":"actor_face","args":[153,1,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[153,1,0]},{"op":20,"name":"dialog","args":["&王允\n貂蝉……实话告诉你吧…\n同盟军已经解散了……。"]},{"op":51,"name":"actor_face","args":[17,6,2]},{"op":20,"name":"dialog","args":["&貂蝉\n……刚才的话，女儿都听到了。\n……爹，您得多保重。"]},{"op":51,"name":"actor_face","args":[153,0,0]},{"op":20,"name":"dialog","args":["&王允\n好女儿。"]},{"op":51,"name":"actor_face","args":[153,0,2]},{"op":20,"name":"dialog","args":["&王允\n不过，只是已经无望了。\n\n\n不！也许还有办法……"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":20,"name":"dialog","args":["&貂蝉\n……爹……还有什么办法？"]},{"op":51,"name":"actor_face","args":[153,0,0]},{"op":20,"name":"dialog","args":["&王允\n……"]},{"op":20,"name":"dialog","args":["&貂蝉\n父亲难道有什么顾虑。"]},{"op":50,"name":"actor_move","args":[65535,153,0,58,68,0]},{"op":20,"name":"dialog","args":["&王允\n老夫观察了很久，\n这两个人都是好色之人。\n我要把妳分别献给董卓与吕布。\n女儿，妳从中周旋，\n一定要让他们两个起矛盾。\n最后，让吕布杀了董卓……"]},{"op":50,"name":"actor_move","args":[65535,17,0,58,56,0]},{"op":20,"name":"dialog","args":["&貂蝉\n这……。"]},{"op":9,"name":"delay","args":[15]},{"op":50,"name":"actor_move","args":[0,153,0,58,65,0]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[153,9,0]},{"op":20,"name":"dialog","args":["&王允\n怎么样！貂蝉，现在只有这样了！\n老夫为天下苍生，求你了！"]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[0,17,0,58,60,2]},{"op":52,"name":"actor_action","args":[17,9]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&貂蝉\n爹，你千万别这样，\n女儿答应就是。"]},{"op":52,"name":"actor_action","args":[153,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[153,9]},{"op":20,"name":"dialog","args":["&王允\n就算是为了天下，\n我苦命的女儿……。"]},{"op":20,"name":"dialog","args":["&貂蝉\n女儿的安危不用担心，这么做也不全是\n为了天下，也是为了报答您……把我这个\n孤儿当亲生女儿来抚养的恩情。"]},{"op":20,"name":"dialog","args":["&貂蝉\n所以为了爹，女儿必须这么做。"]},{"op":20,"name":"dialog","args":["&王允\n爹对不起你，貂蝉……。"]},{"op":50,"name":"actor_move","args":[65535,17,0,58,60,2]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[17,6,2]},{"op":20,"name":"dialog","args":["&貂蝉\n就这么办吧，爹……。"]},{"op":50,"name":"actor_move","args":[65535,17,0,30,60,3]},{"op":49,"name":"actor_select","args":[65535,17,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":51,"name":"actor_face","args":[153,0,3]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,153,0,58,70,2]},{"op":9,"name":"delay","args":[6]},{"op":51,"name":"actor_face","args":[153,1,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[153,9,2]},{"op":20,"name":"dialog","args":["&王允\n……貂蝉。"]},{"op":22,"name":"info","args":["年仅十六的女儿为了报答养父，\n不惜舍身取义，后人称此为「连环计」。"]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":6926,"sections":[{"index":0,"offset":6928,"title":"连环计.P2","body_off":6948,"body_end":7722,"conditions":[{"op":2,"name":"comment","args":["连环计.P2"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,3,65535]},{"op":48,"name":"actor_appear","args":[153,58,70,0,0]},{"op":48,"name":"actor_appear","args":[119,58,60,2,0]},{"op":9,"name":"delay","args":[5]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["长安  王允府"]},{"op":20,"name":"dialog","args":["&吕布\n王大人，我目前还没有能力納妾……。"]},{"op":52,"name":"actor_action","args":[153,3]},{"op":20,"name":"dialog","args":["&王允\n将军可别这么说，\n我家小女说过非将军不嫁呢。"]},{"op":52,"name":"actor_action","args":[153,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,153,0,58,68,0]},{"op":20,"name":"dialog","args":["&王允\n您可别见笑，就见她一面吧。\n&吕布\n好，既然王大人这么说……。"]},{"op":52,"name":"actor_action","args":[153,3]},{"op":20,"name":"dialog","args":["&王允\n哦，你答应了！太好了。"]},{"op":52,"name":"actor_action","args":[153,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[153,0,3]},{"op":20,"name":"dialog","args":["&王允\n貂蝉，貂蝉。"]},{"op":9,"name":"delay","args":[8]},{"op":48,"name":"actor_appear","args":[17,30,60,1,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&貂蝉\n来了，爹。"]},{"op":51,"name":"actor_face","args":[119,0,3]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,17,0,50,60,1]},{"op":51,"name":"actor_face","args":[119,3,3]},{"op":20,"name":"dialog","args":["&吕布\n哦？"]},{"op":51,"name":"actor_face","args":[153,0,0]},{"op":20,"name":"dialog","args":["&王允\n这是小女貂蝉，如何？"]},{"op":51,"name":"actor_face","args":[119,0,3]},{"op":20,"name":"dialog","args":["&吕布\n这……这真是太……太美了……。"]},{"op":51,"name":"actor_face","args":[17,6,1]},{"op":20,"name":"dialog","args":["&貂蝉\n谢将军抬爱。"]},{"op":50,"n