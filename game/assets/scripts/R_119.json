5]},{"op":20,"name":"dialog","args":["&刘备\n子龍，這次我能夠平安脫險，\n都要多虧了你。"]},{"op":20,"name":"dialog","args":["&赵云\n劉使君別這麼說，都是您指揮有方，\n我充其量只是奉命行事而已。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&刘备\n哈哈……"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[34,11]},{"op":20,"name":"dialog","args":["&赵云\n劉使君，請讓我今後追隨你打天下吧！\n這也是公孫瓚的遺願，還請您成全！"]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n子龍此言差矣！\n論武功，論勇氣，甚至是智謀，\n你都在我之上，我哪能做你的主人呢！"]},{"op":20,"name":"dialog","args":["&赵云\n趙雲只是一介武夫，\n哪能與萬人擁戴的您相比！"]},{"op":20,"name":"dialog","args":["&赵云\n此生能夠追隨劉使君，是我一生的榮幸！\n還請您別再推辭，成全在下吧！"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,32,0,52,73,1]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,5]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[34,6]},{"op":20,"name":"dialog","args":["&刘备\n子龍………"]},{"op":9,"name":"delay","args":[5]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1046,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":134,"end_off":3687},{"op":10,"name":"clear_flags","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[183]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,108,65535]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["左天羅右地網"]},{"op":9,"name":"delay","args":[5]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,0]},{"op":39,"name":"change_scene","args":[2,65535,65535,166,65535]},{"op":48,"name":"actor_appear","args":[9,51,25,0,0]},{"op":48,"name":"actor_appear","args":[720,51,46,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["西涼 龐德宅邸"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&庞德\n兒子，咱們父子養精蓄銳多年，\n為的就是今日！"]},{"op":52,"name":"actor_action","args":[720,6]},{"op":20,"name":"dialog","args":["&庞会\n是。"]},{"op":20,"name":"dialog","args":["&庞德\n曹操名為漢相，實為漢賊。\n他，挾天子以令諸侯，人人得而誅之。"]},{"op":20,"name":"dialog","args":["&庞德\n然而，上面卻一直不允許我們刺殺他，\n你可知道是為什麼嗎？"]},{"op":52,"name":"actor_action","args":[720,3]},{"op":20,"name":"dialog","args":["&庞会\n請恕孩兒愚鈍，不能明白其中緣由。"]},{"op":51,"name":"actor_face","args":[9,0,2]},{"op":20,"name":"dialog","args":["&庞德\n因為馬超大人想要親自解決他！\n在那之前，我們必須先等曹賊替我們\n清除一切的障礙！"]},{"op":52,"name":"actor_action","args":[720,0]},{"op":20,"name":"dialog","args":["&庞会\n……………"]},{"op":20,"name":"dialog","args":["&庞德\n總之，有一個自稱是[C0D魔王]的人一直在\n給馬超大人出主意。多年以來，我們都在\n曹操身邊做了安排，藉此增加勝算。"]},{"op":20,"name":"dialog","args":["&庞德\n現在，曹操正專心與袁紹軍作戰，\n正是進行下一步計畫的時候。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[9,0,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&庞德\n馬超大人已經給了密令。\n他要我們暗殺劉備、劉表等漢室宗親，\n並嫁禍給曹操，讓他的罪行更加惡劣。"]},{"op":20,"name":"dialog","args":["&庞德\n在那之後，馬超大人會親率大軍討伐曹賊。\n縱使曹賊的軍隊再兵強馬壯，\n也不是我們西涼鐵騎的對手。"]},{"op":20,"name":"dialog","args":["&庞德\n一旦我軍成功殲滅了曹賊，\n馬超大人就會被視為拯救天下的英雄，\n然後……"]},{"op":52,"name":"actor_action","args":[720,6]},{"op":20,"name":"dialog","args":["&庞会\n孩兒明白了。"]},{"op":52,"name":"actor_action","args":[720,0]},{"op":51,"name":"actor_face","args":[9,0,2]},{"op":20,"name":"dialog","args":["&庞德\n這份名單你拿去，上面寫了很多礙事者\n的姓名。這幫傢伙遲早會成為妨礙馬超\n大人的霸業，必須趁早解決。"]},{"op":20,"name":"dialog","args":["&庞德\n要嘛你就將他們生擒作為人質，\n要嘛你就將他們直接格殺，\n並讓曹賊擔下罪名。"]},{"op":52,"name":"actor_action","args":[720,6]},{"op":20,"name":"dialog","args":["&庞会\n孩兒遵命。"]},{"op":47,"name":"op_2f","args":[]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,107,65535]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["龐會一手接過，",1,0,1]},{"op":44,"name":"caption","args":["只見他的手佈滿疤痕，",1,0,1]},{"op":44,"name":"caption","args":["似曾受盡折磨。",1,0,1]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["但其父能對他如此信任，",1,1,1]},{"op":44,"name":"caption","args":["亦全因這雙不平凡的手。",1,0,1]},{"op":9,"name":"delay","args":[5]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,0]},{"op":39,"name":"change_scene","args":[2,65535,65535,166,65535]},{"op":48,"name":"actor_appear","args":[9,51,25,2,0]},{"op":48,"name":"actor_appear","args":[720,51,46,0,6]},{"op":28,"name":"fade_out","args":[]},{"op":20,"name":"dialog","args":["&庞会\n(關平，關興，關索，關嫣，張苞……\n看來他們是很有潛力的後起之秀，\n也許會是一群好對手呢。)"]},{"op":20,"name":"dialog","args":["&庞德\n那麼，你需要多少人才可以辦成此事？"]},{"op":52,"name":"actor_action","args":[720,0]},{"op":9,"name":"delay","args":[9]},{"op":56,"name":"set_attr","args":[720,15,0,581]},{"op":52,"name":"actor_action","args":[720,6]},{"op":20,"name":"dialog","args":["&庞会\n孩兒需要一千名最為悍勇的[C0D鐵羅煞]同行！"]},{"op":20,"name":"dialog","args":["&庞德\n很好，懂得評估自己與對手的實力，\n不盲目自信，這才是大將之風。"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[720,0]},{"op":20,"name":"dialog","args":["&庞德\n快去辦吧。"]},{"op":56,"name":"set_attr","args":[720,15,0,580]},{"op":52,"name":"actor_action","args":[720,6]},{"op":20,"name":"dialog","args":["&庞会\n是。"]},{"op":51,"name":"actor_face","args":[720,0,2]},{"op":20,"name":"dialog","args":["&庞会\n(天下，我來了。)"]},{"op":50,"name":"actor_move","args":[65535,720,0,51,98,3]},{"op":49,"name":"actor_select","args":[65535,720,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&马超\n哈哈哈哈哈哈！"]},{"op":47,"name":"op_2f","args":[]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,109,65535]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[6]},{"op":44,"name":"caption","args":["龐會出發了。",1,0,1]},{"op":44,"name":"caption","args":["此行不是為了父親龐德，",1,0,1]},{"op":44,"name":"caption","args":["更不是為了馬超。",1,0,1]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["龐會是一個野心家，",1,1,1]},{"op":44,"name":"caption","args":["他誓以自己的雙手攪亂天下大勢，",1,0,1]},{"op":44,"name":"caption","args":["讓世間再掀風雲。",1,0,1]},{"op":9,"name":"delay","args":[5]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,0]},{"op":29,"name":"fade_in","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3687,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":441,"end_off":9378},{"op":11,"name":"set_flag","args":[1716,1]},{"op":56,"name":"set_attr","args":[800,15,0,297]},{"op":1,"name":"if","args":[],"off":3733,"cond":{"op":2,"name":"comment","args":["本關的武將加入"]},"end":164,"end_off":4218},{"op":119,"name":"int_var_op","args":[2,202,2,0,22]},{"op":1,"name":"if","args":[],"off":3782,"cond":{"op":5,"name":"test_flags","args":[[],[1713]]},"end":145,"end_off":3886},{"op":59,"name":"join","args":[40,0,0]},{"op":119,"name":"int_var_op","args":[2,202,2,0,22]},{"op":120,"name":"data_transfer","args":[202,1,40,18]},{"op":62,"name":"set_equipment","args":[40,0,0,0,0,38]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3886,"cond":{"op":5,"name":"test_flags","args":[[],[1712]]},"end":151,"end_off":3990},{"op":59,"name":"join","args":[46,0,0]},{"op":119,"name":"int_var_op","args":[2,202,2,0,22]},{"op":120,"name":"data_transfer","args":[202,1,46,18]},{"op":62,"name":"set_equipment","args":[46,58,0,17,0,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3990,"cond":{"op":5,"name":"test_flags","args":[[1713],[718]]},"end":156,"end_off":4070},{"op":59,"name":"join","args":[701,0,0]},{"op":119,"name":"int_var_op","args":[2,202,2,0,22]},{"op":120,"name":"data_transfer","args":[202,1,701,18]},{"op":0,"name":"end","args":[]},{"op":59,"name":"join","args":[723,0,0]},{"op":119,"name":"int_var_op","args":[2,202,2,0,22]},{"op":120,"name":"data_transfer","args":[202,1,723,18]},{"op":59,"name":"join","args":[800,0,0]},{"op":119,"name":"int_var_op","args":[2,202,2,0,22]},{"op"