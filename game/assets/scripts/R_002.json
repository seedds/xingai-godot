72,"body_end":7790,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[10]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&乐进\n我记得吕布是西凉骑兵。\n&乐进\n攻击和防御的确都很出色，\n还能够斜向攻击…\n唉，真是强劲的对手啊。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":7790,"title":"玩家切换","body_off":7815,"body_end":8027,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[11]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&李典\n听说吕布的坐骑叫「赤兔马」，\n即使与敌方部队相邻也能够自由移动。\n&李典\n还听说他惯使的「方天画戟」，\n击退一支敌军后，还能攻击其他敌人。\n&夏侯惇\n喂喂喂，这太不像话了！\n根本就是犯规的特权嘛！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}