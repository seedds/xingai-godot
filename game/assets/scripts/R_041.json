"args":["&貂蝉\n丞相，没想到，我俩还有意外的收获。\n&荀彧\n是不是探听到了蜀军的虚实？\n&貂蝉\n正是。蜀军认为我军会避其锋芒，\n而会从两侧包夹，\n所以将重兵埋伏在成都城两侧。\n&荀彧\n我军正好可以从中央攻击敌军的薄弱地带。\n&貂蝉\n正是。\n&曹操\n好，既然这样，我军就有底了。\n准备出征！！"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6350,"cond":{"op":5,"name":"test_flags","args":[[794],[]]},"end":271,"end_off":6405},{"op":111,"name":"lose_item","args":[116]},{"op":111,"name":"lose_item","args":[116]},{"op":105,"name":"popup","args":["本關不可使用獨角獸。"]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":1,"name":"if","args":[],"off":6411,"cond":{"op":5,"name":"test_flags","args":[[740],[]]},"end":305,"end_off":7294},{"op":1,"name":"if","args":[],"off":6427,"cond":{"op":5,"name":"test_flags","args":[[1280],[]]},"end":277,"end_off":6549},{"op":6,"name":"battle_select_units","args":[1,15,1,4,5,12,8,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,15,6,119,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6549,"cond":{"op":5,"name":"test_flags","args":[[],[1280]]},"end":281,"end_off":6671},{"op":6,"name":"battle_select_units","args":[1,15,1,4,5,12,8,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,15,6,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]},{"op":6,"name":"battle_select_units","args":[1,15,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,15,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":1,"name":"if","args":[],"off":6775,"cond":{"op":2,"name":"comment","args":["戰前地圖預覽"]},"end":304,"end_off":7292},{"op":119,"name":"int_var_op","args":[2,4076,2,0,0]},{"op":119,"name":"int_var_op","args":[2,4057,2,0,41]},{"op":1,"name":"if","args":[],"off":6848,"cond":{"op":2,"name":"comment","args":["HEX我军设定"]},"end":303,"end_off":7290},