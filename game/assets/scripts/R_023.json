54,3]},{"op":20,"name":"dialog","args":["&士兵01\n是……"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[205,255]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,28,65535]},{"op":48,"name":"actor_appear","args":[181,58,70,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":105,"name":"popup","args":["当天傍晚"]},{"op":48,"name":"actor_appear","args":[0,58,16,2,0]},{"op":48,"name":"actor_appear","args":[22,58,6,2,0]},{"op":50,"name":"actor_move","args":[65535,0,0,58,54,2]},{"op":50,"name":"actor_move","args":[65535,22,0,58,44,2]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[181,0,0]},{"op":20,"name":"dialog","args":["&士兵01\n原来是主公！"]},{"op":20,"name":"dialog","args":["&曹操\n嗯，辛苦了。"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":20,"name":"dialog","args":["&曹操\n嗯？"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n怎么？好像有人进去了！"]},{"op":56,"name":"set_attr","args":[0,15,0,253]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n我说谁也不许进去，\n你忘了吗！！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":20,"name":"dialog","args":["&士兵01\n是！小的没有忘记……。\n&士兵01\n是曹丕世子进去了……。"]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n什么！？"]},{"op":35,"name":"play_music","args":[202,255]},{"op":36,"name":"play_sound","args":[11]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":1365,"cond":{"op":18,"name":"choice","args":["惩罚曹丕\n原谅曹丕",0]},"end":112,"end_off":2535},{"op":1,"name":"if","args":[],"off":1395,"cond":{"op":19,"name":"test_choice","args":[1]},"end":90,"end_off":2113},{"op":11,"name":"set_flag","args":[308,1]},{"op":58,"name":"set_resource","args":[2,1,5]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[202,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n这小子……胆子倒不小！"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n奉孝，马上逮捕子环。\n我要依军法处置！！"]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n且慢，主公。\n&郭嘉\n邺城刚攻下不久，\n也许有人窝藏在内。\n&郭嘉\n身为嫡子的世子曹丕，\n在主公入馆前进行检查，\n也并不为过啊。"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":9,"name":"delay","args":[3]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯……\n&曹操\n说的倒是……好吧。\n此事就不再追究了，\n取消刚才的命令。"]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n是。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n奉孝……"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":20,"name":"dialog","args":["&郭嘉\n是？\n&曹操\n我不想重蹈袁绍的覆辙，\n就给予嫡子一些特权吧。\n&郭嘉\n这…………"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。\n奉孝，进去吧！"]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n是，是。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2113,"cond":{"op":19,"name":"test_choice","args":[2]},"end":111,"end_off":2533},{"op":11,"name":"set_flag","args":[308,0]},{"op":58,"name":"set_resource","args":[2,2,5]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":20,"name":"dialog","args":["&曹操\n算了。\n&士兵01\n啊？\n&曹操\n邺城刚刚陷落，\n可能还有许多可疑的人潜伏着。\n&曹操\n身为嫡子的子环，\n在我入馆前进行检查，\n也并不为过。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n奉孝。"]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n是，小人也是这么想的。"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。\n奉孝，进去吧！"]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n是，是。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":2573,"sections":[{"index":0,"offset":2575,"title":"甄宓","body_off":2590,"body_end":4123,"conditions":[{"op":2,"name":"comment","args":["甄宓"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,36,65535]},{"op":48,"name":"actor_appear","args":[137,45,42,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[1]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["邺 袁熙公馆"]},{"op":9,"name":"delay","args":[5]},{"op":48,"name":"actor_appear","args":[8,52,95,0,0]},{"op":20,"name":"dialog","args":["&曹丕\n里面藏着的，是谁？\n快出来，否则别怪我的宝剑了！"]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[0,137,0,45,50,2]},{"op":52,"name":"actor_action","args":[137,0]},{"op":20,"name":"dialog","args":["&甄宓\n别……别动手。"]},{"op":50,"name":"actor_move","args":[0,8,0,52,70,0]},{"op":22,"name":"info","args":["曹丕一下子被眼前的这个女人\n给震住了……"]},{"op":52,"name":"actor_action","args":[8,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&曹丕\n（世上竟然还有如此的女人……\n这个女人有着与貂蝉不同的美丽）\n你是谁？"]},{"op":20,"name":"dialog","args":["&甄宓\n我是袁熙的妻子，甄氏。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&曹丕\n不用怕，我是丞相的次子，曹丕。\n今后有我在，自然可以保护你的。"]},{"op":20,"name":"dialog","args":["&甄宓\n这……"]},{"op":50,"name":"actor_move","args":[0,8,0,52,65,0]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&曹丕\n……"]},{"op":9,"name":"delay","args":[10]},{"op":36,"name":"play_sound","args":[255]},{"op":36,"name":"play_sound","args":[9]},{"op":20,"name":"dialog","args":["&曹操\n丕儿，你在里面吗？"]},{"op":51,"name":"actor_face","args":[8,0,2]},{"op":48,"name":"actor_appear","args":[0,47,95,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":48,"name":"actor_appear","args":[22,56,95,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[0,0,0,47,78,0]},{"op":50,"name":"actor_move","args":[0,22,0,56,78,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[22,0]},{"op":20,"name":"dialog","args":["&曹操\n丕儿，这妇人是谁？"]},{"op":20,"name":"dialog","args":["&曹丕\n……这……这……\n（不好！父亲知道此女身份后，\n没准儿会……）"]},{"op":50,"name":"actor_move","args":[0,137,0,45,54,2]},{"op":52,"name":"actor_action","args":[137,0]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[137,11]},{"op":20,"name":"dialog","args":["&甄宓\n我是袁熙的妻子甄氏。\n要不是世子刚才到来，\n恐怕妾身早已身首异处了。\n&甄宓\n今后，妾身愿意为世子……\n……扫地煮酒。"]},{"op":20,"name":"dialog","args":["&曹操\n丕儿，是这样的吗？"]},{"op":20,"name":"dialog","args":["&曹丕\n……正是如此。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&曹操\n恩。\n好吧……"]},{"op":50,"name":"actor_move","args":[0,0,0,47,95,2]},{"op":49,"name":"actor_select","args":[0,0,0,0,0,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n……呵呵。\n世子，保重。"]},{"op":20,"name":"dialog","args":["&曹丕\n先生……您也……保重。"]},{"op":50,"name":"actor_move","args":[0,22,0,56,95,2]},{"op":49,"name":"actor_select","args":[0,22,0,0,0,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&曹丕\n呼……好险！"]},{"op":50,"name":"actor_move","args":[0,8,0,52,63,0]},{"op":52,"name":"actor_action","args":[8,0]},{"op":20,"name":"dialog","args":["&曹丕\n起来说话。"]},{"op":22,"name":"info","args":["曹丕遂纳甄氏为妾……"]},{"op":36,"name":"play_sound","args":[255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":4123,"sections":[{"index":0,"offset":4125,"title":"将相","body_off":4140,"body_end":5917,"conditions":[{"op":2,"name":"comment","args":["将相"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":4140,"cond":{"op":5,"name":"test_flags","args":[[],[710]]},"end":58,"end_off":5915},{"op":39,"name":"change_scene","args":[2,65535,65535,0,65535]},{"op":48,"name":"actor_appear","args":[23,40,54,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":35,"name":"play_music","args":[202,0]},{"op":24,"name":"title_text","args":["将相和"]},{"op":23,"name":"place_name","args":["邺  临时贾府"]},{"op":48,"name":"actor_appear","args":[181,90,54,3,0]},{"op":50,"name":"actor_move","args":[0,181,0,80,54,3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&士兵01\n报告，典韦将军求见。\n&贾诩\n……。"]},{"op":9,"name":"delay","args":[15]},{"op":20,"name":"dialog","args":["&贾诩\n有请。\n&士兵01\n是。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[181,0,1]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[0,181,0,95,54,1]},{"op":49,"name":"actor_select","args":[0,181,0,0,0,0,0]},{"op":9,"name":"delay","args":[20]},{"op":20,"name":"dialog","args":["&典韦\n军师。"]},{"op":48,"name":"actor_appear","args":[16,90,54,3,0]},{"op":50,"name":"actor_move","args":[0,16,0,70,54,3]},{"op":20,"name":"dialog","args":["&典韦\n军师果然在家啊。\n"]},{"op":50,"name":"actor_move","args":[0,23,0,60,54,1]},{"op":20,"name":"dialog","args":["&贾诩\n是典韦将军啊，\n今天怎么有时间到我这里来？\n快，里边请……。\n&典韦\n哎呀，还坐什么！\n军师，以前我因为宛城的事情上，\n一直对军师耿耿于怀。"]},{"op":20,"name":"dialog","args":["&典韦\n现在，我终于明白了，我是一个粗人，\n以前态度很不好，请军师不要见怪。"]},{"op":52,"name":"actor_action","args":[16,6]},{"op":50,"name":"actor_move","args":[0,23,0,64,54,1]},{"op":52,"name":"actor_action","args":[23,6]},{"op":36,"name":"play_sound","args":[18]},{"op":20,"name":"dialog","args":["&贾诩\n恶来将军说的哪里话，事情早就过去了，\n我从来就没有放在心上。\n反倒是将军直爽的性格，令我钦佩不以。\n&典韦\n您能不计较当然太好了。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":50,"name":"actor_move","args":[0,16,0,70,64,2]},{"op":52,"name":"actor_action","args":[16,0]},{"op":51,"name":"actor_face","args":[23,0,2]},{"op":20,"name":"dialog","args":["&典韦\n军师你看袁家兄弟，因为内部闹矛盾，\n有多么大的损失。"]},{"op":51,"name":"actor_face","args":[16,0,0]},{"op":20,"name":"dialog","args":["&典韦\n以前，我在当猎户的时候，\n可以徒手对付一只老虎，但是，\n从来就对付不了一群狼。"]},{"op":20,"name":"dialog","args":["&典韦\n所以，内部团结是非常重要的。\n军师，我说的对吗？\n&贾诩\n将军能有此觉悟，实是主公之福啊。\n"]},{"op":51,"name":"actor_face","args":[23,0,1]},{"op":20,"name":"dialog","args":["&贾诩\n古有廉颇、蔺相如，今有典韦、贾文和。\n哈哈，千百年后，定能传为佳话。\n"]},{"op":20,"name":"dialog","args":["&典韦\n军师，这廉颇、蔺相如是什么东西？\n"]},{"op":51,"name":"actor_face","args":[23,0,2]},{"op":20,"name":"dialog","args":["&贾诩\n这……，说来话就长了。\n还记得主公的传国玉玺吧，那是……\n&典韦\n话长了就慢慢说。今天晚上是许胖子值班，\n难得今天高兴，军师就和我喝两杯吧……"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n好，就舍命奉陪将军。\n&典韦\n哈哈哈，痛快！！"]},{"op":51,"name":"actor_face","args":[16,16,1]},{"op":20,"name":"dialog","args":["&典韦\n卫兵，把这里最好的酒拿出来，\n我要把军师的好酒全喝光。\n"]},{"op":51,"name":"actor_face","args":[23,0,1]},{"op":20,"name":"dialog","args":["&贾诩\n就那三十八年的杜康！！"]},{"op":9,"name":"delay","args":[20]},{"op":35,"name":"play_music","args":[202,255]},{"op":36,"name":"play_sound","args":[255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":5917,"sections":[{"index":0,"offset":5919,"title":"袁谭  讨伐布告","body_off":5944,"body_end":8230,"conditions":[{"op":2,"name":"comment","args":["袁谭  讨伐布告"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,7,65535]},{"op":48,"name":"actor_appear","args":[0,53,28,2,0]},{"op":48,"name":"actor_appear","args":[1,68,48,3,0]},{"op":48,"name":"actor_appear","args":[15,68,54,3,0]},{"op":48,"name":"actor_appear","args":[8,68,60,3,0]},{"op":48,"name":"actor_appear","args":[13,68,66,3,0]},{"op":48,"name":"actor_appear","args":[2,68,72,3,0]},{"op":48,"name":"actor_appear","args":[20,38,48,1,0]},{"op":48,"name":"actor_appear","args":[22,38,54,1,0]},{"op":48,"name":"actor_appear","args":[24,38,60,1,0]},{"op":48,"name":"actor_appear","args":[21,38,66,1,0]},{"op":48,"name":"actor_appear","args":[23,38,72,1,0]},{"op":48,"name":"actor_appear","args":[192,53,48,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":35,"name":"play_music","args":[202,0]},{"op":22,"name":"info","args":["袁谭得知邺城陷落，派遣使者来见曹操。"]},{"op":24,"name":"title_text","args":["目标是袁谭"]},{"op":23,"name":"place_name","args":["邺　临时相府"]},{"op":20,"name":"dialog","args":["&文官01\n我家主公祝贺丞相取得胜利。\n&曹操\n太客气了，曹某真过意不去。\n&曹操\n对了，使者。\n不是请袁谭共同出兵吗？\n为何没有派兵前来？\n&文官01\n啊？这……这……"]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n由于如今领地治安状况不佳……\n因此派不出人手协助丞相作战……"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":20,"name":"dialog","args":["&曹操\n是啊，我猜也是这么回事。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n所以………"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n我想派部队去袁谭那里，\n替他消灭不法之徒。"]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n啊？\n不……不……无须劳烦丞相了。\n&曹操\n何必客气呢，\n这些不法之徒的恶名，\n曹某早有所闻。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n就是袁谭、郭图、辛评。"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":20,"name":"dialog","args":["&文官01\n您说什么……\n丞相是说笑的吧……！？"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n我没功夫跟你说笑……"]},{"op":52,"name":"actor_action","args":[0,2]},{"op":56,"name":"set_attr","args":[0,15,0,253]},{"op":20,"name":"dialog","args":["&曹操\n你这帮凶一样得砍头！！"]},{"op":52,"name":"actor_action","args":[192,3]},{"op":20,"name":"dialog","args":["&文官01\n啊！？"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":20,"name":"dialog","args":["&曹操\n蠢货！\n我会上袁谭这个笨蛋的当吗？\n&曹操\n想利用我帮他争权夺利？\n别做梦！\n&曹操\n听着！回去告诉袁谭，\n让他洗干净脖子等死吧！！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n难道要我砍下你的脑袋，\n送回袁谭那里吗？"]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n啊！\n丞相饶命！"]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n那就快点回去传话！\n否则就砍下你的脑袋送回去！\n叫他不要小看我曹孟德！！\n&文官01\n是……是！"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,192,0,53,98,2]},{"op":49,"name":"actor_select","args":[65535,192,0,0,0,0,65535]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":51,"name":"actor_face","args":[1,0,0]},{"op":20,"name":"dialog","args":["&夏侯惇\n这家伙吓得都快哭了。\n&夏侯惇\n早料到袁谭这小子，\n不会派兵共同作战的。\n孟德，你可真厉害。\n&曹操\n那个使者内心的恐慌，\n也会感染给袁谭的，\n这也是策略。\n&夏侯惇\n是啊，是啊。"]},{"op":51,"name":"actor_face","args":[1,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。\n真想看看袁谭的表情！\n好！进军南皮！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,17]},{"op":20,"name":"dialog","args":["&夏侯惇\n是！"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[22,4]},{"op":20,"name":"dialog","args":["&郭嘉\n唔，咳，咳………"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n奉孝！"]},{"op":51,"name":"actor_face","args":[24,0,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":20,"name":"dialog","args":["&荀彧\n奉孝！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n怎么了，奉孝？"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":20,"name":"dialog","args":["&郭嘉\n啊，没什么大不了的……\n只是点小风寒，不久就会好的。\n请大家不必担心。\n&曹操\n………\n（上次作战时就咳嗽不止，\n难道………）"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":5,"offset":8230,"sections":[{"index":0,"offset":8232,"title":"南皮  和曹操同盟","body_off":8259,"body_end":9484,"conditions":[{"op":2,"name":"comment","args":["南皮  和曹操同盟"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,308,45]},{"op":41,"name":"op_29","args":[115,372,45]},{"op":41,"name":"op_29","args":[113,460,28]},{"op":9,"name":"delay","args":[8]},{"op":42,"name":"op_2a","args":[115,390,30]},{"op":9,"name":"delay","args":[8]},{"op":43,"name":"op_2b","args":[115]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["袁尚弃走邺城后，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[0,340,45]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["曹操占领了此地，",1,1,0]},{"op":9,"name":"delay","args":[8]},{"op":42,"name":"op_2a","args":[0,396,45]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["并继续进攻袁谭所在的南皮。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,42,65535]},{"op":48,"name":"actor_appear","args":[113,54,70,0,0]},{"op":48,"name":"actor_appear","args":[103,35,56,1,0]},{"op":48,"name":"actor_appear","args":[112,71,56,3,0]},{"op":48,"name":"actor_appear","args":[192,53,56,2,6]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[203,0]},{"op":23,"name":"place_name","args":["南皮  袁谭公馆"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[113,3]},{"op":20,"name":"dialog","args":["&袁谭\n什……什么！？\n曹操要讨伐我！"]},{"op":20,"name":"dialog","args":["&文官01\n是……是……\n看起来非常震怒的样子……"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":20,"name":"dialog","args":["&袁谭\n嗯嗯嗯………\n莫非我们的计策败露了……\n&袁谭\n郭图！！"]},{"op":52,"name":"actor_action","args":[103,6]},{"op":20,"name":"dialog","args":["&郭图\n在。"]},{"op":52,"name":"actor_action","args":[103,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[113,2]},{"op":20,"name":"dialog","args":["&袁谭\n都怪你出了这个蠢主意，\n才会落到今天这个地步！！\n你打算怎么办！"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":20,"name":"dialog","args":["&郭图\n可……可是……"]},{"op":52,"name":"actor_action","args":[113,2]},{"op":20,"name":"dialog","args":["&袁谭\n住口！我不想听你解释！\n马上拖出去斩首！"]},{"op":51,"name":"actor_face","args":[112,0,2]},{"op":20,"name":"dialog","args":["&辛评\n请等一下。"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":20,"name":"dialog","args":["&袁谭\n什么事？辛评。"]},{"op":52,"name":"actor_action","args":[112,6]},{"op":20,"name":"dialog","args":["&辛评\n主公，\n如今除了打败曹操之外，\n我们已经无路可走了。\n&辛评\n这时候如果杀了郭图，\n只会让曹操高兴罢了。"]},{"op":51,"name":"actor_face","args":[113,0,1]},{"op":20,"name":"dialog","args":["&袁谭\n什么……？"]},{"op":51,"name":"actor_face","args":[113,0,0]},{"op":20,"name":"dialog","args":["&袁谭\n嗯嗯……说的没错。\n可恶，加强防卫！\n准备对付曹操！\n&郭图\n是。\n&辛评\n是。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[203,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":6,"offset":9484,"sections":[{"index":0,"offset":9486,"title":"军事会议  南皮之战前","body_off":9517,"body_end":10628,"conditions":[{"op":2,"name":"comment","args":["军事会议  南皮之战前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":9517,"cond":{"op":5,"name":"te