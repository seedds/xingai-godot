20,"name":"dialog","args":["&荀彧\n是。謝謝主公的體諒。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":8095,"title":"玩家切换","body_off":8120,"body_end":8610,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[804]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[804,6,2]},{"op":20,"name":"dialog","args":["&蔡琰\n接下來我會以可控友軍的身分參戰。\n雖然我的兵種是女兵，\n可是我會裝備七星寶刀。"]},{"op":52,"name":"actor_action","args":[0,17]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n如此甚好！"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[0,0]},{"op":51,"name":"actor_face","args":[804,0,2]},{"op":20,"name":"dialog","args":["&蔡琰\n除此以外，我還會裝備鶴氅。\n這件衣服具有恢復MP和策略必中\n兩種功效，放策略的任務就交給我吧。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n好樣的！那麼我把我的大宛馬借給你，\n這樣你就會更方便行動了。"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":51,"name":"actor_face","args":[804,6,2]},{"op":20,"name":"dialog","args":["&蔡琰\n多謝丞相。"]},{"op":51,"name":"actor_face","args":[804,0,2]},{"op":52,"name":"actor_action","args":[0,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":8610,"title":"玩家切换","body_off":8635,"body_end":9280,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[17]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[17,3]},{"op":20,"name":"dialog","args":["&貂蝉\n告訴主公一個好消息，\n那就是我和昭姬現在有魔法護體，\n我倆幾乎就是不死之身呢。"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n真的嗎？那麼真是太好了！"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[17,0]},{"op":20,"name":"dialog","args":["&貂蝉\n儘管如此，我們兩人不能在同一回合\n被擊退，否則能會死亡。"]},{"op":56,"name":"set_attr","args":[0,15,0,256]},{"op":20,"name":"dialog","args":["&曹操\n有這種事？那麼可得當心點了。"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n對了，主公還記得呂舞衣嗎？"]},{"op":20,"name":"dialog","args":["&曹操\n呂舞衣？她不是呂布和正妻的女兒嗎？\n她已經失蹤很久了啊。"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":20,"name":"dialog","args":["&貂蝉\n是啊。其實她已經拜左慈為師，\n目的是要替奉先報仇呢。"]},{"op":20,"name":"dialog","args":["&曹操\n是這樣嗎？我實在很難想像。\n她怎麼看也不會是那種孝順的人啊。"]},{"op":20,"name":"dialog","args":["&貂蝉\n我也這麼認為………"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":9280,"title":"玩家切换","body_off":9305,"body_end":9560,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[829]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[829,3,2]},{"op":20,"name":"dialog","args":["&王朗\n且看老夫如何用三寸不爛之舌\n勸降敵軍吧！"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n……………………"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":51,"name":"actor_face","args":[804,0,0]},{"op":20,"name":"dialog","args":["&蔡琰\n嗯，加油。"]},{"op":20,"name":"dialog","args":["&王朗\n總之，相信老夫就對了。就是這麼簡單！"]},{"op":51,"name":"actor_face","args":[829,0,2]},{"op":51,"name":"actor_face","args":[804,0,2]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":9560,"title":"玩家切换","body_off":9585,"body_end":9776,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[151]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n對了，元直。\n你為何會忽然不見蹤影呢？"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[151,6]},{"op":20,"name":"dialog","args":["&徐庶\n詳細的情形我都已經跟貂蟬姑娘說明了。\n眼下我們先設法打敗左慈吧。"]},{"op":20,"name":"dialog","args":["&曹操\n嗯。"]},{"op":52,"name":"actor_action","args":[151,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":9776,"title":"玩家切换","body_off":9801,"body_end":9869,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[3]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&关羽\n不管是魔王還是左慈，\n關某都一定要打敗他們！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":9869,"title":"玩家切换","body_off":9894,"body_end":10066,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[22,0,3]},{"op":20,"name":"dialog","args":["&郭嘉\n（瞬間移動？這倒挺有意思的，\n真希望我也能學會。）"]},{"op":20,"name":"dialog","args":["&曹操\n郭嘉，你在想什麼呢？"]},{"op":51,"name":"actor_face","args":[22,0,2]},{"op":20,"name":"dialog","args":["&郭嘉\n呃……沒什麼。"]},{"op":51,"name":"actor_face","args":[22,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":10066,"title":"玩家切换","body_off":10091,"body_end":10163,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[19]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&司马懿\n左慈可不能小看！\n他的實力或許能與魔王匹敵呢。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":10163,"title":"玩家切换","body_off":10188,"body_end":10233,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[16]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&典韦\n請主公務必派我出戰！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":10233,"title":"玩家切换","body_off":10258,"body_end":11185,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[157]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n等一下貧道不會直接參加戰鬥，\n但是會提供你們一些幫助。"]},{"op":20,"name":"dialog","args":["&曹操\n是這樣啊……"]},{"op":20,"name":"dialog","args":["&许子将\n左慈有一個叫「保你命三千」的鏡子，\n幾乎可以抵抗任何攻擊。"]},{"op":20,"name":"dialog","args":["&曹操\n喔？那麼我們該如何應付呢？"]},{"op":20,"name":"dialog","args":["&许子将\n請曹大人放心。雖然此物非常厲害，\n可是並非是無懈可擊的。"]},{"op":20,"name":"dialog","args":["&许子将\n舉例來說，策略「八陣圖」便是這面\n鏡子的剋星，有機會讓持有者混亂，\n這樣我們就可以隨便虐待他了。"]},{"op":20,"name":"dialog","args":["&许子将\n除此以外，孫子兵法和鶴氅有策略必中\n的效果，酒壺則是讓物理攻擊輕鬆擊中\n對手，它們都能用來對付這面魔鏡。"]},{"op":20,"name":"dialog","args":["&许子将\n還有「必殺」，基本上是絕對命中，\n也能用來破解這面鏡子的法力，\n請善加運用。"]},{"op":20,"name":"dialog","args":["&曹操\n嗯……我了解了。"]},{"op":52,"name":"actor_action","args":[157,3]},{"op":20,"name":"dialog","args":["&许子将\n另外，剛剛給你們的鐵鏟可以用來\n起出地雷，起出後的地雷便可用來\n對付敵軍，這點還請多多注意。"]},{"op":52,"name":"actor_action","args":[157,0]},{"op":20,"name":"dialog","args":["&曹操\n看來左慈真的是個狠角色呢。"]},{"op":20,"name":"dialog","args":["&许子将\n是的，尤其他還有三個秘密幫手，\n曹大人以前也見過她們喔。\n只論法力，三人個個不在左慈之下。"]},{"op":20,"name":"dialog","args":["&曹操\n喔？她們是誰？\n別賣關子了，快點告訴我呀！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}