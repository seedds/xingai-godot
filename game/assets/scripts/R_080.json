":[]},{"op":1,"name":"if","args":[],"off":7935,"cond":{"op":5,"name":"test_flags","args":[[],[1834]]},"end":12,"end_off":8025},{"op":20,"name":"dialog","args":["&沙摩可\n俺在上一仗的表現還不錯吧？\n下次俺會多殺幾個武將給你們瞧瞧。"]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":8033,"title":"玩家切换","body_off":8058,"body_end":8273,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[58]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[58,2,2]},{"op":20,"name":"dialog","args":["&马岱\n我恨曹操！"]},{"op":52,"name":"actor_action","args":[32,17]},{"op":20,"name":"dialog","args":["&刘备\n我也恨曹操，但是他已經死了，\n換個口號吧。"]},{"op":52,"name":"actor_action","args":[58,3]},{"op":20,"name":"dialog","args":["&马岱\n那好吧，我恨曹孟德！"]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n……這樣有差別嗎？"]},{"op":51,"name":"actor_face","args":[58,0,3]},{"op":52,"name":"actor_action","args":[32,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":8273,"title":"玩家切换","body_off":8298,"body_end":9095,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[36]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":1,"name":"if","args":[],"off":8304,"cond":{"op":5,"name":"test_flags","args":[[779],[]]},"end":12,"end_off":8567},{"op":20,"name":"dialog","args":["&刘备\n漢升，你的身體好點了嗎？"]},{"op":52,"name":"actor_action","args":[36,6]},{"op":20,"name":"dialog","args":["&黄忠\n哈哈，沒事的沒事的。\n這點小傷還要不了老夫的命。"]},{"op":52,"name":"actor_action","args":[36,3]},{"op":20,"name":"dialog","args":["&黄忠\n今後老夫還要對陛下竭力盡忠，\n再幹他個七十五年！！！\n哈哈哈哈哈哈！"]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n哈哈，好氣魄！"]},{"op":52,"name":"actor_action","args":[36,0]},{"op":52,"name":"actor_action","args":[32,0]},{"op":0,"name":"end","