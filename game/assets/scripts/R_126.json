","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1589,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":136,"end_off":3654},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[113]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,0]},{"op":39,"name":"change_scene","args":[2,65535,65535,242,65535]},{"op":48,"name":"actor_appear","args":[598,49,39,2,3]},{"op":48,"name":"actor_appear","args":[599,49,40,0,11]},{"op":48,"name":"actor_appear","args":[837,43,52,0,0]},{"op":48,"name":"actor_appear","args":[800,49,52,0,0]},{"op":48,"name":"actor_appear","args":[804,54,52,0,0]},{"op":23,"name":"place_name","args":["民居"]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["西北玉芝丸"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&董黑\n拜託！給我！給我！"]},{"op":20,"name":"dialog","args":["&董黑\n就一口！給我吃一口就行了！"]},{"op":20,"name":"dialog","args":["&董白\n你想吃什麼？\n大聲的說出來。"]},{"op":52,"name":"actor_action","args":[599,2]},{"op":20,"name":"dialog","args":["&董黑\n[C0D西北預製菜！！！]"]},{"op":52,"name":"actor_action","args":[598,2]},{"op":20,"name":"dialog","args":["&董白\n錯！是西北玉芝丸！！！"]},{"op":20,"name":"dialog","args":["&董黑\n隨便啦！反正我要吃！\n妳再不讓我吃，我就死給妳看！！！"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&关嫣\n這是什麼奇怪的對話？"]},{"op":20,"name":"dialog","args":["&蔡琰\n弟弟抱著姊姊的大腿，\n只為了再吃一口什麼東西？"]},{"op":20,"name":"dialog","args":["&吕舞衣\n是西北玉芝丸啦。"]},{"op":51,"name":"actor_face","args":[837,0,1]},{"op":20,"name":"dialog","args":["&吕舞衣\n那是某個仙人教董白調製的藥丸，\n據說能治百病，我也只吃過幾次。"]},{"op":52,"name":"actor_action","args":[837,11]},{"op":20,"name":"dialog","args":["&吕舞衣\n[C0D一天不吃難受，]\n[C0D吃了難受一天。]"]},{"op":20,"name":"dialog","args":["&吕舞衣\n據說董黑在兩歲時就開始吃這種藥。\n每當他藥癮發作的時候，\n不管是帶他去什麼地方，"]},{"op":20,"name":"dialog","args":["&吕舞衣\n或是給他買玩具，\n都無法轉移他的注意力。"]},{"op":20,"name":"dialog","args":["&吕舞衣\n好在我戒了。"]},{"op":51,"name":"actor_face","args":[800,0,3]},{"op":51,"name":"actor_face","args":[804,0,3]},{"op":20,"name":"dialog","args":["&蔡琰\n這是什麼鬼東西……"]},{"op":52,"name":"actor_action","args":[800,2]},{"op":20,"name":"dialog","args":["&关嫣\n原來董白是這樣控制她弟弟的！？"]},{"op":20,"name":"dialog","args":["&关嫣\n我們費盡千辛萬苦，\n居然是幫她煉製這麼糟糕的東西！？"]},{"op":52,"name":"actor_action","args":[837,6]},{"op":20,"name":"dialog","args":["&吕舞衣\n差不多，但是她自己也吃了不少。"]},{"op":51,"name":"actor_face","args":[804,0,0]},{"op":20,"name":"dialog","args":["&蔡琰\n不管他們嗑了什麼，\n我都不要來一點！"]},{"op":51,"name":"actor_face","args":[837,0,0]},{"op":51,"name":"actor_face","args":[800,0,0]},{"op":52,"name":"actor_action","args":[599,3]},{"op":52,"name":"actor_action","args":[598,3]},{"op":20,"name":"dialog","args":["&董黑\n求妳了，再讓我吃一次吧，\n一次，一次也行！\n求妳了，我再也不亂跑了。"]},{"op":52,"name":"actor_action","args":[599,11]},{"op":20,"name":"dialog","args":["&董黑\n姊，我真的太癢了，求妳了。\n我聽話，我以後再也不鬧了。"]},{"op":49,"name":"actor_select","args":[0,599,0,0,0,0,65535]},{"op":48,"name":"actor_appear","args":[599,49,41,0,10]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&董黑\n[C0D我現在身體癢的要死，]\n[C0D好像有螞蟻在爬，太癢了！]"]},{"op":20,"name":"dialog","args":["&董黑\n給我再吃最後一次！\n我發誓，真的是最後一次了！"]},{"op":52,"name":"actor_action","args":[598,6]},{"op":20,"name":"dialog","args":["&董白\n真拿你沒辦法，吃吧。"]},{"op":52,"name":"actor_action","args":[599,3]},{"op":20,"name":"dialog","args":["&董黑\n謝謝！！！"]},{"op":52,"name":"actor_action","args":[599,6]},{"op":105,"name":"popup","args":["得到西北玉芝丸。"]},{"op":52,"name":"actor_action","args":[599,11]},{"op":20,"name":"dialog","args":["&董黑\n嗚嗚嗚，太好了。\n我以為我再也吃不到西北玉芝丸了……"]},{"op":52,"name":"actor_action","args":[598,7]},{"op":20,"name":"dialog","args":["&董白\n想不到你居然這麼支持我的靈藥。\n特別感謝你，你是我的忠實粉絲。"]},{"op":52,"name":"actor_action","args":[800,2]},{"op":20,"name":"dialog","args":["&关嫣\n真是看不下去！！！"]},{"op":20,"name":"dialog","args":["&吕舞衣\n這還算是好的。\n為了吃上一口玉芝丸，董黑可以做\n任何事，哪怕是送出套房都沒問題。"]},{"op":51,"name":"actor_face","args":[804,4,2]},{"op":20,"nam