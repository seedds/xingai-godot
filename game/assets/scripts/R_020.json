itions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[2]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&张辽\n请让我去对付关羽。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":6451,"title":"玩家切换","body_off":6476,"body_end":6658,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[7]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":1,"name":"if","args":[],"off":6482,"cond":{"op":5,"name":"test_flags","args":[[1852],[]]},"end":4,"end_off":6564},{"op":20,"name":"dialog","args":["&张郃\n每個連弩騎兵都能隨時發出\n致命一擊，請大家拭目以待吧！"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6564,"cond":{"op":5,"name":"test_flags","args":[[],[1852]]},"end":7,"end_off":6650},{"op":20,"name":"dialog","args":["&张郃\n從現在開始，每個連弩騎兵都能\n主動連擊，請大家拭目以待吧！"]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":6658,"title":"玩家切换","body_off":6683,"body_end":6842,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[20]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀彧\n战场上都是山，\n让许褚将军出马吧……"]},{"op":52,"name":"actor_action","args":[15,3]},{"op":20,"name":"dialog","args":["&许褚\n哦！不愧是文若老军师，\n果然有眼力。"]},{"op":51,"name":"actor_face","args":[20,0,3]},{"op":20,"name":"dialog","args":["&荀彧\n哈哈哈。"]},{"op":52,"name":"actor_action","args":[15,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":6842,"title":"玩家切换","body_off":6867,"body_end":7018,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭嘉\n赵云好像加入刘备军中了。\n&曹操\n赵云？在徐州见过的那员虎将？\n&郭嘉\n是的。\n他的武力可以跟关羽、张飞媲美。\n&曹操\n哦，这倒有意思。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":7018,"title":"玩家切换","body_off":7043,"body_end":7103,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许褚\n穰山？原来是座山。\n这回该我表现了！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":7103,"title":"玩家切换","body_off":7128,"body_end":7223,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[21]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&程昱\n不过刘备这个人很有外交才能。\n&曹操\n的确如此。\n他曾经成功地利用了袁绍。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":7223,"sections":[{"index":0,"offset":7225,"title":"穰山  刘备主营","body_off":7250,"body_end":7991,"conditions":[{"op":2,"name":"comment","args":["穰山  刘备主营"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,54,65535]},{"op":48,"name":"actor_appear","args":[32,53,37,2,0]},{"op":48,"name":"actor_appear","args":[3,42,52,1,0]},{"op":48,"name":"actor_appear","args":[33,42,58,1,0]},{"op":48,"name":"actor_appear","args":[74,67,52,3,0]},{"op":48,"name":"actor_appear","args":[75,67,58,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["穰山  刘备军主营"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n什么！？\n曹军向穰山杀来了！？"]},{"op":20,"name":"dialog","args":["&龚都\n是的，我的手下看见了。\n一定是曹操的旗号。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&刘备\n这么说来………\n曹操彻底击败袁绍了吗？\n&关羽\n恐怕正是如此。\n曹操真是可怕啊！"]},{"op":51,"name":"actor_face","args":[33,0,0]},{"op":20,"name":"dialog","args":["&张飞\n喂喂！\n现在可不是称赞敌人的时候。"]},{"op":51,"name":"actor_face","args":[33,0,1]},{"op":20,"name":"dialog","args":["&刘备\n嗯，没错。\n我们无论如何，\n都要挡住曹军的进攻。"]},{"op":52,"name":"actor_action","args":[74,3]},{"op":20,"name":"dialog","args":["&刘辟\n主公不必担心。\n这一带是我们的地盘，\n请您放心吧。"]},{"op":52,"name":"actor_action","args":[74,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[75,3]},{"op":20,"name":"dialog","args":["&龚都\n是啊！"]},{"op":52,"name":"actor_action","args":[75,0]},{"op":20,"name":"dialog","args":["&刘备\n嗯。"]},{"op":52,"name":"actor_action","args":[32,17]},{"op":20,"name":"dialog","args":["&刘备\n好！大家加强防御，\n防范曹军来袭。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]}]}