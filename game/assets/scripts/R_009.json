or_face","args":[2,0,1]},{"op":51,"name":"actor_face","args":[126,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n主公，您的心情我能理解，\n不过现在只能先逃命要紧了。"]},{"op":51,"name":"actor_face","args":[119,0,0]},{"op":20,"name":"dialog","args":["&吕布\n话虽如此，能上哪去？\n&陈宫\n去徐州投奔刘玄德吧。"]},{"op":20,"name":"dialog","args":["&张辽\n刘玄德……？"]},{"op":52,"name":"actor_action","args":[126,0]},{"op":51,"name":"actor_face","args":[119,0,2]},{"op":20,"name":"dialog","args":["&吕布\n我知道这个人………\n不过，他会收留我们吗……？"]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n刘玄德最重义气，一定会接纳我们的。"]},{"op":20,"name":"dialog","args":["&吕布\n…………"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,3,0]},{"op":20,"name":"dialog","args":["&吕布\n好吧！就听你的主意去徐州。\n&陈宫\n是。"]},{"op":52,"name":"actor_action","args":[126,0]},{"op":51,"name":"actor_face","args":[2,0,2]},{"op":20,"name":"dialog","args":["&张辽\n是。"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":50,"name":"actor_move","args":[65535,2,0,44,4,0]},{"op":50,"name":"actor_move","args":[65535,126,0,54,4,0]},{"op":50,"name":"actor_move","args":[65535,119,0,49,12,0]},{"op":49,"name":"actor_select","args":[65535,2,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,126,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,119,0,49,4,0]},{"op":49,"name":"actor_select","args":[65535,119,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":1309,"sections":[{"index":0,"offset":1311,"title":"献帝  逃出","body_off":1332,"body_end":3886,"conditions":[{"op":2,"name":"comment","args":["献帝  逃出"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,416,67]},{"op":41,"name":"op_29","args":[119,480,67]},{"op":41,"name":"op_29","args":[32,459,152]},{"op":44,"name":"caption","args":["吕布败给曹操后，辗转逃亡，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[119,523,67]},{"op":42,"name":"op_2a","args":[119,523,152]},{"op":44,"name":"caption","args":["最后投奔徐州刘备的帐下。",1,0,1]},{"op":44,"name":"caption","args":["此时，",0,1,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[131,220,82]},{"op":44,"name":"caption","args":["李傕、郭汜二人争权夺利，",1,1,0]},{"op":41,"name":"op_29","args":[129,156,82]},{"op":44,"name":"caption","args":["终于爆发了武力冲突。",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["长安又燃起了战火。",1,1,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,15,65535]},{"op":48,"name":"actor_appear","args":[149,27,55,1,0]},{"op":48,"name":"actor_appear","args":[23,46,55,3,6]},{"op":48,"name":"actor_appear","args":[192,46,43,2,0]},{"op":48,"name":"actor_appear","args":[608,52,43,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["长安  宫廷"]},{"op":20,"name":"dialog","args":["&献帝\n什么，你说要放朕逃走！？\n&贾诩\n是。"]},{"op":52,"name":"actor_action","args":[192,3]},{"op":20,"name":"dialog","args":["&文官01\n什么！"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[23,0]},{"op":20,"name":"dialog","args":["&贾诩\n……请陛下快点。\n&献帝\n可是贾爱卿，你是李傕军队的军师，\n为什么……？"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n良禽择木而栖，李傕不适合做我的主公。"]},{"op":51,"name":"actor_face","args":[149,0,3]},{"op":20,"name":"dialog","args":["&献帝\n好吧……贾爱卿，谢谢你了。"]},{"op":51,"name":"actor_face","args":[149,0,1]},{"op":20,"name":"dialog","args":["&献帝\n快去通知群臣，马上离开长安，\n……朕要返回洛阳。\n&文官01\n是。"]},{"op":52,"name":"actor_action","args":[608,6]},{"op":20,"name":"dialog","args":["&阉兵1\n是。"]},{"op":52,"name":"actor_action","args":[608,0]},{"op":50,"name":"actor_move","args":[65535,608,0,91,43,1]},{"op":50,"name":"actor_move","args":[65535,192,0,85,43,1]},{"op":49,"name":"actor_select","args":[65535,608,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,192,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&献帝\n贾爱卿，今后你打算怎么办？\n&贾诩\n我想去投奔宛城的张绣。\n&献帝\n张绣？\n&贾诩\n他是已故的张济大人的侄子。\n&献帝\n贾爱卿，你不想为朕效力吗？\n你才是真正的忠臣，\n我会给你高官厚禄的。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":20,"name":"dialog","args":["&贾诩\n……恕我难以从命。\n&献帝\n你是说不为朕效力？\n&贾诩\n陛下，\n我想为能够发挥我才能的人效力。"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n请恕我直言，陛下现在还没有实力。\n&献帝\n……………。\n&献帝\n张绣就值得你为他效力吗？\n&贾诩\n我的事，陛下就不必操心了，\n陛下还是多考虑自己的安全吧。"]},{"op":48,"name":"actor_appear","args":[192,85,43,3,0]},{"op":48,"name":"actor_appear","args":[608,91,43,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,192,0,66,43,3]},{"op":50,"name":"actor_move","args":[65535,608,0,72,43,3]},{"op":52,"name":"actor_action","args":[192,0]},{"op":52,"name":"actor_action","args":[608,0]},{"op":20,"name":"dialog","args":["&文官01\n陛下，大家都很高兴。"]},{"op":52,"name":"actor_action","args":[608,6]},{"op":20,"name":"dialog","args":["&阉兵1\n马上出发吧，时间紧迫！"]},{"op":52,"name":"actor_action","args":[608,0]},{"op":52,"name":"actor_action","args":[149,5]},{"op":20,"name":"dialog","args":["&献帝\n嗯……贾爱卿。\n&贾诩\n陛下，一路上保重。"]},{"op":52,"name":"actor_action","args":[149,0]},{"op":50,"name":"actor_move","args":[65535,149,0,27,48,0]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,149,0,66,48,1]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[192,0,2]},{"op":51,"name":"actor_face","args":[608,0,2]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[65535,149,0,92,48,1]},{"op":50,"name":"actor_move","args":[65535,192,0,85,43,1]},{"op":50,"name":"actor_move","args":[65535,608,0,91,43,1]},{"op":49,"name":"actor_select","args":[65535,192,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,608,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,149,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":51,"name":"actor_face","args":[23,0,3]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[23,0,1]},{"op":20,"name":"dialog","args":["&贾诩\n李傕很快就会发觉陛下逃走的，\n我也必须马上离开长安。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[0,9,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":22,"name":"info","args":["李傕与郭汜之争中，由于郭汜军中的将领\n徐晃表现出色，局势对郭汜军十分有利。"]},{"op":22,"name":"info","args":["可是就在最后的紧要关头，献帝却被贾诩\n放走，出了长安城。李傕、郭汜知道后\n马上停战，合力追捕献帝。"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":3886,"sections":[{"index":0,"offset":3888,"title":"献帝  请求援军","body_off":3913,"body_end":5792,"conditions":[{"op":2,"name":"comment","args":["献帝  请求援军"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,59,65535]},{"op":48,"name":"actor_appear","args":[609,49,95,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["长安郊外  山道"]},{"op":50,"name":"actor_move","args":[65535,609,0,49,85,0]},{"op":48,"name":"actor_appear","args":[149,49,95,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,609,0,49,75,0]},{"op":50,"name":"actor_move","args":[65535,149,0,49,85,0]},{"op":48,"name":"actor_appear","args":[192,44,95,0,0]},{"op":48,"name":"actor_appear","args":[608,54,95,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,609,0,49,30,0]},{"op":50,"name":"actor_move","args":[65535,149,0,49,40,0]},{"op":50,"name":"actor_move","args":[65535,192,0,44,50,0]},{"op":50,"name":"actor_move","args":[65535,608,0,54,50,0]},{"op":51,"name":"actor_face","args":[149,0,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&献帝\n啊，啊……。"]},{"op":51,"name":"actor_face","args":[609,0,2]},{"op":52,"name":"actor_action","args":[608,0]},{"op":52,"name":"actor_action","args":[192,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[609,6,2]},{"op":20,"name":"dialog","args":["&阉兵2\n啊，陛下！"]},{"op":51,"name":"actor_face","args":[609,0,2]},{"op":50,"name":"actor_move","args":[65535,192,0,44,40,0]},{"op":52,"name":"actor_action","args":[192,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[192,0,1]},{"op":20,"name":"dialog","args":["&文官01\n陛下！您怎么了？"]},{"op":20,"name":"dialog","args":["&献帝\n朕已经走不动了……。\n&文官01\n可是如果留在这里，\n会被李傕、郭汜的部队追上的。"]},{"op":51,"name":"actor_face","args":[149,0,1]},{"op":20,"name":"dialog","args":["&献帝\n我不走了，李傕他们不会杀死我的，\n你们别管我，快逃命吧。"]},{"op":51,"name":"actor_face","args":[609,6,2]},{"op":20,"name":"dialog","args":["&阉兵2\n那……那可不行。"]},{"op":51,"name":"actor_face","args":[609,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[608,6]},{"op":20,"name":"dialog","args":["&阉兵1\n陛下，去向附近的诸侯求救吧？"]},{"op":50,"name":"actor_move","args":[65535,149,0,54,40,1]},{"op":52,"name":"actor_action","args":[149,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[149,0,2]},{"op":20,"name":"dialog","args":["&献帝\n诸侯之中有谁有实力，\n可与李傕、郭汜的大军交战呢？\n&阉兵1\n臣有两个人选，一是河北的袁绍。\n&阉兵1\n此人是当时反董卓同盟军的主帅。\n&阉兵1\n其兵力应该比李傕、郭汜强大。\n&献帝\n还有一人呢……？\n&阉兵1\n就是濮阳的曹操。此人兵力虽然比袁绍\n差些，不过他手下谋士勇将云集，\n而且消灭过贼匪，于朝廷有大功。"]},{"op":51,"name":"actor_face","args":[149,0,1]},{"op":20,"name":"dialog","args":["&献帝\n袁绍和曹操……？\n我明白了，去请他们二人救援吧。\n&阉兵1\n那么臣马上就去。"]},{"op":51,"name":"actor_face","args":[608,0,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,608,0,44,50,3]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[608,0,0]},{"op":20,"name":"dialog","args":["&阉兵1\n走吧。"]},{"op":51,"name":"actor_face","args":[192,0,2]},{"op":20,"name":"dialog","args":["&文官01\n是。"]},{"op":50,"name":"actor_move","args":[65535,192,0,44,4,0]},{"op":50,"name":"actor_move","args":[65535,608,0,44,14,0]},{"op":49,"name":"actor_select","args":[65535,192,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,608,0,44,4,0]},{"op":49,"name":"actor_select","args":[65535,608,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,609,0,49,40,1]},{"op":20,"name":"dialog","args":["&阉兵2\n陛下，我们去洛阳吧。"]},{"op":51,"name":"actor_face","args":[609,0,3]},{"op":20,"name":"dialog","args":["&阉兵2\n让臣搀着您走吧。"]},{"op":51,"name":"actor_face","args":[149,0,3]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,149,0,51,40,3]},{"op":52,"name":"actor_action","args":[149,0]},{"op":20,"name":"dialog","args":["&献帝\n……有劳你了。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":5792,"sections":[{"index":0,"offset":5794,"title":"袁绍  拒绝敕命","body_off":5819,"body_end":6972,"conditions":[{"op":2,"name":"comment","args":["袁绍  拒绝敕命"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,7,65535]},{"op":48,"name":"actor_appear","args":[192,52,31,2,0]},{"op":48,"name":"actor_appear","args":[101,49,46,0,0]},{"op":48,"name":"actor_appear","args":[106,57,46,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":105,"name":"popup","args":["过了几天……。"]},{"op":23,"name":"place_name","args":["信都  袁绍公馆"]},{"op":20,"name":"dialog","args":["&文官01\n……圣旨到，\n命大臣袁绍火速至陛下身边护驾，\n以示忠节。\n&袁绍\n是。"]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n请接旨。\n&袁绍\n真是惶恐之至，请恕我不能接受。"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":20,"name":"dialog","args":["&文官01\n为什么？再怎么说这也是圣旨啊！"]},{"op":20,"name":"dialog","args":["&袁绍\n如今信都附近山贼出没，\n我忙于剿灭山贼，\n实在分身乏术……。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[106,6]},{"op":20,"name":"dialog","args":["&审配\n是的，实在是太抱歉了……。"]},{"op":52,"name":"actor_action","args":[106,0]},{"op":52,"name":"actor_action","args":[192,3]},{"op":20,"name":"dialog","args":["&文官01\n情况好像不是这样吧，\n我看城里城外，治安非常好嘛。"]},{"op":20,"name":"dialog","args":["&袁绍\n不，不，还有很多山贼呢。"]},{"op":52,"name":"actor_action","args":[106,6]},{"op":20,"name":"dialog","args":["&审配\n钦差大人，实在很抱歉……。"]},{"op":52,"name":"actor_action","args":[192,2]},{"op":20,"name":"dialog","args":["&文官01\n唔唔………"]},{"op":51,"name":"actor_face","args":[192,0,0]},{"op":20,"name":"dialog","args":["&文官01\n唔唔………算了！\n我将禀报陛下，原来你是如此不忠。\n&袁绍\n这也是无奈之事啊。"]},{"op":52,"name":"actor_action","args":[106,0]},{"op":20,"name":"dialog","args":["&审配\n是啊……。"]},{"op":50,"name":"actor_move","args":[65535,192,0,45,31,3]},{"op":52,"name":"actor_action","args":[192,0]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,192,0,45,90,2]},{"op":49,"name":"actor_select","args":[65535,192,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[101,0,1]},{"op":20,"name":"dialog","args":["&袁绍\n审配，你看这么做行吗……？"]},{"op":51,"name":"actor_face","args":[106,0,3]},{"op":20,"name":"dialog","args":["&审配\n行的。"]},{"op":51,"name":"actor_face","args":[106,0,2]},{"op":20,"name":"dialog","args":["&审配\n反正现在主公也得不到朝廷的奖赏，\n又何必白白损失兵力。"]},{"op":51,"name":"actor_face","args":[101,0,2]},{"op":20,"name":"dialog","args":["&袁绍\n嗯……。"]},{"op":29,"name":"fad