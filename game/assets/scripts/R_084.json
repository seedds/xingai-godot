","args":[2,65535,65535,9,65535]},{"op":48,"name":"actor_appear","args":[127,32,55,1,0]},{"op":48,"name":"actor_appear","args":[132,50,40,2,0]},{"op":48,"name":"actor_appear","args":[119,58,40,2,0]},{"op":48,"name":"actor_appear","args":[847,66,40,2,0]},{"op":48,"name":"actor_appear","args":[129,74,40,2,0]},{"op":48,"name":"actor_appear","args":[128,50,70,0,0]},{"op":48,"name":"actor_appear","args":[133,58,70,0,0]},{"op":48,"name":"actor_appear","args":[130,66,70,0,0]},{"op":48,"name":"actor_appear","args":[131,74,70,0,0]},{"op":48,"name":"actor_appear","args":[135,50,55,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[203,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["兵敗虎牢关"]},{"op":23,"name":"place_name","args":["洛阳  相府"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n什么！！你说华雄被杀了！？"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":20,"name":"dialog","args":["&李肃\n是的，现在同盟军开始朝洛阳进军了。"]},{"op":52,"name":"actor_action","args":[127,2]},{"op":20,"name":"dialog","args":["&董卓\n哼……。"]},{"op":52,"name":"actor_action","args":[132,6]},{"op":20,"name":"dialog","args":["&李儒\n既然如此，现今之计………\n只有在虎牢关击溃敌人了。"]},{"op":52,"name":"actor_action","args":[132,0]},{"op":52,"name":"actor_action","args":[127,0]},{"op":20,"name":"dialog","args":["&董卓\n嗯……。"]},{"op":52,"name":"actor_action","args":[127,17]},{"op":20,"name":"dialog","args":["&董卓\n吕布，该你出马了。\n你可得死守虎牢关！"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n是！"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&董卓\n我也去见识见识你的武勇。"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":20,"name":"dialog","args":["&吕布\n请您放心。"]},{"op":52,"name":"actor_action","args":[119,17]},{"op":20,"name":"dialog","args":["&吕布\n曹操，袁绍，我倒要瞧瞧你们的本事！"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n哈哈，不愧是我的兒子。\n真有氣魄！"]},{"op":20,"name":"dialog","args":["&董卓\n正所謂「得奉先者得天下」，\n我可是一直秉持著這個信念呢。"]},{"op":52,"name":"actor_action","args":[127,17]},{"op":20,"name":"dialog","args":["&董卓\n李儒！准备出发！"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[132,6]},{"op":20,"name":"dialog","args":["&李儒\n是！"]},{"op":52,"name":"actor_action","args":[132,0]},{"op":35,"name":"play_music","args":[203,255]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["本關是「虎牢關撤退戰」，\n我們將以董卓軍的視角遊玩，\n勝利條件是掩護董卓逃跑，或者全滅敵軍。"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&许子将\n對了，您希望外傳中的敵軍夏侯惇\n與正篇故事一樣強嗎？"]},{"op":1,"name":"if","args":[],"off":1542,"cond":{"op":18,"name":"choice","args":["好呀\n拜託你，把他變弱",0]},"end":75,"end_off":1680},{"op":1,"name":"if","args":[],"off":1576,"cond":{"op":19,"name":"test_choice","args":[1]},"end":70,"end_off":1633},{"op":20,"name":"dialog","args":["&许子将\nOK，故事繼續進行。"]},{"op":11,"name":"set_flag","args":[1833,1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1633,"cond":{"op":19,"name":"test_choice","args":[2]},"end":74,"end_off":1678},{"op":20,"name":"dialog","args":["&夏侯惇\n可惡！"]},{"op":11,"name":"set_flag","args":[1833,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[3]},{"op":36,"name":"play_sound","args":[15]},{"op":9,"name":"delay","args":[3]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,2,1,0,0,0,0,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end