,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[76,442,219]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["撤退到建业。\n同一时间……",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[19]},{"op":39,"name":"change_scene","args":[2,65535,65535,61,65535]},{"op":48,"name":"actor_appear","args":[159,54,60,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":24,"name":"title_text","args":["洛神赋"]},{"op":23,"name":"place_name","args":["许都  曹植府后花园"]},{"op":20,"name":"dialog","args":["&曹植\n宓儿，你可知道有一个人，\n一直在惦记着你……\n你可知道，大海是永远不会枯竭。"]},{"op":20,"name":"dialog","args":["&曹植\n每当西山日落，我的思绪万千惆怅。\n没有了心中所爱的人，\n纵然锦衣驷马，又有何用？"]},{"op":20,"name":"dialog","args":["&曹植\n眼见政务荒废，却不能自拔……\n难道这……就是命运？"]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&曹植\n哈哈……哈哈……"]},{"op":20,"name":"dialog","args":["&曹植\n你可曾听说洛水女神的传说？\n在我心中，那……多么像你……"]},{"op":9,"name":"delay","args":[10]},{"op":50,"name":"actor_move","args":[0,159,0,54,70,2]},{"op":22,"name":"info","args":["由于传说中的洛水之神名字叫宓妃，\n使曹植不免感伤。\n一时兴起，作《洛神赋》。\n"]},{"op":20,"name":"dialog","args":["&曹植\n……御着对曰：“臣闻河洛之神，名曰\n宓妃。然则君王之所见也，无乃是乎！\n其状若何？臣愿闻之。”……"]},{"op":20,"name":"dialog","args":["&曹植\n……其形也，翩若惊鸿，婉若游龙。\n荣曜秋菊，华茂春松。仿佛兮若轻云\n之蔽月，飘遥兮若流风之回雪……"]},{"op":20,"name":"dialog","args":["&曹植\n……余情悦取其美兮，心震荡而不怡。\n无良媒以接欢兮，托微波而通辞……"]},{"op":20,"name":"dialog","args":["&曹植\n……含辞未吐，气若幽兰。\n华容婀娜，令我忘餐……"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[15]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[2,65535,65535,53,65535]},{"op":48,"name":"actor_appear","args":[0,54,80,0,0]},{"op":48,"name":"actor_appear","args":[1,44,64,1,0]},{"op":48,"name":"actor_appear","args":[7,44,52,1,0]},{"op":48,"name":"actor_appear","args":[20,64,64,3,0]},{"op":48,"name":"actor_appear","args":[19,64,58,3,0]},{"op":48,"name":"actor_appear","args":[23,64,52,3,0]},{"op":1,"name":"if","args":[],"off":2676,"cond":{"op":5,"name":"test_flags","args":[[1270],[]]},"end":120,"end_off":2720},{"op":48,"name":"actor_appear","args":[16,44,58,1,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2720,"cond":{"op":5,"name":"test_flags","args":[[710],[]]},"end":123,"end_off":2764},{"op":48,"name":"actor_appear","args":[15,44,58,1,0]},{"op":0,"name":"end","args":[]},{"op":28,"name":"fade_out","args":[]},{"op":24,"name":"title_text","args":["最后的水战"]},{"op":23,"name":"place_name","args":["赤壁  曹操军主营"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[19,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n孙权和孔明好像一起撤往建业了。"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[1,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n孟德，终于要攻打建业了！\n如果打赢这一仗，就可以统一天下了！"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n不，夏侯惇将军。\n很遗憾的，挥兵建业之前还得打一仗。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":20,"name":"dialog","args":["&夏侯惇\n还得打一仗？\n什么意思？"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n位于建业前哨的濡须口，\n必然会设下重兵严防的。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n濡须口？\n又要水战了吗！？"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n嗯，正所谓「南船北马」。\n敌人当然很清楚这一点。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n好，不管