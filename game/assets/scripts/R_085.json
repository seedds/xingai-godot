,"name":"set_menu","args":[0]},{"op":39,"name":"change_scene","args":[2,65535,65535,9,65535]},{"op":48,"name":"actor_appear","args":[127,32,53,1,0]},{"op":48,"name":"actor_appear","args":[132,32,44,1,0]},{"op":48,"name":"actor_appear","args":[193,50,40,2,0]},{"op":48,"name":"actor_appear","args":[194,58,40,2,0]},{"op":48,"name":"actor_appear","args":[192,66,40,2,0]},{"op":48,"name":"actor_appear","args":[181,58,70,0,0]},{"op":48,"name":"actor_appear","args":[182,50,70,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[43]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["董卓焚城"]},{"op":23,"name":"place_name","args":["洛阳  相府"]},{"op":51,"name":"actor_face","args":[127,0,0]},{"op":20,"name":"dialog","args":["&董卓\n李儒，同盟军已经逼近洛阳了。"]},{"op":51,"name":"actor_face","args":[132,0,2]},{"op":20,"name":"dialog","args":["&李儒\n是啊。"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n有什么好主意吗？"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[132,6]},{"op":20,"name":"dialog","args":["&李儒\n洛阳的四周都是开阔地，不适合防守。"]},{"op":20,"name":"dialog","args":["&李儒\n因此还是放弃洛阳，\n迁都到有天然要塞的长安，重整旗鼓吧。"]},{"op":52,"name":"actor_action","args":[132,0]},{"op":20,"name":"dialog","args":["&董卓\n嗯，你是说迁都吗？"]},{"op":20,"name":"dialog","args":["&李儒\n是的。"]},{"op":20,"name":"dialog","args":["&董卓\n可是如果敵軍不要命的追上來，\n該當如何？"]},{"op":52,"name":"actor_action","args":[132,3]},{"op":20,"name":"dialog","args":["&李儒\n相國考慮的是。\n所以我們還要放火把\n这座洛陽城烧了。\n&李儒\n这样就可以阻止敌军\n继续追击我们了啊。"]},{"op":52,"name":"actor_action","args":[192,3]},{"op":20,"name":"dialog","args":["&文官01\n什……什么！？"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":51,"name":"actor_face","args":[127,0,3]},{"op":20,"name":"dialog","args":["&董卓\n嗯……"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[193,6]},{"op":20,"name":"dialog","args":["&文官02\n且……且慢！\n請相國三思啊！"]},{"op":52,"name":"actor_action","args":[132,0]},{"op":51,"name":"actor_face","args":[127,0,1]},{"op":20,"name":"dialog","args":["&董卓\n嗯？怎么？谁有异议？"]},{"op":20,"name":"dialog","args":["&文官02\n这洛阳可是历史悠久的都城啊。"]},{"op":52,"name":"actor_action","args":[194,6]},{"op":20,"name":"dialog","args":["&文官03\n如果草率迁都，百姓可要受罪了。"]},{"op":20,"name":"dialog","args":["&董卓\n…………"]},{"op":52,"name":"actor_action","args":[193,0]},{"op":52,"name":"actor_action","args":[194,0]},{"op":51,"name":"actor_face","args":[127,0,0]},{"op":20,"name":"dialog","args":["&董卓\n李儒，你繼續說下去。"]},{"op":20,"name":"dialog","args":["&李儒\n是。\n首先，既然我们都打算要迁都了，\n留着这座城已经没有好处；"]},{"op":52,"name":"actor_action","args":[132,3]},{"op":20,"name":"dialog","args":["&李儒\n其次，敌军的内部的向心力本身\n就很有限。\n&李儒\n如果我们一把火烧了洛陽，\n就等於是让敌军一无所得。\n&李儒\n他们一定会因此失去追杀我们\n的动力，然後自动解散！"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n很精辟的分析，继续说。"]},{"op":52,"name":"actor_action","args":[132,6]},{"op":20,"name":"dialog","args":["&李儒\n第三点，也是最重要的一点：\n洛陽是建设了數百年的城市，"]},{"op":20,"name":"dialog","args":["&李儒\n如果此城被焚毁，\n粮食与财物也被我们带走，\n那就等於是切断了敌军的补给线。\n&李儒\n就算他们真的还想追击我们，\n也絕對撐不了多久，\n我們可以不费吹灰之力的战胜他们！"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&董卓\n哈哈，好！\n你的主意正合我意！太棒了！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[132,0]},{"op":51,"name":"actor_face","args":[127,17,1]},{"op":20,"name":"dialog","args":["&董卓\n你们都听到了吗？\n现在就去没收城内所有的粮食和财产，\n然後做好放火的准备！"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[193,6]},{"op":20,"name":"dialog","args":["&文官02\n且……且慢！\n此事万万不可。"]},{"op":51,"name":"actor_face","args":[127,17,1]},{"op":20,"name":"dialog","args":["&董卓\n嗯？還有誰有別的意見嗎？"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":52,"name":"actor_action","args":[193,6]},{"op":20,"name":"dialog","args":["&文官02\n洛陽是座大城，\n我们根本不可能在短时间内\n就搬走所有的粮食和财产。\n&文官02\n如果真的放火烧城，不是太可惜了吗？"]},{"op":52,"name":"actor_action","args":[193,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&董卓\n喔？这倒是个问题欸。"]},{"op":20,"name":"dialog","args":["&董卓\n我会考虑看看的。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[194,6]},{"op":20,"name":"dialog","args":["&文官03\n相國大人，我也認為洛陽不能燒！"]},{"op":20,"name":"dialog","args":["&文官03\n洛陽的百姓那麽多，\n如果我们想要放火焚城，\n他们一定会想要反抗的。\n&文官03\n万一他们故意阻挠我军撤退，\n害得我们被敌军追上，那要怎麽办呢？"]},{"op":52,"name":"actor_action","args":[194,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[127,0,3]},{"op":20,"name":"dialog","args":["&董卓\n嗯，这个问题更大。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[127,17,1]},{"op":20,"name":"dialog","args":["&董卓\n粉紅帽，你有什麼看法？"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[127,0]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n相國大人，\n我不打算跟您讲什麽俗气的利益，\n也不打算说太多没意义的话。\n&文官01\n我只想对您说：洛陽不能烧。\n只要您摸著您的良心替百姓们想一想，\n自然可以找到原因。"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n你要我摸著我的良心………？"]},{"op":36,"name":"play_sound","args":[56]},{"op":9,"name":"delay","args":[8]},{"op":52,"name":"actor_action","args":[127,2]},{"op":20,"name":"dialog","args":["&董卓\n來人啊，把這個蠢貨叉出去，\n立即處死！"]},{"op":20,"name":"dialog","args":["&董卓\n罪名：廢話連篇！！！！"]},{"op":52,"name":"actor_action","args":[192,3]},{"op":20,"name":"dialog","args":["&文官01\n啊？這………"]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[193,0,1]},{"op":51,"name":"actor_face","args":[194,0,1]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,181,0,63,38,1]},{"op":50,"name":"actor_move","args":[65535,182,0,63,42,1]},{"op":51,"name":"actor_face","args":[192,3,1]},{"op":52,"name":"actor_action","args":[181,0]},{"op":52,"name":"actor_action","args":[182,0]},{"op":20,"name":"dialog","args":["&文官01\n相國，我冤！相國，我冤！"]},{"op":20,"name":"dialog","args":["&董卓\n你們還在等什麼？還不快點動手？"]},{"op":20,"name":"dialog","args":["&士兵01\n是。"]},{"op":52,"name":"actor_action","args":[192,2]},{"op":20,"name":"dialog","args":["&文官01\n真是個冥頑不靈的老賊。"]},{"op":52,"name":"actor_action","args":[192,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,192,0,98,40,1]},{"op":50,"name":"actor_move","args":[65535,181,0,95,38,1]},{"op":50,"name":"actor_move","args":[65535,182,0,95,42,1]},{"op":49,"name":"actor_select","args":[65535,192,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,182,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":35,"name":"play_music","args":[36,1]},{"op":20,"name":"dialog","args":["&文官01\n啊！"]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[193,0,2]},{"op":51,"name":"actor_face","args":[194,0,2]},{"op":51,"name":"actor_face","args":[127,0,0]},{"op":20,"name":"dialog","args":["&董卓\n李儒！"]},{"op":52,"name":"actor_action","args":[132,6]},{"op":20,"name":"dialog","args":["&李儒\n在。"]},{"op":52,"name":"actor_action","args":[132,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n現在就放把火把洛阳城烧光，\n百姓的全部财产一律没收。"]},{"op":20,"name":"dialog","args":["&董卓\n哈哈哈哈哈！！"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[132,6]},{"op":20,"name":"dialog","args":["&李儒\n丞相果然英明，下官马上去执行。"]},{"op":52,"name":"actor_action","args":[132,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[127,0,3]},{"op":20,"name":"dialog","args":["&董卓\n百姓们只要一心一意为我卖命就行了。"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n哈哈哈。"]},{"op":20,"name":"dialog","args":["&文官03\n……这简直是恶魔的行径。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[203,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":4208,"sections"