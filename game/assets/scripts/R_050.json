,"args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":1,"name":"if","args":[],"off":529,"cond":{"op":5,"name":"test_flags","args":[[1908],[]]},"end":32,"end_off":579},{"op":119,"name":"int_var_op","args":[2,4051,2,0,1]},{"op":17,"name":"goto_scenario","args":[15]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":581,"sections":[{"index":0,"offset":583,"title":"周瑜，败逃到濡须口","body_off":612,"body_end":3072,"conditions":[{"op":2,"name":"comment","args":["周瑜，败逃到濡须口"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":1,"name":"if","args":[],"off":622,"cond":{"op":2,"name":"comment","args":["過場CG"]},"end":24,"end_off":968},{"op":36,"name":"play_sound","args":[203]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,2]},{"op":39,"name":"change_scene","args":[0,13,65535,65535,65535]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[10]},{"op":44,"name":"caption","args":["夏侯惇與司馬懿至地穴調查神秘祭壇，",0,0,1]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["遇到了已故的黃巾軍，",1,1,1]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["雙方展開激烈的戰鬥。",1,0,1]},{"op":9,"name":"delay","args":[10]},{"op":44,"name":"caption","args":["最後地穴崩塌，",1,1,1]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["黃巾軍重歸塵土。",1,0,1]},{"op":9,"name":"delay","args":[10]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,72,65535]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[208,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["一切只为东吴"]},{"op":23,"name":"place_name","args":["赤壁郊外  河畔"]},{"op":48,"name":"actor_appear","args":[76,69,95,0,0]},{"op":50,"name":"actor_move","args":[65535,76,0,69,85,0]},{"op":48,"name":"actor_appear","args":[77,69,95,0,0]},{"op":50,"name":"actor_move","args":[65535,76,0,69,45,0]},{"op":50,"name":"actor_move","args":[65535,77,0,69,55,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n主公，东吴的命运还有希望！\n请您不要泄气！"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[76,0,2]},{"op":20,"name":"dialog","args":["&孙权\n……周瑜。\n有件事我想问你。"]},{"op":52,"name":"actor_action","args":[77,6]},{"op":20,"name":"dialog","args":["&周瑜\n不知主公所问何事？"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&孙权\n逼死刘备的既然是我们东吴，\n那么对蜀国来说，我们就是仇敌。\n&孙权\n但是赤壁之战中，\n蜀军却为我吴国作战，\n这究竟是怎么回事？"]},{"op":52,"name":"actor_action","args":[77,6]},{"op":20,"name":"dialog","args":["&周瑜\n主公，公瑾的内心也问着自己，\n那么公瑾就全盘托出吧。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[77,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n其实周瑜皓洁之心已经受污，\n与不义之徒立下誓约了。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&孙权\n孔明是吗……果然如此。"]},{"op":51,"name":"actor_face","args":[77,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,6]},{"op":20,"name":"dialog","args":["&周瑜\n孔明是个悖主忘义之徒，\n他为了掌握蜀国的实权，\n打算谋害主公的性命。\n&孙权\n孔明谋害刘备……？\n孔明竟然……我真不敢相信！\n&周瑜\n孔明挥舞着污秽的双翼，\n翩然来到公瑾镇守的家园，\n泛起蛊惑的笑容提出了交易。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[77,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n他说只要我们帮他杀死刘备，\n就把荆州割让给我们！\n&孙权\n嗯。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&周瑜\n……公瑾便与他立下这个誓约。"]},{"op":51,"name":"actor_face","args":[77,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,6]},{"op":20,"name":"dialog","args":["&周瑜\n后来公瑾助他成功地消灭了刘备。\n&周瑜\n也换得了富饶的荆州做为回报。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[77,0,1]},{"op":20,"name":"dialog","args":["&周瑜\n可是，我周瑜万万也没有想到，\n奸贼曹操竟会侵吴……"]},{"op":52,"name":"actor_action","args":[77,17]},{"op":20,"name":"dialog","args":["&周瑜\n公瑾所做一切只是为了东吴，\n为了东吴能够统一天下……"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[77,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,11]},{"op":20,"name":"dialog","args":["&周瑜\n还请主公恕罪。\n&孙权\n……嗯，你这么做也是无可奈何的。\n&孙权\n不过，如今到了这个地步，\n我们该如何是好？"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&周瑜\n位于前线的濡须口，\n是守护都城建业的门户重地，\n我军必须于此地阻止曹军的攻势。"]},{"op":52,"name":"actor_action","args":[77,6]},{"op":20,"name":"dialog","args":["&周瑜\n主公，为保家园免受曹贼的践踏，\n我将集结各地剩余的兵力前往濡须口。\n&周瑜\n主公能否在周瑜赶回之前，\n加强濡须口的防御？\n&孙权\n嗯，好吧。\n我会命令陆逊重整水军的。\n&周瑜\n那么周瑜暂且告别主公。\n&孙权\n嗯，有劳你了。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,77,0,75,55,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,77,0,75,10,1]},{"op":51,"name":"actor_face","args":[76,0,0]},{"op":49,"name":"actor_select","args":[65535,77,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[208,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":3072,"sections":[{"index":0,"offset":3074,"title":"军事会议  濡须口之战前","body_off":3107,"body_end":7150,"conditions":[{"op":2,"name":"comment","args":["军事会议  濡须口之战前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"o