gs":[],"off":5334,"cond":{"op":19,"name":"test_choice","args":[3]},"end":55,"end_off":5390},{"op":105,"name":"popup","args":["敵軍能力140"]},{"op":119,"name":"int_var_op","args":[2,4033,2,0,140]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[21,0]},{"op":11,"name":"set_flag","args":[22,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,157,212]},{"op":44,"name":"caption","args":["曹军",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[0,280,227]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["开赴了渊源颇深的赤壁。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,57,65535]},{"op":48,"name":"actor_appear","args":[76,66,52,3,0]},{"op":48,"name":"actor_appear","args":[88,52,41,2,0]},{"op":48,"name":"actor_appear","args":[78,46,41,2,0]},{"op":48,"name":"actor_appear","args":[79,40,41,2,0]},{"op":48,"name":"actor_appear","args":[81,52,63,0,0]},{"op":48,"name":"actor_appear","args":[86,46,63,0,0]},{"op":48,"name":"actor_appear","args":[85,40,63,0,0]},{"op":48,"name":"actor_appear","args":[35,52,52,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["赤壁  孙权军主营"]},{"op":20,"name":"dialog","args":["&孙权\n孔明先生，我按照你的指示，\n在赤壁布下大军了，\n不过这样能打败曹操吗？"]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n如果有陆逊将军的协助，\n一定能够打赢的。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[81,6]},{"op":20,"name":"dialog","args":["&陆逊\n我们已经有了万全的准备。\n请放心吧。"]},{"op":52,"name":"actor_action","args":[81,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[78,6]},{"op":20,"name":"dialog","args":["&鲁肃\n可是……万一我们失败呢？"]},{"op":52,"name":"actor_action","args":[78,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[88,6]},{"op":20,"name":"dialog","args":["&张昭\n是啊，\n你不是数次败给魏军了吗？"]},{"op":20,"name":"dialog","args":["&张昭\n就是因为这几场无谋的战斗，\n才加速蜀国灭亡的，\n你就别再说大话了。"]},{"op":51,"name":"actor_face","args":[35,0,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n你就是张昭大人吧？\n那么在这种局面下，\n你打算怎么做呢？"]},{"op":52,"name":"actor_action","args":[88,0]},{"op":20,"name":"dialog","args":["&张昭\n这还用说嘛！\n当然与魏国谈和，\n保全东吴的安泰。"]},{"op":52,"name":"actor_action","args":[35,11]},{"op":20,"name":"dialog","args":["&诸葛亮\n哈哈哈。"]},{"op":52,"name":"actor_action","args":[88,6]},{"op":20,"name":"dialog","args":["&张昭\n有什么好笑的！"]},{"op":52,"name":"actor_action","args":[88,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n张昭大人，你毕竟只是个文官，\n根本无法看出当前局势。"]},{"op":52,"name":"actor_action","args":[88,6]},{"op":20,"name":"dialog","args":["&张昭\n什么……你太放肆了！"]},{"op":52,"name":"actor_action","args":[88,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n我想请教你，\n你认为现在与魏国谈和，\n东吴果真就能安泰吗？"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n如今三国鼎立的局面已经瓦解，\n谈和就是把东吴献给曹操的卖国行为。"]},{"op":20,"name":"dialog","args":["&诸葛亮\n如果真的谈和了，\n你还能保全自己做个大臣，\n但是孙权大人会怎么样呢？"]},{"op":20,"name":"dialog","args":["&诸葛亮\n显然一定会被赐死的。\n所以你主张与曹魏和谈，\n可见你根本没有忠义之心。"]},{"op":52,"name":"actor_action","args":[88,6]},{"op":20,"name":"dialog","args":["&张昭\n哼……"]},{"op":20,"name":"dialog","args":["&诸葛亮\n吴国土地丰饶肥沃，\n孙氏已经治理了三代，\n国力相当雄厚。\n&诸葛亮\n而且还有易守难攻的长江天险。"]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n这样的国家一仗也不打，\n难道就这样交给曹操吗？"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":20,"name":"dialog","args":["&诸葛亮\n过去蜀国山中农业落后，\n建国的时日也不多，\n还是个新兴的国家。"]},{"op":51,"name":"actor_face","args":[35,0,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n尽管如此，后主刘禅和众将士，\n还是与强大的魏国周旋到底。"]},{"op":52,"name":"actor_action","args":[35,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n所以你根本没有资格谈论……\n后主刘禅和蜀国将士们的奋战。"]},{"op":52,"name":"actor_action","args":[88,0]},{"op":20,"name":"dialog","args":["&张昭\n唔唔！"]},{"op":52,"name":"actor_action","args":[76,3]},{"op":20,"name":"dialog","args":["&孙权\n孔明大人，我明白了。\n我们只有作战到底。"]},{"op":52,"name":"actor_action","args":[76,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[35,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":20,"name":"dialog","args":["&诸葛亮\n是的。"]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n那么在下去准备作战事宜。\n就此告退。\n&孙权\n嗯。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,35,0,40,52,3]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&诸葛瑾\n孔明……"]},{"op":51,"name":"actor_face","args":[35,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n兄长，你多保重。"]},{"op":20,"name":"dialog","args":["&诸葛瑾\n你也多保重。"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[35,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,35,0,16,52,3]},{"op":49,"name":"actor_select","args":[65535,35,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&孙权\n孔明这个人……\n陆逊，我们应该相信他吗？"]},{"op":51,"name":"actor_face","args":[81,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[81,6]},{"op":20,"name":"dialog","args":["&陆逊\n这该怎么说呢？"]},{"op":52,"name":"actor_action","args":[81,0]},{"op":20,"name":"dialog","args":["&陆逊\n主公，现在曹操最怕的就是孔明，\n能拯救我东吴的也只有孔明。\n&孙权\n嗯……"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":1,"name":"if","args":[],"off":8090,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":174,"end_off":8106},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":8108,"title":"玩家切换","body_off":8133,"body_end":8234,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭嘉\n上次险些失败……\n这次，相信也难不倒丞相。\n过了赤壁，东吴最大的天险就没有了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":8234,"title":"玩家切换","body_off":8259,"body_end":8309,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[6]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯渊\n又是水战啊……\n有点烦。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":8309,"title":"玩家切换","body_off":8334,"body_end":8441,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[20]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀彧\n这次的战斗不同于以往，\n主战场在东吴的河岸上。\n&荀彧\n恐怕东吴和孔明已在河岸列阵了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":8441,"title":"玩家切换","body_off":8466,"body_end":8619,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许褚\n不是在白帝城找到穿雲箭吗？\n&许褚\n那到底是什麼東西呀？\n&程昱\n穿雲箭可以使弓兵或弓騎兵部隊\n進行串連攻擊。\n&许褚\n这玩意儿可真厉害！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":8619,"title":"玩家切换","body_off":8644,"body_end":8735,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n又得在赤壁作战了是吗？\n当年一时让东吴得逞，\n这次一定要雪洗此仇。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":8735,"title":"玩家切换","body_off":8760,"body_end":8859,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[4]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹彰\n当年赤壁之战我还未从军，\n不过经常听大家提起。\n&曹彰\n这地方与我军颇有渊源。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":8859,"title":"玩家切换","body_off":8884,"body_end":8941,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[19]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&司马懿\n孔明，看你水战还能有什么本事。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":8941,"title":"玩家切换","body_off":8966,"body_end":9058,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[21]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&程昱\n不论如何，只要能上岸就有胜算了。\n只是不知这次东吴水军会用什么战术？"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}