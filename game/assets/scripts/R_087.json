ion","args":["再次變成流浪軍。",1,0,1]},{"op":9,"name":"delay","args":[10]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,67,65535]},{"op":48,"name":"actor_appear","args":[2,44,98,0,0]},{"op":48,"name":"actor_appear","args":[126,54,98,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["濮阳  郊外山道"]},{"op":50,"name":"actor_move","args":[65535,2,0,44,86,0]},{"op":50,"name":"actor_move","args":[65535,126,0,54,86,0]},{"op":48,"name":"actor_appear","args":[119,49,98,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,2,0,44,40,0]},{"op":50,"name":"actor_move","args":[65535,126,0,54,40,0]},{"op":50,"name":"actor_move","args":[65535,119,0,49,52,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,0,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,2,2]},{"op":20,"name":"dialog","args":["&吕布\n曹瞒老贼，我非报此仇不可！"]},{"op":51,"name":"actor_face","args":[2,0,1]},{"op":51,"name":"actor_face","args":[126,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n主公，您的心情我能理解，\n不过现在只能先逃命要紧了。"]},{"op":51,"name":"actor_face","args":[119,0,0]},{"op":20,"name":"dialog","args":["&吕布\n话虽如此，能上哪去？\n&陈宫\n去徐州投奔刘玄德吧。"]},{"op":20,"name":"dialog","args":["&张辽\n刘玄德……？"]},{"op":52,"name":"actor_action","args":[126,0]},{"op":51,"name":"actor_face","args":[119,0,2]},{"op":20,"name":"dialog","args":["&吕布\n我知道这个人………\n不过，他会收留我们吗……？"]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n刘玄德最重义气，一定会接纳我们的。"]},{"op":20,"name":"dialog","args":["&吕布\n…………"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,3,0]},{"op":20,"name":"dialog","args":["&吕布\n好吧！就听你的主意去徐州。\n&陈宫\n是。"]},{"op":52,"name":"actor_action","args":[126,0]},{"op":51,"name":"actor_face","args":[2,0,2]},{"op":20,"name":"dialog","args":["&张辽\n是。"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":50,"name":"actor_move","args":[65535,2,0,44,4,0]},{"op":50,"name":"actor_move","args":[65535,126,0,54,4,0]},{"op":50,"name":"actor_move","args":[65535,119,0,49,12,0]},{"op":49,"name":"actor_select","args":[65535,2,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,126,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,119,0,49,4,0]},{"op":49,"name":"actor_select","args":[65535,119,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":1780,"sections":[{"index":0,"offset":1782,"title":"收留呂布","body_off":1801,"body_end":5887,"conditions":[{"op":2,"name":"comment","args":["收留呂布"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":24,"name":"title_text","args":["引狼入室"]},{"op":48,"name":"actor_appear","args":[32,34,55,1,6]},{"op":48,"name":"actor_appear","args":[3,52,40,2,0]},{"op":48,"name":"actor_appear","args":[33,58,40,2,0]},{"op":48,"name":"actor_appear","args":[41,52,70,0,0]},{"op":48,"name":"actor_appear","args":[42,58,70,0,0]},{"op":48,"name":"actor_appear","args":[119,52,55,3,0]},{"op":48,"name":"actor_appear","args":[126,58,52,3,0]},{"op":48,"name":"actor_appear","args":[2,58,58,3,0]},{"op":23,"name":"place_name","args":["下邳"]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[61]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&刘备\n呂布將軍想投奔我們，\n真乃徐州之幸！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n哈哈，這是當然的啦！"]},{"op":51,"name":"actor_face","args":[119,17,2]},{"op":20,"name":"dialog","args":["&吕布\n你劉玄德在這個世界上敬畏的\n人，也只有我呂布而已！"]},{"op":51,"name":"actor_face","args":[119,3,1]},{"op":20,"name":"dialog","args":["&吕布\n有你的仁德搭配我的武勇，\n天下何愁不定！"]},{"op":51,"name":"actor_face","args":[119,17,0]},{"op":20,"name":"dialog","args":["&吕布\n到時候，天下就是你跟我兩個人的了！"]},{"op":51,"name":"actor_face","args":[119,3,3]},{"op":20,"name":"dialog","args":["&吕布\n如何？這條件還不壞吧？\n我們可以一起平分天下呀！"]},{"op":20,"name":"dialog","args":["&吕布\n所以，你絕對要收留我。\n不然你這輩子就別想統一天下了！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&刘备\n哈哈………"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&关羽\n(哼！)"]},{"op":20,"name":"dialog","args":["&张飞\n(呸！)"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[2,0,0]},{"op":20,"name":"dialog","args":["&张辽\n(奇怪，這裡怎麼有一股殺氣？)"]},{"op":51,"name":"actor_face","args":[2,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,6]},{"op":20,"name":"dialog","args":["&刘备\n對了，當初在徐州之戰，\n真多虧了呂布將軍偷襲了曹操的背後，\n化解了徐州的燃眉之急。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&刘备\n劉備不才，哪有治理徐州的本事。"]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n而呂布將軍名聞天下，武功蓋世。\n何不從此接管徐州，我倆攜手抗曹呢？"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n哈哈，劉賢弟真是說得太好了！\n既然你誠心誠意的拜託我了，\n那我就大發慈悲的接管徐州吧！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&刘备\n(什麼！？你還真敢拿呀！)"]},{"op":52,"name":"actor_action","args":[3,2]},{"op":52,"name":"actor_action","args":[33,2]},{"op":20,"name":"dialog","args":["&关羽\n(呂布！你敢！？)"]},{"op":20,"name":"dialog","args":["&张飞\n(三姓家奴！你敢！？)"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&吕布\n(咦？怎麼氣氛怪怪的？)"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n哈哈！主公只是開玩笑的啦！\n你們肯收留我們，我們已經很知足了，\n哪敢反客為主呢！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,2,1]},{"op":20,"name":"dialog","args":["&吕布\n(陳宮！你……)"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[126,0]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n(哼！)"]},{"op":52,"name":"actor_action","args":[33,0]},{"op":20,"name":"dialog","args":["&张飞\n(切！)"]},{"op":20,"name":"dialog","args":["&张辽\n…………………"]},{"op":20,"name":"dialog","args":["&刘备\n…………………"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[32,6]},{"op":51,"name":"actor_face","args":[119,0,3]},{"op":20,"name":"dialog","args":["&刘备\n哈哈，那麼這樣吧：\n小沛就給呂將軍做為駐軍之用，\n我們一同對抗曹操。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n那就多謝玄德大人了………"]},{"op":52,"name":"actor_action","args":[33,2]},{"op":20,"name":"dialog","args":["&张飞\n大哥，你可要想清楚呀！\n呂布是一個見利忘義的小人，\n你收留了他，根本就是養虎遺患呀！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,0]},{"op":51,"name":"actor_face","args":[126,0,0]},{"op":51,"name":"actor_face","args":[2,0,0]},{"op":51,"name":"actor_face","args":[119,2,0]},{"op":20,"name":"dialog","args":["&吕布\n你說什麼？\n好你個環眼賊！你是想死不成？"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n三弟，別說了！"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&张飞\n呂布！你一生叛人無數，根本沒有信用！\n或許你能騙得了丁原和董卓，\n可是絕對騙不了俺老張！"]},{"op":20,"name":"dialog","args":["&张飞\n你如果有種的話就發個毒誓保證不會\n背叛我們，怎樣？"]},{"op":20,"name":"dialog","args":["&吕布\n哼，這有何難？\n想要毒誓是吧？好呀！\n本大爺立刻發給你！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,0,0]},{"op":52,"name":"actor_action","args":[33,0]},{"op":52,"name":"actor_action","args":[32,0]},{"op":51,"name":"actor_face","args":[126,0,3]},{"op":51,"name":"actor_face","args":[2,0,3]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[119,0,3]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[119,0,2]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[119,0,1]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[119,0,0]},{"op":9,"name":"delay","args":[10]},{"op":36,"name":"play_sound","args":[180]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[119,17]},{"op":20,"name":"dialog","args":["&吕布\n我，無雙英雄呂奉先在此發誓：\n一定會與劉賢弟密切合作，絕不背叛！"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[119,3,3]},{"op":20,"name":"dialog","args":["&吕布\n如果有違此誓，那麼我爹會不得好死，\n我娘會被雷劈死。"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[119,17,2]},{"op":20,"name":"dialog","args":["&吕布\n陳宮會被亂刀分屍，\n張遼會被活活溺死。"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[119,3,1]},{"op":20,"name":"dialog","args":["&吕布\n高順會斷子絕孫，\n我的女兒會被凌遲處死！"]},{"op":9,"name":"delay","args":[8]},{"op":20,"name":"dialog","args":["&陈宫\n…………………"]},{"op":20,"name":"dialog","args":["&张辽\n…………………"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[33,2]},{"op":20,"name":"dialog","args":["&张飞\n切，都拿別人來發誓，\n算什麼英雄好漢！"]},{"op":52,"name":"actor_action","args":[3,9]},{"op":20,"name":"dialog","args":["&关羽\n三弟，別說了。我都無力吐槽了………"]},{"op":20,"name":"dialog","args":["&糜竺\n(什麼跟什麼呀！\n頭一次聽到這麼瞎的誓言。)"]},{"op":20,"name":"dialog","args":["&糜芳\n(太扯了！呂布真的太扯了！)"]},{"op":20,"name":"dialog","args":["&糜芳\n(這傢伙發的誓言裡倒楣的都是別人，\n這種人能相信嗎？)"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&刘备\n………………"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[3,0]},{"op":52,"name":"actor_action","args":[33,0]},{"op":52,"name":"actor_action","args":[32,17]},{"op":20,"name":"dialog","args":["&刘备\n哈哈，呂將軍的誓言真是鏗鏘有力，\n充滿了個性呀。您的真誠我們已經感\n受到了。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,3,3]},{"op":20,"name":"dialog","args":["&吕布\n哈哈，這還用你說？"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[33,12]},{"op":20,"name":"dialog","args":["&张飞\n(哼！)"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,0]},{"op":52,"name":"actor_action","args":[32,6]},{"op":20,"name":"dialog","args":["&刘备\n那麼，就請呂將軍先在小沛歇息，\n今後還請多多關照。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n好的，那麼我們先告辭了。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,0]},{"op":52,"name":"actor_action","args":[119,0]},{"op":51,"name":"actor_face","args":[126,0,1]},{"op":51,"name":"actor_face","args":[2,0,1]},{"op":50,"name":"actor_move","args":[65535,119,0,64,55,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n(哼！到手的鴨子居然飛了！)"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,126,0,92,52,1]},{"op":50,"name":"actor_move","args":[65535,119,0,98,55,1]},{"op":50,"name":"actor_move","args":[65535,2,0,92,58,1]},{"op":49,"name":"actor_select","args":[65535,119,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,126,0,98,52,1]},{"op":50,"name":"actor_move","args":[65535,2,0,98,58,1]},{"op":49,"name":"actor_select","args":[65535,2,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,126,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":22,"name":"info","args":["就這樣，劉備讓呂布在小沛屯兵抵禦\n曹操。然而，呂布前科累累，讓他駐\n守小沛真的是正確的選擇嗎？"]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":5887,"sections":[{"index":0,"offset":5889,"title":"二虎競食","body_off":5908,"body_end":7092,"conditions":[{"op":2,"name":"comment","args":["二虎競食"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,0]},{"op":36,"name":"play_sound","args":[43]},{"op":39,"name":"change_scene","args":[2,65535,65535,7,65535]},{"op":48,"name":"actor_appear","args":[0,52,28,2,0]},{"op":48,"name":"actor_appear","args":[20,38,50,1,0]},{"op":48,"name":"actor_appear","args":[22,38,58,1,0]},{"op":48,"name":"actor_appear","args":[21,38,68,1,0]},{"op":48,"name":"actor_appear","args":[25,38,76,1,0]},{"op":48,"name":"actor_appear","args":[1,67,50,3,0]},{"op":48,"name":"actor_appear","args":[5,67,58,3,0]},{"op":48,"name":"actor_appear","args":[6,67,68,3,0]},{"op":48,"name":"actor_appear","args":[12,67,76,3,0]},{"op":24,"name":"title_text","args":["二虎競食"]},{"op":23,"name":"place_name","args":["许昌  曹操官邸"]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[25,6,0]},{"op":20,"name":"dialog","args":["&满宠\n主公，刘备現在屯兵徐州，\n又有吕布為他看守小沛，\n他們遲早會成為我軍心腹大患的。"]},{"op":51,"name":"actor_face","args":[25,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,6]},{"op":20,"name":"dialog","args":["&夏侯惇\n孟德！我願意借精兵五万，\n保證斬下劉備和呂布的人頭來給你！"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n哈哈，夏侯惇將軍勇則勇矣，\n但是不知用謀。"]},{"op":20,"name":"dialog","args":["&荀彧\n我倒有一計，\n可以讓我們不費一兵一卒的\n讓劉備和呂布反目成仇。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n喔？文若但說無妨。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[20,0]},{"op":20,"name":"dialog","args":["&荀彧\n劉備現在雖然據有徐州，\n但是未得詔命。"]},{"op":20,"name":"dialog","args":["&荀彧\n主公可以奏請詔命讓\n劉備成為徐州太守，\n並且要他誅殺呂布。\n&荀彧\n如果此計成功，我們便可除掉呂布。\n如果不成，呂布必定會怒殺劉備，\n這就是「二虎競食」之計也。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n文若言之有理。\n主公還可密令細作散佈這則消息，\n無論劉備是否動手，呂布必定生疑。"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":20,"name":"dialog","args":["&曹操\n文若此計甚妙，\n可依計行事！"]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[10]},{"op":36,"name":"play_sound","args":[255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":7092,"sections":[{"index":0,"offset":7094,"title":"二虎競食2","body_off":7114,"body_end":10052,"conditions":[{"op":2,"name":"comment","args":["二虎競食2"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,36,65535]},{"op":48,"name":"actor_appear","args":[32,52,70,2,0]},{"op":48,"name":"actor_appear","args":[33,42,68,1,0]},{"op":48,"name":"actor_appear","args":[3,62,68,3,0]},{"op":24,"name":"title_text","args":["二虎競食"]},{"op":23,"name":"place_name","args":["下邳  州牧府"]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[61]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&刘备\n唔……曹操居然要我們誅殺呂布？"]},{"op":52,"name":"actor_action","args":[33,3]},{"op":20,"name":"dialog","args":["&张飞\n吕布本來就是個無義的小人，\n我們何不就殺了他，以絕後患？"]},{"op":52,"name":"actor_action","args":[33,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&关羽\n張飛言之有理，\n可是這事不能輕率決定。"]},{"op":20,"name":"dialog","args":["&关羽\n在我看來，這恐怕是曹操的詭計，\n他根本就是想借刀殺人，\n讓我們來為他除掉呂布。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[33,2]},{"op":20,"name":"dialog","args":["&张飞\n那又怎樣？\n信上寫的也沒錯，呂布的見利忘義\n早已是天下皆知了！"]},{"op":20,"name":"dialog","args":["&张飞\n如果咱們再繼續收留這種無恥小人，\n將來一定會後悔的！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[32,0,3]},{"op":20,"name":"dialog","args":["&刘备\n張飛，不得造次！\n二弟言之有理。這肯定是曹操的陰謀，\n我們不能輕易上當。"]},{"op":51,"name":"actor_face","args":[32,0,0]},{"op":20,"name":"dialog","args":["&刘备\n曹孟德擔憂我們和吕布合作，\n所以才想讓我們為了利益自相殘殺。\n如果我們照辦，正中他的下懷！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[33,0]},{"op":20,"name":"dialog","args":["&张飞\n哎，只怕哥哥好人难做。\n你對呂布好，他反而還覺得\n你好欺負呢！\n&关羽\n此时杀吕布，\n的確不是大丈夫所為。\n只是那使者，該如何應付？"]},{"op":20,"name":"dialog","args":["&刘备\n………………"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[0,32,0,52,60,0]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[32,3,2]},{"op":20,"name":"dialog","args":["&刘备\n這樣吧，我就跟他說最近的黃巾\n餘黨又來搗亂，暫時無法執行任務，\n請再給我一點時間。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&关羽\n不错，\n正所谓缓兵之计也。"]},{"op":20,"name":"dialog","args":["&张飞\n嗨，這次又放過那三姓家奴！\n肯定後患無窮！"]},{"op":20,"name":"dialog","args":["&刘备\n別說了。正所謂唇亡齒寒，\n我們怎能和呂布自相殘殺。\n&刘备\n至於吕布之事，三弟休要再提！\n&张飞\n……是。\n&刘备\n等一下呂布過來的話，\n我就把曹操的信拿給他看，\n以解其心中之惑。"]},{"op":9,"name":"delay","args":[10]},{"op":48,"name":"actor_appear","args":[119,52,98,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&吕布\n賢弟！"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[0,119,0,52,70,0]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n賢弟！聽說曹操給你寫了封信，\n是不是真的？"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,6]},{"op":20,"name":"dialog","args":["&刘备\n是的，他還勸我把你殺了。\n你瞧，這封信在這呢。"]},{"op":20,"name":"dialog","args":["&吕布\n什麼？"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,0]},{"op":50,"name":"actor_move","args":[0,32,0,52,65,2]},{"op":52,"name":"actor_action","args":[32,0]},{"op":52,"name":"actor_action","args":[119,0]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&吕布\n唔唔唔………"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n這個該死的老賊，\n居然想要謀害我！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,6]},{"op":20,"name":"dialog","args":["&刘备\n是啊，這都是曹操的陰謀，\n我們可不能上當。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n哈哈，賢弟說的是。\n咱們哥倆可是情比金堅，他休想破壞！"]},{"op":20,"name":"dialog","args":["&吕布\n今後咱哥倆也要互相幫助。\n這次你幫我，下次我讓你幫！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[33,2]},{"op":20,"name":"dialog","args":["&张飞\n三姓家奴，你也夠了吧！\n什麼“賢弟”、“賢弟”的，\n俺的大哥是能讓你隨便叫的嗎！？"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,0]},{"op":51,"name":"actor_face","args":[119,0,3]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n環眼賊！你………"]},{"op":20,"name":"dialog","args":["&张飞\n怎麼？想打架嗎？\n好啊，俺奉陪到底！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[32,0,3]},{"op":52,"name":"actor_action","args":[32,2]},{"op":20,"name":"dialog","args":["&刘备\n三弟，不可造次！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[33,0]},{"op":20,"name":"dialog","args":["&张飞\n大哥………"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[32,6,2]},{"op":20,"name":"dialog","args":["&刘备\n呂將軍就先離開吧，\n我會管教三弟的。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,0]},{"op":51,"name":"actor_face","args":[119,17,0]},{"op":20,"name":"dialog","args":["&吕布\n哈哈，那就有勞賢弟了。\n咱們合作愉快！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,0,2]},{"op":50,"name":"actor_move","args":[0,119,0,52,90,2]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&吕布\n(想不到劉備這麼相信我，\n他還真是一個好人。)"]},{"op":20,"name":"dialog","args":["&吕布\n(如此說來，如果我現在就發兵徐州，\n應該可以很輕易的得手吧？)"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[0,119,0,52,98,2]},{"op":49,"name":"actor_select","args":[65535,119,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[32,0,2]},{"op":20,"name":"dialog","args":["&刘备\n………………"]},{"op":20,"name":"dialog","args":["&关羽\n………………"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[33,2]},{"op":20,"name":"dialog","args":["&张飞\n大哥！二哥！\n你們不會真的以為那個三姓家奴\n會跟咱們講義氣吧？"]},{"op":9,"name":"delay","args":[10]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":5,"offset":10052,"sections":[{"index":0,"offset":10054,"title":"驱虎吞狼","body_off":10073,"body_end":12005,"conditions":[{"op":2,"name":"comment","args":["驱虎吞狼"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[43]},{"op":39,"name":"change_scene","args":[2,65535,65535,45,65535]},{"op":48,"name":"actor_appear","args":[0,52,34,2,0]},{"op":48,"name":"actor_appear","args":[20,38,51,1,0]},{"op":48,"name":"actor_appear","args":[22,38,59,1,0]},{"op":48,"name":"actor_appear","args":[25,38,72,1,0]},{"op":48,"name":"actor_appear","args":[24,67,51,3,0]},{"op":48,"name":"actor_appear","args":[21,67,59,3,0]},{"op":48,"name":"actor_appear","args":[18,67,72,3,0]},{"op":48,"name":"actor_appear","args":[192,52,55,0,6]},{"op":24,"name":"title_text","args":["驅虎吞狼"]},{"op":23,"name":"place_name","args":["许昌  曹操官邸"]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n劉備既領州牧一職，\n那誘殺吕布一事如何？\n&文官01\n秉告主公，劉備說請再給他一點時間。\n&曹操\n果然不出我所料，\n他始終是狠不下心啊。"]},{"op":20,"name":"dialog","args":["&曹操\n然而，即使他想對呂布施恩，\n呂布也必定會心懷不軌，"]},{"op":20,"name":"dialog","args":["&曹操\n總有一天，劉備會因為今日的\n優柔寡斷而後悔的。"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&文官01\n那麼属下告退。"]},{"op":20,"name":"dialog","args":["&曹操\n嗯，下去吧。"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[0,192,0,52,96,2]},{"op":49,"name":"actor_select","args":[0,192,0,0,0,0,6]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n看來咱們的「二虎競食」之計\n並沒有成功，諸位還有什麼辦法嗎？"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n秉告主公，我又有一計，\n名曰「驅虎吞狼」之計。\n&曹操\n驅虎吞狼之計？"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&荀彧\n主公可以暗中跟袁術說劉備\n打算進攻淮南，袁術得知後，\n一定會怒攻劉備。"]},{"op":20,"name":"dialog","args":["&荀彧\n那時主公再命令劉備出兵討伐袁術，\n他在徐州的兵力就會變得薄弱。\n&荀彧\n在雙方戰得如火如荼的時候，\n呂布必定會產生背叛劉備的野心。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&程昱\n哈哈，劉備雖然有膽略，\n但是呂布、袁術都是見利忘義之人，\n文若此計可成！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[25,0,0]},{"op":20,"name":"dialog","args":["&满宠\n自從陶谦死后，袁術一直想要吞併徐州。\n現在劉備卻坐享其成，袁術早已不滿了。"]},{"op":20,"name":"dialog","args":["&满宠\n只要我們搧風點火，\n他一定會發兵徐州的。"]},{"op":51,"name":"actor_face","args":[25,0,1]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[18,0,0]},{"op":20,"name":"dialog","args":["&刘晔\n刘备、吕布既然可以合力對抗我們，\n未嘗不會一同對付袁術。\n&刘晔\n必须令此二人暂时分开，\n方可成功。"]},{"op":51,"name":"actor_face","args":[18,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n這事很容易解決，泰山的山賊反覆無常，\n主公可以收買他們繼續搗亂，\n劉備必定會派呂布去平定山賊。"]},{"op":20,"name":"dialog","args":["&郭嘉\n這時主公再使文若之計，\n劉備就不得不獨自出兵禦敵了！"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[24,6]},{"op":20,"name":"dialog","args":["&荀攸\n此計無論最後結果如何，\n袁、劉、呂三人必然損兵折將，\n對我們大大有利。"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":9,"name":"delay","args":[3]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n哈哈，諸位所言正合我意，\n我倒要看看劉備這次如何應付！"]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[10]},{"op":36,"name":"play_sound","args":[255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":6,"offset":12005,"sections":[{"index":0,"offset":12007,"title":"袁術","body_off":12022,"body_end":13344,"conditions":[{"op":2,"name":"comment","args":["袁術"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,0]},{"op":1,"name":"if","args":[],"off":12032,"cond":{"op":2,"name":"comment","args":["過場CG"]},"end":15,"end_off":12317},{"op":36,"name":"play_sound","args":[52]},{"op":39,"name":"change_scene","args":[2,65535,65535,52,65535]},{"op":39,"name":"change_scene","args":[0,148,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[10]},{"op":22,"name":"info","args":["袁術自從得到玉璽之後，便自封為帝，\n過著奢侈糜爛的生活。"]},{"op":22,"name":"info","args":["在曹操的煽動下，袁術對劉備不滿激增，\n終於決定要正式與劉備開戰。"]},{"op":22,"name":"info","args":["這場袁術、劉備，甚至是與曹操之間\n的戰爭，究竟會鹿死誰手？"]},{"op":9,"name":"delay","args":[10]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,9,65535]},{"op":48,"name":"actor_appear","args":[136,32,53,1,0]},{"op":48,"name":"actor_appear","args":[192,50,40,2,0]},{"op":48,"name":"actor_appear","args":[193,58,40,2,0]},{"op":48,"name":"actor_appear","args":[194,66,40,2,0]},{"op":48,"name":"actor_appear","args":[848,50,70,0,0]},{"op":48,"name":"actor_appear","args":[181,58,70,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[61]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["淮南"]},{"op":52,"name":"actor_action","args":[136,2]},{"op":20,"name":"dialog","args":["&袁术\n哼，劉備那個編蓆小兒。\n居然想奪我城池！"]},{"op":20,"name":"dialog","args":["&袁术\n紀靈！立刻準備發兵徐州，\n一定要給這個編草蓆的窮鬼\n一點顏色瞧瞧！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[848,0,3]},{"op":52,"name":"actor_action","args":[848,6]},{"op":20,"name":"dialog","args":["&纪灵\n是！"]},{"op":51,"name":"actor_face","args":[848,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[193,6]},{"op":20,"name":"dialog","args":["&文官02\n陛下，劉備可不是省油的燈。\n雖然敵寡我眾，貿然進軍肯定\n會損失慘重啊。"]},{"op":52,"name":"actor_action","args":[193,0]},{"op":52,"name":"actor_action","args":[136,0]},{"op":20,"name":"dialog","args":["&袁术\n嗯，那倒是。"]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n有誰有辦法增加我軍的勝算的嗎？"]},{"op":9,"name":"delay","args":[10]},{"op":52,"name":"actor_action","args":[192,3]},{"op":20,"name":"dialog","args":["&文官01\n有。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[136,0]},{"op":20,"name":"dialog","args":["&袁术\n喔？那你快說呀！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[192,6]},{"op":20,"name":"dialog","args":["&文官01\n我的辦法就是讓呂布背叛劉備！"]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n喔？"]},{"op":52,"name":"actor_action","args":[136,0]},{"op":20,"name":"dialog","args":["&文官01\n呂布一向見利忘義，\n其實他早有吞併徐州的野心。"]},{"op":20,"name":"dialog","args":["&文官01\n陛下可修書一封，\n答應用錢糧收買他，"]},{"op":20,"name":"dialog","args":["&文官01\n他一定會產生背叛劉備的想法，\n然後趁著徐州空虛的時候搶奪\n劉備的地盤的！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n哈哈，妙計！\n編蓆小兒，這下你死定了！"]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":7,"offset":13344,"sections":[{"index":0,"offset":13346,"title":"天下大势","body_off":13365,"body_end":13682,"conditions":[{"op":2,"name":"comment","args":["天下大势"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[52]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":39,"name":"change_scene","args":[0,19,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["就这样，驱虎吞狼之计以袁术抢先发兵进攻徐州而拉开了序幕，",0,0,1]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["刘备迫于其军事压力，加之天子明诏的道义责任不得不奋起自卫，",1,1,1]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["临行前，他把徐州的防务交给了张飞，袁刘两军相持于盱眙……",1,1,1]},{"op":9,"name":"delay","args":[5]},{"op":36,"name":"play_sound","args":[255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":8,"offset":13682,"sections":[{"index":0,"offset":13684,"title":"呂布背叛","body_off":13703,"body_end":18835,"conditions":[{"op":2,"name":"comment","args":["呂布背叛"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[64]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[0,35,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["小沛"]},{"op":9,"name":"delay","args":[5]},{"op":22,"name":"info","args":["袁術的信很快就送到呂布手上，\n袁術在信上不光答應要給呂布豐\n厚的獎賞，更要求呂布趁著徐州\n空虛時背叛劉備。"]},{"op":9,"name":"delay","args":[5]},{"op":22,"name":"info","args":["呂布看著袁術開出的條件，\n又看著唾手可得的徐州，\n他馬上就陷入了沉思……"]},{"op":9,"name":"delay","args":[5]},{"op":22,"name":"info","args":["利益、道義，哪個更重要呢？\n面對眼前的誘惑，\n呂布又會做何選擇？"]},{"op":9,"name":"delay","args":[5]},{"op":29,"name":"fade_in","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,0,65535]},{"op":48,"name":"actor_appear","args":[119,40,54,3,0]},{"op":48,"name":"actor_appear","args":[2,60,44,2,0]},{"op":48,"name":"actor_appear","args":[122,68,44,2,0]},{"op":48,"name":"actor_appear","args":[123,76,44,2,0]},{"op":48,"name":"actor_appear","args":[126,60,64,0,0]},{"op":48,"name":"actor_appear","args":[120,68,64,0,0]},{"op":48,"name":"actor_appear","args":[121,76,64,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[183]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["小沛   呂布府"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[126,6,3]},{"op":20,"name":"dialog","args":["&陈宫\n主公，刘备和关羽都出征了。\n眼下徐州空虚，伺机进攻如何？"]},{"op":20,"name":"dialog","args":["&吕布\n………………"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n哼，負責留守的人是張飛，\n他可不好惹………"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[2,0,3]},{"op":20,"name":"dialog","args":["&张辽\n！！！！！！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[2,6]},{"op":20,"name":"dialog","args":["&张辽\n主公！劉備對我們有收留之恩，\n我們怎麼可以搶奪他的地盤？"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":52,"name":"actor_action","args":[126,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&魏续\n他對我們有收留之恩又怎樣？\n這是我們該對他手下留情的理由嗎？"]},{"op":20,"name":"dialog","args":["&宋宪\n就是說啊。\n這可是亂世，做什麼都是合理的。\n我們本來就該為了生存而不擇手段。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[2,17,2]},{"op":20,"name":"dialog","args":["&张辽\n就算是在亂世，\n我們也不該恩將仇報呀！"]},{"op":20,"name":"dialog","args":["&张辽\n在我們無家可歸的時候，\n是劉備力排眾議的收留了我們，\n出賣他未免太過分了！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[126,0,0]},{"op":20,"name":"dialog","args":["&陈宫\n張將軍這麼說就太天真了，\n劉備根本不是我們應該效忠\n的對象。"]},{"op":52,"name":"actor_action","args":[2,0]},{"op":20,"name":"dialog","args":["&张辽\n啊？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[126,0,2]},{"op":20,"name":"dialog","args":["&陈宫\n劉備此人胸無大志，\n更無與曹操堅決對抗的決心。"]},{"op":20,"name":"dialog","args":["&陈宫\n不敢堅決對抗曹操的人，\n就是曹操的同路人，\n根本不值得同情！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[2,17]},{"op":20,"name":"dialog","args":["&张辽\n陳宮大人！\n難道在你眼裡只有對抗曹操才是正確的，\n其他人都是可以出賣的對象嗎？"]},{"op":20,"name":"dialog","args":["&张辽\n你如果連恩人都出賣了，\n那你和你厭惡的曹操有什麼分別？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[126,0,0]},{"op":20,"name":"dialog","args":["&陈宫\n當然有分別！曹操是萬惡之首，\n唯有對抗他才稱得上是正義！"]},{"op":20,"name":"dialog","args":["&陈宫\n只要能夠打倒曹操，\n不管要我做什麼都在所不辭！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[2,0]},{"op":20,"name":"dialog","args":["&张辽\n你……"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[126,6,3]},{"op":20,"name":"dialog","args":["&陈宫\n主公！\n曹豹剛才已經通知我們張飛喝醉了，\n今天是我們動手的最好機會！"]},{"op":20,"name":"dialog","args":["&陈宫\n若是主公再猶豫不決，\n最好的時機就會錯過了！"]},{"op":51,"name":"actor_face","args":[119,0,1]},{"op":20,"name":"dialog","args":["&吕布\n什麼？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,3,1]},{"op":20,"name":"dialog","args":["&吕布\n真是的，你怎麼不早說呢？\n咱們今晚就動手，一定要奪取徐州！"]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[2,0,3]},{"op":20,"name":"dialog","args":["&张辽\n主公！"]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[126,0,3]},{"op":51,"name":"actor_face","args":[119,17,1]},{"op":20,"name":"dialog","args":["&吕布\n別說了，現在你們立刻做好\n夜襲的準備！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[120,0,3]},{"op":51,"name":"actor_face","args":[121,0,3]},{"op":51,"name":"actor_face","args":[122,0,3]},{"op":51,"name":"actor_face","args":[123,0,3]},{"op":20,"name":"dialog","args":["&侯成\n是！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[2,6,3]},{"op":20,"name":"dialog","args":["&张辽\n主公！劉備對我們有收留大恩，\n就連我們現在居住的小沛，\n都是他借給我們的啊！"]},{"op":20,"name":"dialog","args":["&张辽\n我們不還他恩情便罷，\n如果連他的地盤都搶，\n那就太過分了！"]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n小沛是他借給我們的又怎樣？\n本大爺憑真本事借來的東西，\n為什麼要還？"]},{"op":20,"name":"dialog","args":["&吕布\n更何況本大爺向來叛人無數，\n罔顧道義二字，如果對劉備死心踏地，\n那對其他人公平嗎？"]},{"op":52,"name":"actor_action","args":[2,0]},{"op":20,"name":"dialog","args":["&张辽\n啊？"]},{"op":20,"name":"dialog","args":["&吕布\n如果劉備是真心把我當盟友，\n那麼就算我背叛他，他也會體諒我，\n認同我，支持我，不會有任何怨言；"]},{"op":20,"name":"dialog","args":["&吕布\n如果他覺得我做得不對，就說明他\n不是真心待我，他在乎的不是交情，\n而是利益，那我更沒必要對他客氣！"]},{"op":20,"name":"dialog","args":["&张辽\n這……\n（這說的是人話嗎？）"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[2,6]},{"op":20,"name":"dialog","args":["&张辽\n可是劉備是那樣的信任我們，\n我們怎麼能……"]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n呸！他信任我們又怎樣？\n就是因為他信任我們才更容易得手，\n難道你能欺騙得了不相信你的人嗎？"]},{"op":20,"name":"dialog","args":["&吕布\n再說了，是他自己笨到相信本大爺的，\n他能怪誰？當然是他自己的問題嘛！"]},{"op":52,"name":"actor_action","args":[2,17]},{"op":20,"name":"dialog","args":["&张辽\n啊？？？？？"]},{"op":51,"name":"actor_face","args":[119,2,2]},{"op":20,"name":"dialog","args":["&吕布\n這是亂世，做什麼都是合理的！\n既然劉備要相信我，他就該為\n自己的選擇負責，怨不得別人！"]},{"op":20,"name":"dialog","args":["&吕布\n如果不是他的錯，\n難道還會是我的錯啊！？"]},{"op":52,"name":"actor_action","args":[2,0]},{"op":20,"name":"dialog","args":["&张辽\n……………………"]},{"op":20,"name":"dialog","args":["&吕布\n說來說去，這都要怪那個大耳賊不好！"]},{"op":51,"name":"actor_face","args":[119,2,1]},{"op":20,"name":"dialog","args":["&吕布\n既然他都決定收留本大爺了，\n他為什麼就不順應天意，\n把整個徐州讓給我呢？"]},{"op":20,"name":"dialog","args":["&吕布\n那個沒心沒肺的垃圾，\n居然還想要本大爺當他的手下，作夢！"]},{"op":20,"name":"dialog","args":["&吕布\n他以為他是誰啊？他對我施恩我就要\n對他報恩嗎？老子才沒那麼膚淺呢！"]},{"op":20,"name":"dialog","args":["&吕布\n說白了，他對我施恩不是因為他仁義，\n而是他想藉機當好人，滿足自己的情緒\n價值，這是在利用我，汙辱我！"]},{"op":20,"name":"dialog","args":["&吕布\n對本大爺來說，對我施恩就等同是汙辱！\n汙辱我呂布的人，我一定會叫他終身後悔！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[119,17,1]},{"op":20,"name":"dialog","args":["&吕布\n準備出征！"]},{"op":51,"name":"actor_face","args":[2,0,2]},{"op":51,"name":"actor_face","args":[126,0,0]},{"op":51,"name":"actor_face","args":[120,0,0]},{"op":51,"name":"actor_face","args":[121,0,0]},{"op":51,"name":"actor_face","args":[122,0,2]},{"op":51,"name":"actor_face","args":[123,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,0]},{"op":50,"name":"actor_move","args":[65535,119,0,40,60,2]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,119,0,52,60,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,119,0,52,54,1]},{"op":9,"name":"delay","args":[0]},