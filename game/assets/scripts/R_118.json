]},{"op":20,"name":"dialog","args":["&春霄\n那小子有種特別的魔力，\n讓人很期待他接下來的命運。"]},{"op":20,"name":"dialog","args":["&春霄\n到底他還能有什麼樣的表現呢？\n連我都開始期待了——即使這樣可能\n會讓我輸掉賭局。"]},{"op":52,"name":"actor_action","args":[157,3]},{"op":20,"name":"dialog","args":["&许子将\n哈哈哈哈哈哈！"]},{"op":9,"name":"delay","args":[5]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,88,65535]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["資料讀取中，",1,0,1]},{"op":9,"name":"delay","args":[3]},{"op":44,"name":"caption","args":["請稍後。",1,0,1]},{"op":9,"name":"delay","args":[5]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":4168,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":304,"end_off":6350},{"op":56,"name":"set_attr","args":[820,15,0,198]},{"op":56,"name":"set_attr","args":[821,15,0,512]},{"op":53,"name":"set_r_image","args":[820,194]},{"op":53,"name":"set_r_image","args":[821,197]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":11,"name":"set_flag","args":[248,0]},{"op":36,"name":"play_sound","args":[113]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,0]},{"op":39,"name":"change_scene","args":[2,65535,65535,69,65535]},{"op":48,"name":"actor_appear","args":[34,53,34,2,9]},{"op":48,"name":"actor_appear","args":[157,48,34,1,0]},{"op":48,"name":"actor_appear","args":[708,48,40,0,0]},{"op":48,"name":"actor_appear","args":[706,53,40,0,0]},{"op":48,"name":"actor_appear","args":[707,58,40,0,0]},{"op":1,"name":"if","args":[],"off":4442,"cond":{"op":5,"name":"test_flags","args":[[1712,1713],[]]},"end":221,"end_off":4566},{"op":48,"name":"actor_appear","args":[46,51,45,0,0]},{"op":48,"name":"actor_appear","args":[705,55,45,0,0]},{"op":48,"name":"actor_appear","args":[820,51,53,0,0]},{"op":48,"name":"actor_appear","args":[821,55,53,0,0]},{"op":0,"name":"end","args":[]},{"op"