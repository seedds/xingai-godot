]},"end":12,"end_off":457},{"op":48,"name":"actor_appear","args":[22,64,58,3,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":457,"cond":{"op":5,"name":"test_flags","args":[[1315],[]]},"end":15,"end_off":501},{"op":48,"name":"actor_appear","args":[19,64,58,3,0]},{"op":0,"name":"end","args":[]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["五丈原  曹操军主营"]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[23,54,22,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n主公，贾诩回来了。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,23,0,54,52,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[23,0,3]},{"op":20,"name":"dialog","args":["&贾诩\n……哦，貂蝉姑娘！\n你已经回来了是吗？"]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n是的。"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n喔，贾诩，辛苦你了。\n一切原委我已经听貂蝉说过了。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[23,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n是。那么是否即刻出兵歼灭孔明……？"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n嗯。\n如今既然得知魔王不会复活，\n孔明也不足为惧了！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n主公还是不能大意啊。\n&贾诩\n其实属下在长安已经找到一些文献，\n记载着有关魔王复活之前的能力。\n&贾诩\n文献指出除了木人与土偶之外，\n魔王尚可于特定场所操纵死者。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":1239,"cond":{"op":5,"name":"test_flags","args":[[1320],[]]},"end":54,"end_off":1387},{"op":20,"name":"dialog","args":["&郭嘉\n操纵死者？我也听说过，\n但是由于目前魔王法力不足，\n所操纵的死着是不能见阳光的。\n&郭嘉\n除非……是在一个见不到阳光的地方。"]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n不论魔王有多厉害，\n我们都得消灭他。\n众将士准备出发！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":50,"name":"actor_move","args":[65535,23,0,64,52,3]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,15,0,0,0,0,0,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,15,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,15,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,15,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":1718,"sections":[{"index":0,"offset":1720,"title":"玩家切换","body_off":1741,"body_end":1828,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹操\n出战！"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":1828,"title":"玩家切换","body_off":1853,"body_end":1906,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[20]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀彧\n战场还是隔着长江而战的形势。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":1906,"title":"玩家切换","body_off":1931,"body_end":2073,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[19]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&司马懿\n（那个祭坛还是令人放心不下，\n究竟有何用途呢……）\n&司马懿\n（也罢，此事暂且搁置一旁吧。\n必须集中精力应付这场战斗。）"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":2073,"title":"玩家切换","body_off":2098,"body_end":2170,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[23]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&贾诩\n刚才细作传来军情，\n东吴营中不见周瑜和陆逊踪影。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":2170,"title":"玩家切换","body_off":2195,"body_end":2272,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n不能给吴军有时间准备，\n一鼓作气进攻吧。\n&曹操\n嗯。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":2272,"title":"玩家切换","body_off":2297,"body_end":2359,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[3]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&关羽\n关某无碍于水战或陆战。\n只求全力杀敌。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":2359,"title":"玩家切换","body_off":2384,"body_end":2707,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n对了许褚，诗作好了吗？\n&许褚\n唉？\n&夏侯惇\n什么唉啊、哦的。\n孟德应该教你不少了吧？\n到底作了哪些啦？\n&许褚\n……我已经放弃了。\n&夏侯惇\n放弃？为什么嘛？\n&许褚\n理由……我不想说。\n&夏侯惇\n噢，原来是这样……\n反正我大概也猜得到。\n&许褚\n哼，我才不会放在心上呢。\n反正我生来就是块打仗的料。\n&曹操\n唷唷唷……"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}