 "entry_index": {
  "function": "Ekd5.exe 0x43fc48(unit)",
  "rule": "g = graphic_id(person); if g < 0x50: entry = g*3 + min(unit byte +5, 2) else entry = g + 0xa0",
  "unit.side": "unit byte +5 selects the colour variant of the 80 class graphics: entry g*3+0/1/2 (which army gets which value: battle code)",
  "graphic_id": [
   "Ekd5.exe 0x40685c(person) -> 0x4068a1(pid): pid = word person+0 & 0xfff (0x482715); class = person byte +0x2b (0x406610); tier = class % 3",
   "v = u16 S_table[pid] (VA 0x501000, 1024 entries; saved with the game state; script-settable)",
   "v == 0 (or pid >= 0x400) -> g = class",
   "1 <= v <= 0x20 -> g = 0x50 + 3*(v-1) + tier   (32 three-tier graphics, System.ini Three=32)",
   "v >= 0x21 -> g = v + 0x8f"
  ],
  "entry_ranges": "0..239: 80 classes x 3 colours; 240..335: 32 three-tier graphics x 3 tiers (v 1..32); 336..716: single graphics (v 33..413)",
  "s_table_initial": {
