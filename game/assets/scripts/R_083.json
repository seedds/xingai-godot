},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[845,3]},{"op":20,"name":"dialog","args":["&孙尚香\n你說什麼？母親病倒了？"]},{"op":20,"name":"dialog","args":["&周善\n是的。國太現在的病情十分危急，\n怕是撐不了多久了。"]},{"op":52,"name":"actor_action","args":[845,4]},{"op":20,"name":"dialog","args":["&孙尚香\n這還得了？我得快點趕回去！"]},{"op":51,"name":"actor_face","args":[845,0,3]},{"op":52,"name":"actor_action","args":[845,2]},{"op":20,"name":"dialog","args":["&孙尚香\n事不宜遲！你們快點去收拾東西，\n我要火速趕回江東！"]},{"op":20,"name":"dialog","args":["&女兵1\n是，郡主。"]},{"op":20,"name":"dialog","args":["&孙尚香\n另外，你們趕快去跟皇叔通報此事。\n我要有他的許可才能離開……\n"]},{"op":20,"name":"dialog","args":["&女兵2\n是，遵命。"]},{"op":20,"name":"dialog","args":["&周善\n怕是來不及了，\n郡主您還是先跟我們走吧。"]},{"op":51,"name":"actor_face","args":[845,0,1]},{"op":20,"name":"dialog","args":["&周善\n另外，國太說她很想見見阿斗。\n郡主您就帶著阿斗一起同行吧。"]},{"op":52,"name":"actor_action","args":[845,7]},{"op":20,"name":"dialog","args":["&孙尚香\n啊？這……"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[845,3]},{"op":20,"name":"dialog","args":["&孙尚香\n也罷，阿斗是我的兒子，\n我有權利這麼做！準備出發！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[846,0,1]},{"op":20,"name":"dialog","args":["&周善\n(嘻嘻。)"]},{"op":52,"name":"actor_action","args":[845,0]},{"op":36,"name":"play_sound","args":[15]},{"op":9,"name":"delay","args":[3]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,2,1,0,0,0,0,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":1437,"sections":[{"index":0,"offset":1439,"title":"玩家切换","body_off":1460,"body_end":1650,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[845,2]},{"op":20,"name":"dialog","args":["&孙尚香\n出发，我必须赶回去见\n我母亲最后一面！\n&周善\n(嘿嘿，主公的计画成功了。\n这下可以用阿斗换回荆州了。)"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":1650,"title":"玩家切换","body_off":1675,"body_end":1924,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[845]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n跳過本關嗎？"]},{"op":1,"name":"if","args":[],"off":1706,"cond":{"op":18,"name":"choice","args":["跳過本關\n不跳過",845]},"end":17,"end_off":1916},{"op":1,"name":"if","args":[],"off":1734,"cond":{"op":19,"name":"test_choice","args":[1]},"end":13,"end_off":1869},{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n好的，那麼就跳過本關。"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,255]},{"op":17,"name":"goto_scenario","args":[167]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1869,"cond":{"op":19,"name":"test_choice","args":[2]},"end":16,"end_off":1914},{"op":20,"name":"dialog","args":["&许子将\n呵呵，明智的選擇。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":1924,"title":"玩家切换","body_off":1949,"body_end":2288,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[846]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[846,0,1]},{"op":20,"name":"dialog","args":["&孙尚香\n周善，我的母親的身體一向很硬朗，\n她到底是生了什麼樣的病呢？"]},{"op":51,"name":"actor_face","args":[846,0,3]},{"op":20,"name":"dialog","args":["&周善\n啊？這個…在下也說不清楚，\n反正很嚴重就是了。\n郡主還是趕快去探望國太吧！"]},{"op":20,"name":"dialog","args":["&孙尚香\n唉，娘親…你一定要等我！\n我馬上就去看您了！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[846,0,1]},{"op":20,"name":"dialog","args":["&周善\n(絕不能讓郡主看出來。\n這次的計畫只准成功，不准失敗！)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":2288,"title":"玩家切换","body_off":2313,"body_end":2419,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[518]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[845,0,1]},{"op":20,"name":"dialog","args":["&女兵1\n(是我的錯覺嗎？\n我怎麼覺得周善大人怪怪的？\n希望不要徒生事端才好。)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":2419,"title":"玩家切换","body_off":2444,"body_end":2655,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[519]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[845,0,1]},{"op":20,"name":"dialog","args":["&女兵2\n郡主，我們要不要等皇叔回來了\n再去探望國太呢？"]},{"op":51,"name":"actor_face","args":[845,0,3]},{"op":20,"name":"dialog","args":["&孙尚香\n我的母親並得很重，恐怕是來不及了。\n我就先去探望她，以後再跟皇叔報告。"]},{"op":20,"name":"dialog","args":["&女兵2\n是。"]},{"op":51,"name":"actor_face","args":[845,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}