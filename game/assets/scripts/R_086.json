"op":45,"name":"test_clicked","args":[123]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&侯成\n我的裝備是飛刀，\n所以我的攻擊範圍很大喔。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":11399,"title":"玩家切换","body_off":11424,"body_end":11521,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[122]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&高顺\n我的兵種是“陷陣營”，\n攻擊力和防禦力都很傑出，\n就是敏捷和精神力弱了些。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":11521,"title":"玩家切换","body_off":11546,"body_end":11612,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[121]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&宋宪\n為什麼我軍沒有砲車部隊呢？\n真是太可惜了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":11612,"title":"玩家切换","body_off":11637,"body_end":11694,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[120]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&魏续\n我沒有什麼想說的，換下一個人吧。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":11694,"title":"玩家切换","body_off":11719,"body_end":11787,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[2]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&张辽\n曹操現在究竟是生存還是毀滅，\n這是一個問題。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":11787,"title":"玩家切换","body_off":11812,"body_end":11993,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[126]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[126,0,1]},{"op":20,"name":"dialog","args":["&陈宫\n(曹操，你以前絕對想不到會有\n今天這個下場吧。)"]},{"op":20,"name":"dialog","args":["&陈宫\n(無論你現在是死是活，\n我都會盡我所能的與你對抗，\n哪怕是會犧牲我的靈魂。)"]},{"op":51,"name":"actor_face","args":[126,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":11993,"title":"玩家切换","body_off":12018,"body_end":12158,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[17]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[119,0,1]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":20,"name":"dialog","args":["&貂蝉\n姊姊，今後我們一起輔佐奉先吧。"]},{"op":51,"name":"actor_face","args":[847,0,0]},{"op":20,"name":"dialog","args":["&严氏\n嗯。"]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":51,"name":"actor_face","args":[847,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":12158,"title":"玩家切换","body_off":12183,"body_end":12425,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[847]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[119,0,1]},{"op":51,"name":"actor_face","args":[847,0,2]},{"op":52,"name":"actor_action","args":[847,6]},{"op":20,"name":"dialog","args":["&严氏\n(唉，當年夫君對我的誓言如此\n信誓旦旦，但是自從他納貂蟬為妾後，\n我就逐漸被冷落了。)"]},{"op":52,"name":"actor_action","args":[847,4]},{"op":20,"name":"dialog","args":["&严氏\n(正因為如此，即使我知道\n貂蟬妹子是個好人，\n我依然無法喜歡她。)"]},{"op":51,"name":"actor_face","args":[847,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}