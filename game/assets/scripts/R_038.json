{"file":"R_038.eex","kind":"story","scenario_index":76,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":38,"sections":[{"index":0,"offset":40,"title":"曹操形象(老年)","body_off":65,"body_end":141,"conditions":[{"op":2,"name":"comment","args":["曹操形象(老年)"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,202]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":1,"name":"if","args":[],"off":85,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":113},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":141,"sections":[{"index":0,"offset":143,"title":"满宠  担任结盟的使者(曹彰加入)","body_off":184,"body_end":2337,"conditions":[{"op":2,"name":"comment","args":["满宠  担任结盟的使者(曹彰加入)"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[19,52,40,2,0]},{"op":1,"name":"if","args":[],"off":268,"cond":{"op":5,"name":"test_flags","args":[[735],[]]},"end":9,"end_off":312},{"op":48,"name":"actor_appear","args":[4,52,70,0,0]},{"op":0,"name":"end","args":[]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["魏吴秘密同盟"]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":1,"name":"if","args":[],"off":366,"cond":{"op":5,"name":"test_flags","args":[[735],[]]},"end":57,"end_off":1163},{"op":35,"name":"play_music","args":[200,255]},{"op":36,"name":"play_sound","args":[18]},{"op":9,"name":"delay","args":[3]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n曹彰，你这次作战相当英勇。\n真不愧是我曹操之子啊！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[4,6]},{"op":20,"name":"dialog","args":["&曹彰\n多谢父亲夸奖。\n&曹操\n今后就正式出任我军将领，\n希望你有出色的表现。\n&曹彰\n是！"]},{"op":52,"name":"actor_action","args":[4,0]},{"op":59,"name":"join","args":[4,0,0]},{"op":1,"name":"if","args":[],"off":658,"cond":{"op":5,"name":"test_flags","args":[[1858],[]]},"end":36,"end_off":810},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["因為樂進先前已擔任特種兵，\n曹彰的兵種變為馴虎師。"]},{"op":117,"name":"set_s_image","args":[4,282]},{"op":119,"name":"int_var_op","args":[2,4081,2,0,1]},{"op":82,"name":"op_52","args":[4,61]},{"op":119,"name":"int_var_op","args":[2,4081,2,0,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":810,"cond":{"op":5,"name":"test_flags","args":[[1826],[]]},"end":42,"end_off":917},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["由於您選的是敵軍成長模式，\n曹彰獲得100點額外HP。"]},{"op":56,"name":"set_attr","args":[4,5,1,100]},{"op":9,"name":"delay","args":[1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":917,"cond":{"op":5,"name":"test_flags","args":[[1041],[]]},"end":53,"end_off":1135},{"op":9,"name":"delay","args":[1]},{"op":22,"name":"info","args":["由於您在夢幻關卡表現良好，\n曹彰的攻、防、爆、士各上升25點。"]},{"op":56,"name":"set_attr","args":[4,0,1,25]},{"op":56,"name":"set_attr","args":[4,1,1,25]},{"op":56,"name":"set_attr","args":[4,3,1,25]},{"op":56,"name":"set_attr","args":[4,4,1,25]},{"op":56,"name":"set_attr","args":[4,5,1,100]},{"op":105,"name":"popup","args":["曹彰HP上升100。"]},{"op":9,"name":"delay","args":[1]},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&曹操\n对了，仲达。\n我们不能就此放弃汉中，\n所以……"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n我打算利用东吴。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n如今蜀国的兵力已不可小觑，\n即使我军正面作战能够取胜，\n也不能算是上上之策。"]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n原来如此……\n因此要把蜀国的视线转移到东吴？"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":20,"name":"dialog","args":["&曹操\n正是如此。\n就让东吴攻击荆州的蜀军吧！\n&曹操\n孙权虽然得到了荆州三郡，\n但是一定尚未对其他的郡死心。\n&曹操\n因此我想与东吴秘密结盟。"]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n属下也赞成。\n&曹操\n不过………\n问题是谁适合担任使者呢？\n&司马懿\n属下以为满宠先生合适。\n&曹操\n伯宁？\n&司马懿\n是的。\n伯宁先生为人正直，\n这样的人有利外交。"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯，好吧。\n伯宁，！\n伯宁在吗！？"]},{"op":48,"name":"actor_appear","args":[25,90,55,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&满宠\n满宠在此。"]},{"op":50,"name":"actor_move","args":[65535,25,0,48,55,3]},{"op":52,"name":"actor_action","args":[25,0]},{"op":20,"name":"dialog","args":["&曹操\n哦，伯宁。\n我想让你担任使者前往东吴结盟。"]},{"op":52,"name":"actor_action","args":[25,6]},{"op":20,"name":"dialog","args":["&满宠\n前往东吴？\n&曹操\n嗯，我要你与东吴结成同盟，\n并且敦促他们进攻荆州。\n没问题吧？\n&满宠\n是，我一定不辱使命。\n&曹操\n嗯，那就有劳你了。"]},{"op":52,"name":"actor_action","args":[25,0]},{"op":50,"name":"actor_move","args":[65535,25,0,95,55,1]},{"op":49,"name":"actor_select","args":[65535,25,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操\n仲达，留守荆州的蜀将是关羽吧。"]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n是的。"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n……关羽是吗？\n想不到又要与他作战了……"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":2337,"sections":[{"index":0,"offset":2339,"title":"于禁、庞德率军增援","body_off":2368,"body_end":4708,"conditions":[{"op":2,"name":"comment","args":["于禁、庞德率军增援"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,334,102]},{"op":44,"name":"caption","args":["镇守荆州的蜀将，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[3,278,236]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["是智勇兼备的关羽。",1,0,0]},{"op":9,"name":"delay","args":[8]},{"op":41,"name":"op_29","args":[76,500,217]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["孙权",1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["以魏国先行攻打荆州为条件，",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["与魏国秘密缔结了同盟。",1,0,0]},{"op":9,"name":"delay","args":[8]},{"op":44,"name":"caption","args":["曹操接受这个条件后，",1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":43,"name":"op_2b","args":[0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[5,300,76]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["派遣曹仁、",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[25,364,109]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["满宠",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[5,278,156]},{"op":42,"name":"op_2a","args":[25,342,202]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["进攻荆州。",1,0,1]},{"op":44,"name":"caption","args":["然而曹仁和满宠遭到关羽的反击，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[5,255,140]},{"op":42,"name":"op_2a","args":[25,342,140]},{"op":42,"name":"op_2a","args":[25,319,140]},{"op":42,"name":"op_2a","args":[3,288,220]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["反而被围困在樊城。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[9,48,58,3,0]},{"op":48,"name":"actor_appear","args":[14,48,52,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&曹操\n文则，想必你也听说了，\n曹仁和满宠被关羽围困于樊城。\n&曹操\n就凭他们还打不过关羽，\n所以你马上率领援军去樊城。"]},{"op":52,"name":"actor_action","args":[14,6]},{"op":20,"name":"dialog","args":["&于禁\n是。"]},{"op":52,"name":"actor_action","args":[14,0]},{"op":20,"name":"dialog","args":["&曹操\n令明，你任副将协助文则。"]},{"op":52,"name":"actor_action","args":[9,6]},{"op":20,"name":"dialog","args":["&庞德\n是。"]},{"op":52,"name":"actor_action","args":[9,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[14,0,2]},{"op":20,"name":"dialog","args":["&于禁\n派遣庞德将军？\n&曹操\n嗯，怎么了？"]},{"op":51,"name":"actor_face","args":[14,0,3]},{"op":20,"name":"dialog","args":["&于禁\n不……没什么。\n那么我这就去准备。\n请恕末将告退。"]},{"op":50,"name":"actor_move","args":[65535,14,0,95,52,1]},{"op":49,"name":"actor_select","args":[65535,14,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[9,0,1]},{"op":20,"name":"dialog","args":["&庞德\n看来于将军还不完全信任我。"]},{"op":51,"name":"actor_face","args":[9,0,3]},{"op":20,"name":"dialog","args":["&庞德\n既然深知我的过去，\n这也是无可奈何的事。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n令明，这些传闻我也曾经听说，\n不过我还是非常相信你，\n所以才命你前去增援樊城。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[9,6]},{"op":20,"name":"dialog","args":["&庞德\n多谢丞相。\n那么末将也去准备出兵的事宜。"]},{"op":52,"name":"actor_action","args":[9,0]},{"op":50,"name":"actor_move","args":[65535,9,0,85,58,1]},{"op":52,"name":"actor_action","args":[9,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[9,0,3]},{"op":20,"name":"dialog","args":["&庞德\n主公。\n&曹操\n什么事？"]},{"op":52,"name":"actor_action","args":[9,6]},{"op":20,"name":"dialog","args":["&庞德\n主公交给末将如此重要的任务，\n我非常感谢。\n&庞德\n就算拼了这条命，\n也要完成救援樊城的任务。\n&庞德\n……我一定会办到的！\n&曹操\n令明，不要急于立功。\n&庞德\n……那么末将告退。"]},{"op":52,"name":"actor_action","args":[9,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,9,0,95,58,1]},{"op":49,"name":"actor_select","args":[65535,9,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操\n看来已经头脑发热了，这怎么行呢？\n作战讲求的就是冷静，\n否则会丢掉性命的。\n&曹操\n这样下去令明可危险了，\n关羽是个智勇双全的猛将，\n无法冷静以对是胜不了他的。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n可是如今庞德这个样子，\n只怕也听不进我的话了，\n只好让于禁稳住庞德吧。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n……庞德，千万别冲动啊。\n我可不想失去你……"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":4708,"sections":[{"index":0,"offset":4710,"title":"吕蒙  着手进攻荆州","body_off":4739,"body_end":5641,"conditions":[{"op":2,"name":"comment","args":["吕蒙  着手进攻荆州"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[5,271,145]},{"op":41,"name":"op_29","args":[3,271,225]},{"op":9,"name":"delay","args":[3]},{"op":41,"name":"op_29","args":[14,283,47]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["于禁和",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[9,347,89]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["庞德",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[14,207,47]},{"op":42,"name":"op_2a","args":[14,207,145]},{"op":42,"name":"op_2a","args":[9,335,145]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["率领援军奔赴曹仁被困的樊城。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,51,65535]},{"op":48,"name":"actor_appear","args":[76,53,29,2,0]},{"op":48,"name":"actor_appear","args":[88,41,48,1,0]},{"op":48,"name":"actor_appear","args":[79,41,54,1,0]},{"op":48,"name":"actor_appear","args":[80,65,48,3,0]},{"op":48,"name":"actor_appear","args":[194,65,54,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["建业  孙权公馆"]},{"op":20,"name":"dialog","args":["&孙权\n子明，你应该已经知道……\n魏将曹仁被关羽围困樊城的事吧？"]},{"op":52,"name":"actor_action","args":[80,6]},{"op":20,"name":"dialog","args":["&吕蒙\n是。\n这正是我们千载难逢的好机会。"]},{"op":52,"name":"actor_action","args":[80,0]},{"op":20,"name":"dialog","args":["&孙权\n没错。\n我们必须趁机取得整个荆州。\n&孙权\n子明，命你前往夺取荆州。\n一切就看你的了！"]},{"op":52,"name":"actor_action","args":[80,6]},{"op":20,"name":"dialog","args":["&吕蒙\n是。请主公放心。"]},{"op":52,"name":"actor_action","args":[80,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[80,0,2]},{"op":20,"name":"dialog","args":["&吕蒙\n看来关羽这家伙……\n好像不懂得什么叫「见好就收」。\n&吕蒙\n这场胜利将是我东吴的了。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":5641,"sections":[{"index":0,"offset":5643,"title":"曹操  增援樊城","body_off":5668,"body_end":9251,"conditions":[{"op":2,"name":"comment","args":["曹操  增援樊城"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[5,325,145]},{"op":41,"name":"op_29","args":[3,261,145]},{"op":44,"name":