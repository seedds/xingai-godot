的两位夫人在一起。\n&曹操\n是吗？\n好，把他带到这来。\n&张辽\n是。"]},{"op":50,"name":"actor_move","args":[65535,2,0,49,16,0]},{"op":49,"name":"actor_select","args":[65535,2,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操\n请大家暂时先退下吧。"]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":20,"name":"dialog","args":["&荀彧\n是。"]},{"op":51,"name":"actor_face","args":[22,0,2]},{"op":20,"name":"dialog","args":["&郭嘉\n是。"]},{"op":51,"name":"actor_face","args":[1,0,2]},{"op":20,"name":"dialog","args":["&夏侯惇\n……是。"]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":51,"name":"actor_face","args":[22,0,3]},{"op":51,"name":"actor_face","args":[20,0,3]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,1,0,49,54,1]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,1,0,49,42,0]},{"op":50,"name":"actor_move","args":[65535,20,0,49,54,3]},{"op":50,"name":"actor_move","args":[65535,22,0,49,48,3]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,1,0,49,16,0]},{"op":50,"name":"actor_move","args":[65535,20,0,49,26,0]},{"op":50,"name":"actor_move","args":[65535,22,0,49,21,0]},{"op":49,"name":"actor_select","args":[65535,1,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,22,0,49,16,0]},{"op":50,"name":"actor_move","args":[65535,20,0,49,21,0]},{"op":49,"name":"actor_select","args":[65535,22,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,20,0,49,16,0]},{"op":49,"name":"actor_select","args":[65535,20,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":48,"name":"actor_appear","args":[2,49,16,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,2,0,49,21,2]},{"op":48,"name":"actor_appear","args":[3,49,16,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,2,0,49,52,2]},{"op":50,"name":"actor_move","args":[65535,3,0,49,47,2]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,2,0,41,52,3]},{"op":50,"name":"actor_move","args":[65535,3,0,49,52,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[2,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n云长啊，\n你能否留在我的营中效力？"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&关羽\n……关某有三个条件，\n如果丞相都能答应，\n关某就留下来。"]},{"op":35,"name":"play_music","args":[203,255]},{"op":36,"name":"play_sound","args":[11]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n嗯。哪三个条件？\n&关羽\n第一、我关羽降汉不降曹。\n&曹操\n嗯。\n&关羽\n第二、主公将二位夫人托付给我，\n请保证二位夫人的安全。\n&曹操\n哦，这也容易。\n&关羽\n第三、\n&关羽\n如果得知我家主公刘备还活着，\n请丞相让我立刻离开此地。"]},{"op":56,"name":"set_attr","args":[0,15,0,252]},{"op":20,"name":"dialog","args":["&曹操\n……！！\n&关羽\n如何？"]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":1,"name":"if","args":[],"off":2123,"cond":{"op":18,"name":"choice","args":["好吧\n……",0]},"end":102,"end_off":2720},{"op":1,"name":"if","args":[],"off":2145,"cond":{"op":19,"name":"test_choice","args":[1]},"end":91,"end_off":2352},{"op":58,"name":"set_resource","args":[2,1,2]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[203,0]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n好吧。这三个条件我就答应吧。"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n多谢丞相答应关某如此无理的要求。\n&关羽\n那么关某便将此事告诉二位夫人了。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2352,"cond":{"op":19,"name":"test_choice","args":[2]},"end":101,"end_off":2718},{"op":58,"name":"set_resource","args":[2,2,2]},{"op":36,"name":"play_sound","args":[255]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":35,"name":"play_music","args":[203,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n……。\n&关羽\n……看来您是不会答应了。\n既然如此，快点将我斩首吧。\n&张辽\n主……主公！\n&曹操\n且慢，云长！\n……好吧，我答应这三个条件。\n&关羽\n丞相不会后悔吗？\n&曹操\n当然。我曹操向来一言九鼎。"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n多谢丞相答应关某如此无理的要求。\n&关羽\n那么关某便将此事告诉二位夫人了。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,3,0,49,47,0]},{"op":20,"name":"dialog","args":["&关羽\n（不知兄长和三弟是否平安……）"]},{"op":50,"name":"actor_move","args":[65535,3,0,49,16,0]},{"op":49,"name":"actor_select","args":[65535,3,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n一知道刘备还活着，\n云长就要离我而去……。"]},{"op":51,"name":"actor_face","args":[2,0,2]},{"op":20,"name":"dialog","args":["&张辽\n云长真是重义之人……。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n也好。\n就让云长了解一下\n刘备和我的差距吧。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[203,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":3107,"sections":[{"index":0,"offset":3109,"title":"刘备，投奔袁绍","body_off":3134,"body_end":4086,"conditions":[{"op":2,"name":"comment","args":["刘备，投奔袁绍"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,490,150]},{"op":41,"name":"op_29","args":[32,554,150]},{"op":41,"name":"op_29","args":[101,350,27]},{"op":44,"name":"caption","args":["刘备败给曹操之后，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[32,554,70]},{"op":42,"name":"op_2a","args":[32,414,27]},{"op":9,"name":"delay","args":[8]},{"op":44,"name":"caption","args":["便去投奔邺的袁绍。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,7,65535]},{"op":48,"name":"actor_appear","args":[101,52,28,2,0]},{"op":48,"name":"actor_appear","args":[106,38,48,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[203,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["邺 袁绍公馆"]},{"op":48,"name":"actor_appear","args":[181,52,92,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&士兵01\n主公，刘备来了。\n&袁绍\n嗯，快请。\n&士兵01\n是。"]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":48,"name":"actor_appear","args":[32,52,98,0,0]},{"op":9,"name":"delay","args":[10]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,32,0,52,48,0]},{"op":20,"name":"dialog","args":["&刘备\n袁绍大人……刘备实力不足，\n徐州给曹操夺走了。\n&袁绍\n嗯，我听说了。\n真是一场灾难啊。\n&审配\n刘备大人，就你一个人吗？"]},{"op":51,"name":"actor_face","args":[32,0,3]},{"op":20,"name":"dialog","args":["&刘备\n是的。\n义弟关羽和张飞都在战场上失散了。\n&袁绍\n原来如此。"]},{"op":51,"name":"actor_face","args":[32,0,0]},{"op":20,"name":"dialog","args":["&刘备\n不知道他们是否还活着……\n&袁绍\n好了，你也别太难过。\n关羽、张飞都是天下闻名的豪杰，\n不会有事的。\n&刘备\n但愿如此……\n&袁绍\n就暂且留在我这儿吧。\n&刘备\n……是。（关羽、张飞……）"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[203,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":4086,"sections":[{"index":0,"offset":4088,"title":"许都  关羽府","body_off":4111,"body_end":5058,"conditions":[{"op":2,"name":"comment","args":["许都  关羽府"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,63,65535]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[200,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府附近"]},{"op":48,"name":"actor_appear","args":[0,85,66,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,0,0,73,66,3]},{"op":48,"name":"actor_appear","args":[3,81,66,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,0,0,65,66,3]},{"op":50,"name":"actor_move","args":[65535,3,0,73,66,3]},{"op":48,"name":"actor_appear","args":[155,81,66,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,0,0,57,66,3]},{"op":50,"name":"actor_move","args":[65535,3,0,65,66,3]},{"op":50,"name":"actor_move","args":[65535,155,0,73,66,3]},{"op":48,"name":"actor_appear","args":[154,81,66,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n云长，这府第就送给你了，\n今天起就住在这里吧。\n&关羽\n谢丞相。\n&曹操\n嗯，就这样吧……。"]},{"op":50,"name":"actor_move","args":[65535,0,0,20,66,3]},{"op":49,"name":"actor_select","args":[65535,0,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,3,0,57,66,3]},{"op":50,"name":"actor_move","args":[65535,155,0,65,66,3]},{"op":50,"name":"actor_move","args":[65535,154,0,73,66,3]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[3,0,1]},{"op":20,"name":"dialog","args":["&关羽\n请二位嫂嫂住在这里吧。\n&糜夫人\n那么二叔住在哪里呢？\n&关羽\n我住在门房小屋。\n&甘夫人\n可是这不是曹操大人……？\n&关羽\n现在兄长下落不明，\n二位嫂嫂就是我的主公。\n&关羽\n让主公歇息在舒适的居所，\n曹丞相不会怪罪我的。\n&糜夫人\n二叔……。\n&甘夫人\n全靠二叔了……。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":5058,"sections":[{"index":0,"offset":5060,"title":"赤兔马","body_off":5077,"body_end":8221,"conditions":[{"op":2,"name":"comment","args":["赤兔马"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[0,35,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":22,"name":"info","args":["曹操返回许都，想尽各种办法拉拢关羽。"]},{"op":22,"name":"info","args":["曹操送给关羽豪华的宅第，\n三日一小宴，五日一大宴，\n天天赠送金银财宝。"]},{"op":22,"name":"info","args":["可是关羽的心并没有被曹操打动，\n曹操越来越担忧。"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,25,65535]},{"op":48,"name":"actor_appear","args":[2,56,55,1,0]},{"op":48,"name":"actor_appear","args":[3,78,55,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府花园"]},{"op":48,"name":"actor_appear","args":[0,66,80,0,0]},{"op":9,"name":"delay","args":[10]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操\n怎么，你们二人都在这里？"]},{"op":51,"name":"actor_face","args":[2,0,2]},{"op":20,"name":"dialog","args":["&张辽\n噢，主公。\n&曹操\n文远。\n&张辽\n是？"]},{"op":50,"name":"actor_move","args":[65535,2,0,56,80,1]},{"op":52,"name":"actor_action","args":[2,0]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[65535,0,0,62,80,3]},{"op":52,"name":"actor_action","args":[0,0]},{"op":1,"name":"if","args":[],"off":5626,"cond":{"op":5,"name":"test_flags","args":[[1280],[]]},"end":33,"end_off":5996},{"op":20,"name":"dialog","args":["&曹操\n外面拴着的是云长的马吗？\n&张辽\n是的。\n&曹操\n云长这样的武将，竟然骑那种劣马，\n太不相配了。\n&曹操\n（借此机会检验一下吕布的真心也好……）\n去把那匹马牵来。\n&张辽\n哪匹马……？\n&曹操\n就是赤兔马。\n&张辽\n要把它送给云长！？\n&曹操\n是啊。\n&张辽\n可是那是吕布将军的爱马啊。\n&曹操\n你按我说的办，吕布那边，\n我会去解释的。"]},{"op":52,"name":"actor_action","args":[2,6]},{"op":20,"name":"dialog","args":["&张辽\n是。"]},{"op":52,"name":"actor_action","args":[2,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":5996,"cond":{"op":5,"name":"test_flags","args":[[1290],[]]},"end":39,"end_off":6266},{"op":20,"name":"dialog","args":["&曹操\n外面拴着的是云长的马吗？\n&张辽\n是的。\n&曹操\n云长这样的武将，竟然骑那种劣马，\n太不相配了。\n&曹操\n去把那匹马牵来。\n&张辽\n哪匹马……？\n&曹操\n就是谁也骑不了的那匹。\n&张辽\n要把它送给云长！？\n&曹操\n是啊。"]},{"op":52,"name":"actor_action","args":[2,6]},{"op":20,"name":"dialog","args":["&张辽\n末将明白了。"]},{"op":52,"name":"actor_action","args":[2,0]},{"op":0,"name":"end","args":[]},{"op":51,"name":"actor_face","args":[2,0,2]},{"op":50,"name":"actor_move","args":[65535,2,0,56,98,2]},{"op":49,"name":"actor_select","args":[65535,2,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,0,0,62,55,1]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n云长。"]},{"op":51,"name":"actor_face","args":[3,6,3]},{"op":20,"name":"dialog","args":["&关羽\n啊？原来是曹丞相。\n实在有失远迎，\n关某方才正在沉思呢……\n&曹操\n啊，没关系。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":50,"name":"actor_move","args":[65535,0,0,68,55,1]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n在许都过得如何？\n&关羽\n多亏丞相关照，\n生活得非常愉快。\n&曹操\n是吗……那就好。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n对了，你喜欢许都吗？\n&关羽\n是的，许都这里非常繁华，\n简直像是梦中的都市。"]},{"op":51,"name":"actor_face","args":[3,0,1]},{"op":20,"name":"dialog","args":["&关羽\n一定是关某心中挂念着兄长，\n所以才会有置身梦中的感觉吧……。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n……还是一点都没变。"]},{"op":48,"name":"actor_appear","args":[2,60,87,0,0]},{"op":48,"name":"actor_appear","args":[198,60,92,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&张辽\n主公。\n我把马牵来了。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":50,"name":"actor_move","args":[65535,2,0,60,55,1]},{"op":50,"name":"actor_move","args":[65535,198,0,60,63,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":20,"name":"dialog","args":["&曹操\n喔，辛苦了。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n云长啊。\n这匹马就送给你了。"]},{"op":51,"name":"actor_face","args":[3,0,3]},{"op":20,"name":"dialog","args":["&关羽\n啊？"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[65535,3,0,78,63,2]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":51,"name":"actor_face","args":[2,0,2]},{"op":50,"name":"actor_move","args":[65535,3,0,68,63,3]},{"op":52,"name":"actor_action","args":[3,5]},{"op":20,"name":"dialog","args":["&关羽\n这……这匹马莫非是……\n&曹操\n没错。\n这就是吕布所骑，\n日行千里的赤兔马。"]},{"op":51,"name":"actor_face","args":[3,3,0]},{"op":20,"name":"dialog","args":["&关羽\n丞相要把它赐给关某？\n&曹操\n嗯。\n&曹操\n这是攻打吕布时得到的，\n不过没有人能骑得惯它。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,254]},{"op":20,"name":"dialog","args":["&曹操\n我想你应该骑得了它吧。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n谢丞相厚爱。"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n我能马上试骑吗？\n&曹操\n嗯。"]},{"op":51,"name":"actor_face","args":[3,0,3]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,3,0,62,63,3]},{"op":52,"name":"actor_action","args":[3,5]},{"op":20,"name":"dialog","args":["&关羽\n啊，真不愧是名马。\n曹丞相，太感谢您了。\n&曹操\n看来你很满意啊。"]},{"op":51,"name":"actor_face","args":[3,3,0]},{"op":20,"name":"dialog","args":["&关羽\n是的。\n&关羽\n如此一旦知道兄长的下落，\n关某就可以马上去见他了。"]},{"op":56,"name":"set_attr","args":[0,15,0,252]},{"op":20,"name":"dialog","args":["&曹操\n！？"]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":51,"name":"actor_face","args":[3,0,2]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,3,0,62,98,2]},{"op":50,"name":"actor_move","args":[65535,198,0,60,98,2]},{"op":49,"name":"actor_select","args":[65535,3,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,198,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":56,"name":"set_attr","args":[0,15,0,0]},{"op":20,"name":"dialog","args":["&曹操\n…………。\n&张辽\n云长你…………。"]},{"op":1,"name":"if","args":[],"off":8162,"cond":{"op":5,"name":"test_flags","args":[[1829],[]]},"end":116,"end_off":8203},{"op":111,"name":"lose_item","args":[114]},{"op":105,"name":"popup","args":["失去赤兔馬。"]},{"op":0,"name":"end","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":5,"offset":8221,"sections":[{"index":0,"offset":8223,"title":"吕布的爱马","body_off":8244,"body_end":9221,"conditions":[{"op":2,"name":"comment","args":["吕布的爱马"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":8244,"cond":{"op":5,"name":"test_flags","args":[[1280],[]]},"end":38,"end_off":9219},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[2,65535,65535,25,65535]},{"op":48,"name":"actor_appear","args":[0,60,60,1,0]},{"op":48,"name":"actor_appear","args":[119,72,60,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府花园"]},{"op":20,"name":"dialog","args":["&曹操\n奉先，\n我已经把你的赤兔马送给关羽了。"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&吕布\n丞相，你怎么能这么做？"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n奉先，千军易得，一将难求啊……\n你就不要小气了，\n明天我把我的马送给你。"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&吕布\n丞相，说的哪里话。\n现在的吕布再也不是从前的吕布了，"]},{"op":20,"name":"dialog","args":["&吕布\n虽然我非常喜欢赤兔马……\n但如今我已经是您的下属了，\n理应服从命令，又怎么会向您所要条件？"]},{"op":20,"name":"dialog","args":["&吕布\n只是那关羽本是刘备的兄弟，\n丞相小心养虎为患啊。"]},{"op":9,"name":"delay","args":[15]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&曹操\n……。"]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&曹操\n（虽然如此，\n对于吕布这个人还是不能大意）"]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&曹操\n（不过吕布所说也不错，\n关羽……是刘备的二弟就……）"]},{"op":9,"name":"delay","args":[10]},{"op":50,"name":"actor_move","args":[0,0,0,60,57,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n（但愿我所做的一切能感化关羽吧！）"]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n（你這個可惡的死老頭！\n居然把本大爺的赤兔馬送給\n那個紅臉賊！）"]},{"op":20,"name":"dialog","args":["&吕布\n（總有一天，老子一定會跟你\n算這筆帳！）"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":6,"offset":9221,"sections":[{"index":0,"offset":9223,"title":"曹操的叹息","body_off":9244,"body_end":9777,"conditions":[{"op":2,"name":"comment","args":["曹操的叹息"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,35,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[2,49,40,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&曹操\n文远啊，难道云长不了解我的心意吗？"]},{"op":51,"name":"actor_face","args":[0,0,3]},{"op":20,"name":"dialog","args":["&曹操\n我已经无计可施了……\n&张辽\n主公，我去云长的住处，\n探探他的本意如何吧？\n&张辽\n云长深受丞相大恩，\n没有不知感恩的道理的。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n这倒也是。\n你肯帮我吗……？"]},{"op":52,"name":"actor_action","args":[2,6]},{"op":20,"name":"dialog","args":["&张辽\n请交给末将吧。"]},{"op":52,"name":"actor_action","args":[2,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,2,0,81,40,2]},{"op":49,"name":"actor_select","args":[65535,2,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&曹操\n刘备究竟是什么样的人啊……？"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":7,"offset":9777,"sections":[{"index":0,"offset":9779,"title":"关羽的心意","body_off":9800,"body_end":10678,"conditions":[{"op":2,"name":"comment","args":["关羽的心意"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,0,65535]},{"op":48,"name":"actor_appear","args":[3,40,54,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  关羽府"]},{"op":20,"name":"dialog","args":["&张辽\n关将军在吗？\n&关羽\n不知哪位？"]},{"op":48,"name":"actor_appear","args":[2,90,54,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&张辽\n是我。\n&关羽\n喔，原来是文远。"]},{"op":50,"name":"actor_move","args":[65535,2,0,52,54,3]},{"op":20,"name":"dialog","args":["&关羽\n有急事吗？\n&张辽\n不，没什么事。\n&关羽\n是吗。\n&关羽\n今天曹丞相又送关某礼物，\n我正写信感谢他呢。\n&张辽\n是吗？\n对了，你受丞相大恩，\n心中有何打算？\n&关羽\n关某非常感激丞相。\n&张辽\n可是一旦知道刘玄德的消息，\n你就会离开这里吧？\n&关羽\n……是的。\n&张辽\n你不想为丞相效力吗？\n&关羽\n无论我身在何处，\n我的心总是和兄长在一起的。\n&张辽\n嗯……\n&关羽\n……文远兄。\n&关羽\n关某离开之前，\n一定要立下战功，\n以报答丞相之恩。\n&关羽\n烦请转告丞相。\n&张辽\n……嗯。"]},{"op":50,"name":"actor_move","args":[65535,2,0,90,54,1]},{"op":52,"name":"actor_action","args":[2,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[2,0,3]},{"op":20,"name":"dialog","args":["&张辽\n打搅了。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[2,0,1]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,2,0,98,54,1]},{"op":49,"name":"actor_select","args":[65535,2,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":8,"offset":10678,"sections":[{"index":0,"offset":10680,"title":"曹操的心愿","body_off":10701,"body_end":11471,"conditions":[{"op":2,"name":"comment","args":["曹操的心愿"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,35,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[20,49,40,2,0]},{"op":48,"name":"actor_appear","args":[2,49,55,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&曹操\n是吗…？\n关羽是这么说的？"]},{"op":52,"name":"actor_action","args":[2,6]},{"op":20,"name":"dialog","args":["&张辽\n是的。"]},{"op":52,"name":"actor_action","args":[2,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n真是义薄云天啊，\n所以我才更想留住他。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n主公。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n怎么？\n&荀彧\n我有良策可以留住关羽。\n&曹操\n什么？"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":20,"name":"dialog","args":["&荀彧\n关羽是个讲情重义的好汉。\n&荀彧\n不立下战功报答主公，\n他是不会离开许都的。\n&曹操\n大概是吧。\n&荀彧\n那么反过来思考又如何呢？\n只要不给关羽立功的机会就行了。\n&曹操\n嗯…………。"]},{"op":51,"name":"actor_face","args":[2,0,0]},{"op":20,"name":"dialog","args":["&张辽\n你们打算就这么养着云长？"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n不，文远将军。\n直到云长对主公心悦诚服为止。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":51,"name":"actor_face","args":[2,0,3]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n我懂了。\n就暂且不带云长上战场吧。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":9,"offset":11471,"sections":[{"index":0,"offset":11473,"title":"内讧","body_off":11488,"body_end":13084,"conditions":[{"op":2,"name":"comment","args":["内讧"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,7,65535]},{"op":48,"name":"actor_appear","args":[101,52,28,2,0]},{"op":48,"name":"actor_appear","args":[106,38,48,1,0]},{"op":48,"name":"actor_appear","args":[32,38,54,1,0]},{"op":48,"name":"actor_appear","args":[110,67,48,3,0]},{"op":48,"name":"actor_appear","args":[105,67,54,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":105,"name":"popup","args":["就在此时。"]},{"op":23,"name":"place_name","args":["邺  袁绍公馆"]},{"op":20,"name":"dialog","args":["&袁绍\n我即将讨伐曹操，\n大家的意见如何？"]},{"op":52,"name":"actor_action","args":[110,6]},{"op":20,"name":"dialog","args":["&田丰\n主公。\n&田丰\n我认为现在是守重于攻的时期。\n我们应该致力国防，积蓄国力，\n训练兵马以待来日之战。\n&田丰\n如此经过二、三年的光阴，\n许都的曹操便会衰竭疲敝，\n届时我们再一鼓作气打垮他。"]},{"op":52,"name":"actor_action","args":[110,0]},{"op":20,"name":"dialog","args":["&袁绍\n嗯。"]},{"op":52,"name":"actor_action","args":[106,6]},{"op":20,"name":"dialog","args":["&审配\n奸贼曹操无视天子，\n怎么能再容忍他两年呢？"]},{"op":52,"name":"actor_action","args":[106,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,6]},{"op":20,"name":"dialog","args":["&刘备\n审配所言极是。\n应该尽早讨伐他。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&袁绍\n嗯。"]},{"op":52,"name":"actor_action","args":[106,6]},{"op":20,"name":"dialog","args":["&审配\n我军兵力相较于曹军而言，\n也占有绝对的优势。"]},{"op":52,"name":"actor_action","args":[110,2]},{"op":20,"name":"dialog","args":["&田丰\n审配！\n&田丰\n虽然曹军的兵员较少，\n但都是身经百战的武将\n所率领的精锐部队。\n&田丰\n如果过于大意，\n将会招来危险！"]},{"op":52,"name":"actor_action","args":[106,0]},{"op":20,"name":"dialog","args":["&审配\n哦！\n我军都已经打败了公孙瓒，\n难道你还不相信我军的实力吗？"]},{"op":52,"name":"actor_action","args":[110,0]},{"op":20,"name":"dialog","args":["&田丰\n唔唔……。"]},{"op":52,"name":"actor_action","args":[110,2]},{"op":20,"name":"dialog","args":["&田丰\n我并没有这么说！\n&审配\n那你真是太目光短浅了。\n&袁绍\n田丰，我军如今实力强大，\n士气正值高昂的时候，\n难道这还战胜不了曹操？"]},{"op":52,"name":"actor_action","args":[110,0]},{"op":20,"name":"dialog","args":["&田丰\n主公，万万不可小看曹操。\n这个人经历多次大战，\n经验非常丰富。"]},{"op":51,"name":"actor_face","args":[101,0,0]},{"op":20,"name":"dialog","args":["&袁绍\n……………。"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[101,0,2]},{"op":20,"name":"dialog","args":["&袁绍\n我已经决定了。\n准备讨伐曹操。"]},{"op":52,"name":"actor_action","args":[110,3]},{"op":20,"name":"dialog","args":["&田丰\n主……主公！！\n&袁绍\n田丰，你给我回去反省。"]},{"op":52,"name":"actor_action","args":[110,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[110,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[110,2]},{"op":20,"name":"dialog","args":["&田丰\n怎么能够如此轻率呢……！\n&袁绍\n其他人都去准备出战。"]},{"op":52,"name":"actor_action","args":[101,17]},{"op":20,"name":"dialog","args":["&袁绍\n我要讨伐奸贼曹操！"]},{"op":52,"name":"actor_action","args":[101,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[105,0,1]},{"op":20,"name":"dialog","args":["&沮授\n（还是田丰说的对，\n现在不该与曹操争斗，\n不过如今已经没有办法了。）"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":10,"offset":13084,"sections":[{"index":0,"offset":13086,"title":"袁绍进兵","body_off":13105,"body_end":14625,"conditions":[{"op":2,"name":"comment","args":["袁绍进兵"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,35,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[20,49,40,2,0]},{"op":48,"name":"actor_appear","args":[22,55,40,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":48,"name":"actor_appear","args":[181,90,55,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&士兵01\n主公！袁绍军队集结在边境附近的白马，\n即将进攻我边境！\n&曹操\n嗯，终于来了是吗？\n马上召集幕僚进行商议。\n&士兵01\n是。"]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":48,"name":"actor_appear","args":[3,90,55,3,0]},{"op":9,"name":"delay","args":[10]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&关羽\n丞相！"]},{"op