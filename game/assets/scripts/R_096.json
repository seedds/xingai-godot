":[]},{"op":1,"name":"if","args":[],"off":398,"cond":{"op":5,"name":"test_flags","args":[[1866,1867],[]]},"end":18,"end_off":438},{"op":56,"name":"set_attr","args":[837,15,0,686]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":438,"cond":{"op":5,"name":"test_flags","args":[[1865],[1866,1867]]},"end":21,"end_off":480},{"op":56,"name":"set_attr","args":[837,15,0,478]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":480,"cond":{"op":5,"name":"test_flags","args":[[1865,1866],[1867]]},"end":24,"end_off":522},{"op":56,"name":"set_attr","args":[837,15,0,482]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[64]},{"op":39,"name":"change_scene","args":[2,65535,65535,18,65535]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["鄴 呂舞衣軍軍營"]},{"op":24,"name":"title_text","args":["扮豬吃虎"]},{"op":9,"name":"delay","args":[5]},{"op":48,"name":"actor_appear","args":[782,66,52,1,0]},{"op":48,"name":"actor_appear","args":[72,66,60,1,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&祝融\n咦？我們怎麼又回來了？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[782,0,2]},{"op":51,"name":"actor_face","args":[72,0,0]},{"op":20,"name":"dialog","args":["&祝融\n這到底是怎麼回事？\n難道剛才發生的事都只是一場夢嗎？"]},{"op":20,"name":"dialog","args":["&马如霜\n我哪知道！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[782,0,0]},{"op":9,"name":"delay","args":[8]},{"op":51,"name":"actor_face","args":[782,0,3]},{"op":9,"name":"delay","args":[8]},{"op":51,"name":"actor_face","args":[782,0,2]},{"op":9,"name":"delay","args":[8]},{"op":51,"name":"actor_face","args":[782,0,1]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&马如霜\n話說回來，呂舞衣那個垃圾死哪兒去了？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[782,0,2]},{"op":20,"name":"dialog","args":["&马如霜\n還有小鬼頭呢？他怎麼沒一起回來？"]},{"op":20,"name":"dialog","args":["&左慈\n我來告訴你們是怎麼一回事。"]},{"op":20,"name":"dialog","args":["&马如霜\n！！！！"]},{"op":20,"name":"dialog","args":["&祝融\n！！！！"]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[837,66,56,2,0]},{"op":48,"name":"actor_appear","args":[797,70,56,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[782,0,1]},{"op":51,"name":"actor_face","args":[72,0,1]},{"op":20,"name":"dialog","args":["&马如霜\n馬的！你們師徒倆是想嚇死人啊？\n總是神出鬼沒的，草！"]},{"op":51,"name":"actor_face","args":[837,0,0]},{"op":20,"name":"dialog","args":["&吕舞衣\n少扯開話題了！\n我們是盟友，你卻趁我不備時偷襲，\n你這個人真是太卑鄙！"]},{"op":51,"name":"actor_face","args":[782,0,2]},{"op":20,"name":"dialog","args":["&马如霜\n哼，真不曉得是誰先出賣誰的。\n真要算帳的話，你欠得比誰都多，\n草！"]},{"op":52,"name":"actor_action","args":[837,5]},{"op":20,"name":"dialog","args":["&吕舞衣\n你個沒素質的傢伙閉嘴！\n都跟你說了幾次不要講髒話了，贛！"]},{"op":20,"name":"dialog","args":["&马如霜\n你還講髒話！你還講髒話！"]},{"op":20,"name":"dialog","args":["&祝融\n呵呵。(真是狗咬狗，一嘴毛。)"]},{"op":51,"name":"actor_face","args":[797,0,1]},{"op":20,"name":"dialog","args":["&左慈\n唉，年輕人到底是年輕人，\n沉不住氣。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[72,0,0]},{"op":20,"name":"dialog","args":["&祝融\n對了，姓呂的啊，你的臉色怎麼這麼\n不好？蒼白得就像紙似的。"]},{"op":52,"name":"actor_action","args":[837,0]},{"op":51,"name":"actor_face","args":[837,0,2]},{"op":20,"name":"dialog","args":["&吕舞衣\n不想說！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[837,0,0]},{"op":20,"name":"dialog","args":["&吕舞衣\n對了，姓馬的。\n我恰好做了首詩要送給你，\n你敢聽嗎？"]},{"op":20,"name":"dialog","args":["&马如霜\n我有什麼不敢的？你敢講我就敢聽！"]},{"op":20,"name":"dialog","args":["&吕舞衣\n嘿嘿。"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&吕舞衣\n淋樽溼沙壁，暮幽曉寂寂， "]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[837,0,1]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&吕舞衣\n泥若香不透，沃草溺馬鼻。"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&马如霜\n…………………"]},{"op":20,"name":"dialog","args":["&祝融\n(怎麼唸起來怪怪的？而且也沒有意境。)"]},{"op":36,"name":"play_sound","args":[56]},{"op":9,"name":"delay","args":[9]},{"op":20,"name":"dialog","args":["&马如霜\n去泥馬德！我要把你活活分屍！"]},{"op":51,"name":"actor_face","args":[797,0,3]},{"op":20,"name":"dialog","args":["&左慈\n好了，別再為那些無聊的小事爭執了。"]},{"op":20,"name":"dialog","args":["&左慈\n那個可惡的小鬼欺騙了你們，\n你們難道不想報復嗎？"]},{"op":51,"name":"actor_face","args":[782,0,1]},{"op":51,"name":"actor_face","args":[837,0,1]},{"op":51,"name":"actor_face","args":[72,0,1]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&祝融\n對了，這到底是怎麼回事？"]},{"op":20,"name":"dialog","args":["&吕舞衣\n莫非那小鬼根本就不是師父的徒弟？"]},{"op":20,"name":"dialog","args":["&左慈\n哼。"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,797,0,73,56,1]},{"op":52,"name":"actor_action","args":[797,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&左慈\n那小子的確是我的徒弟，\n可是他背叛了我。"]},{"op":20,"name":"dialog","args":["&左慈\n如果不是為師及時趕到，\n你就要被困在其他時空回不來了。"]},{"op":20,"name":"dialog","args":["&吕舞衣\n哼，如此一來關嫣在這個世界\n就會沒人能奈何得了她，對吧？\n那個死小鬼真卑鄙！"]},{"op":51,"name":"actor_face","args":[782,0,2]},{"op":20,"name":"dialog","args":["&马如霜\n嘿嘿，我倒覺得他的點子不錯。\n如果他真的成功了，至少姐就不用\n再看到你這張噁心的臉了。"]},{"op":51,"name":"actor_face","args":[837,0,0]},{"op":20,"name":"dialog","args":["&吕舞衣\n臭女人，你說什麼！？"]},{"op":51,"name":"actor_face","args":[72,3,0]},{"op":20,"name":"dialog","args":["&祝融\n哈哈，如霜說得是。\n而且那小子至少還把我和如霜送回來\n了，可見他良心未泯嘛。"]},{"op":20,"name":"dialog","args":["&马如霜\n是啊，一定是這個姓呂的平常都沒做\n善事，所以被針對了。"]},{"op":51,"name":"actor_face","args":[837,0,2]},{"op":20,"name":"dialog","args":["&吕舞衣\n閉嘴！你們這兩個自私的卑鄙小人！"]},{"op":20,"name":"dialog","args":["&马如霜\n哈哈哈哈哈哈！"]},{"op":20,"name":"dialog","args":["&左慈\n哼，看樣子你們之間的衝突根本沒有\n調解，反而還激化矛盾了。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[782,0,1]},{"op":51,"name":"actor_face","args":[837,0,1]},{"op":51,"name":"actor_face","args":[72,0,1]},{"op":20,"name":"dialog","args":["&吕舞衣\n對了，為什麼那個小鬼會擁有那面\n魔鏡啊？真的是師父給他的嗎？"]},{"op":20,"name":"dialog","args":["&左慈\n…………………"]},{"op":9,"name":"delay","args":[5]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":1,"name":"if","args":[],"off":3359,"cond":{"op":2,"name":"comment","args":["賣萌小子的詭計"]},"end":205,"end_off":5146},{"op":36,"name":"play_sound","args":[18]},{"op":39,"name":"change_scene","args":[2,65535,65535,145,65535]},{"op":48,"name":"actor_appear","args":[781,60,50,3,0]},{"op":23,"name":"place_name","args":["深山"]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":56,"name":"set_attr","args":[781,15,0,334]},{"op":20,"name":"dialog","args":["&卖萌小子\n嗚嗚，嗚嗚………"]},{"op":20,"name":"dialog","args":["&左慈\n怎麼回事？"]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[797,86,50,3,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[781,0,1]},{"op":20,"name":"dialog","args":["&卖萌小子\n師父………"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,797,0,66,50,3]},{"op":52,"name":"actor_action","args":[797,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&左慈\n說吧，你又惹了什麼禍啦？"]},{"op":20,"name":"dialog","args":["&卖萌小子\n我…我……\n師父，對不起，我做了不好的事。"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[781,0,2]},{"op":20,"name":"dialog","args":["&卖萌小子\n嗚嗚………我偷了一個人的東西，\n我的良心正受到折磨，我真的好後悔！"]},{"op":52,"name":"actor_action","args":[797,3]},{"op":20,"name":"dialog","args":["&左慈\n唉，你怎麼這麼糊塗呢？\n偷竊是不對的，你真的錯大了。"]},{"op":52,"name":"actor_action","args":[797,0]},{"op":20,"name":"dialog","args":["&左慈\n快把東西還給人家吧。\n只要你把東西歸還，並且誠心的道歉，\n對方應該會原諒你的。"]},{"op":51,"name":"actor_face","args":[781,0,1]},{"op":20,"name":"dialog","args":["&卖萌小子\n可是我會害怕呀！\n萬一那個人不原諒我怎麼辦？"]},{"op":20,"name":"dialog","args":["&卖萌小子\n這樣吧，師父，\n我把偷來的東西交給你，\n你幫我處理好不好？"]},{"op":20,"name":"dialog","args":["&左慈\n胡說！你怎麼能把偷來的東西交給我呢？\n快點把它還給失主，然後道歉！快去！"]},{"op":56,"name":"set_attr","args":[781,15,0,336]},{"op":20,"name":"dialog","args":["&卖萌小子\n可是……\n其實我已經試圖把偷來的東西還給失主了，\n可是他說他不要了。"]},{"op":52,"name":"actor_action","args":[797,3]},{"op":20,"name":"dialog","args":["&左慈\n喔？是這樣嗎？"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[797,0]},{"op":20,"name":"dialog","args":["&左慈\n那麼你就自己收著吧，\n失主的意思是他把東西給你了。"]},{"op":52,"name":"actor_action","args":[781,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n啊？他是那個意思嗎？"]},{"op":20,"name":"dialog","args":["&左慈\n呵呵，這是當然的。\n因為你已經試著還給他了，\n可是他拒絕了嘛。"]},{"op":52,"name":"actor_action","args":[781,0]},{"op":20,"name":"dialog","args":["&卖萌小子\n是這樣嗎………"]},{"op":9,"name":"delay","args":[5]},{"op":56,"name":"set_attr","args":[781,15,0,333]},{"op":52,"name":"actor_action","args":[781,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n原來是這樣啊！真是太好了。\n謝謝師父的開導！"]},{"op":20,"name":"dialog","args":["&左慈\n呵呵，下次可不能再偷東西了喔。"]},{"op":52,"name":"actor_action","args":[781,0]},{"op":20,"name":"dialog","args":["&卖萌小子\n是！"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,781,0,60,53,1]},{"op":52,"name":"actor_action","args":[781,0]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,781,0,70,53,1]},{"op":51,"name":"actor_face","args":[797,0,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,781,0,90,53,1]},{"op":49,"name":"actor_select","args":[65535,781,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&左慈\n呵呵，這小子也太單純了。"]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["然而，賣萌小子從那天之後就失蹤了。\n後來左慈發現自己珍藏的法寶──「保\n你命三千」被偷，犯人是誰不言而喻。"]},{"op":9,"name":"delay","args":[3]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[61]},{"op":39,"name":"change_scene","args":[2,65535,65535,18,65535]},{"op":23,"name":"place_name","args":["鄴 呂舞衣軍軍營"]},{"op":48,"name":"actor_appear","args":[782,66,52,1,0]},{"op":48,"name":"actor_appear","args":[72,66,60,1,0]},{"op":48,"name":"actor_appear","args":[837,66,56,1,0]},{"op":48,"name":"actor_appear","args":[797,73,56,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[61]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&左慈\n…………那不是重點。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[797,3,3]},{"op":20,"name":"dialog","args":["&左慈\n總之，那小子已經投降了許子將，\n也等同於是自甘墮落成曹操的同路人，\n我們沒必要對他手下留情。"]},{"op":20,"name":"dialog","args":["&左慈\n我打算把許子將他們引來一網打盡，\n你們現在就去做好開打的準備！"]},{"op":51,"name":"actor_face","args":[797,0,3]},{"op":20,"name":"dialog","args":["&马如霜\n我可沒興趣喔。"]},{"op":20,"name":"dialog","args":["&左慈\n喔？"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,782,0,73,52,1]},{"op":52,"name":"actor_action","args":[782,0]},{"op":51,"name":"actor_face","args":[797,0,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&马如霜\n你們這群垃圾，\n要玩就自己留下來玩吧，\n姐不奉陪了。"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,782,0,86,52,1]},{"op":51,"name":"actor_face","args":[797,0,1]},{"op":20,"name":"dialog","args":["&吕舞衣\n站住，馬如霜！\n你想臨陣脫逃嗎？"]},{"op":20,"name":"dialog","args":["&吕舞衣\n你難道不知道在各種作品裡，\n像你這種臨陣脫逃的角色都會\n立刻被殺嗎？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[782,0,3]},{"op":20,"name":"dialog","args":["&马如霜\n少來了，你以為現實是小說嗎？\n姐之所以與你們合作，不外乎是\n想找幾個可靠的隊友而已。"]},{"op":20,"name":"dialog","args":["&马如霜\n誰知道你們這麼遜，\n一個比一個還垃圾，真叫姐失望。"]},{"op":20,"name":"dialog","args":["&祝融\n哼哼。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[782,0,1]},{"op":20,"name":"dialog","args":["&马如霜\n後會無期，垃圾們。"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,782,0,89,52,1]},{"op":20,"name":"dialog","args":["&左慈\n馬如霜，你難道不想親手打敗\n關嫣了嗎？"]},{"op":20,"name":"dialog","args":["&马如霜\n！！！！！"]},{"op":52,"name":"actor_action","args":[782,0]},{"op":20,"name":"dialog","args":["&左慈\n如果你願意幫老夫這個忙，\n老夫就幫你加10個等級，\n如此一來你一定可以戰勝關嫣。"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[797,3]},{"op":20,"name":"dialog","args":["&左慈\n如何？感興趣嗎？"]},{"op":20,"name":"dialog","args":["&马如霜\n………………"]},{"op":9,"name":"delay","args":[8]},{"op":20,"name":"dialog","args":["&马如霜\n哼，姐才不稀罕你能幫上什麼呢。\n不過既然能再次跟關嫣那個小妮子交手，\n姐就再幫一次忙吧。"]},{"op":52,"name":"actor_action","args":[797,0]},{"op":20,"name":"dialog","args":["&左慈\n呵、呵、呵。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[837,0,2]},{"op":20,"name":"dialog","args":["&吕舞衣\n(哼，這傢伙都淪落到這個地步了還\n這麼跩，真是死鴨子嘴硬。)"]},{"op":52,"name":"actor_action","args":[72,3]},{"op":20,"name":"dialog","args":["&祝融\n哈哈，看樣子事情越來越有趣了。 ^O^"]},{"op":9,"name":"delay","args":[3]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6742,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":468,"end_off":11952},{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":56,"name":"set_attr","args":[782,15,0,323]},{"op":56,"name":"set_attr","args":[804,15,0,275]},{"op":56,"name":"set_attr","args":[781,15,0,333]},{"op":53,"name":"set_r_image","args":[17,203]},{"op":1,"name":"if","args":[],"off":6836,"cond":{"op":2,"name":"comment","args":["貂蟬換頭像"]},"end":285,"end_off":6971},{"op":1,"name":"if","args":[],"off":6855,"cond":{"op":5,"name":"test_flags","args":[[1845],[]]},"end":278,"end_off":6893},{"op":56,"name":"set_attr","args":[17,15,0,242]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6893,"cond":{"op":5,"name":"test_flags","args":[[1846],[]]},"end":281,"end_off":6931},{"op":56,"name":"set_attr","args":[17,15,0,328]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6931,"cond":{"op":5,"name":"test_flags","args":[[1847],[]]},"end":284,"end_off":6969},{"op":56,"name":"set_attr","args":[17,15,0,329]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":117,"name":"set_s_image","args":[35,204]},{"op":36,"name":"play_sound","args":[86]},{"op":39,"name":"change_scene","args":[2,65535,65535,41,65535]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["蔡琰的寢室"]},{"op":24,"name":"title_text","args":["左慈的陰謀"]},{"op":9,"name":"delay","args":[5]},{"op":48,"name":"actor_appear","args":[804,52,62,1,0]},{"op":48,"name":"actor_appear","args":[17,52,56,1,0]},{"op":48,"name":"actor_appear","args":[781,52,59,1,0]},{"op":48,"name":"actor_appear","args":[157,58,56,3,0]},{"op":48,"name":"actor_appear","args":[829,58,62,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[804,0,0]},{"op":20,"name":"dialog","args":["&蔡琰\n欸？剛剛到底發生了什麼事？"]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":20,"name":"dialog","args":["&貂蝉\n我也不清楚欸。"]},{"op":20,"name":"dialog","args":["&卖萌小子\n嘻嘻。"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[0,781,0,55,59,1]},{"op":52,"name":"actor_action","args":[781,0]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[0,804,0,52,61,1]},{"op":50,"name":"actor_move","args":[0,17,0,52,57,1]},{"op":52,"name":"actor_action","args":[804,0]},{"op":52,"name":"actor_action","args":[17,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[781,3,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n兩個大姐姐都好漂亮喔，\n一定有很多人追對不對？"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[804,0,1]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":20,"name":"dialog","args":["&蔡琰\n啊？"]},{"op":20,"name":"dialog","args":["&貂蝉\n這個……"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[804,6,1]},{"op":20,"name":"dialog","args":["&蔡琰\n不好意思，請問您的名字是什麼呢？"]},{"op":52,"name":"actor_action","args":[781,0]},{"op":20,"name":"dialog","args":["&卖萌小子\n嘿嘿，我叫什麼不重要啦。\n你們就跟其他人一樣，\n叫我「小朋友」就行了。"]},{"op":52,"name":"actor_action","args":[804,0]},{"op":20,"name":"dialog","args":["&蔡琰\n小朋友……？"]},{"op":52,"name":"actor_action","args":[781,0]},{"op":52,"name":"actor_action","args":[17,3]},{"op":20,"name":"dialog","args":["&貂蝉\n對了，小朋友你跟呂舞衣她們是\n什麼關係呢？她們可不是好人，\n你可別被她們的外表給欺騙啊。"]},{"op":20,"name":"dialog","args":["&许子将\n呵呵。\n(真不曉得是誰騙誰呢。)"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[157,6]},{"op":20,"name":"dialog","args":["&许子将\n我來說明一下這個孩子的來歷。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[781,0,1]},{"op":51,"name":"actor_face","args":[829,0,0]},{"op":52,"name":"actor_action","args":[157,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&许子将\n這個孩子本是我的徒弟。\n他的天賦很高，可是卻不太認真。"]},{"op":20,"name":"dialog","args":["&许子将\n後來，一個叫左慈的修道人打算要\n設法消滅曹丞相。為了達到這個目的，\n他可說是非常的不擇手段。"]},{"op":20,"name":"dialog","args":["&蔡琰\n左慈？莫非就是我和貂蟬上次在攘山\n看到的老人？"]},{"op":20,"name":"dialog","args":["&许子将\n大概是吧。\n雖然我當時不在現場，\n可是應該是他沒錯。"]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":20,"name":"dialog","args":["&貂蝉\n根據關嫣的說法，那個老人是舞衣\n的師父，他可不是個好人呀。"]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":20,"name":"dialog","args":["&许子将\n由於左慈的個性非常偏執，\n我擔心他會採用更極端的手段，"]},{"op":20,"name":"dialog","args":["&许子将\n所以我派遣這個孩子拜左慈為師，\n藉此告訴我左慈的行動。"]},{"op":51,"name":"actor_face","args":[781,3,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n後來的事你們也知道了，我表面上在\n幫助舞衣姐姐她們調解糾紛，其實\n是在讓她們更加不合。"]},{"op":20,"name":"dialog","args":["&卖萌小子\n然後我把她們騙到未來的平行時空，\n趁機把舞衣姐姐留在那裡，\n這樣她就不會去妨礙這邊的關嫣姐姐啦。"]},{"op":51,"name":"actor_face","args":[829,3,3]},{"op":20,"name":"dialog","args":["&王朗\n然後呢？你表面上要幫呂舞衣傳功，\n其實是讓她的身體承受不住，\n進而武功大減嗎？真沒道義！"]},{"op":51,"name":"actor_face","args":[157,0,2]},{"op":51,"name":"actor_face","args":[781,3,1]},{"op":20,"name":"dialog","args":["&卖萌小子\n反正舞衣姐姐本來就不是好人，\n讓她更不能做惡不是更好嗎？"]},{"op":52,"name":"actor_action","args":[829,0]},{"op":20,"name":"dialog","args":["&王朗\n胡說！也許呂舞衣不是個好人，\n但是你的行為又比她高尚多少呢？"]},{"op":20,"name":"dialog","args":["&王朗\n說白了，你只不過是黑吃黑，\n根本就不足取！"]},{"op":20,"name":"dialog","args":["&蔡琰\n………………"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[781,3,1]},{"op":20,"name":"dialog","args":["&卖萌小子\n哇啊，你真的好正直喔！\n大家都說王大人是一個正義又古道熱腸\n的聖人，今日一見果然名不虛傳！"]},{"op":51,"name":"actor_face","args":[829,0,1]},{"op":20,"name":"dialog","args":["&王朗\n哼，少巴結我了。\n老夫不會這麼輕易的被你巴結的。"]},{"op":20,"name":"dialog","args":["&卖萌小子\n啊，被你識破了嗎？\n哈哈………"]},{"op":51,"name":"actor_face","args":[781,0,1]},{"op":20,"name":"dialog","args":["&卖萌小子\n沒辦法啊，世人不都喜歡別人巴結。\n像王大人這樣不喜歡別人戴高帽的人\n真的少之又少，這就是現實啊。"]},{"op":51,"name":"actor_face","args":[829,0,3]},{"op":51,"name":"actor_face","args":[157,0,3]},{"op":20,"name":"dialog","args":["&王朗\n唉，你說的倒也是事實啊。\n世道就是如此，所以老夫有必要出來\n匡正世風啊。"]},{"op":51,"name":"actor_face","args":[781,3,1]},{"op":20,"name":"dialog","args":["&卖萌小子\n了不起！了不起！"]},{"op":20,"name":"dialog","args":["&蔡琰\n………………"]},{"op":51,"name":"actor_face","args":[781,0,1]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[781,0,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n對了，其實我也有學過法術啦。\n我最擅長的就是「讀心術」，\n超好用的喔！"]},{"op":20,"name":"dialog","args":["&卖萌小子\n只要我把手放在你們心臟前面的位置，\n我就可以讀出你們內心真正的想法。"]},{"op":51,"name":"actor_face","args":[781,3,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n來吧，要不要試試看呢？"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[804,4]},{"op":20,"name":"dialog","args":["&蔡琰\n不，我不用了。"]},{"op":52,"name":"actor_action","args":[17,3]},{"op":20,"name":"dialog","args":["&貂蝉\n我也不必了。"]},{"op":52,"name":"actor_action","args":[804,0]},{"op":52,"name":"actor_action","args":[17,0]},{"op":51,"name":"actor_face","args":[781,0,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n那好吧，如果有需要的話隨時找我，\n我馬上會幫你們服務喔。"]},{"op":20,"name":"dialog","args":["&卖萌小子\n對了，你們最近是否會腰痠背痛呢？"]},{"op":20,"name":"dialog","args":["&卖萌小子\n其實我也很擅長按摩，也很會擦背，\n歡迎你們洗澡的時候找我幫忙。"]},{"op":52,"name":"actor_action","args":[17,3]},{"op":20,"name":"dialog","args":["&貂蝉\n是嗎？那麼等一下就麻煩你了。"]},{"op":52,"name":"actor_action","args":[804,5]},{"op":20,"name":"dialog","args":["&蔡琰\n！！！！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[804,0,0]},{"op":20,"name":"dialog","args":["&蔡琰\n不行！"]},{"op":51,"name":"actor_face","args":[17,3,2]},{"op":20,"name":"dialog","args":["&貂蝉\n唉呀，有什麼關係呢？\n他只是個孩子而已呀。"]},{"op":20,"name":"dialog","args":["&蔡琰\n對，他只是一個孩子，\n所以請不要放縱他！！！"]},{"op":51,"name":"actor_face","args":[157,3,3]},{"op":20,"name":"dialog","args":["&许子将\n哈哈哈哈哈哈！"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[157,0,3]},{"op":20,"name":"dialog","args":["&许子将\n好了，我們還是先討論正事吧。"]},{"op":20,"name":"dialog","args":["&许子将\n現在附近正瀰漫著一股妖氣，\n我想是左慈在搞鬼，我們要儘快阻止他。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[157,0,1]},{"op":51,"name":"actor_face","args":[804,0,1]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":51,"name":"actor_face","args":[781,0,1]},{"op":51,"name":"actor_face","args":[829,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[157,3]},{"op":20,"name":"dialog","args":["&许子将\n出來吧，同伴們！"]},{"op":52,"name":"actor_action","args":[157,0]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[800,66,56,3,0]},{"op":48,"name":"actor_appear","args":[35,66,62,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&貂蝉\n啊！是關姑娘！"]},{"op":52,"name":"actor_action","args":[804,5]},{"op":20,"name":"dialog","args":["&蔡琰\n還有那個誰！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[35,17]},{"op":20,"name":"dialog","args":["&诸葛亮\n喂喂喂，不認識我就算了，別裝熟啊。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":52,"name":"actor_action","args":[804,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[157,0,2]},{"op":51,"name":"actor_face","args":[829,0,0]},{"op":1,"name":"if","args":[],"off":11066,"cond":{"op":2,"name":"comment","args":["設置地雷"]},"end":461,"end_off":11730},{"op":20,"name":"dialog","args":["&许子将\n由於我們這次要面對的是仙人，\n破例使用一點點未來的武器吧。"]},{"op":20,"name":"dialog","args":["&蔡琰\n未來的武器？"]},{"op":20,"name":"dialog","args":["&许子将\n地雷功能開啟。"]},{"op":119,"name":"int_var_op","args":[2,4089,2,0,0]},{"op":119,"name":"int_var_op","args":[2,4090,2,0,0]},{"op":119,"name":"int_var_op","args":[2,4091,2,0,0]},{"op":119,"name":"int_var_op","args":[2,4092,2,0,0]},{"op":119,"name":"int_var_op","args":[2,4093,2,0,1]},{"op":61,"name":"get_item","args":[200,2,0,65535]},{"op":61,"name":"get_item","args":[203,0,0,65535]},{"op":61,"name":"get_item","args":[206,0,0,65535]},{"op":1,"name":"if","args":[],"off":11387,"cond":{"op":5,"name":"test_flags","args":[[1040],[]]},"end":450,"end_off":11423},{"op":61,"name":"get_item","args":[207,0,0,65535]},{"op":0,"name":"end","args":[]},{"op":61,"name":"get_item","args":[208,2,0,65535]},{"op":61,"name":"get_item","args":[209,0,0,65535]},{"op":61,"name":"get_item","args":[210,0,0,65535]},{"op":61,"name":"get_item","args":[211,0,0,65535]},{"op":61,"name":"get_item","args":[212,0,0,65535]},{"op":61,"name":"get_item","args":[213,0,0,65535]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["注意：擁有「穿越移動」技能或道具\n的武將必須慎重移動。"]},{"op":22,"name":"info","args":["如果此人在經過他人時踩到地雷，\n而且地雷的上方站著其他人，\n那麼他在引爆地雷時會令對方憑空消失！"]},{"op":22,"name":"info","args":["因此，請自行避免這樣的Bug。"]},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[15]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,2,0,1,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":11954,"sections":[{"index":0,"offset":11956,"title":"玩家切换","body_off":11977,"body_end":12078,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[157,3]},{"op":20,"name":"dialog","args":["&许子将\n出發吧。"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":12078,"title":"玩家切换","body_off":12103,"body_end":12242,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[804]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[804,0,2]},{"op":20,"name":"dialog","args":["&蔡琰\n(目前發生在我身邊的事情究竟\n是不是夢呢？)"]},{"op":51,"name":"actor_face","args":[804,0,1]},{"op":20,"name":"dialog","args":["&蔡琰\n(莫非過去才是作夢，現在才是現實？)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":12242,"title":"玩家切换","body_off":12267,"body_end":12454,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[17]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&貂蝉\n奇怪，我總有一種不祥的預感……"]},{"op":51,"name":"actor_face","args":[804,0,0]},{"op":20,"name":"dialog","args":["&蔡琰\n是啊，總覺得胸口悶悶的。"]},{"op":51,"name":"actor_face","args":[804,0,1]},{"op":51,"name":"actor_face","args":[829,3,3]},{"op":20,"name":"dialog","args":["&王朗\n難道大家不覺得心裡毛毛的嗎！？"]},{"op":51,"name":"actor_face","args":[829,0,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":12454,"title":"玩家切换","body_off":12479,"body_end":12975,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[829]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[829,3,0]},{"op":20,"name":"dialog","args":["&王朗\n且看老夫如何大顯身手！"]},{"op":51,"name":"actor_face","args":[804,0,3]},{"op":20,"name":"dialog","args":["&蔡琰\n嗯，加油。"]},{"op":51,"name":"actor_face","args":[829,3,3]},{"op":20,"name":"dialog","args":["&王朗\n總之，相信老夫就對了。就是這麼簡單！"]},{"op":51,"name":"actor_face","args":[829,0,3]},{"op":51,"name":"actor_face","args":[804,0,1]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n您就是王大人吧？久仰大名了。"]},{"op":51,"name":"actor_face","args":[829,3,1]},{"op":20,"name":"dialog","args":["&王朗\n喔，孔明先生原來聽說過老夫的事蹟嗎？\n那可真是老夫的榮幸啊！"]},{"op":52,"name":"actor_action","args":[35,3]},{"op":20,"name":"dialog","args":["&诸葛亮\n據說您雖然經常碰壁，可是依然嚴\n以律己，堅守聖人的道德規範，\n我從未見過如此高風亮節之人！"]},{"op":51,"name":"actor_face","args":[829,6,1]},{"op":20,"name":"dialog","args":["&王朗\n哈哈，好說好說！"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":51,"name":"actor_face","args":[829,0,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":12975,"title":"玩家切换","body_off":13000,"body_end":13739,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[157]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[157,0,2]},{"op":20,"name":"dialog","args":["&许子将\n抱歉，本關無法進行跳關。"]},{"op":20,"name":"dialog","args":["&蔡琰\n請問許先生，\n您說的地雷要如何使用呢？"]},{"op":51,"name":"actor_face","args":[157,3,2]},{"op":20,"name":"dialog","args":["&许子将\n問得好。地雷的使用方法是在適當\n的位置按下「道具」，並且選擇地雷。"]},{"op":20,"name":"dialog","args":["&许子将\n一旦敵軍踩到了地雷，地雷就會瞬間\n爆炸，令敵人立即停止行動。"]},{"op":20,"name":"dialog","args":["&蔡琰\n這麼厲害？"]},{"op":52,"name":"actor_action","args":[157,0]},{"op":20,"name":"dialog","args":["&许子将\n是的。但是地雷也會傷到自己人，\n而且數量有限，所以不能隨便使用。"]},{"op":20,"name":"dialog","args":["&许子将\n另外，擁有「穿越移動」技能或道具\n的人可要當心了。"]},{"op":20,"name":"dialog","args":["&许子将\n如果此人在經過他人時踩到地雷，\n而且地雷的上方站著其他人，\n那麼他在引爆地雷時會令對方憑空消失！"]},{"op":20,"name":"dialog","args":["&蔡琰\n那也太可怕了吧！"]},{"op":20,"name":"dialog","args":["&许子将\n是的，所以千萬要避免這樣的Bug喔。"]},{"op":20,"name":"dialog","args":["&许子将\n另外，剛剛給你們的鐵鏟可以用來\n起出地雷，起出後的地雷便可用來\n對付敵軍，請善加運用喔。"]},{"op":51,"name":"actor_face","args":[157,0,2]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":13739,"title":"玩家切换","body_off":13764,"body_end":14185,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[781]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[781,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n雖然我出場的時間不長，\n但是我很開心喔！"]},{"op":52,"name":"actor_action","args":[781,0]},{"op":20,"name":"dialog","args":["&蔡琰\n對了，小朋友你曾故意灌給呂舞衣\n體質不合的功力，讓她當時力量衰退吧？"]},{"op":51,"name":"actor_face","args":[781,0,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n嗯，對啊。"]},{"op":20,"name":"dialog","args":["&蔡琰\n那麼，你也用同樣的方法對付馬如霜和\n祝融了嗎？"]},{"op":51,"name":"actor_face","args":[781,3,3]},{"op":20,"name":"dialog","args":["&卖萌小子\n欸欸欸，這倒是沒有欸。\n她們對我蠻友善的，我不想害她們啦。"]},{"op":51,"name":"actor_face","args":[781,0,3]},{"op":20,"name":"dialog","args":["&蔡琰\n這樣啊。"]},{"op":20,"name":"dialog","args":["&蔡琰\n(呼，看來他也有善良的地方呢。)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":14185,"title":"玩家切换","body_off":14210,"body_end":14369,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[800]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[800,2,3]},{"op":20,"name":"dialog","args":["&关嫣\n我一定要親手了結掉呂舞衣！"]},{"op":51,"name":"actor_face","args":[17,6,1]},{"op":20,"name":"dialog","args":["&貂蝉\n關姑娘別衝動啊！"]},{"op":51,"name":"actor_face","args":[17,0,1]},{"op":20,"name":"dialog","args":["&许子将\n………………"]},{"op":51,"name":"actor_face","args":[800,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":14369,"title":"玩家切换","body_off":14394,"body_end":14632,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[35]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n妖氣越來越強烈了。\n這次要面對的對手可能不是人。"]},{"op":20,"name":"dialog","args":["&蔡琰\n啊？對手不是人，難道是鬼嗎？"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n就怕真是如此。"]},{"op":51,"name":"actor_face","args":[800,3,2]},{"op":20,"name":"dialog","args":["&关嫣\n沒差！\n管他是人也好，鬼也好，我都不怕！"]},{"op":51,"name":"actor_face","args":[800,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}