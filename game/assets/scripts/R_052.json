r_select","args":[65535,549,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,550,0,0,0,0,65535]},{"op":48,"name":"actor_appear","args":[545,57,45,2,0]},{"op":48,"name":"actor_appear","args":[546,53,45,2,0]},{"op":48,"name":"actor_appear","args":[547,61,45,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&凌霄\n如何？考慮得怎麼樣了？"]},{"op":20,"name":"dialog","args":["&孙尚香\n………………"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[845,6]},{"op":9,"name":"delay","args":[8]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":56,"name":"set_attr","args":[845,15,0,222]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":4919,"sections":[{"index":0,"offset":4921,"title":"四个祭坛","body_off":4940,"body_end":6551,"conditions":[{"op":2,"name":"comment","args":["四个祭坛"]},{"op":0,"name":"end","args":[]}],"body":[{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,52,65535]},{"op":103,"name":"chapter_title","args":[4,"魔王复活"]},{"op":39,"name":"change_scene","args":[2,65535,65535,53,65535]},{"op":48,"name":"actor_appear","args":[0,54,80,0,0]},{"op":48,"name":"actor_appear","args":[20,64,64,3,0]},{"op":48,"name":"actor_appear","args":[19,64,58,3,0]},{"op":48,"name":"actor_appear","args":[21,64,52,3,0]},{"op":48,"name":"actor_appear","args":[1,44,64,1,0]},{"op":48,"name":"actor_appear","args":[3,44,58,1,0]},{"op":48,"name":"actor_appear","args":[17,44,52,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[203,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["前往蜀国！"]},{"op":23,"name":"place_name","args":["建业  曹操军主营"]},{"op":51,"name":"actor_face","args":[19,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n孔明被魔王附体一事，\n实在不可思议，\n不过………"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯，我也这么想。\n不过孔明的这些失常的行径，\n也的确只有恶魔才做得出来。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n周瑜死前所说的话，让人不得不信。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n他说孔明要在天下建造四个祭坛，\n进行祈祷以便唤醒魔王的力量。\n&曹操\n四个祭坛的祈祷一旦全部完成，\n就会恢复魔王原本的魔力。"]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n孔明…不，应该说是魔王，\n他的目的就在于此。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n四个祭坛……\n其中一个就是在赤壁发现的祭坛。"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[21,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n那么剩下的三个祭坛位于何处？"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&曹操\n还有一个位于许都。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n什么，许都！？\n就在我们的根据地？"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n马上通知许都，\n禁止一切可疑人等进入。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n许都有徐庶镇守，\n马上让他严加戒备吧。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&曹操\n还有两个在西方。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n我看应该在蜀国领地内。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯……不过目前还无法确定。\n对了，仲达。"]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n在。"]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n正式命你前去调查。\n查探祭坛的位置。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&司马懿\n是。"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n大家听着！\n绝不能让魔王复活！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n全军即刻行军，\n讨伐蜀国！\n一定要消灭孔明！"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[203,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":6551,"sections":[{"index":0,"offset":6553,"title":"鱼腹浦的圈套","body_off":6576,"body_end":8496,"conditions":[{"op":2,"name":"comment","args":["鱼腹浦的圈套"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,471,198]},{"op":41,"name":"op_29","args":[76,535,198]},{"op":44,"name":"caption","args":["曹操进攻建业，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":43,"name":"op_2b","args":[76]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["终于消灭了东吴。",1,0,0]},{"op":9,"name":"delay","args":[10]},{"op":44,"name":"caption","args":["周瑜临死前说出了",1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["四个祭坛之谜。",1,0,0]},{"op":9,"name":"delay","args":[10]},{"op":44,"name":"caption","args":["曹操为了阻止魔王复活，",1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[0,240,220]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["挥兵赶往蜀国。",1,0,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,46,65535]},{"op":48,"name":"actor_appear","args":[35,53,71,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[204,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["白帝城  孔明公馆"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[35,11]},{"op":20,"name":"dialog","args":["&诸葛亮\n周瑜位于东方天际的将星已落。\n哼，周瑜小辈终于死了。\n&诸葛亮\n反正他不过是我的一个棋子。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n……呜！！"]},{"op":52,"name":"actor_action","args":[35,8]},{"op":20,"name":"dialog","args":["&诸葛亮\n哇啊啊！\n是……是孔、孔明的魂魄……！\n哇啊啊啊！"]},{"op":52,"name":"actor_action","args":[35,12]},{"op":20,"name":"dialog","args":["&诸葛亮\n孔、孔明……\n你想反过来支配我吗！？\n太小看我了！"]},{"op":48,"name":"actor_appear","args":[69,53,5,2,0]},{"op":20,"name":"dialog","args":["&姜维\n军师？"]},{"op":52,"name":"actor_action","args":[35,8]},{"op":20,"name":"dialog","args":["&诸葛亮\n姜、姜维……？糟、糟了！"]},{"op":52,"name":"actor_action","args":[35,12]},{"op":20,"name":"dialog","args":["&诸葛亮\n唔哇！"]},{"op":52,"name":"actor_action","args":[35,8]},{"op":20,"name":"dialog","args":["&诸葛亮\n…嗄、嗄、嗄……\n哼、该死的孔明……\n竟然还想挣扎！？"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n我这个魔王虽然尚未复活，\n但也绝不会被凡人的灵魂控制……\n&姜维\n军师，我是姜维。\n可以进来吗？"]},{"op":51,"name":"actor_face","args":[35,0,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n哦、哦是姜维啊？\n快进来吧。\n&姜维\n打扰了。"]},{"op":50,"name":"actor_move","args":[65535,69,0,53,55,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[69,6]},{"op":20,"name":"dialog","args":["&姜维\n孔明先生，您刚才怎么了？\n我好像听见了呻吟声。"]},{"op":52,"name":"actor_action","args":[69,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":20,"name":"dialog","args":["&诸葛亮\n呃，没什么。\n你不用在意。\n倒是你……有何事？"]},{"op":52,"name":"actor_action","args":[69,6]},{"op":20,"name":"dialog","args":["&姜维\n噢，对了。\n刚才接到军情报告，\n曹操已经消灭了东吴。"]},{"op":51,"name":"actor_face","args":[35,0,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n是吗……\n东吴灭亡了？\n&姜维\n孙权、周瑜还有其他主要将领皆已战死。\n&诸葛亮\n嗯。\n&姜维\n而且曹军目前乘势追击，\n已经前来攻打我蜀国。"]},{"op":52,"name":"actor_action","args":[69,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":20,"name":"dialog","args":["&诸葛亮\n原来如此……\n那么我们也必须行动了。"]},{"op":51,"name":"actor_face","args":[35,0,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n我将即刻前往鱼腹浦。\n&诸葛亮\n你留在此地继续完成祈祷的准备。\n绝不能有任何差错。"]},{"op":52,"name":"actor_action","args":[69,6]},{"op":20,"name":"dialog","args":["&姜维\n是。"]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[35,11]},{"op":20,"name":"dialog","args":["&诸葛亮\n为了继承先主复兴汉室的遗志，\n如今只有通过祈祷修得秘术了。\n&姜维\n姜维明白。\n请您放心。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[204,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":8496,"sections":[{"index":0,"offset":8498,"title":"要军会议  鱼腹浦之战前","body_off":8531,"body_end":14706,"conditions":[{"op":2,"name":"comment","args":["要军会议  鱼腹浦之战前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":8531,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":3,"end_off":8578},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":8578,"cond":{"op":2,"name":"comment","args":["甄宓能力刷新2"]},"end":68,"end_off":9705},{"op":1,"name":"if","args":[],"off":8600,"cond":{"op":5,"name":"test_flags","args":[[530],[1280]]},"end":67,"end_off":9703},{"op":119,"name":"int_var_op","args":[2,4076,2,0,0]},{"op":119,"name":"int_var_op","args":[2,200,2,0,137]},{"op":1,"name":"if","args":[],"off":8670,"cond":{"op":2,"name":"comment","args":["甄宓能力+裝備記錄"]},"end":31,"end_off":9118}