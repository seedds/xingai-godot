r_appear","args":[19,39,58,1,0]},{"op":48,"name":"actor_appear","args":[24,39,70,1,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":566,"cond":{"op":5,"name":"test_flags","args":[[1280],[]]},"end":26,"end_off":610},{"op":48,"name":"actor_appear","args":[119,69,64,3,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":610,"cond":{"op":5,"name":"test_flags","args":[[1290],[]]},"end":29,"end_off":654},{"op":48,"name":"actor_appear","args":[15,69,64,3,0]},{"op":0,"name":"end","args":[]},{"op":28,"name":"fade_out","args":[]},{"op":24,"name":"title_text","args":["孔明的计策"]},{"op":23,"name":"place_name","args":["汉中  临时相府"]},{"op":20,"name":"dialog","args":["&曹操\n庞德，像你这般勇猛的武将，\n如果死在这里就太可惜了，\n不如为我效力吧？\n&庞德\n张鲁大人呢？\n&曹操\n嗯，我已经下令保护他和他的家人。\n&庞德\n是吗？谢曹大人。\n不过我的心意未改，\n请杀了我吧。"]},{"op":20,"name":"dialog","args":["&曹操\n庞德，你恨我吗？\n就因为我杀了你的故主马腾？"]},{"op":52,"name":"actor_action","args":[9,6]},{"op":20,"name":"dialog","args":["&庞德\n我庞德并非无情无义之人，\n只不过身为一个武将，\n为故主尽忠义之道罢了。"]},{"op":52,"name":"actor_action","args":[9,0]},{"op":20,"name":"dialog","args":["&曹操\n是吗……？\n&庞德\n不必多说了，\n快把我杀了吧！"]},{"op":52,"name":"actor_action","args":[0,2]},{"op":56,"name":"set_attr","args":[0,15,0,257]},{"op":20,"name":"dialog","args":["&曹操\n住口！\n你的生死由我来决定，\n你没有选择的余地。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":20,"name":"dialog","args":["&曹操\n我不杀你。\n我要你做我营中的武将，\n为我的霸业出力。\n&庞德\n让我呆在你身边，难道你不害怕吗！\n我会杀了你的！\n&曹操\n哦？我听说庞德是个武艺高强的武将，\n应该不会使用暗杀这种卑劣的手段。\n&庞德\n………\n好！我就当你的属下，\n让我看清你曹操是什么样的人物。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。\n元让，给庞德安排住处。"]},{"op":51,"name":"actor_face","args":[1,0,0]},{"op":20,"name":"dialog","args":["&夏侯惇\n喔，知道啦。"]},{"op":51,"name":"actor_face","args":[1,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":20,"name":"dialog","args":["&曹操\n庞德，好好为我效力，\n你会了解我的志向的。"]},{"op":59,"name":"join","args":[9,0,0]},{"op":1,"name":"if","args":[],"off":1690,"cond":{"op":5,"name":"test_flags","args":[[777,1826],[]]},"end":82,"end_off":2219},{"op":9,"name":"delay","args":[3]},{"op":105,"name":"popup","args":["請選擇龐德的兵種。"]},{"op":22,"name":"info","args":["可以選擇讓龐德擔任白馬騎，\n如果龐德維持步兵，將獲得50點防禦力\n和50點HP上限。"]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":1828,"cond":{"op":18,"name":"choice","args":["讓龐德擔任步兵\n讓龐德擔任白馬騎",0]},"end":81,"end_off":2217},{"op":1,"name":"if","args":[],"off":1872,"cond":{"op":19,"name":"test_choice","args":[1]},"end":69,"end_off":2028},{"op":105,"name":"popup","args":["龐德的兵種是步兵，並獲得50點防禦力。"]},{"op":56,"name":"set_attr","args":[9,1,1,50]},{"op":105,"name":"popup","args":["龐德的HP上限提高50。"]},{"op":56,"name":"set_attr","args":[9,5,1,50]},{"op":117,"name":"set_s_image","args":[9,60]},{"op":62,"name":"set_equipment","args":[9,65535,65535,65535,65535,12]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2028,"cond":{"op":19,"name":"test_choice","args":[2]},"end":80,"end_off":2215},{"op":117,"name":"set_s_image","args":[9,65]},{"op":119,"name":"int_var_op","args":[2,4081,2,0,1]},{"op":82,"name":"op_52","args":[9,63]},{"op":119,"name":"int_var_op","args":[2,4081,2,0,0]},{"op":105,"name":"popup","args":["龐德的兵種是白馬騎。"]},{"op":56,"name":"set_attr","args":[9,5,1,150]},{"op":62,"name":"set_equipment","args":[9,0,0,0,0,0]},{"op":61,"name":"get_item","args":[119,0,0,65535]},{"op":11,"name":"set_flag","args":[1828,1]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2219,"cond":{"op":5,"name":"test_flags","args":[[777],[1826]]},"end":107,"end_off":2687},{"op":9,"name":"delay","args":[3]},{"op":105,"name":"popup","args":["請選擇龐德的兵種。"]},{"op":22,"name":"info","args":["可以選擇讓龐德擔任白馬騎，\n如果龐德維持步兵，\n將獲得50點HP上限。"]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":234