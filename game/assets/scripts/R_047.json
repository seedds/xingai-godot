et_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":13170,"title":"玩家切换","body_off":13195,"body_end":13362,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n不过再怎么说，关羽单骑救援的行动，\n太有勇无谋了。\n&曹操\n这证明他们三兄弟的感情非常深厚。\n&曹操\n对于关羽个人来说，\n是否有胜算已经无关紧要了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":13362,"title":"玩家切换","body_off":13387,"body_end":13503,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许褚\n总，总觉得好像有一股寒气。\n这，这到底怎么回事？\n&曹操\n你害怕啦？许褚。\n&许褚\n没，没这回事。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":13503,"title":"玩家切换","body_off":13528,"body_end":13691,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[17]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹操\n貂蝉，黄巾教徒的细作是怎么回事？\n&貂蝉\n他们是小女子已逝双亲的故友。\n&貂蝉\n当初小女子劝降张鲁时，\n曾经得到他们的协助。\n&曹操\n哦，原来如此。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":13691,"title":"玩家切换","body_off":13716,"body_end":13886,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[23]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&贾诩\n不论东吴大军如何强大，\n守麦城的毕竟是虎将张飞。\n&贾诩\n照理说应该不会轻易失陷的，不过……\n&曹操\n不过孔明如果谋反，\n事情就难说了是吗？\n&贾诩\n是的。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":13886,"title":"玩家切换(觸發596後)","body_off":13922,"body_end":14718,"conditions":[{"op":2,"name":"comment","args":["玩家切换(觸發596後)"]},{"op":45,"name":"test_clicked","args":[804]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n昭姬姑娘會想參加到前線作戰，\n想必是下了很大的決心吧。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[804,6]},{"op":20,"name":"dialog","args":["&蔡琰\n是的。\n過去我因為害怕受傷，\n總是避免自己上戰場。"]},{"op":52,"name":"actor_action","args":[804,0]},{"op":20,"name":"dialog","args":["&蔡琰\n可是自從做了那個夢以後，\n我忽然察覺到我應該要勇於開創自己\n的命運，還請丞相成全！"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n哈哈，當然沒問題了。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n貂蟬，這次可是昭姬第一次到前線作戰，\n你可要多多照顧她呀。"]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n是！"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n對了，請問昭姬姑娘做的是什麼樣\n的夢呢？那個夢肯定很有啟發性。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":52,"name":"actor_action","args":[804,6]},{"op":20,"name":"dialog","args":["&蔡琰\n是。那是一個很長的故事，\n以後我會找時間跟大家分享的。"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n嗯，我會期待的。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":52,"name":"actor_action","args":[804,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[804,0,3]},{"op":20,"name":"dialog","args":["&蔡琰\n(貂蟬！)"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[804,0,2]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}