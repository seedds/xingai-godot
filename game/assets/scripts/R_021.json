e":"actor_action","args":[106,6]},{"op":20,"name":"dialog","args":["&审配\n对手是曹操，我们必须智取。"]},{"op":52,"name":"actor_action","args":[106,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[113,0,1]},{"op":20,"name":"dialog","args":["&袁谭\n哼！全军一起对付曹操就行了，\n不必讲什么计策。\n&袁尚\n兄长，这么做的话，\n恐怕不是曹操的对手。"]},{"op":51,"name":"actor_face","args":[113,0,3]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[113,2,3]},{"op":20,"name":"dialog","args":["&袁谭\n什么！？\n&逢纪\n我也是这么想。"]},{"op":52,"name":"actor_action","args":[113,0]},{"op":20,"name":"dialog","args":["&袁谭\n唔唔唔………\n&袁尚\n首先请大哥、二哥、\n还有郭图、逢纪四人，\n率军与曹军作战吧。"]},{"op":51,"name":"actor_face","args":[102,0,0]},{"op":20,"name":"dialog","args":["&逢纪\n我也要去吗？\n&袁尚\n嗯。"]},{"op":51,"name":"actor_face","args":[102,0,1]},{"op":20,"name":"dialog","args":["&逢纪\n……好吧。\n&袁谭\n袁尚，那你做什么？\n&袁尚\n我和审配接应兄长们。"]},{"op":51,"name":"actor_face","args":[113,0,1]},{"op":20,"name":"dialog","args":["&袁谭\n哼！\n（真是无趣！可恶的袁尚，\n亏你做出此事？）"]},{"op":51,"name":"actor_face","args":[113,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[103,6]},{"op":20,"name":"dialog","args":["&郭图\n（袁将军，先忍耐一下。）"]},{"op":52,"name":"actor_action","args":[103,0]},{"op":20,"name":"dialog","args":["&袁谭\n（好吧！）\n&袁尚\n二哥还行吧。\n&袁熙\n是。\n&袁尚\n好！你四人马上出战。\n务必打败曹操！"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[200,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":7135,"sections":[{"index":0,"offset":7137,"title":"军事会议  黎阳之战前","body_off":7168,"body_end":8389,"conditions":[{"op":2,"name":"comment","args":["军事会议  黎阳之战前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":7168,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":3,"end_off":7215},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_soun