gs":[800,0,0]},{"op":20,"name":"dialog","args":["&关嫣\n是的………"]},{"op":20,"name":"dialog","args":["&关嫣\n其實他人還不錯，就是太囉嗦了。"]},{"op":20,"name":"dialog","args":["&关嫣\n廢話多，本事差，\n而且總是在不該出現的時候出現。"]},{"op":48,"name":"actor_appear","args":[829,53,75,3,3]},{"op":30,"name":"wait_frame","args":[]},{"op":51,"name":"actor_face","args":[800,0,0]},{"op":20,"name":"dialog","args":["&王朗\n喂！妳可真沒禮貌。\n難道老夫真的有這麼差嗎？"]},{"op":51,"name":"actor_face","args":[800,0,1]},{"op":20,"name":"dialog","args":["&关嫣\n嚇！"]},{"op":49,"name":"actor_select","args":[0,829,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n嫣兒，怎麼回事？"]},{"op":20,"name":"dialog","args":["&关嫣\n沒、沒有。\n可能是我最近太累了，\n忽然產生幻覺了。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[800,0,2]},{"op":20,"name":"dialog","args":["&关嫣\n(怎麼回事？忽然有很不好的預感……)"]},{"op":51,"name":"actor_face","args":[800,0,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":10999,"title":"玩家切换","body_off":11024,"body_end":14661,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[49]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&马良\n我的兵種是軍師，擅長地系與火系策略。"]},{"op":20,"name":"dialog","args":["&马良\n尤其是地陣與火陣，\n可以一次攻擊多名敵軍。\n如果善加利用，會有事半功倍的效果。"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n嗯，有勞你了。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":52,"name":"actor_action","args":[49,0]},{"op":20,"name":"dialog","args":["&马良\n然而，將軍您是了解我的。"]},{"op":20,"name":"dialog","args":["&马良\n我的策略大多受到天氣的限制，\n若是碰到惡劣天氣，\n那麼在下幾乎是無計可施。"]},{"op":20,"name":"dialog","args":["&关羽\n嗯，我了解。"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"