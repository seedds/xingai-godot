[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":4416,"title":"玩家切换","body_off":4441,"body_end":4511,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[19]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&司马懿\n徐庶指出祭坛就在地下，\n必然有密道通往该处。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":4511,"title":"玩家切换","body_off":4536,"body_end":4623,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭嘉\n主公，我们要注意伏兵。\n这是诸葛亮常用的伎俩，\n尤其是树林丛中。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":4623,"title":"玩家切换","body_off":4648,"body_end":4947,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[17]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&貂蝉\n不光是魔王本人，姜維、趙雲、馬超\n也都是可怕的強敵呢。"]},{"op":20,"name":"dialog","args":["&曹操\n嗯，那你覺得孟獲身旁的祝融\n的本事如何？"]},{"op":52,"name":"actor_action","args":[17,3]},{"op":20,"name":"dialog","args":["&貂蝉\n哈哈。她的肉搏能力比我強，\n但是精神力卻比我要差遠了。"]},{"op":52,"name":"actor_action","args":[0,17]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n哈哈，言之有理！"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":4947,"title":"玩家切换","body_off":4972,"body_end":5113,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[804]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&蔡琰\n我和貂蟬善用「誘惑」削弱敵軍，\n還請丞相多多運用。"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":20,"name":"dialog","args":["&曹操\n呵呵，這是當然。"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":5113,"title":"玩家切换","body_off":5138,"body_end":5283,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[3]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹操\n关羽，你又要與你過去的同伴們作戰了。\n你真的沒問題嗎？\n&关羽\n請丞相放心！\n此戰攸關天下蒼生的命運，\n关某是絕對不會遲疑的！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":5283,"title":"玩家切换","body_off":5308,"body_end":5374,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n天空开始变得诡异了，\n也许风暴即将到来。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":5374,"title":"玩家切换","body_off":5399,"body_end":5552,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[16]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&典韦\n我一直想要跟趙雲分個高下！\n主公請派我上陣吧。"]},{"op":20,"name":"dialog","args":["&典韦\n除此以外，許胖子和孟獲的體格相近，\n我也好像看他倆打打喔。"]},{"op":20,"name":"dialog","args":["&曹操\n嗯。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":5552,"title":"玩家切换","body_off":5577,"body_end":5667,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[23]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&贾诩\n雖然魔王佔據了諸葛亮的身體，\n但是他的智慧卻未必比得上諸葛亮本人。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}