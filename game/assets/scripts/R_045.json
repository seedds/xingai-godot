,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[24]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&荀攸\n粮草等军用物资我已经准备齐全，\n只能丞相一声令下。\n&曹操\n这些日子辛苦你了，\n这后勤保障完全是你的功劳。\n&荀攸\n您说哪里话，只要您能平定天下，\n就是我们最大的满足。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":6274,"title":"玩家切换","body_off":6299,"body_end":6783,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[16]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[16,0,2]},{"op":20,"name":"dialog","args":["&典韦\n想想我们经历的苦难，主公，\n也应该是有结果的时候了。\n&曹操\n恶来，在你的身上，\n留下了当初懊悔的伤痕。\n&典韦\n什么伤痕的……懊悔的……\n主公，你明知道我不识几个字，\n就不要文邹邹的了。"]},{"op":51,"name":"actor_face","args":[15,3,2]},{"op":20,"name":"dialog","args":["&许褚\n主公的意思就是，\n你把敌人打的都是伤痕。\n笨！"]},{"op":51,"name":"actor_face","args":[16,14,0]},{"op":20,"name":"dialog","args":["&典韦\n我笨？！好像你比我聪明多少？"]},{"op":51,"name":"actor_face","args":[15,0,1]},{"op":51,"name":"actor_face","args":[16,0,1]},{"op":20,"name":"dialog","args":["&许褚\n哼。\n&典韦\n哼。"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n呵呵……还是老样子。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":6783,"title":"玩家切换","body_off":6808,"body_end":6882,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[8]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹丕\n父亲，这场战斗事关天下统一，\n请务必让孩儿出战吧。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":6882,"title":"玩家切换","body_off":6907,"body_end":6975,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[2]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&张辽\n我们就要完成统一天下的愿望了，\n这是天命啊。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":6975,"title":"玩家切换","body_off":7000,"body_end":7078,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[19]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹操\n司马懿，如今天色如何？\n&司马懿\n已经染成主公的颜色了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":7078,"title":"玩家切换","body_off":7103,"body_end":7160,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[1]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯惇\n孟德，我几乎快看见你的天下了。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":7160,"title":"玩家切换","body_off":7185,"body_end":7260,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[21]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&程昱\n主公，\n如今正是结束漫长乱世的大好时机。\n&曹操\n嗯。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":7260,"title":"玩家切换","body_off":7285,"body_end":7672,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[15]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&曹操\n许褚，你紧张吗？\n&许褚\n啊？\n我……我不……不是很紧张……\n&曹操\n啊，那就好。"]},{"op":1,"name":"if","args":[],"off":7377,"cond":{"op":5,"name":"test_flags","args":[[1270],[]]},"end":15,"end_off":7664},{"op":51,"name":"actor_face","args":[16,0,0]},{"op":20,"name":"dialog","args":["&典韦\n好兄弟，虽然我经常叫你“胖子”，\n但那完全是因为咱俩关系好。"]},{"op":51,"name":"actor_face","args":[15,3,2]},{"op":20,"name":"dialog","args":["&许褚\n哈哈，是啊，咱俩人关系最亲密啊。\n我很乐意和你开玩笑。"]},{"op":56,"name":"set_attr","args":[0,15,0,258]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n哈哈哈。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":51,"name":"actor_face","args":[15,0,1]},{"op":51,"name":"actor_face","args":[16,0,1]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":7672,"title":"玩家切换","body_off":7697,"body_end":7763,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[137]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&甄宓\n能夠參與如此重要的戰役，\n是我最大的榮幸。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":7763,"title":"玩家切换","body_off":7788,"body_end":7852,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[13]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&徐晃\n主公，\n公明这一生最不后悔的就是跟了您。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":7852,"title":"玩家切换","body_off":7877,"body_end":8166,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭嘉\n主公。\n&曹操\n奉孝。\n&郭嘉\n我们的大业马上就要完成了。\n&曹操\n是啊。你知道在你生病的时候，\n我多么惦记你吗？\n&郭嘉\n主公别说了……奉孝不惧力不从心，\n惟恐稍有差池。\n&曹操\n……。\n&郭嘉\n主公，进军建业，千万不能着急。\n需要北门部队掩护东、西门的部队，\n相互配合，大事可成！！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":8166,"title":"玩家切换","body_off":8187,"body_end":9100,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op"