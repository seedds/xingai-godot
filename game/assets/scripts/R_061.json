{"file":"R_061.eex","kind":"story","scenario_index":122,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":34,"sections":[{"index":0,"offset":36,"title":"曹操军繼續進軍的的消息","body_off":69,"body_end":1194,"conditions":[{"op":2,"name":"comment","args":["曹操军繼續進軍的的消息"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":69,"cond":{"op":5,"name":"test_flags","args":[[303],[703]]},"end":48,"end_off":1192},{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":39,"name":"change_scene","args":[2,65535,65535,54,65535]},{"op":48,"name":"actor_appear","args":[101,54,37,2,0]},{"op":48,"name":"actor_appear","args":[99,42,68,1,0]},{"op":48,"name":"actor_appear","args":[136,42,60,1,0]},{"op":48,"name":"actor_appear","args":[145,42,52,1,0]},{"op":48,"name":"actor_appear","args":[161,67,52,3,0]},{"op":48,"name":"actor_appear","args":[32,67,60,3,0]},{"op":48,"name":"actor_appear","args":[181,54,60,0,11]},{"op":28,"name":"fade_out","args":[]},{"op":24,"name":"title_text","args":["同盟？"]},{"op":35,"name":"play_music","args":[203,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["洛阳  同盟军主营"]},{"op":52,"name":"actor_action","args":[101,3]},{"op":20,"name":"dialog","args":["&袁绍\n什麼？曹操居然不在乎損失，\n堅持要追擊董卓？\n&士兵01\n是的。"]},{"op":52,"name":"actor_action","args":[101,0]},{"op":20,"name":"dialog","args":["&袁绍\n曹操如今身在何处？\n&士兵01\n正在集结兵力進攻長安。"]},{"op":20,"name":"dialog","args":["&袁绍\n嗯……。"]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n嘻嘻嘻，就那點兵力也想打下長安！\n真是可笑啊。"]},{"op":52,"name":"actor_action","args":[136,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[99,0,0]},{"op":20,"name":"dialog","args":["&孙坚\n可笑？\n真是这么回事吗？"]},{"op":51,"name":"actor_face","args":[136,0,2]},{"op":20,"name":"dialog","args":["&袁术\n那当然喽！\n他這樣做無異於送死嘛。"]},{"op":51,"name":"actor_face","args":[99,0,1]},{"op":20,"name":"dialog","args":["&孙坚\n那倒不是曹操真正的目的。"]},{"op":51,"name":"actor_face","args":[136,0,1]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[32,6]},{"op":20,"name":"dialog","args":["&刘备\n正是。\n我同盟军中只有曹操一人去追击董卓，\n希望曹操的行动能唤起人们共讨董卓。"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":20,"name":"dialog","args":["&孙坚\n他已经达到了目的。\n&孙坚\n跟他比起來，我們真是太窩囊了！"]},{"op":20,"name":"dialog","args":["&袁绍\n……。"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[101,3]},{"op":20,"name":"dialog","args":["&袁绍\n傳令下去，我們也要征討董卓！"]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n什麼？為什麼我們也要啊？\n&袁绍\n這是當然的，身為盟主，\n我豈能讓曹操專美於前！\n&袁绍\n大家快去集結兵馬，\n我們也要進軍長安了！"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[203,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":1194,"sections":[{"index":0,"offset":1196,"title":"连环计.P1","body_off":1216,"body_end":3895,"conditions":[{"op":2,"name":"comment","args":["连环计.P1"]},{"op":0,"name":"end","args":[]}],"body":[{"op":9,"name":"delay","args":[5]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,3,65535]},{"op":1,"name":"if","args":[],"off":1252,"cond":{"op":2,"name":"comment","args":["貂蟬換頭像"]},"end":14,"end_off":1387},{"op":1,"name":"if","args":[],"off":1271,"cond":{"op":5,"name":"test_flags","args":[[1845],[]]},"end":7,"end_off":1309},{"op":56,"name":"set_attr","args":[17,15,0,242]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1309,"cond":{"op":5,"name":"test_flags","args":[[1846],[]]},"end":10,"end_off":1347},{"op":56,"name":"set_attr","args":[17,15,0,328]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1347,"cond":{"op":5,"name":"test_flags","args":[[1847],[]]},"end":13,"end_off":1385},{"op":56,"name":"set_attr","args":[17,15,0,329]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":48,"name":"actor_appear","args":[153,58,70,3,1]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["长安  王允府"]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":48,"name":"actor_appear","args":[181,30,60,1,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,181,0,38,60,1]},{"op":20,"name":"dialog","args":["&士兵01\n王大人，今晚相府召开庆祝宴，\n董卓丞相请您务必出席。"]},{"op":50,"name":"actor_move","args":[65535,153,0,58,60,3]},{"op":20,"name":"dialog","args":["&王允\n庆祝宴？庆祝什么？\n我们不是还在跟同盟军打仗吗？\n&士兵01\n現在我們已經抵達長安，\n同盟军也只有曹操一人追趕過來。\n其他人完全沒有追擊的打算。\n&士兵01\n丞相說大局已定，所以要庆祝。"]},{"op":36,"name":"play_sound","args":[17]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[153,3]},{"op":20,"name":"dialog","args":["&王允\n什么？只有曹操追來長安！？"]},{"op":50,"name":"actor_move","args":[65535,181,0,40,60,1]},{"op":20,"name":"dialog","args":["&士兵01\n是啊，曹操此舉無異於以卵擊石，\n他敗局已定了。\n&士兵01\n總之，请大人务必要出席。"]},{"op":52,"name":"actor_action","args":[153,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[153,0,1]},{"op":20,"name":"dialog","args":["&王允\n……我岂有推辞之理？\n请转告丞相，我一定出席。\n&士兵01\n是。"]},{"op":50,"name":"actor_move","args":[65535,181,0,30,60,3]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[65535,153,0,58,70,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[153,1]},{"op":20,"name":"dialog","args":["&王允\n董卓未滅，\n同盟军卻已如同一盤散沙。"]},{"op":52,"name":"actor_action","args":[153,9]},{"op":20,"name":"dialog","args":["&王允\n呜呜呜……完了……。\n消灭董卓再也无望了，圣上……。"]},{"op":9,"name":"delay","args":[10]},{"op":48,"name":"actor_appear","args":[17,30,60,1,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&貂蝉\n爹。"]},{"op":50,"name":"actor_move","args":[65535,17,0,58,60,2]},{"op":20,"name":"dialog","args":["&貂蝉\n爹……。"]},{"op":51,"name":"actor_face","args":[153,1,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[153,1,0]},{"op":20,"name":"dialog","args":["&王允\n貂蝉……实话告诉你吧…\n同盟军已经名存實亡了……。"]},{"op":51,"name":"actor_face","args":[17,6,2]},{"op":20,"name":"dialog","args":["&貂蝉\n……刚才的话，女儿都听到了。\n……爹，您得多保重。"]},{"op":51,"name":"actor_face","args":[153,0,0]},{"op":20,"name":"dialog","args":["&王允\n好女儿。"]},{"op":51,"name":"actor_face","args":[153,0,2]},{"op":20,"name":"dialog","args":["&王允\n不过，只是已经无望了。\n\n\n不！也许还有办法……"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":20,"name":"dialog","args":["&貂蝉\n……爹……还有什么办法？"]},{"op":51,"name":"actor_face","args":[153,0,0]},{"op":20,"name":"dialog","args":["&王允\n……"]},{"op":20,"name":"dialog","args":["&貂蝉\n父亲难道有什么顾虑。"]},{"op":50,"name":"actor_move","args":[65535,153,0,58,68,0]},{"op":20,"name":"dialog","args":["&王允\n老夫观察了很久，\n这两个人都是好色之人。\n我要把你分别献给董卓与吕布。\n女儿，你从中周旋，\n一定要让他们两个起矛盾。\n最后，让吕布杀了董卓……"]},{"op":50,"name":"actor_move","args":[65535,17,0,58,56,0]},{"op":20,"name":"dialog","args":["&貂蝉\n这……。"]},{"op":9,"name":"delay","args":[15]},{"op":50,"name":"actor_move","args":[0,153,0,58,65,0]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[153,9,0]},{"op":20,"name":"dialog","args":["&王允\n怎么样！貂蝉，现在只有这样了！\n老夫为天下苍生，求你了！"]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[0,17,0,58,60,2]},{"op":52,"name":"actor_action","args":[17,9]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&貂蝉\n爹，你千万别这样，\n女儿答应就是。"]},{"op":52,"name":"actor_action","args":[153,1]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[153,9]},{"op":20,"name":"dialog","args":["&王允\n就算是为了天下，\n我苦命的女儿……。"]},{"op":20,"name":"dialog","args":["&貂蝉\n女儿的安危不用担心，这么做也不全是\n为了天下，也是为了报答您……把我这个\n孤儿当亲生女儿来抚养的恩情。"]},{"op":20,"name":"dialog","args":["&貂蝉\n所以为了爹，女儿必须这么做。"]},{"op":20,"name":"dialog","args":["&王允\n爹对不起你，貂蝉……。"]},{"op":50,"name":"actor_move","args":[65535,17,0,58,60,2]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[17,6,2]},{"op":20,"name":"dialog","args":["&貂蝉\n就这么办吧，爹……。"]},{"op":50,"name":"actor_move","args":[65535,17,0,30,60,3]},{"op":49,"name":"actor_select","args":[65535,17,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":51,"name":"actor_face","args":[153,0,3]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,153,0,58,70,2]},{"op":9,"name":"delay","args":[6]},{"op":51,"name":"actor_face","args":[153,1,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[153,9,2]},{"op":20,"name":"dialog","args":["&王允\n……貂蝉。"]},{"op":22,"name":"info","args":["年仅十六的女儿为了报答养父，\n不惜舍身取义，后人称此为「连环计」。"]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":3895,"sections":[{"index":0,"offset":3897,"title":"连环计.P2","body_off":3917,"body_end":4699,"conditions":[{"op":2,"name":"comment","args":["连环计.P2"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,3,65535]},{"op":48,"name":"actor_appear","args":[153,58,70,0,0]},{"op":48,"name":"actor_appear","args":[119,58,60,2,0]},{"op":9,"name":"delay","args":[5]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["长安  王允府"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&吕布\n王大人，我目前还没有能力納妾……。"]},{"op":52,"name":"actor_action","args":[153,3]},{"op":20,"name":"dialog","args":["&王允\n将军可别这么说，\n我家小女说过非将军不嫁呢。"]},{"op":52,"name":"actor_action","args":[153,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,153,0,58,68,0]},{"op":20,"name":"dialog","args":["&王允\n您可别见笑，就见她一面吧。\n&吕布\n好，既然王大人这么说……。"]},{"op":52,"name":"actor_action","args":[153,3]},{"op":20,"name":"dialog","args":["&王允\n哦，你答应了！太好了。"]},{"op":52,"name":"actor_action","args":[153,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[153,0,3]},{"op":20,"name":"dialog","args":["&王允\n貂蝉，貂蝉。"]},{"op"