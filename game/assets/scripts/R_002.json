:"actor_appear","args":[161,67,52,3,0]},{"op":48,"name":"actor_appear","args":[32,67,60,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[203,0]},{"op":9,"name":"delay","args":[3]},{"op":23,"name":"place_name","args":["洛阳郊外  同盟军主营"]},{"op":52,"name":"actor_action","args":[101,3]},{"op":20,"name":"dialog","args":["&袁绍\n大家都表现得很出色，\n我们乘势一举夺回洛阳吧。"]},{"op":52,"name":"actor_action","args":[101,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n现在董卓一定也知道我们的厉害了吧，\n嘻嘻。"]},{"op":52,"name":"actor_action","args":[136,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&曹操\n这么乐观，恐怕还太早吧。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&袁术\n嗯？为什么？"]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&曹操\n董卓还没有让吕布出马，\n有吕布在我们……。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&袁绍\n……吕布？是啊…\n他可是自稱武艺比华雄强上百倍。"]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n吕布之辈不过是山野匹夫，\n你这么怕他啊？"]},{"op":52,"name":"actor_action","args":[136,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&曹操\n既然如此，让实力强大的袁术大人，\n前去会会吕布应该没有问题吧。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&袁术\n哼！"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[136,2]},{"op":20,"name":"dialog","args":["&袁术\n还是得让乡巴佬对付乡巴佬。"]},{"op":52,"name":"actor_action","args":[136,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[136,0,2]},{"op":20,"name":"dialog","args":["&袁术\n对了，就让那个孙坚……。"]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n嘻嘻。"]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n……。"]},{"op":52,"name":"actor_action","args":[32,6]},{"op":1,"name":"if","args":[],"off":2136,"cond":{"op":5,"name":"test_flags","args":[[701],[]]},"end":55,"end_off":2277},{"op":20,"name":"dialog","args":["&刘备\n对了，不知孙将军是否平安脱险了？"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[136,0,1]},{"op":20,"name":"dialog","args":["&袁术\n不可能的。\n都这时候了，我看一定死了。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2277,"cond":{"op":5,"name":"test_flags","args":[[],[701]]},"end":62,"end_off":2423},{"op":20,"name":"dialog","args":["&刘备\n孙将军迟迟未到，\n莫非出了什么事？"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[136,0,1]},{"op":20,"name":"dialog","args":["&袁术\n八成是吃了败仗，\n这家伙大概已经没命了吧！"]},{"op":0,"name":"end","args":[]},{"op":51,"name":"actor_face","args":[136,3,1]},{"op":20,"name":"dialog","args":["&袁术\n嘻嘻嘻。"]},{"op":51,"name":"actor_face","args":[136,0,1]},{"op":20,"name":"dialog","args":["&孙坚\n我还活着。"]},{"op":51,"name":"actor_face","args":[136,3,1]},{"op":20,"name":"dialog","args":["&袁术\n啊！"]},{"op":51,"name":"actor_face","args":[136,0,2]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":51,"name":"actor_face","args":[145,0,2]},{"op":51,"name":"actor_face","args":[143,0,2]},{"op":51,"name":"actor_face","args":[161,0,2]},{"op":51,"name":"actor_face","args":[32,0,2]},{"op":48,"name":"actor_appear","args":[99,54,94,0,0]},{"op":50,"name":"actor_move","args":[65535,99,0,54,60,0]},{"op":51,"name":"actor_face","args":[32,0,3]},{"op":51,"name":"actor_face","args":[136,0,1]},{"op":51,"name":"actor_face","args":[145,0,1]},{"op":51,"name":"actor_face","args":[143,0,3]},{"op":51,"name":"actor_face","args":[161,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n哦，孙将军！"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[32,3]},{"op":20,"name":"dialog","args":["&刘备\n你没事吧！"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[99,0,2]},{"op":20,"name":"dialog","args":["&孙坚\n……曹大人！"]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&曹操\n怎么？"]},{"op":51,"name":"actor_face","args":[99,0,0]},{"op":20,"name":"dialog","args":["&孙坚\n是谁负责供应粮草？\n难道是你和袁绍大人吗？"]},{"op":20,"name":"dialog","args":["&袁术\n糟了。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n这…粮草都是公路负责的。"]},{"op":51,"name":"actor_face","args":[99,0,2]},{"op":20,"name":"dialog","args":["&孙坚\n果然如此……。"]},{"op":50,"name":"actor_move","args":[65535,99,0,50,60,3]},{"op":35,"name":"play_music","args":[203,255]},{"op":36,"name":"play_sound","args":[56]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[99,2]},{"op":20,"name":"dialog","args":["&孙坚\n袁术！果然是你！\n&孙坚\n先前的军事会议上你嫉恨我，\n就生了害我之心！"]},{"op":51,"name":"actor_face","args":[145,0,2]},{"op":20,"name":"dialog","args":["&孙坚\n我是同盟军的一员，\n你居然敢停止供应粮草！\n你这个混蛋！"]},{"op":52,"name":"actor_action","args":[99,2]},{"op":20,"name":"dialog","args":["&孙坚\n今天我要宰了你！"]},{"op":50,"name":"actor_move","args":[65535,136,0,36,60,1]},{"op":52,"name":"actor_action","args":[136,3]},{"op":20,"name":"dialog","args":["&袁术\n啊，且慢动手，这是误会！"]},{"op":52,"name":"actor_action","args":[136,0]},{"op":50,"name":"actor_move","args":[65535,99,0,44,60,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[99,2]},{"op":20,"name":"dialog","args":["&孙坚\n我不听你解释，就因为你，\n我损失了无数忠勇的属下。\n&孙坚\n我要用你的血祭奠我的属下。"]},{"op":52,"name":"actor_action","args":[136,9]},{"op":20,"name":"dialog","args":["&袁术\n啊，这全是我的属下自作主张。"]},{"op":52,"name":"actor_action","args":[99,0]},{"op":20,"name":"dialog","args":["&袁术\n呆会儿我就把他押到你的营里去！\n让你随意处置，你可别生气！"]},{"op":52,"name":"actor_action","args":[99,2]},{"op":20,"name":"dialog","args":["&孙坚\n居然把责任推卸给属下！\n你也算是一军之将吗！？\n拿命来！！"]},{"op":52,"name":"actor_action","args":[32,6]},{"op":20,"name":"dialog","args":["&刘备\n孙将军，你的心情可以理解，\n不过现在与董卓大军决战在即，\n请你先忍耐一下吧。"]},{"op":51,"name":"actor_face","args":[99,2,1]},{"op":20,"name":"dialog","args":["&孙坚\n别劝我，别拦着我！"]},{"op":52,"name":"actor_action","args":[32,0]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&曹操\n孙将军，你这么做的话……\n死去的属下们也会伤心的。"]},{"op":51,"name":"actor_face","args":[99,2,0]},{"op":20,"name":"dialog","args":["&孙坚\n这话怎么说？"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n如果现在你杀了袁术，同盟军就此瓦解，\n你的属下们也就白死了。"]},{"op":52,"name":"actor_action","args":[0,6]},{"op":20,"name":"dialog","args":["&曹操\n难道你真的愿意如此吗！？"]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[99,0]},{"op":20,"name":"dialog","args":["&孙坚\n……嗯！"]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[99,0,2]},{"op":20,"name":"dialog","args":["&孙坚\n……好吧，我就暂且忍耐一下。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[8]},{"op":51,"name":"actor_face","args":[99,0,3]},{"op":20,"name":"dialog","args":["&孙坚\n袁术，等我消灭了董卓，\n再来取你的狗头。"]},{"op":52,"name":"actor_action","args":[136,1]},{"op":20,"name":"dialog","args":["&袁术\n呼！"]},{"op":20,"name":"dialog","args":["&曹操\n……。（为了属下居然如此激愤，\n孙坚真是条汉子……。）"]},{"op":52,"name":"actor_action","args":[101,3]},{"op":20,"name":"dialog","args":["&袁绍\n好了，都入座吧。\n大战就在眼前了。"]},{"op":52,"name":"actor_action","args":[101,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[99,0,0]},{"op":20,"name":"dialog","args":["&孙坚\n……好吧。"]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,99,0,42,68,1]},{"op":50,"name":"actor_move","args":[65535,136,0,42,60,1]},{"op":51,"name":"actor_face","args":[145,0,1]},{"op":36,"name":"play_sound","args":[255]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[101,3]},{"op":20,"name":"dialog","args":["&袁绍\n曹操，你介绍一下接下来的战况。"]},{"op":52,