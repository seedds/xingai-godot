,3]},{"op":20,"name":"dialog","args":["&关羽\n快做戰前準備吧！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":8,"name":"set_menu","args":[1]},{"op":6,"name":"battle_select_units","args":[1,2,0,1,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":6,"name":"battle_select_units","args":[1,2,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":0,"name":"end","args":[]}]}]},{"index":5,"offset":4714,"sections":[{"index":0,"offset":4716,"title":"玩家切换","body_off":4737,"body_end":4900,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[3,17]},{"op":20,"name":"dialog","args":["&关羽\n出兵。一舉攻陷樊城！"]},{"op":20,"name":"dialog","args":["&关羽\n(大哥，三弟，我們的夢想將在\n今日實現了。)"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":4900,"title":"玩家切换","body_off":4925,"body_end":5226,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[3]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n跳過本關嗎？"]},{"op":1,"name":"if","args":[],"off":4956,"cond":{"op":18,"name":"choice","args":["跳過本關\n不跳過",3]},"end":18,"end_off":5218},{"op":1,"name":"if","args":[],"off":4984,"cond":{"op":19,"name":"test_choice","args":[1]},"end":14,"end_off":5171},{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n好的，那麼就跳過本關。"]},{"op":20,"name":"dialog","args":["&许子将\n在此先說明一下，\n下一關是無法跳過的喔。"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,255]},{"op":17,"name":"goto_scenario","args":[157]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":5171,"cond":{"op":19,"name":"test_choice","args":[2]},"end":17,"end_off":5216},{"op":20,"name":"dialog","args":["&许子将\n呵呵，明智的選擇。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":5226,"title":"玩家切换","body_off":5251,"body_end":5331,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[44]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&廖化\n軍侯，请派我当先锋吧！\n咱们人才济济，绝对不会输给魏军。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":5331,"title":"玩家切换","body_off":5356,"body_end":5420,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[39]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&伊籍\n我的兵种是医师，\n加血的工作就交给我吧。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":5420,"title":"玩家切换","body_off":5445,"body_end":5584,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[51]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&王甫\n我的攻击力和精神力都不差，\n可說是文武雙修。"]},{"op":51,"name":"actor_face","args":[66,0,2]},{"op":20,"name":"dialog","args":["&关索\n(那不就是高不成低不就的意思嗎？)"]},{"op":51,"name":"actor_face","args":[66,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":5584,"title":"玩家切换","body_off":5609,"body_end":5807,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[66]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&关索\n看我怎麼取下曹仁的首級！"]},{"op":51,"name":"actor_face","args":[53,0,2]},{"op":20,"name":"dialog","args":["&关兴\n嘻嘻，你的兵種對他沒有優勢喔。"]},{"op":51,"name":"actor_face","args":[66,0,0]},{"op":20,"name":"dialog","args":["&关索\n哥哥，你別糗我了啦！"]},{"op":20,"name":"dialog","args":["&关兴\n嘿嘿嘿嘿。"]},{"op":51,"name":"actor_face","args":[53,0,3]},{"op":51,"name":"actor_face","args":[66,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":5807,"title":"玩家切换","body_off":5832,"body_end":6013,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[53]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&关兴\n聽說傅士仁和糜芳又惹禍了？"]},{"op":52,"name":"actor_action","args":[3,2]},{"op":20,"name":"dialog","args":["&关羽\n沒錯，他倆因為貪杯好飲，\n居然把糧草給燒了！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关兴\n真是不像話！\n咱們回去後一定要給他倆一個教訓。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":6013,"title":"玩家切换","body_off":6038,"body_end":6120,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[812]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&赵累\n我的兵種是砲兵，射程很遠，\n而且一次最多可以攻擊五名敵軍。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":6120,"title":"玩家切换","body_off":6145,"body_end":6563,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[49]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[49,6]},{"op":20,"name":"dialog","args":["&马良\n軍侯，我們帶了這麼多軍隊來攻樊城，\n萬一東吳出賣我們，我們不就腹背受\n敵了？"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n哈哈，馬良你就放心吧。\n呂蒙病了，頂替他的人是個小癟三，\n根本不足為懼！"]},{"op":20,"name":"dialog","args":["&马良\n但願如此吧……"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n別再說了，我意已決！"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n而且我已經安排好數十座烽火台，\n即使吳軍背叛我們，我們也能及時趕回。"]},{"op":52,"name":"actor_action","args":[49,0]},{"op":20,"name":"dialog","args":["&马良\n………是。\n(總有一種不好的預感。)"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":6563,"title":"玩家切换","body_off":6588,"body_end":6697,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[47]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&周仓\n嘿嘿，雖然俺是山賊，\n但是俺可是很會游泳的啦。"]},{"op":20,"name":"dialog","args":["&关羽\n(可惜遊戲裡沒體現出這一點。)"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":6697,"title":"玩家切换","body_off":6722,"body_end":6806,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[46]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&关平\n據說曹操派了許多援軍來守樊城，\n但是他們絕對不是父親的對手。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}