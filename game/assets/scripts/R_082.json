"args":["&孙乾\n爽快！真不愧是大都督。\n那麼在下就告辭了。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":51,"name":"actor_face","args":[40,0,2]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&孙乾\n(嘿嘿。)"]},{"op":9,"name":"delay","args":[1]},{"op":50,"name":"actor_move","args":[65535,40,0,53,90,2]},{"op":49,"name":"actor_select","args":[65535,40,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":51,"name":"actor_face","args":[78,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[78,6]},{"op":20,"name":"dialog","args":["&鲁肃\n大都督，這樣真的好嗎？\n萬一我們沒有在期限內拿下江陵，\n豈不是白白損失了？"]},{"op":52,"name":"actor_action","args":[77,17]},{"op":20,"name":"dialog","args":["&周瑜\n哈哈，子敬你就不必擔憂了。\n只要我們快點拿下江陵，\n不就什麼事都沒有了嗎？"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&鲁肃\n可是曹仁畢竟是曹操的名將，\n他恐怕不是個能夠輕易擺平的對手啊。"]},{"op":20,"name":"dialog","args":["&周瑜\n哼哼，這樣挺好。\n對手越強，越能襯托我的智慧。"]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n無論如何，這次我一定會徹底擊敗\n諸葛…曹仁！我是說曹仁！\n哈哈哈哈哈哈！"]},{"op":52,"name":"actor_action","args":[78,0]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&鲁肃\n……………………"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[78,0,3]},{"op":36,"name":"play_sound","args":[15]},{"op":9,"name":"delay","args":[8]},{"op":1,"name":"if","args":[],"off":2001,"cond":{"op":2,"name":"comment","args":["自由R指令"]},"end":81,"end_off":2079},{"op":8,"name":"set_menu","args":[1]},{"op":40,"name":"op_28","args":[1]},{"op":22,"name":"info","args":["點擊魯肅可更換周瑜形象，\n並進行戰前部屬。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":2081,"sections":[{"index":0,"offset":2083,"title":"玩家切换","body_off":2104,"body_end":2287,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":7,"name":"test_pending","args":[]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0