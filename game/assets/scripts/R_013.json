{"file":"R_013.eex","kind":"story","scenario_index":26,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":38,"sections":[{"index":0,"offset":40,"title":"曹操形象","body_off":59,"body_end":109,"conditions":[{"op":2,"name":"comment","args":["曹操形象"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,0]},{"op":117,"name":"set_s_image","args":[3,101]},{"op":1,"name":"if","args":[],"off":79,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":107},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":109,"sections":[{"index":0,"offset":111,"title":"许都  袁绍的要求","body_off":138,"body_end":2407,"conditions":[{"op":2,"name":"comment","args":["许都  袁绍的要求"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[16]},{"op":8,"name":"set_menu","args":[0]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[143,251,146]},{"op":41,"name":"op_29","args":[0,315,146]},{"op":44,"name":"caption","args":["曹操讨伐张绣再次失利，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[0,342,111]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["只有返回许都加紧练兵。",1,0,0]},{"op":9,"name":"delay","args":[8]},{"op":44,"name":"caption","args":["此时，",1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[101,390,22]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["河北的袁绍",1,0,0]},{"op":9,"name":"delay","args":[5]},{"op":41,"name":"op_29","args":[161,471,1]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["决定攻打北平的公孙瓒，",1,0,0]},{"op":9,"name":"delay","args":[8]},{"op":44,"name":"caption","args":["便遣使请求曹操提供援助。",1,1,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,5]},{"op":48,"name":"actor_appear","args":[20,52,40,2,0]},{"op":48,"name":"actor_appear","args":[22,58,40,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["打倒吕布！"]},{"op":23,"name":"place_name","args":["许都  相府"]},{"op":20,"name":"dialog","args":["&曹操\n袁绍居然天真地跑来找我，\n想跟我借士兵和军粮。\n&荀彧\n借士兵和军粮……？"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n据说是为了攻打北平的公孙瓒。\n&郭嘉\n为了这种个人的争斗……\n居然向我们提出这种无耻的要求。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n此人一向如此。\n&荀彧\n是啊……。主公打算如何答复他？\n&曹操\n嗯。"]},{"op":35,"name":"play_music","args":[202,255]},{"op":36,"name":"play_sound","args":[11]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":1003,"cond":{"op":18,"name":"choice","args":["隐忍答应。\n拒绝要求。",65535]},"end":98,"end_off":2389},{"op":1,"name":"if","args":[],"off":1037,"cond":{"op":19,"name":"test_choice","args":[1]},"end":62,"end_off":1409},{"op":58,"name":"set_resource","args":[2,2,5]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n就答应他的要求吧。\n&荀彧\n是。\n&曹操\n现在还不能跟袁绍对峙。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n文若，尽可能表现宽大的一面。\n如此袁绍就会把目光集中在北平了。"]},{"op":51,"name":"actor_face","args":[0,17,2]},{"op":20,"name":"dialog","args":["&曹操\n我们要利用这个机会剿灭外敌。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n这笔帐将来再向袁绍讨回来。"]},{"op":51,"name":"actor_face","args":[20,6,2]},{"op":20,"name":"dialog","args":["&荀彧\n遵命。"]},{"op":11,"name":"set_flag","args":[305,1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1409,"cond":{"op":19,"name":"test_choice","args":[2]},"end":97,"end_off":2387},{"op":58,"name":"set_resource","args":[2,1,5]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[202,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n拒绝他的要求吧！"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n主公，请您三思。\n此刻隐忍答应袁绍方为上策。"]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n正是如此。\n否则袁军将不是攻打北平，\n而是直逼许都而来了。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n袁绍不会来的。\n&郭嘉\n可是……。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n你们不要小看袁绍这个人。\n眼前有北平这个后顾之忧，\n他是不会笨到进攻我的。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n这个可恶的家伙，\n分明是在试探于我！"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":20,"name":"dialog","args":["&荀彧\n试探主公？\n&曹操\n不错。他想看看我有没有你们……\n这种纵观全局的能力。"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":20,"name":"dialog","args":["&郭嘉\n……………。"]},{"op":50,"name":"actor_move","args":[65535,0,0,34,59,2]},{"op":20,"name":"dialog","args":["&曹操\n如果我一时冲动拒绝要求，\n他一定认为我是那种人。\n&荀彧\n原来如此……。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n文若，痛骂使者一顿，赶他回去。"]},{"op":50,"name":"actor_move","args":[65535,0,0,34,55,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n我们的周围还有张绣、\n吕布等许多敌人要消灭。\n&曹操\n等消灭他们以后，\n再与袁绍一战。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n在这之前，\n就尽量让他轻视我吧。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n是。"]},{"op":11,"name":"set_flag","args":[305,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,