rgs":[3]},{"op":1,"name":"if","args":[],"off":1564,"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":54,"end_off":1782},{"op":20,"name":"dialog","args":["&许子将\n對了，您希望外傳中的敵軍夏侯惇\n與正篇故事一樣強嗎？"]},{"op":1,"name":"if","args":[],"off":1642,"cond":{"op":18,"name":"choice","args":["好呀\n拜託你，把他變弱",0]},"end":53,"end_off":1780},{"op":1,"name":"if","args":[],"off":1676,"cond":{"op":19,"name":"test_choice","args":[1]},"end":48,"end_off":1733},{"op":20,"name":"dialog","args":["&许子将\nOK，故事繼續進行。"]},{"op":11,"name":"set_flag","args":[1833,1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1733,"cond":{"op":19,"name":"test_choice","args":[2]},"end":52,"end_off":1778},{"op":20,"name":"dialog","args":["&夏侯惇\n可惡！"]},{"op":11,"name":"set_flag","args":[1833,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n哈，哈，哈！\n曹操现在大概很不甘心吧，公台？"]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n是的。而且根據探子的報告，\n曹操在逃跑時受到了很嚴重的火傷，\n現在可能已經死了。"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&吕布\n喔？此事當真？\n&陈宫\n據說曹軍現在正在發喪，\n但是還得多加確認……"]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n敵軍都發喪了，還有什麼好確認的？\n傳令下去：現在就去劫營！"]},{"op":52,"name":"actor_action","args":[126,0]},{"op":20,"name":"dialog","args":["&陈宫\n主公！曹操是個陰險狡詐的人，\n萬一這是他故意放出的假消息，\n該當如何是好？"]},{"op":20,"name":"dialog","args":["&吕布\n你就別再胡思亂想了。\n難道我會判斷錯誤嗎？"]},{"op":52,"name":"actor_action","args":[119,17]},{"op":20,"name":"dialog","args":["&吕布\n傳令全軍，現在就去準備劫營。\n違令者斬！"]},{"op":20,"name":"dialog","args":["&陈宫\n這……"]},{"op":52,"name":"actor_action","args":[126,6]},{"op":20,"name":"dialog","args":["&陈宫\n……是。"]},{"op":52,"name":"actor_action","args":[126,0]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n哈哈哈哈哈哈！\n曹操，你活該啦！"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&张辽\n(曹操真的會這麼輕易的死掉嗎？)"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&吕布\n(嘿嘿，老子終於成功了。\n那一天的付出，今天終於有了回報。)"]},{"op":105,"name":"popup","args":["呂布回想起了自己的過去……"]},{"op":9,"name":"delay","args":[3]},{"op":36,"name":"play_sound","args":[255]},{"op":1,"name":"if","args":[],"off":2601,"cond":{"op":2,"name":"comment","args":["呂布降董卓"]},"end":426,"end_off":10012},{"op":56,"name":"set_attr","args":[777,15,0,205]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,18,65535]},{"op":36,"name":"play_sound","args":[18]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[119,35,56,1,0]},{"op":48,"name":"actor_appear","args":[135,50,56,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":105,"name":"popup","args":["數年前………"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n哈哈！李兄的這匹赤兔馬真的太棒了，\n當真要送我？"]},{"op":20,"name":"dialog","args":["&吕布\n不管你的回答是什麼，\n反正我是要定啦！"]},{"op":20,"name":"dialog","args":["&李肃\n嘿嘿，當然是認真的啦。\n只要呂兄喜歡，就儘管收下。"]},{"op":52,"name":"actor_action","args":[119,17]},{"op":20,"name":"dialog","args":["&吕布\n好！這可是你說的，不准反悔呀。"]},{"op":52,"name":"actor_action","args":[119,12]},{"op":20,"name":"dialog","args":["&吕布\n說吧，你送我這匹名馬是有什麼要求呢？\n儘管說，我來為你做主。"]},{"op":20,"name":"dialog","args":["&李肃\n哈哈，那我就不客氣的說了。"]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,135,0,48,56,3]},{"op":52,"name":"actor_action","args":[135,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&李肃\n呂布兄，像你這樣武藝高強、英俊挺拔、\n重情重義、德才兼備、氣質脫俗，"]},{"op":20,"name":"dialog","args":["&李肃\n而且智勇雙全的大英雄，\n待在丁原底下不是太憋屈了嗎？"]},{"op":20,"name":"dialog","args":["&吕布\n唉！這有什麼辦法呢？\n眼下又沒有更好的選擇，\n只能先認他當乾爹了。"]},{"op":20,"name":"dialog","args":["&李肃\n嘿嘿，呂兄如果想找更好的主人，\n眼下不就有一個很好的人選嗎？"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&吕布\n喔？誰呀？"]},{"op":20,"name":"dialog","args":["&李肃\n那就是當今的相國──董卓。"]},{"op":52,"name":"actor_action","args":[119,16]},{"op":20,"name":"dialog","args":["&吕布\n啥！？那個敗類？"]},{"op":36,"name":"play_sound","args":[56]},{"op":9,"name":"delay","args":[9]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n你在開什麼玩笑！\n董卓這廝的的惡名，\n怕是天下人都知道了！"]},{"op":20,"name":"dialog","args":["&吕布\n董卓是敗類，他身邊也一堆敗類！\n要我認他當主人？還不如吃屎！"]},{"op":20,"name":"dialog","args":["&李肃\n哈哈，呂兄先冷靜些吧。\n請慢慢聽我道來。"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&李肃\n董卓大人禮賢下士，英俊瀟灑，\n德才兼備又寬厚仁慈，堪稱完美！"]},{"op":20,"name":"dialog","args":["&李肃\n再加上他大權在握，\n得到天下是指日可待，\n他有哪一點不如丁原了？"]},{"op":20,"name":"dialog","args":["&李肃\n與其繼續幫丁原那個窩囊廢辦事，\n不如早點向董卓效勞，\n這樣不是更有前途嗎？"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&吕布\n這…………"]},{"op":52,"name":"actor_action","args":[119,16]},{"op":20,"name":"dialog","args":["&吕布\n可是我今天才當眾大罵董卓的身邊\n一堆敗類，我現在有什麼臉去跟他呢？"]},{"op":20,"name":"dialog","args":["&李肃\n這個簡單，您只要給董卓大人帶上一個\n見面禮，他就一定就會接納你的。"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&吕布\n見面禮？你是指什麼東西啊？"]},{"op":20,"name":"dialog","args":["&李肃\n那就是，丁原的──首級。"]},{"op":52,"name":"actor_action","args":[119,16]},{"op":20,"name":"dialog","args":["&吕布\n什麼！？你要我弒父？"]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":4322,"cond":{"op":18,"name":"choice","args":["答應\n不答應",119]},"end":164,"end_off":5225},{"op":1,"name":"if","args":[],"off":4346,"cond":{"op":19,"name":"test_choice","args":[1]},"end":146,"end_off":4614},{"op":36,"name":"play_sound","args":[19]},{"op":9,"name":"delay","args":[6]},{"op":52,"name":"actor_action","args":[119,17]},{"op":20,"name":"dialog","args":["&吕布\n李兄一席話令我茅塞頓開。"]},{"op":20,"name":"dialog","args":["&吕布\n要怪就怪那個丁老頭子不識時務，\n誰叫他不退為讓賢、直接把位子讓給我，\n否則哪會有今日的殺身之禍呢！"]},{"op":20,"name":"dialog","args":["&李肃\n哈哈，呂兄願意棄暗投明，真是太好了。\n既然如此，我就等你的好消息喽。"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":4614,"cond":{"op":19,"name":"test_choice","args":[2]},"end":163,"end_off":5223},{"op":36,"name":"play_sound","args":[41]},{"op":9,"name":"delay","args":[9]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n開什麼玩笑！弒父是多大的罪惡，\n你以為我幹得出來嗎？你當我畜生啊？\n你未免太小看我天下無雙呂奉先的人品了！"]},{"op":20,"name":"dialog","args":["&吕布\n看在你我是舊識的份上，我就饒你一命，\n快滾吧！以後不要在我面前出現了！"]},{"op":20,"name":"dialog","args":["&李肃\n呂兄且慢，你知道我剛剛送你的赤兔馬\n是哪來的嗎？當然是董卓大人給的啊！"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&吕布\n啊？"]},{"op":20,"name":"dialog","args":["&李肃\n喏，這些金子也是董大人要給你的。\n他說會給你很多好處，要你跟他混。"]},{"op":36,"name":"play_sound","args":[19]},{"op":9,"name":"delay","args":[6]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n唉呀，你怎麼不早說呢？\n早說嘛，這樣我就不必猶豫了，\n肯定會爽快的答應啊。"]},{"op":20,"name":"dialog","args":["&李肃\n哈哈，呂兄願意棄暗投明，真是太好了。\n既然如此，我就等你的好消息喽。"]},{"op":52,"name":"actor_action","args":[119,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,119,0,35,63,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,119,0,48,63,1]},{"op":51,"name":"actor_face","args":[135,0,2]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,119,0,53,63,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,119,0,53,56,1]},{"op":51,"name":"actor_face","args":[135,0,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,119,0,93,56,1]},{"op":49,"name":"actor_select","args":[65535,119,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&李肃\n(嘻嘻……)"]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&丁原\n奉先？"]},{"op":1,"name":"if","ar