":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":3523,"title":"玩家切换","body_off":3548,"body_end":3597,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[22]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&郭嘉\n文丑有勇無謀，命不久矣。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":3597,"title":"玩家切换","body_off":3622,"body_end":3919,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[6]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&夏侯渊\n想不到敌人这么强悍。\n平定淮南盗匪的部队还没有回来吗？\n&曹操\n怎么，害怕了？\n&夏侯渊\n孟德说的哪里话。\n看我不射瞎敌人的双眼。\n&郭嘉\n这兵马与粮草的关系……\n丞相派谁前去，\n不是没有道理的。\n&曹操\n是啊，我们地处中原地带，\n虽然富庶，却也常常腹背受敌。\n&夏侯渊\n没办法，再等等吧。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":3919,"title":"玩家切换","body_off":3944,"body_end":4016,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[13]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&徐晃\n文丑可是與顏良齊名的勇將，\n我們可千萬不能大意！"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":4016,"title":"玩家切换","body_off":4041,"body_end":4123,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[21]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&程昱\n武器店好像到了新的铠甲和衣服，\n这些东西日后都得准备齐全。"]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":4123,"title":"玩家切换","body_off":4148,"body_end":4250,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[119]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","