{"file":"R_029.eex","kind":"story","scenario_index":58,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":26,"sections":[{"index":0,"offset":28,"title":"曹操形象","body_off":47,"body_end":175,"conditions":[{"op":2,"name":"comment","args":["曹操形象"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,202]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":1,"name":"if","args":[],"off":67,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":95},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":119,"name":"int_var_op","args":[2,4033,2,0,100]},{"op":119,"name":"int_var_op","args":[2,4034,2,0,100]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":175,"sections":[{"index":0,"offset":177,"title":"孔明的指示","body_off":198,"body_end":2642,"conditions":[{"op":2,"name":"comment","args":["孔明的指示"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":39,"name":"change_scene","args":[2,65535,65535,49,65535]},{"op":48,"name":"actor_appear","args":[32,54,73,0,0]},{"op":48,"name":"actor_appear","args":[35,40,57,1,0]},{"op":48,"name":"actor_appear","args":[3,67,57,3,0]},{"op":48,"name":"actor_appear","args":[33,67,51,3,0]},{"op":48,"name":"actor_appear","args":[34,67,45,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[203,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["关羽的誓约"]},{"op":23,"name":"place_name","args":["江夏  刘备公馆"]},{"op":20,"name":"dialog","args":["&刘备\n孔明，东吴和曹魏的动静如何？"]},{"op":51,"name":"actor_face","args":[35,0,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n回禀主公。\n东吴利用顺风，\n大举火攻曹军。"]},{"op":20,"name":"dialog","args":["&诸葛亮\n曹军必定大败，\n届时我们再追击败逃的曹军吧。\n&刘备\n嗯，全交由你指挥。"]},{"op":51,"name":"actor_face","args":[35,0,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n是！那么即刻动员兵力吧。"]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":20,"name":"dialog","args":["&诸葛亮\n子龙、翼德听令！"]},{"op":52,"name":"actor_action","args":[34,6]},{"op":20,"name":"dialog","args":["&赵云\n在。"]},{"op":52,"name":"actor_action","args":[33,3]},{"op":20,"name":"dialog","args":["&张飞\n在。"]},{"op":52,"name":"actor_action","args":[34,0]},{"op":52,"name":"actor_action","args":[33,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n曹军一定会逃往荆州，\n你们预先到那里……"]},{"op":52,"name":"actor_action","args":[35,11]},{"op":20,"name":"dialog","args":["&诸葛亮\n如此这般……"]},{"op":52,"name":"actor_action","args":[34,6]},{"op":20,"name":"dialog","args":["&赵云\n军师妙计。"]},{"op":52,"name":"actor_action","args":[33,3]},{"op":20,"name":"dialog","args":["&张飞\n俺懂啦！\n看俺的。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n那么请即刻出发。"]},{"op":52,"name":"actor_action","args":[3,2]},{"op":20,"name":"dialog","args":["&关羽\n军师！"]},{"op":52,"name":"actor_action","args":[33,0]},{"op":52,"name":"actor_action","args":[34,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[33,0,2]},{"op":51,"name":"actor_face","args":[34,0,2]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&诸葛亮\n云长将军，什么事？"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n军师，您给了翼德和子龙命令，\n却没有给关某命令。\n这是为何？"]},{"op":52,"name":"actor_action","args":[35,11]},{"op":20,"name":"dialog","args":["&诸葛亮\n哦，是这件事啊？"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n在下的确有许多事情想劳烦将军，\n只是有一点小小顾虑。"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n什么顾虑？"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":35,"name":"play_music","args":[203,255]},{"op":36,"name":"play_sound","args":[19]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&诸葛亮\n阁下过去深受曹操的礼遇，\n想必你还记得他的恩德吧。"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n先前与袁绍作战时，\n关某已经报答过他了。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[35,0,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n既然如此………\n曹操狼狈不堪地向你求饶时，\n你会斩杀曹操吗？"]},{"op":52,"name":"actor_action","args":[3,2]},{"op":20,"name":"dialog","args":["&关羽\n关某定可斩杀曹操！\n如果关某不能斩他，\n愿受军法处置。"]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":20,"name":"dialog","args":["&诸葛亮\n……能立军令状吗？"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n当然。"]},{"op":20,"name":"dialog","args":["&诸葛亮\n好吧。"]},{"op":20,"name":"dialog","args":["&诸葛亮\n请指挥第三队跟随翼德将军身后，\n燃放干柴祭起浓烟，以便伏击曹军。"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n如果曹军见到浓烟，\n知道前面藏有敌兵，\n不就改走别的路线了？"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n非也。曹操是个熟谙兵法之人，\n他会认为狼烟乃是故布疑阵的伎俩，\n反倒会大胆挺进的。\n&关羽\n原来如此。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n你都明白了吗？\n那就马上行动吧。"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n是。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,34,0,67,10,0]},{"op":50,"name":"actor_move","args":[65535,33,0,67,10,0]},{"op":50,"name":"actor_move","args":[65535,3,0,67,10,0]},{"op":49,"name":"actor_select","args":[65535,34,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,33,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,3,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&刘备\n……孔明。"]},{"op":51,"name":"actor_face","args":[35,0,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n是。\n&刘备\n二弟虽然坚决保证，\n只怕他不会杀害曹操的。\n&诸葛亮\n嗯，恐怕下不了手吧。\n&刘备\n那么他的军令状？"]},{"op":52,"name":"actor_action","args":[35,6]},{"op":20,"name":"dialog","args":["&诸葛亮\n如果云长将军心中尚有过去的恩义，\n会利用这个机会做个了断的。"]},{"op":52,"name":"actor_action","args":[35,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n这也是为了云长将军。\n&刘备\n孔明，你想得可真远……"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":2642,"sections":[{"index":0,"offset":2644,"title":"军事会议  赤壁逃出前","body_off":2675,"body_end":3726,"conditions":[{"op":2,"name":"comment","args":["军事会议  赤壁逃出前"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":2675,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":3,"end_off":2722},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[15]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[2,65535,65535,53,65535]},{"op":48,"name":"actor_appear","args":[0,54,80,0,0]},{"op":48,"name":"actor_appear","args":[2,44,64,1,0]},{"op":48,"name":"actor_appear","args":[21,64,64,3,0]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["乌林  曹操军主营"]},{"op":56,"name":"set_attr","args":[0,15,0,257]},{"op":52,"name":"actor_action","args":[0,2]},{"op":20,"name":"dialog","args":["&曹操\n这帮可恶的東吴狗賊！\n居然打得我一败涂地！"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":51,"name":"actor_face","args":[2,17,2]},{"op":20,"name":"dialog","args":["&张辽\n丞相請先冷靜。\n眼下最重要的是設法脫身，\n日後再跟東吳算帳。"]},{"op":51,"name":"actor_face","args":[21,6,2]},{"op":20,"name":"dialog","args":["&程昱\n張將軍所言即是。\n東吳的追兵很快就會追趕過來，\n我們還是快點撤退吧。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":51,"name":"actor_face","args":[2,0,1]},{"op":51,"name":"actor_face","args":[21,0,3]},{"op":20,"name":"dialog","args":["&曹操\n唉，都怪我一時大意，真是追悔莫及！"]},{"op":1,"name":"if","args":[],"off":3218,"cond":{"op":5,"name":"test_flags","args":[[794],[]]},"end":28,"end_off":3273},{"op":111,"name":"lose_item","args":[116]},{"op":111,"name":"lose_item","args":[116]},{"op":105,"name":"popup","args":["本關不可使用獨角獸。"]},{"o