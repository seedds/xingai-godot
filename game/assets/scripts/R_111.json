{"file":"R_111.eex","kind":"story","scenario_index":222,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":26,"sections":[{"index":0,"offset":28,"title":"人物形象","body_off":47,"body_end":87,"conditions":[{"op":2,"name":"comment","args":["人物形象"]},{"op":0,"name":"end","args":[]}],"body":[{"op":119,"name":"int_var_op","args":[2,4051,2,0,0]},{"op":11,"name":"set_flag","args":[248,0]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":87,"sections":[{"index":0,"offset":89,"title":"戰後","body_off":104,"body_end":9649,"conditions":[{"op":2,"name":"comment","args":["戰後"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":104,"cond":{"op":5,"name":"test_flags","args":[[],[1750]]},"end":291,"end_off":7432},{"op":10,"name":"clear_flags","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[64]},{"op":119,"name":"int_var_op","args":[2,4027,2,0,1]},{"op":39,"name":"change_scene","args":[2,65535,65535,31,65535]},{"op":23,"name":"place_name","args":["靈山山腳"]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["師徒絕"]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[34,54,95,0,0]},{"op":50,"name":"actor_move","args":[65535,34,0,54,57,0]},{"op":48,"name":"actor_appear","args":[545,53,43,2,0]},{"op":48,"name":"actor_appear","args":[546,58,43,2,0]},{"op":48,"name":"actor_appear","args":[547,48,43,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[545,2]},{"op":52,"name":"actor_action","args":[546,17]},{"op":52,"name":"actor_action","args":[547,2]},{"op":20,"name":"dialog","args":["&凌霄\n趙雲，你想逃哪去啊？"]},{"op":20,"name":"dialog","args":["&春霄\n臭小子，竟敢背叛我們！"]},{"op":52,"name":"actor_action","args":[546,0]},{"op":20,"name":"dialog","args":["&月霄\n……子龍！"]},{"op":52,"name":"actor_action","args":[34,0]},{"op":20,"name":"dialog","args":["&赵云\n哼！"]},{"op":52,"name":"actor_action","args":[546,5]},{"op":20,"name":"dialog","args":["&月霄\n徒兒，最起碼讓我知道是為什麼。"]},{"op":52,"name":"actor_action","args":[34,2]},{"op":20,"name":"dialog","args":["&赵云\n自從妳們把我變成小孩、困在這山上開始，\n我就一直想要擺脫妳們了！"]},{"op":52,"name":"actor_action","args":[546,0]},{"op":52,"name":"actor_action","args":[547,13]},{"op":20,"name":"dialog","args":["&春霄\n至少我們待你不薄，還幫你提升了武藝！"]},{"op":20,"name":"dialog","args":["&赵云\n是！但那也只是妳們想利用我去偷\n青龍寶玉的碎片而已！"]},{"op":20,"name":"dialog","args":["&赵云\n我知道是怎麼回事！\n因為青龍寶玉的碎片有著結界，\n所以妳們也被困在山上，對吧？"]},{"op":20,"name":"dialog","args":["&赵云\n很巧的，我正好符合拿到寶玉碎片的\n條件，所以妳們拐我當妳們的徒弟，\n利用我去破除結界！"]},{"op":52,"name":"actor_action","args":[547,0]},{"op":52,"name":"actor_action","args":[545,0]},{"op":20,"name":"dialog","args":["&春霄\n你……"]},{"op":20,"name":"dialog","args":["&凌霄\n你很聰明，你的猜想大體不差，\n就是這麼回事。"]},{"op":52,"name":"actor_action","args":[545,17]},{"op":20,"name":"dialog","args":["&凌霄\n把碎片給我，我就放過你。"]},{"op":52,"name":"actor_action","args":[546,5]},{"op":20,"name":"dialog","args":["&月霄\n子龍，這些年來我對你不差吧？\n即便我們利用了你，\n但我也確實將你視如己出啊。"]},{"op":20,"name":"dialog","args":["&赵云\n妳不是把我當成兒子，\n而是當成妳養的狗！"]},{"op":20,"name":"dialog","args":["&赵云\n妳們這樣的人永遠不懂什麼是愛，\n在妳們眼裡兒子、徒弟跟狗根本\n沒有區別！"]},{"op":52,"name":"actor_action","args":[546,0]},{"op":20,"name":"dialog","args":["&月霄\n被我當成寵物有這麼糟嗎……？"]},{"op":52,"name":"actor_action","args":[547,2]},{"op":20,"name":"dialog","args":["&春霄\n少囉嗦，快點交出碎片！這是命令！\n我警告你：如果我們動手搶，\n那你可就死無葬身之地了。"]},{"op":52,"name":"actor_action","args":[34,0]},{"op":20,"name":"dialog","args":["&赵云\n哼，那麼就來吧。\n即使我會死，也比做妳們的狗強！"]},{"op":20,"name":"dialog","args":["&春霄\n你自找的！"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[545,2]},{"op":52,"name":"actor_action","args":[546,4]},{"op":52,"name":"actor_action","args":[547,13]},{"op":9,"name":"delay","args":[6]},{"op":105,"name":"popup","args":["慢！"]},{"op":48,"name":"actor_appear","args":[157,54,52,0,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[545,0]},{"op":52,"name":"actor_action","args":[546,0]},{"op":52,"name":"actor_action","args":[547,0]},{"op":20,"name":"dialog","args":["&凌霄\n許子將！"]},{"op":52,"name":"actor_action","args":[547,13]},{"op":20,"name":"dialog","args":["&春霄\n又是你！\n這次不干你的事，快點滾開！"]},{"op":52,"name":"actor_action","args":[157,6]},{"op":20,"name":"dialog","args":["&许子将\n久違了，三位道友。\n請妳們看在貧道的面子上放他一馬吧。"]},{"op":52,"name":"actor_action","args":[547,0]},{"op":20,"name":"dialog","args":["&许子将\n三位道友之所以干預他的命運，\n不外乎就是要他打破寶玉的結界，\n讓妳們有機會離開這座山吧？"]},{"op":20,"name":"dialog","args":["&许子将\n現在既然目的已經達到，\n趙雲對妳們已無利用價值，\n不如網開一面，放他離開吧。"]},{"op":52,"name":"actor_action","args":[547,8]},{"op":20,"name":"dialog","args":["&春霄\n別想！你沒資格跟我們談條件！"]},{"op":20,"name":"dialog","args":["&凌霄\n如果我們放過他，可以得到什麼好處？"]},{"op":51,"name":"actor_face","args":[547,0,1]},{"op":51,"name":"actor_face","args":[546,0,3]},{"op":20,"name":"dialog","args":["&春霄\n大姊！"]},{"op":51,"name":"actor_face","args":[546,0,2]},{"op":51,"name":"actor_face","args":[547,0,2]},{"op":52,"name":"actor_action","args":[157,3]},{"op":20,"name":"dialog","args":["&许子将\n妳們可以得到青龍寶玉的碎片，\n增強妳們的功力！"]},{"op":52,"name":"actor_action","args":[34,2]},{"op":20,"name":"dialog","args":["&赵云\n大叔！不要慷別人之慨呀！"]},{"op":20,"name":"dialog","args":["&凌霄\n憑我們三個人的實力，\n寶玉的碎片絕對能搶回來，\n所以你開的這個條件毫無意義。"]},{"op":52,"name":"actor_action","args":[34,0]},{"op":52,"name":"actor_action","args":[157,6]},{"op":20,"name":"dialog","args":["&许子将\n那麼這樣吧：當年妳們之所以\n會被困住，是因為打賭輸給了我，\n所以被「天」制裁了。"]},{"op":20,"name":"dialog","args":["&许子将\n按照當年的約定，即使沒了結界，\n妳們還要待滿二十年才能出去。"]},{"op":20,"name":"dialog","args":["&许子将\n現在我取消當年的賭約，\n妳們現在就可以獲得自由，\n這樣可以嗎？"]},{"op":52,"name":"actor_action","args":[547,15]},{"op":20,"name":"dialog","args":["&春霄\n笑死人了！\n對我們這些活了上千年的仙人來說，\n區區二十年有什麼大不了的！我們可以等！"]},{"op":20,"name":"dialog","args":["&凌霄\n好吧，這個條件還可以考慮。"]},{"op":51,"name":"actor_face","args":[547,0,1]},{"op":20,"name":"dialog","args":["&春霄\n大姊！妳在說什麼呢！"]},{"op":20,"name":"dialog","args":["&凌霄\n接下來的二十年，\n可能是數百年來最精采的二十年，\n我也不想錯過。"]},{"op":52,"name":"actor_action","args":[545,17]},{"op":51,"name":"actor_face","args":[547,0,2]},{"op":20,"name":"dialog","args":["&凌霄\n許子將！我可以接受你的這個條件！\n但是還有另一個條件：你要跟我們打賭！"]},{"op":52,"name":"actor_action","args":[545,2]},{"op":20,"name":"dialog","args":["&凌霄\n如果趙雲能夠力挽狂瀾，\n大幅改變原本的世界線，\n那就是你贏！"]},{"op":20,"name":"dialog","args":["&凌霄\n假如不能，那就換成你要被困在\n你的山上一千年！這樣可以嗎？"]},{"op":52,"name":"actor_action","args":[157,0]},{"op":20,"name":"dialog","args":["&许子将\n好吧，貧道接受了。"]},{"op":52,"name":"actor_action","args":[545,0]},{"op":20,"name":"dialog","args":["&凌霄\n很好。"]},{"op":20,"name":"dialog","args":["&许子将\n但是妳們得保證絕對不會再來糾纏\n趙雲，這樣可以嗎？"]},{"op":20,"name":"dialog","args":["&凌霄\n可以，今後我不會再主動插手他的命運。"]},{"op":51,"name":"actor_face","args":[545,0,0]},{"op":51,"name":"actor_face","args":[547,0,1]},{"op":51,"name":"actor_face","args":[546,0,3]},{"op":20,"name":"dialog","args":["&凌霄\n妹妹們，我們回去吧。"]},{"op":52,"name":"actor_action","args":[547,4]},{"op":20,"name":"dialog","args":["&春霄\n等、等等！"]},{"op":51,"name":"actor_face","args":[547,15,2]},{"op":51,"name":"actor_face","args":[546,0,2]},{"op":20,"name":"dialog","args":["&春霄\n臭小子！你要離開可以，\n但是你不能把我們教你的本事也帶走！"]},{"op":52,"name":"actor_action","args":[547,14]},{"op":20,"name":"dialog","args":["&春霄\n我要廢了你！讓你沒機會來對付我們！"]},{"op":52,"name":"actor_action","args":[34,2]},{"op":20,"name":"dialog","args":["&赵云\n好！從此我不再是妳們的徒弟，\n我們一刀兩斷！"]},{"op":52,"name":"actor_action","args":[546,4]},{"op":20,"name":"dialog","args":["&凌霄\n夠了！"]},{"op":52,"name":"actor_action","args":[547,0]},{"op":52,"name":"actor_action","args":[546,0]},{"op":20,"name":"dialog","args":["&凌霄\n子龍，我同意你下山。\n但是你從此不再是[C0D丹靈門]的人，\n不管到哪裡都不能報上我們的名號。"]},{"op":51,"name":"actor_face","args":[547,0,1]},{"op":51,"name":"actor_face","args":[546,4,3]},{"op":20,"name":"dialog","args":["&月霄\n大姊……"]},{"op":20,"name":"dialog","args":["&凌霄\n你現在還太年輕，容易被情感左右。\n只要你改變主意，隨時都能回冰心殿\n找我們拜師。"]},{"op":51,"name":"actor_face","args":[547,0,2]},{"op":51,"name":"actor_face","args":[546,4,2]},{"op":52,"name":"actor_action","args":[34,0]},{"op":20,"name":"dialog","args":["&赵云\n…………"]},{"op":9,"name":"delay","args":[8]},{"op":51,"name":"actor_face","args":[547,0,1]},{"op":9,"name":"delay","args":[8]},{"op":51,"name":"actor_face","args":[547,0,2]},{"op":9,"name":"delay","args":[8]},{"op":51,"name":"actor_face","args":[547,0,1]},{"op":9,"name":"delay","args":[10]},{"op":52,"name":"actor_action","args":[547,5]},{"op":20,"name":"dialog","args":["&春霄\n大姊，難道妳……"]},{"op":20,"name":"dialog","args":["&凌霄\n你是最令我失望的弟子。"]},{"op":50,"name":"actor_move","args":[65535,545,0,53,39,0]},{"op":51,"name":"actor_face","args":[546,4,0]},{"op":51,"name":"actor_face","args":[547,0,0]},{"op":1,"name":"if","args":[],"off":4205,"cond":{"op":2,"name":"comment","args":["旋轉"]},"end":159,"end_off":4300},{"op":51,"name":"actor_face","args":[545,0,3]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[545,0,2]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[545,0,1]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[545,0,0]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[1]},{"op":1,"name":"if","args":[],"off":4308,"cond":{"op":2,"name":"comment","args":["旋轉"]},"end":169,"end_off":4403},{"op":51,"name":"actor_face","args":[545,0,3]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[545,0,2]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[545,0,1]},{"op":9,"name":"delay","args":[1]},{"op":51,"name":"actor_face","args":[545,0,0]},{"op":0,"name":"end","args":[]},{"op":49,"name":"actor_select","args":[65535,545,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[8]},{"op":51,"name":"actor_face","args":[546,4,2]},{"op":51,"name":"actor_face","args":[547,0,2]},{"op":9,"name":"delay","args":[2]},{"op":52,"name":"actor_action","args":[547,15]},{"op":20,"name":"dialog","args":["&春霄\n你別以為我會就這樣算了！"]},{"op":20,"name":"dialog","args":["&月霄\n子龍，希