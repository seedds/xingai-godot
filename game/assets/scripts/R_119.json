7,2]},{"op":20,"name":"dialog","args":["&关嫣\n我繼承了父親的刀法。\n只要手持青龍偃月刀，\n每次都能發出致命一擊。"]},{"op":51,"name":"actor_face","args":[800,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":10762,"title":"","body_off":10779,"body_end":11039,"conditions":[{"op":2,"name":"comment","args":[""]},{"op":45,"name":"test_clicked","args":[705]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[705,3,2]},{"op":20,"name":"dialog","args":["&蒙古大夫\n現在我軍有兩個醫生，\n後勤很有保障了。"]},{"op":51,"name":"actor_face","args":[701,3,2]},{"op":20,"name":"dialog","args":["&索朗次仁\n哈哈，說的是。"]},{"op":52,"name":"actor_action","args":[705,0]},{"op":52,"name":"actor_action","args":[701,6]},{"op":20,"name":"dialog","args":["&索朗次仁\n我雖然精神力是降檔的，\n但是攻擊力卻是提檔，\n堪稱是目前武力值最高的輜重隊。"]},{"op":51,"name":"actor_face","args":[705,0,3]},{"op":51,"name":"actor_face","args":[701,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":11039,"title":"","body_off":11056,"body_end":11160,"conditions":[{"op":2,"name":"comment","args":[""]},{"op":45,"name":"test_clicked","args":[701]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[701,6,2]},{"op":20,"name":"dialog","args":["&索朗次仁\n我叫索朗次仁，我是一個藏醫，\n今後還請多多指教。"]},{"op":51,"name":"actor_face","args":[701,0,3]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":11160,"title":"玩家切换","body_off":11185,"body_end":11422,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[40]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[40,0,2]},{"op":20,"name":"dialog","args":["&孙乾\n我是辎重队，最擅长补给，\n后勤的事情就交给我处理吧。\n&关平\n辎重队的防御力也很高，\n所以孙乾先生也能充当肉盾吗？"]},{"op":51,"name":"actor_face","args":[40,0,3]},{"op":20,"name":"dialog","args":["&孙乾\n这……\n很遗憾的，我的防御是降档的。\n&