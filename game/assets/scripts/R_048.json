,"args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n……三弟！\n振作点……！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&张飞\n……唔唔？\n二，二哥？\n俺对不起你……让荆州给丢了……\n&张飞\n江，江陵的士兵背叛……投靠了东吴……\n&张飞\n可恶，俺饶不过他们！\n……唔，唔唔……！"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n三弟，你要振作下去！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&张飞\n……大哥呢？\n&关羽\n……啊，啊。\n不必担心……\n已经安然撤往白帝城了。\n&张飞\n是，是吗？\n……太好了。\n死守麦城总算有回报了……\n&张飞\n……这样……\n我们三个又能一起喝酒了……\n&张飞\n………………"]},{"op":9,"name":"delay","args":[10]},{"op":52,"name":"actor_action","args":[3,9]},{"op":20,"name":"dialog","args":["&关羽\n……三弟？\n三弟！！\n你醒醒，振作下去！"]},{"op":52,"name":"actor_action","args":[3,7]},{"op":20,"name":"dialog","args":["&关羽\n三弟！！"]},{"op":9,"name":"delay","args":[10]},{"op":52,"name":"actor_action","args":[3,9]},{"op":48,"name":"actor_appear","args":[46,54,5,2,0]},{"op":50,"name":"actor_move","args":[65535,46,0,54,24,2]},{"op":52,"name":"actor_action","args":[46,0]},{"op":9,"name":"delay","args":[8]},{"op":20,"name":"dialog","args":["&关平\n……父亲。"]},{"op":9,"name":"delay","args":[5]},{"op":35,"name":"play_music","args":[38,1]},{"op":52,"name":"actor_action","args":[46,10]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n平儿！"]},{"op":50,"name":"actor_move","args":[65535,3,0,48,41,1]},{"op":9,"name":"delay","args":[0]},{"op":50,"name":"actor_move","args":[65535,3,0,48,24,1]},{"op":20,"name":"dialog","args":["&关平\n唔，唔唔……"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n平儿，振作下去！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关平\n……父，父亲，您没事吧……\n&关羽\n为父没事，东吴军也被击退了。\n放心吧！"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n平儿，究竟发生何事？\n为父不相信你们会如此轻易被击败！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关平\n……我们听到吴军来袭的报告，\n孩儿和弟弟们杀出江陵城迎敌。"]},{"op":20,"name":"dialog","args":["&关平\n当我们与吴军的先锋交战时……"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&关平\n江陵的城门大开，\n城内的军马向我们背后袭来！"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&关平\n而且……率领我荆州军的是周瑜！"]},{"op":52,"name":"actor_action","args":[3,2]},{"op":20,"name":"dialog","args":["&关羽\n什么！？\n荆州军为何听命于周瑜……\n难道荆州军叛变降吴了？"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关平\n……似乎并不是单纯的叛变，\n孩儿还听到令人难以置信的消息。"]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&关平\n叛军说他们是依照军师的命令……"]},{"op":52,"name":"actor_action","args":[3,2]},{"op":20,"name":"dialog","args":["&关羽\n军师的命令……？\n难道兄长说的没错……唔唔！\n&关平\n……遭到前后夹击的我军败走，\n最后才逃到了麦城。\n&关平\n留在江陵城内的刘备主公，\n也在张飞将军的保护下逃了出来。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&关平\n父亲……主公没事吧？"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n……啊？兄长没事。\n&关平\n……是吗？\n那么弟弟们的死也值得了。"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n你说什么？\n他们都死了！？\n&关平\n父亲……孩儿真幸福，\n竟然还能死在父亲的身边……"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&关羽\n平儿，你说什么？\n不要胡说，\n要活下去！！"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&关平\n…………………"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[3,9]},{"op":20,"name":"dialog","args":["&关羽\n平儿啊平儿……\n&关羽\n我关羽……一定要……\n一定要报此血仇！"]},{"op":9,"name":"delay","args":[10]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[3,2]},{"op":20,"name":"dialog","args":["&关羽\n周瑜！！\n孔明！！\n我要亲手杀了你们！！"]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":2698,"sections":[{"index":0,"offset":2700,"title":"曹操与关羽再次重逢","body_off":2729,"body_end":4800,"conditions":[{"op":2,"name":"comment","args":["曹操与关羽再次重逢"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,53,65535]},{"op":48,"name":"actor_appear","args":[0,54,80,0,0]},{"op":48,"name":"actor_appear","args":[20,64,64,3,0]},{"op":48,"name":"actor_appear","args":[23,64,52,3,0]},{"op":48,"name":"actor_appear","args":[1,44,64,1,0]},{"op":48,"name":"actor_appear","args":[17,44,52,1,0]},{"op":1,"name":"if","args":[],"off":2881,"cond":{"op":5,"name":"test_flags","args":[[],[710]]},"end":9,"end_off":2925},{"op":48,"name":"actor_appear","args":[16,44,58,1,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2925,"cond":{"op":5,"name":"test_flags","args":[[710],[]]},"end":12,"end_off":2969},{"op":48,"name":"actor_appear","args":[15,44,58,1,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":2969,"cond":{"op":5,"name":"test_flags","args":[[1320],[]]},"end":15,"end_off":3013},{"op":48,"name":"actor_appear","args":[22,64,58,3,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3013,"cond":{"op":5,"name":"test_flags","args":[[1315],[]]},"end":18,"end_off":3057},{"op":48,"name":"actor_appear","args":[19,64,58,3,0]},{"op":0,"name":"end","args":[]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["襄阳  曹操军主营"]},{"op":48,"name":"actor_appear","args":[181,54,22,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":20,"name":"dialog","args":["&士兵01\n主公，关羽将军来了。\n&曹操\n嗯，有请。\n&士兵01\n是。"]},{"op":52,"name":"actor_action","args":[181,0]},{"op":9,"name":"delay","args":[3]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":48,"name":"actor_appear","args":[3,54,22,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&关羽\n参见丞相。"]},{"op":50,"name":"actor_move","args":[65535,3,0,54,64,2]},{"op":20,"name":"dialog","args":["&曹操\n关羽，别来无恙。"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n是。\n感谢丞相前来救援，\n关某不胜感激。\n&曹操\n嗯。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n……听说刘备过世了。\n&关羽\n是的。\n&关羽\n三弟和我的三个儿子，\n也都死于吴军之手。"]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n是吗？\n那么你对蜀国应该无可留恋了吧？"]},{"op":52,"name":"actor_action","args":[3,2]},{"op":20,"name":"dialog","args":["&关羽\n丞相何出此言？\n&曹操\n关羽啊，你就为我军效力吧。"]},{"op":9,"name":"delay","args":[10]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n丞相……\n您打算在关某无家可归之际趁虚而入吗？"]},{"op":20,"name":"dialog","args":["&曹操\n是的。"]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n主公！"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":3833,"cond":{"op":5,"name":"test_flags","args":[[1320],[]]},"end":61,"end_off":3934},{"op":51,"name":"actor_face","args":[22,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[22,6]},{"op":20,"name":"dialog","args":["&郭嘉\n主公，此事确实过于苛求关将军！"]},{"op":52,"name":"actor_action","args":[22,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":3934,"cond":{"op":5,"name":"test_flags","args":[[1315],[]]},"end":68,"end_off":4037},{"op":51,"name":"actor_face","args":[19,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[19,6]},{"op":52,"name":"actor_action","args":[19,0]},{"op":20,"name":"dialog","args":["&司马懿\n主公，此事确实过于苛求关将军！"]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,2]},{"op":56,"name":"set_attr","args":[0,15,0,257]},{"op":20,"name":"dialog","args":["&曹操\n……。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":20,"name":"dialog","args":["&曹操\n……关羽，我会给你时间考虑的，\n你若想返回蜀国也可以，\n作我的属下也可以。"]},{"op":51,"name":"actor_face","args":[0,0,2]},{"op":20,"name":"dialog","args":["&曹操\n考虑一下吧。"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n……好吧，关某告辞。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,3,0,54,30,0]},{"op":20,"name":"dialog","args":["&关羽\n（兄长……）"]},{"op":50,"name":"actor_move","args":[65535,3,0,54,22,0]},{"op":49,"name":"actor_select","args":[65535,3,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n主公，为何对关羽这么说呢？"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n小女子亦有同感。\n何不将刘备大人给主公的信函，\n交予关将军过目呢？"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[0,0,0]},{"op":20,"name":"dialog","args":["&曹操\n这个做法我当然也很清楚。"]},{"op":51,"name":"actor_face","args":[0,0,1]},{"op":20,"name":"dialog","args":["&曹操\n但是如果让关羽见到信上所说的话，\n因而放弃了自己该做的事，\n即使加盟于我也没有任何意义了。"]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":4800,"sections":[{"index":0,"offset":4802,"title":"孔明和周瑜的密谈","body_off":4829,"body_end":6131,"conditions":[{"op":2,"name":"comment","args":["孔明和周瑜的密谈"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,10,65535]},{"op":48,"name":"actor_appear","args":[77,70,55,3,0]},{"op":48,"name":"actor_appear","args":[35,52,55,1,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":105,"name":"popup","args":["此时……"]},{"op":23,"name":"place_name","args":["江陵  周瑜公馆"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n……孔明，你的计谋真是高明。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[77,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,17]},{"op":20,"name":"dialog","args":["&周瑜\n如今成功地结果了刘备和张飞的性命。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":20,"name":"dialog","args":["&周瑜\n接下来就该对付曹操了。"]},{"op":51,"name":"actor_face","args":[77,0,3]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n只可惜没能结果关羽的性命。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[35,0,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n想不到曹操竟然会赶来救援麦城……"]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n关羽该不会投靠他所厌恶的曹操吧？"]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":20,"name":"dialog","args":["&诸葛亮\n嗯，这件事恐怕已经成为事实。\n想必他也该察觉我们的举动了。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[77,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[77,11]},{"op":20,"name":"dialog","args":["&周瑜\n关羽啊关羽，你这令人厌恶之徒，\n真的打算和奸相曹操联手，\n一起挑战我东吴吗？\n&诸葛亮\n周瑜，不论魏军有何举动，\n你可不能违背誓约噢。"]},{"op":52,"name":"actor_action","args":[77,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[77,0,3]},{"op":20,"name":"dialog","args":["&周瑜\n只有完全的美才能称为美，\n我周瑜又怎么可能会失败呢。\n你就放心地交给我吧。\n&诸葛亮\n嗯。"]},{"op":50,"name":"actor_move","args":[65535,35,0,5,55,3]},{"op":49,"name":"actor_select","args":[65535,35,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&周瑜\n哼！孔明。\n我不会任由你摆布的。"]},{"op":51,"name":"actor_face","args":[77,0,2]},{"op":20,"name":"dialog","args":["&周瑜\n这一仗我不会击溃魏国。\n只要曹操活着一天，\n你就必须与曹操作战。"]},{"op":52,"name":"actor_action","args":[77,3]},{"op":20,"name":"dialog","args":["&周瑜\n迟早你会不知不觉踏上死路，\n在庄严的丧曲之中安息的。"]},{"op":52,"name":"actor_action","args":[77,17]},{"op":20,"name":"dialog","args":["&周瑜\n取得天下的既非你孔明也非曹操！\n天下最终将会落于我东吴之手。"]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":4,"offset":6131,"sections":[{"index":0,"offset":6133,"title":"关羽降曹","body_off":6152,"body_end":8154,"conditions":[{"op":2,"name":"comment","args":["关羽降曹"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,12,65535]},{"op":48,"name":"actor_appear","args":[0,29,54,1,0]},{"op":48,"name":"actor_appear","args":[20,50,41,2,0]},{"op":48,"name":"actor_appear","args":[23,62,41,2,0]},{"op":48,"name":"actor_appear","args":[1,50,68,0,0]},{"op":48,"name":"actor_appear","args":[17,56,68,0,0]},{"op":1,"name":"if","args":[],"off":6304,"cond":{"op":5,"name":"test_flags","args":[[],[710]]},"end":9,"end_off":6348},{"op":48,"name":"actor_appear","args":[16,62,68,0,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6348,"cond":{"op":5,"name":"test_flags","args":[[710],[]]},"end":12,"end_off":6392},{"op":48,"name":"actor_appear","args":[15,62,68,0,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6392,"cond":{"op":5,"name":"test_flags","args":[[1320],[]]},"end":15,"end_off":6436},{"op":48,"name":"actor_appear","args":[22,56,41,2,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":6436,"cond":{"op":5,"name":"test_flags","args":[[1315],[]]},"end":18,"end_off":6480},{"op":48,"name":"actor_appear","args":[19,56,41,2,0]