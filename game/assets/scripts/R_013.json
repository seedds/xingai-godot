02\n是的。\n还破口大骂，令人难以忍受……。\n&审配\n曹操这人看来比想像中还要感情用事。"]},{"op":51,"name":"actor_face","args":[101,0,1]},{"op":20,"name":"dialog","args":["&袁绍\n嗯嗯。\n让我多少有点意外。"]},{"op":51,"name":"actor_face","args":[101,0,2]},{"op":20,"name":"dialog","args":["&袁绍\n嗯，这一趟辛苦使者了。"]},{"op":51,"name":"actor_face","args":[101,0,0]},{"op":20,"name":"dialog","args":["&袁绍\n我们本来就不是真的要求什么，\n那就按照原计划进攻北平吧。"]},{"op":51,"name":"actor_face","args":[101,0,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[101,17,2]},{"op":20,"name":"dialog","args":["&袁绍\n等我消灭了公孙瓒，\n整个河北就是我的了！"]},{"op":0,"name":"end","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[202,255]},{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[1,65535,65535,65535,65535]},{"op":28,"name":"fade_out","args":[]},{"op":41,"name":"op_29","args":[0,342,111]},{"op":41,"name":"op_29","args":[101,390,22]},{"op":41,"name":"op_29","args":[161,471,0]},{"op":44,"name":"caption","args":["得到曹操答复的袁绍，",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":42,"name":"op_2a","args":[101,407,0]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["出兵攻打北平了。",1,1,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":3758,"sections":[{"index":0,"offset":3760,"title":"许都  相府","body_off":3781,"body_end":4749,"conditions":[{"op":2,"name":"comment","args":["许都  相府"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,8,65535]},{"op":48,"name":"actor_appear","args":[0,34,55,1,0]},{"op":48,"name":"actor_appear","args":[1,52,70,0,0]},{"op":48,"name":"actor_appear","args":[6,58,70,0,0]},{"op":48,"name":"actor_appear","args":[5,64,70,0,0]},{"op":48,"name":"actor_appear","args":[20,52,40,2,0]},{"op":48,"name":"actor_appear","args":[22,58,40,2,0]},{"op":48,"name":"actor_appear","a