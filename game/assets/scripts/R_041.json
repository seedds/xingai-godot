r_face","args":[21,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n是的。\n除了进行短期决战别无选择。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&曹操\n元让，你打先锋。"]},{"op":51,"name":"actor_face","args":[1,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n喔，交给我吧。"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":20,"name":"dialog","args":["&曹操\n子桓，你也出战。\n我已经派曹彰出战了。"]},{"op":51,"name":"actor_face","args":[8,0,2]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹丕\n是。"]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n蜀国是刘备一手创建的，\n为了表示敬意，\n我曹氏一族一定要亲手消灭蜀国。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":51,"name":"actor_face","args":[8,0,1]},{"op":51,"name":"actor_face","args":[20,0,3]},{"op":51,"name":"actor_face","args":[19,0,3]},{"op":51,"name":"actor_face","args":[21,0,3]},{"op":9,"name":"delay","args":[20]},{"op":1,"name":"if","args":[],"off":2587,"cond":{"op":5,"name":"test_flags","args":[[1280],[]]},"end":184,"end_off":4125},{"op":48,"name":"actor_appear","args":[13,54,23,2,0]},{"op":36,"name":"play_sound","args":[12]},{"op":20,"name":"dialog","args":["&徐晃\n丞相……"]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":50,"name":"actor_move","args":[0,13,0,54,64,2]},{"op":52,"name":"actor_action","args":[13,6]},{"op":20,"name":"dialog","args":["&徐晃\n丞相……\n吕布和貂蝉回来了！！"]},{"op":56,"name":"set_attr","args":[0,15,0,256]},{"op":20,"name":"dialog","args":["&曹操\n啊？\n他们带了多少军马？\n&徐晃\n只有他们两个。"]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":20,"name":"dialog","args":["&曹操\n？\n……让他们进来。\n&徐晃\n是。"]},{"op":52,"name":"actor_action","args":[13,0]},{"op":50,"name":"actor_move","args":[0,13,0,54,23,0]},{"op":52,"name":"actor_action","args":[13,17]},{"op":9,"name":"delay","args":[20]},{"op":51,"name":"actor_face","args":[13,0,2]},{"op":50,"name":"actor_move","args":[0,13,0,44,46,1]},{"op":52,"name":"actor_action","args":[13,0]},{"op":48,"name":"actor_appear","args":[119,54,25,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[0,119,0,50,30,2]},{"op":52,"name":"actor_action","args":[119,0]},{"op":48,"name":"actor_appear","args":[17,54,25,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":50,"name":"actor_move","args":[0,17,0,58,30,2]},{"op":20,"name":"dialog","args":["&吕布\n丞相。"]},{"op":50,"name":"actor_move","args":[0,119,0,50,64,2]},{"op":50,"name":"actor_move","args":[0,17,0,58,64,2]},{"op":52,"name":"actor_action","args":[119,0]},{"op":20,"name":"dialog","args":["&吕布\n丞相，奉先这次行动，\n因为时间的关系，没来得急向您禀报。\n请您恕罪。\n&曹操\n发生了什么事？\n&吕布\n是这样的，我发现我军弓箭力量不足，\n便再次打造硬弓。\n&貂蝉\n没想到，等到好不容易完成的时候，\n被一个士兵偷走了。\n他偷的时候，刚好被我们发现。\n&吕布\n我们没有声张，一路尾随这个士兵。\n最后竟然到了成都。\n他原来是蜀军潜伏在我军的奸细。\n&曹操\n啊？后来呢？\n&吕布\n当然是我俩武艺高强，杀死他，\n并且夺回硬弓。"]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n既然如此，你的弓能讓我看看嗎？\n&吕布\n(開什麼玩笑，老子的寶弓哪能交給你！)\n很可惜的，弓已經壞了。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n……好喔。"]},{"op":1,"name":"if","args":[],"off":3768,"cond":{"op":5,"name":"test_flags","args":[[],[835]]},"end":180,"end_off":3836},{"op":20,"name":"dialog","args":["&夏侯渊\n(呂布這小子向來心懷鬼胎，\n不可輕信。)"]},{"op":0,"name":"end","args":[]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n丞相，没想到，我俩还有意外的收获。\n&荀彧\n是不是探听到了蜀军的虚实？\n&貂蝉\n正是。蜀军认为我军会避其锋芒，\n而会从两侧包夹，\n所以将重兵埋伏在成都城两侧。\n&荀彧\n我军正好可以从中央攻击敌军的薄弱地带。\n&貂蝉\n正是。\n&曹操\n好，既然这样，我军就有底了。\n准备出征！！"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":4127,"cond":{"op":5,"name":"test_flags","args":[[],[740]]},"end":266,"end_off":6350},{"op":20,"name":"dialog","args":["&曹操\n终于来到这里了。"]},{"op":51,"name":"actor_face","args":[19,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n不过因为勉强行军，\n多数部队都掉队了。"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[20,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n话说回来，倒是取得足够的兵粮……"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[21,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n这场战斗必定相当漫长艰辛，\n我们绝不能急躁。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯。\n元让，你打前锋。"]},{"op":51,"name":"actor_face","args":[1,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[1,3]},{"op":20,"name":"dialog","args":["&夏侯惇\n喔，交给我吧。"]},{"op":52,"name":"actor_action","args":[1,0]},{"op":20,"name":"dialog","args":["&曹操\n子桓，你也出战。\n我已经派曹彰出战了。"]},{"op":51,"name":"actor_face","args":[8,0,2]},{"op":20,"name":"dialog","args":["&曹丕\n是。"]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n蜀国是刘备一手创建的，\n为了表示敬意，\n我曹氏一族要亲手消灭蜀国。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":51,"name":"actor_face","args":[1,0,1]},{"op":51,"name":"actor_face","args":[8,0,1]},{"op":51,"name":"actor_face","args":[20,0,3]},{"op":51,"name":"actor_face","args":[19,0,3]},{"op":51,"name":"actor_face","args":[21,0,3]},{"op":9,"name":"delay","args":[20]},{"op":1,"name":"if","args":[],"off":4810,"cond":{"op":5,"name":"test_flags","args":[[1280],[]]},"end":265,"end_off":6348},{"op":48,"name":"actor_appear","args":[13,54,23,2,0]},{"op":36,"name":"play_sound","args":[12]},{"op":20,"name":"dialog","args":["&徐晃\n丞相……"]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[10]},{"op":50,"name":"actor_move","args":[0,13,0,54,64,2]},{"op":