{"file":"R_047.eex","kind":"story","scenario_index":94,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":34,"sections":[{"index":0,"offset":36,"title":"曹操形象(老年)","body_off":61,"body_end":137,"conditions":[{"op":2,"name":"comment","args":["曹操形象(老年)"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,202]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":1,"name":"if","args":[],"off":81,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":109},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":137,"sections":[{"index":0,"offset":139,"title":"关羽　赶往白帝城","body_off":166,"body_end":979,"conditions":[{"op":2,"name":"comment","args":["关羽　赶往白帝城"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":39,"name":"change_scene","args":[2,65535,65535,31,65535]},{"op":53,"name":"set_r_image","args":[181,201]},{"op":53,"name":"set_r_image","args":[3,199]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["桃园梦断"]},{"op":23,"name":"place_name","args":["白帝城郊外  山道"]},{"op":48,"name":"actor_appear","args":[3,5,49,1,0]},{"op":50,"name":"actor_move","args":[65535,3,0,51,49,1]},{"op":20,"name":"dialog","args":["&关羽\n兄长！\n三弟！\n不要出事！"]},{"op":48,"name":"actor_appear","args":[181,95,55,3,0]},{"op":50,"name":"actor_move","args":[65535,181,0,59,55,3]},{"op":20,"name":"dialog","args":["&士兵01\n关，关将军！\n是关将军吗！？\n&关羽\n你……是荆州的守军吧？\n你要往何处去？\n&士兵01\n小的正要去向孔明军师报告。\n&关羽\n报告？\n报告什么？\n难，难道……\n&士兵01\n关将军，荆州已经失陷了！\n&关羽\n是吗……这么说我来迟了……\n那么主公和三将军呢！？\n&士兵01\n向白帝城撤退了。\n&关羽\n是吗……我知道了。\n辛苦你了。\n我要赶往白帝城！\n&士兵01\n是。\n&关羽\n告诉军师不要犹豫，即刻派兵增援。\n&士兵01\n是，小的一定办到！\n&关羽\n拜托你了。\n&士兵01\n关，关羽将军……"]},{"op":50,"name":"actor_move","args":[65535,3,0,98,49,1]},{"op":49,"name":"actor_select","args":[65535,3,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":53,"name":"set_r_image","args":[181,169]},{"op":53,"name":"set_r_image","args":[3,6]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":979,"sections":[{"index":0,"offset":981,"title":"刘备之死","body_off":1000,"body_end":3090,"conditions":[{"op":2,"name":"comment","args":["刘备之死"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[13]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[2,65535,65535,5,65535]},{"op":48,"name":"actor_appear","args":[32,55,46,2,10]},{"op":48,"name":"actor_appear","args":[203,58,43,2,13]},{"op":28,"name":"fade_out","args":[]},{"op":23,"name":"place_name","args":["白帝城"]},{"op":48,"name":"actor_appear","args":[3,31,61,1,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&关羽\n兄长！"]},{"op":50,"name":"actor_move","args":[65535,3,0,52,61,1]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,3,0,52,52,0]},{"op":20,"name":"dialog","args":["&关羽\n兄长！\n&刘备\n……哦，二弟？"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n兄长，你没事吧！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&关羽\n（……唔！？这样的伤势……）\n&刘备\n……如你所见，我将不久于人世了。"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n……别说这种丧气话！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&刘备\n你不用在意我，倒是……\n&刘备\n三弟他们为了让我逃走，死守麦城，\n现在恐怕还在跟吴军交战……"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n三弟……还在浴血奋战是吗？\n&刘备\n二弟，你去支援三弟他们。\n&关羽\n……云长明白。\n我一定会救出他们的。\n请兄长放心。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&刘备\n那我就放心了。\n&刘备\n……荆州之战简直就像一场恶梦。\n&刘备\n我荆州军有三弟、周仓、关平等……\n身经百战的猛将，可说战无不胜。\n&刘备\n……直到那个人的军队出现！"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n那个人？\n是谁？"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&刘备\n……周瑜。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n周瑜！？\n周瑜不是在赤壁之战后病死了吗？"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&刘备\n我原本也以为他已经死了，\n可是击溃我荆州军的敌将确实是周瑜。"]},{"op":20,"name":"dialog","args":["&刘备\n二弟，孔明怎么样了？"]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n……军师还没有到达。"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&刘备\n是吗……那就好。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&刘备\n……二弟啊，孔明背叛了我们。"]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n您说什么！？\n难道军师他……"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&刘备\n我也不相信。\n不，应该说不愿相信！\n可是……"]},{"op":51,"name":"actor_face","args":[3,0,1]},{"op":20,"name":"dialog","args":["&关羽\n（……我原本也曾经有过这样的疑虑，\n只是没想到竟然是真的……！）"]},{"op":20,"name":"dialog","args":["&刘备\n我大概就快死了吧……唔唔！"]},{"op":51,"name":"actor_face","args":[3,0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[3,6]},{"op":20,"name":"dialog","args":["&关羽\n兄，兄长！\n&刘备\n……二弟啊。\n我死后，你就去投奔曹操吧！"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[3,3]},{"op":20,"name":"dialog","args":["&关羽\n什，什么！？"]},{"op":52,"name":"actor_action","args":[3,0]},{"op":20,"name":"dialog","args":["&刘备\n蜀军恐怕已经成了孔明的傀儡。\n如今能够对付孔明的只有曹操了！\n&刘备\n……二弟，拜托你了。\n一定要让蜀国走向正途……唔唔…"]},{"op":52,"name":"actor_action","args":[3,9]},{"op":20,"name":"dialog","args":["&关羽\n呜呜，兄长……\n我会完成兄长心愿的。\n&刘备\n……孔明，你为什么要……？\n我………\n我原本打算把大业托付给你的……\n&刘备\n……………………"]},{"op":9,"name":"delay","args":[10]},{"