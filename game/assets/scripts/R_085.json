":"set_menu","args":[0]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n出发，老夫終於要當皇帝喽！"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":9218,"title":"玩家切换","body_off":9243,"body_end":9488,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[127]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n跳過本關嗎？"]},{"op":1,"name":"if","args":[],"off":9274,"cond":{"op":18,"name":"choice","args":["跳過\n不跳過",127]},"end":17,"end_off":9480},{"op":1,"name":"if","args":[],"off":9298,"cond":{"op":19,"name":"test_choice","args":[1]},"end":13,"end_off":9433},{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&许子将\n好的，那麼就跳過本關。"]},{"op":6,"name":"battle_select_units","args":[0,0,65535,65535,65535,65535,65535,65535,65535,65535,65535,65535]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":35,"name":"play_music","args":[205,255]},{"op":17,"name":"goto_scenario","args":[171]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":9433,"cond":{"op":19,"name":"test_choice","args":[2]},"end":16,"end_off":9478},{"op":20,"name":"dialog","args":["&许子将\n呵呵，明智的選擇。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":9488,"title":"玩家切换","body_off":9513,"body_end":9786,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[17]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":51,"name":"actor_face","args":[127,3,2]},{"op":20,"name":"dialog","args":["&董卓\n嘿嘿，貂蟬你就放心吧。\n等到老夫當了皇帝，馬上封你當皇后！"]},{"op":51,"name":"actor_face","args":[17,3,0]},{"op":20,"name":"dialog","args":["&貂蝉\n真的？真是太棒了！"]},{"op":20,"name":"dialog","args":["&董卓\n嘻嘻，只要再等一下下就行了。\n我馬上就回來啦。"]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":20,"name":"dialog","args":["&貂蝉\n(呵呵，說出這種話的人是絕對\n回不來的。)"]},{"op":51,"name":"actor_face","args":[127,0,1]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":9786,"title":"玩家切换","body_off":9811,"body_end":10287,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[132]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&董卓\n怎麼了？李儒。\n看你心事重重的樣子，有哪裡不對嗎？"]},{"op":52,"name":"actor_action","args":[132,6]},{"op":20,"name":"dialog","args":["&李儒\n相國，這一切未免也來得太突然了。\n我擔心這其中是有詐的。"]},{"op":20,"name":"dialog","args":["&李儒\n王允一向都對漢朝忠心耿耿，\n他真的會要陛下禪讓嗎？"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n哈哈哈哈，這次是你想多了。"]},{"op":20,"name":"dialog","args":["&董卓\n王允的女兒可是老夫的小妾，\n老夫當上皇帝對他也有好處呀。"]},{"op":51,"name":"actor_face","args":[127,3,2]},{"op":20,"name":"dialog","args":["&董卓\n你說是吧？貂蟬。"]},{"op":51,"name":"actor_face","args":[17,6,0]},{"op":20,"name":"dialog","args":["&貂蝉\n是的。"]},{"op":20,"name":"dialog","args":["&李儒\n(希望不會發生任何意外才好………)"]},{"op":51,"name":"actor_face","args":[127,0,1]},{"op":51,"name":"actor_face","args":[17,0,2]},{"op":52,"name":"actor_action","args":[132,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":10287,"title":"玩家切换","body_off":10312,"body_end":10537,"conditions":[{"op":2,"name":"comment","args":["玩家切换"]},{"op":45,"name":"test_clicked","args":[135]},{"op":0,"name":"end","args":[]}],"body":[{"op":8,"name":"set_menu","args":[0]},{"op":20,"name":"dialog","args":["&李肃\n恭喜相國，賀喜相國。"]},{"op":52,"name":"actor_action","args":[127,3]},{"op":20,"name":"dialog","args":["&董卓\n哈哈，好說好說。"]},{"op":20,"name":"dialog","args":["&董卓\n你放心，等到老夫當上了皇帝，\n好處絕對少不了你的。"]},{"op":20,"name":"dialog","args":["&李肃\n嘿嘿，那麼屬下先在此\n謝謝“陛下”啦。"]},{"op":20,"name":"dialog","args":["&董卓\n哈哈哈哈哈哈。"]},{"op":52,"name":"actor_action","args":[127,0]},{"op":8,"name":"set_menu","args":[1]},{"op":0,"name":"end","args":[]}]}]}]}