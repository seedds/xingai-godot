{"file":"R_042.eex","kind":"story","scenario_index":84,"version":[1,2],"tlv":[],"scenes":[{"index":0,"offset":30,"sections":[{"index":0,"offset":32,"title":"曹操形象(老年)","body_off":57,"body_end":133,"conditions":[{"op":2,"name":"comment","args":["曹操形象(老年)"]},{"op":0,"name":"end","args":[]}],"body":[{"op":53,"name":"set_r_image","args":[0,202]},{"op":117,"name":"set_s_image","args":[3,7]},{"op":1,"name":"if","args":[],"off":77,"cond":{"op":5,"name":"test_flags","args":[[],[1837]]},"end":5,"end_off":105},{"op":53,"name":"set_r_image","args":[34,206]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4088,2,0,0]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":133,"sections":[{"index":0,"offset":135,"title":"孔明  逃往白帝城","body_off":162,"body_end":3555,"conditions":[{"op":2,"name":"comment","args":["孔明  逃往白帝城"]},{"op":0,"name":"end","args":[]}],"body":[{"op":10,"name":"clear_flags","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":8,"name":"set_menu","args":[0]},{"op":56,"name":"set_attr","args":[1,15,0,1]},{"op":36,"name":"play_sound","args":[16]},{"op":9,"name":"delay","args":[3]},{"op":39,"name":"change_scene","args":[1,65535,0,65535,65535]},{"op":41,"name":"op_29","args":[0,72,131]},{"op":41,"name":"op_29","args":[35,8,176]},{"op":28,"name":"fade_out","args":[]},{"op":44,"name":"caption","args":["曹操",0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":43,"name":"op_2b","args":[35]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["击败了蜀军，",1,0,0]},{"op":9,"name":"delay","args":[8]},{"op":42,"name":"op_2a","args":[0,29,173]},{"op":9,"name":"delay","args":[5]},{"op":44,"name":"caption","args":["终于占领了成都。",1,0,0]},{"op":9,"name":"delay","args":[10]},{"op":44,"name":"caption","args":["刘备建立的蜀国至此灭亡。",1,1,1]},{"op":29,"name":"fade_in","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":36,"name":"play_sound","args":[13]},{"op":39,"name":"change_scene","args":[2,65535,65535,69,65535]},{"op":23,"name":"place_name","args":["成都  刘备墓"]},{"op":9,"name":"delay","args":[3]},{"op":48,"name":"actor_appear","args":[0,50,35,0,0]},{"op":48,"name":"actor_appear","args":[17,55,45,0,0]},{"op":1,"name":"if","args":[],"off":567,"cond":{"op":5,"name":"test_flags","args":[[1280],[]]},"end":43,"end_off":1153},{"op":48,"name":"actor_appear","args":[119,45,45,0,0]},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&吕布\n没想到，大耳贼还是这样的结果。\n&曹操\n是啊……有些凄凉。"]},{"op":52,"name":"actor_action","args":[119,2]},{"op":20,"name":"dialog","args":["&吕布\n凄凉？哼，应该叫活该才对！"]},{"op":50,"name":"actor_move","args":[65535,0,0,50,37,2]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n你还恨他么……\n&吕布\n对！这样的小人，哼~\n不是连丞相都给蒙蔽了吗？\n&曹操\n不错，刘备的伎俩的确有高明之处。\n&貂蝉\n奉先，既然刘备已经死了，\n你也就不要再往心里去了。"]},{"op":52,"name":"actor_action","args":[119,3]},{"op":20,"name":"dialog","args":["&吕布\n对！该死的人已经死了。\n&曹操\n……(呂布你還有臉說別人嗎？)\n&曹操\n(你自己都出賣了劉備了，你又有什麼\n資格要他對你以德報怨呢？)"]},{"op":20,"name":"dialog","args":["&曹操\n(看來呂布的品性依然半點沒改，\n我得繼續盯緊他了……)"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1153,"cond":{"op":5,"name":"test_flags","args":[[1290],[1670]]},"end":62,"end_off":1764},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":20,"name":"dialog","args":["&曹操\n玄德……\n當年的種種，彷彿昨日才發生一般。\n&曹操\n想不到時至今日，\n玄德建立的國家卻落到這般下場。"]},{"op":52,"name":"actor_action","args":[17,6]},{"op":20,"name":"dialog","args":["&貂蝉\n是的。"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,0,0,50,33,2]},{"op":20,"name":"dialog","args":["&曹操\n玄德曾叫我處死奉先，你还恨他么？\n&貂蝉\n……我也許曾經對他感到不滿，\n但是現在不會了。\n因為他說得並沒有錯。\n&曹操\n…………\n&曹操\n我曾經給過奉先機會，但是他沒有去珍惜。\n貂蝉，你能諒解我嗎？"]},{"op":51,"name":"actor_face","args":[17,65535,2]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&貂蝉\n奉先只是一個見利忘義的懦夫，\n我現在已經認清了這個事實。"]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[17,6,0]},{"op":20,"name":"dialog","args":["&貂蝉\n現在我在这里很好，丞相很照顾我，\n您就放心吧。"]},{"op":52,"name":"actor_action","args":[17,0]},{"op":20,"name":"dialog","args":["&曹操\n谢谢你，貂蝉。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":1764,"cond":{"op":5,"name":"test_flags","args":[[1290,1670],[]]},"end":68,"end_off":2154},{"op":28,"name":"fade_out","args":[]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,0,0,50,33,2]},{"op":20,"name":"dialog","args":["&曹操\n你还恨他么……\n&貂蝉\n恨！\n奉先，加害你的人终于已经死了。\n你的在天之灵，终于可以安息了。\n&曹操\n……\n&貂蝉\n我在这里很好，丞相很照顾我，\n您就放心吧。\n&曹操\n当初我之所以选择听从刘备的话，\n实在是情非得以。\n貂蝉……\n&貂蝉\n哎！过去的早就应该过去了。\n丞相，既然刘备已经死掉，\n那么我们还有更多的事情去做。\n&曹操\n谢谢你，貂蝉。"]},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[255]},{"op":29,"name":"fade_in","args":[]},{"op":47,"name":"op_2f","args":[]},{"op":39,"name":"change_scene","args":[2,65535,65535,67,65535]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":24,"name":"title_text","args":["蜀的灭亡"]},{"op":23,"name":"place_name","args":["成都郊外  山路"]},{"op":48,"name":"actor_appear","args":[35,49,95,0,0]},{"op":50,"name":"actor_move","args":[65535,35,0,49,85,0]},{"op":48,"name":"actor_appear","args":[69,45,95,0,0]},{"op":48,"name":"actor_appear","args":[50,53,95,0,0]},{"op":50,"name":"actor_move","args":[65535,35,0,49,45,0]},{"op":50,"name":"actor_move","args":[65535,69,0,45,55,0]},{"op":50,"name":"actor_move","args":[65535,50,0,53,55,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[35,0,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n你们两个受伤了？"]},{"op":52,"name":"actor_action","args":[69,6]},{"op":20,"name":"dialog","args":["&姜维\n我没事。"]},{"op":52,"name":"actor_action","args":[69,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[50,6]},{"op":20,"name":"dialog","args":["&马谡\n哼，受伤这种事跟我无缘。"]},{"op":52,"name":"actor_action","args":[50,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n是吗……？\n如今蜀国虽然灭亡了，\n不过只要活着就一定有转机的。"]},{"op":52,"name":"actor_action","args":[69,6]},{"op":20,"name":"dialog","args":["&姜维\n孔明大人，今后怎么办呢？"]},{"op":52,"name":"actor_action","args":[69,0]},{"op":20,"name":"dialog","args":["&诸葛亮\n跟着我走就知道了。\n我有个想法……\n&姜维\n啊……"]},{"op":51,"name":"actor_face","args":[69,0,2]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[69,2]},{"op":20,"name":"dialog","args":["&姜维\n话说回来，主公刘禅死得真是丢人。\n这样的主公也未免太不中用了。"]},{"op":51,"name":"actor_face","args":[50,0,2]},{"op":20,"name":"dialog","args":["&马谡\n是啊，这种人实在不值得为他效力。"]},{"op":51,"name":"actor_face","args":[35,2,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n姜维、马谡！\n再说刘禅主公的坏话，\n我可不饶你们！"]},{"op":52,"name":"actor_action","args":[69,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[69,0,0]},{"op":51,"name":"actor_face","args":[50,0,0]},{"op":9,"name":"delay","args":[5]},{"op":51,"name":"actor_face","args":[35,0,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n一切责任在我。\n是先主刘备将刘禅主公托付给我的。"]},{"op":51,"name":"actor_face","args":[35,0,1]},{"op":20,"name":"dialog","args":["&诸葛亮\n要怪就怪我吧！"]},{"op":52,"name":"actor_action","args":[69,6]},{"op":20,"name":"dialog","args":["&姜维\n孔明大人……\n&马谡\n………\n&诸葛亮\n（刘备主公……我对不起您。）"]},{"op":51,"name":"actor_face","args":[35,0,2]},{"op":20,"name":"dialog","args":["&诸葛亮\n走吧。"]},{"op":52,"name":"actor_action","args":[69,0]},{"op":9,"name":"delay","args":[3]},{"op":50,"name":"actor_move","args":[65535,35,0,49,5,0]},{"op":50,"name":"actor_move","args":[65535,50,0,53,5,0]},{"op":50,"name":"actor_move","args":[65535,69,0,45,5,0]},{"op":49,"name":"actor_select","args":[65535,35,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,50,0,0,0,0,65535]},{"op":49,"name":"actor_select","args":[65535,69,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":3555,"sections":[{"index":0,"offset":3557,"title":"曹操  得知孔明的下落","body_off":3588,"body_end":5665,"conditions":[{"op":2,"name":"comment","args":["曹操  得知孔明的下落"]},{"op":0,"name":"end","args":[]}],"body":[{"op":39,"name":"change_scene","args":[2,65535,65535,9,65535]},{"op":48,"name":"actor_appear","args":[0,32,54,1,0]},{"op":48,"name":"actor_appear","args":[1,50,70,0,0]},{"op":48,"name":"actor_appear","args":[8,56,70,0,0]},{"op":48,"name":"actor_appear","args":[4,62,70,0,0]},{"op":48,"name":"actor_appear","args":[5,68,70,0,0]},{"op":48,"name":"actor_appear","args":[12,74,70,0,0]},{"op":48,"name":"actor_appear","args":[20,50,40,2,0]},{"op":48,"name":"actor_appear","args":[19,56,40,2,0]},{"op":48,"name":"actor_appear","args":[24,62,40,2,0]},{"op":48,"name":"actor_appear","args":[21,68,40,2,0]},{"op":48,"name":"actor_appear","args":[23,74,40,2,0]},{"op":28,"name":"fade_out","args":[]},{"op":35,"name":"play_music","args":[201,0]},{"op":9,"name":"delay","args":[3]},{"op":22,"name":"info","args":["此时曹操忙于治理蜀国，\n一面寻找逃亡的孔明。"]},{"op":23,"name":"place_name","args":["成都  临时相府"]},{"op":20,"name":"dialog","args":["&曹操\n仲德，把这份书表撰写几份，\n发给原来的蜀国官员，\n能复职的就继续任用吧。"]},{"op":52,"name":"actor_action","args":[21,6]},{"op":20,"name":"dialog","args":["&程昱\n是。"]},{"op":52,"name":"actor_action","args":[21,0]},{"op":20,"name":"dialog","args":["&曹操\n荀攸，百姓的情况如何？"]},{"op":52,"name":"actor_action","args":[24,6]},{"op":20,"name":"dialog","args":["&荀攸\n是。\n百姓几乎还怀念着蜀国，\n无心劳动终日哭泣的样子。"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯，这也难怪……"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n好，打开府库分发米粮给百姓，\n并免除蜀国百姓一年的赋税。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n让他们今后忘了蜀国，\n安心地做魏国的百姓吧。\n我们必须安抚民心，让他们归顺才行。"]},{"op":52,"name":"actor_action","args":[24,6]},{"op":20,"name":"dialog","args":["&荀攸\n是，属下即刻进行。"]},{"op":52,"name":"actor_action","args":[24,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n治安似乎也已防患于未然了。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯，不过还不能松懈管理，\n军中若有掠夺百姓财物的行为，\n无论官职大小一律斩首。"]},{"op":52,"name":"actor_action","args":[23,6]},{"op":20,"name":"dialog","args":["&贾诩\n是。"]},{"op":52,"name":"actor_action","args":[23,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n好，内政方面就先这样吧。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&曹操\n剩下的就是孔明了。\n司马懿，还没查到孔明的下落吗？"]},{"op":52,"name":"actor_action","args":[19,6]},{"op":20,"name":"dialog","args":["&司马懿\n是的，不过已经派出众多耳目，\n不久就会有结果吧。"]},{"op":52,"name":"actor_action","args":[19,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,2]},{"op":56,"name":"set_attr","args":[0,15,0,257]},{"op":20,"name":"dialog","args":["&曹操\n哦，为什么花了这么久的时间！？"]},{"op":48,"name":"actor_appear","args":[181,90,54,3,0]},{"op":30,"name":"wait_frame","args":[]},{"op":20,"name":"dialog","args":["&士兵01\n报。"]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":20,"name":"dialog","args":["&士兵01\n主公，已经打听到孔明的下落了。"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":56,"name":"set_attr","args":[0,15,0,255]},{"op":20,"name":"dialog","args":["&曹操\n哦！有消息了吗？\n他现在何处？"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":20,"name":"dialog","args":["&士兵01\n回禀主公，\n孔明收拾残兵据守在白帝城。\n&曹操\n白帝城！？\n原来如此。"]},{"op":52,"name":"actor_action","args":[20,6]},{"op":20,"name":"dialog","args":["&荀彧\n白帝城是刘备丧命之处，\n也是最险要的地方。"]},{"op":52,"name":"actor_action","args":[20,0]},{"op":20,"name":"dialog","args":["&曹操\n嗯，孔明小儿，\n难道打算和故主的亡魂迎击我们吗？"]},{"op":52,"name":"actor_action","args":[0,3]},{"op":20,"name":"dialog","args":["&曹操\n好，\n吩咐军师们尽快完成刚才交付的任务，\n其他人马准备出发。"]},{"op":52,"name":"actor_action","args":[0,0]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[0,17]},{"op":20,"name":"dialog","args":["&曹操\n必须早日除掉孔明。\n兵发白帝城！"]},{"op":22,"name":"info","args":["你希望敵方小兵裝備寶物嗎？\n這次的選擇不影響劇情，\n僅供玩家挑戰。"]},{"op":9,"name":"delay","args":[3]},{"op":1,"name":"if","args":[],"off":5557,"cond":{"op":18,"name":"choice","args":["希望敵軍小兵裝備寶物\n不希望",0]},"end":83,"end_off":5639},{"op":1,"name":"if","args":[],"off":5597,"cond":{"op":19,"name":"test_choice","args":[1]},"end":80,"end_off":5623},{"op":11,"name":"set_flag","args":[1830,1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":5623,"cond":{"op":19,"name":"test_choice","args":[2]},"end":82,"end_off":5637},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[3]},{"op":29,"name":"fade_in","args":[]},{"op":35,"name":"play_music","args":[201,255]},{"op":47,"name":"op_2f","args":[]},{"op":0,"name":"end","args":[]}]}]},{"index":3,"offset":5665,"sections":[{"index":0,"offset":5667,"title":"军事会议  白帝城之战Ａ前 (觸發532)","body_off":5712,"body_end":8156,"conditions":[{"op":2,"name":"comment","args":["军事会议  白帝城之战Ａ前 (觸發532)"]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"off":5712,"cond":{"op":5,"name":"test_flags","args":[[1854],[]]},"end":3,"end_off":5759},{"op":114,"name":"ext_command","args":[18,"隊員可達到平均等級"],"ext":{"sub":18,"fn":"party_to_average_level","nums":[],"text":"隊員可達到平均等級"}},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"off":5759,"cond":{"op":2,"name":"comment","args":["甄宓能力刷新2"]},"end":68,"end_off":6886},{"op":1,"name":"if","args":[],"off":5781,"cond":{"op":5,"name":"test_flags","args":[[530],[1280]]},"end":67,"end_off":6884},{"op":119,"name":"int_var_op","args":[2,4076,2,0,0]},{"op":119,"name":"int_var_op","args":[2,200,2,0,137]},{"op":1,"name":"if","args":[],"off":5851,"cond":{"op":2,"name":"comment","args":["甄宓能力+裝備記錄"]},"end":31,"end_off":6299},{"op":120,"name":"data_transfer","args":[201,0,{"var":200},18]},{"op":120,"name":"data_transfer","args":[202,0,{"var":200},19]},{"op":120,"name":"data_transfer","args":[203,0,{"var":200},14