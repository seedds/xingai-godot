_out","args":[]},{"op":23,"name":"place_name","args":["合淝  曹操军主营"]},{"op":51,"name":"actor_face","args":[10,0,2]},{"op":20,"name":"dialog","args":["&乐进\n张将军，东吴军马上就到，\n我们必须立即出战。\n&张辽\n可是……派往汉中的使者还没有回来。"]},{"op":51,"name":"actor_face","args":[11,0,2]},{"op":20,"name":"dialog","args":["&李典\n将军还是死心吧！\n&张辽\n嗯，这也是无可奈何的事。"]},{"op":48,"name":"actor_appear","args":[181,54,22,2,0]},{"op":30,"name":"wait_frame","args":[]},{"op":9,"name":"delay","args":[3]},{"op":52,"name":"actor_action","args":[181,11]},{"op":20,"name":"dialog","args":["&士兵01\n报。属……属下回来了，嗄……"]},{"op":51,"name":"actor_face","args":[10,0,0]},{"op":51,"name":"actor_face","args":[11,0,0]},{"op":20,"name":"dialog","args":["&李典\n喔喔，就等你呢！\n&乐进\n援军来了吗！？"]},{"op":20,"name":"dialog","args":["&士兵01\n这是主公给张将军的书信，\n主公说这封信犹如百万援军……\n&乐进\n相当于百万援军？\n就这封信？\n&张辽\n好，待我一览。\n&士兵01\n是。"]},{"op":52,"name":"actor_action","args":[181,0]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[10,0,1]},{"op":51,"name":"actor_face","args":[11,0,3]},{"op":50,"name":"actor_move","args":[65535,181,0,54,76,2]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[65535,181,0,54,64,2]},{"op":9,"name":"delay","args":[3]},{"op":51,"name":"actor_face","args":[11,0,2]},{"op":20,"name":"dialog","args":["&李典\n上头写些什么？\n&张辽\n出战未见敌人之前不许拆封。"]},{"op":51,"name":"actor_face","args":[10,0,2]},{"op":20,"name":"dialog","args":["&乐进\n什么？\n都已经是这种紧要关头了，\n主公到底是怎么想的！\n&张辽\n事到如今………\n也只有听从主公的吩咐了。"]},{"op":52,"name":"actor_action","args":[2,17]},{"op":20,"name":"dialog","args":["&张辽\n出兵！"]},{"op":52,"name":"actor_action","args":[2,0]},{"op":51,"name":"actor_face","args":[11,0,3]},{"op":51,"name":"actor_face","args":[10,0,1]},{"op":50,"name":"actor_move","args":[65535,181,0,54,22,0]},{"op":49,"name":"actor_select","args":[65535,181,0,0,0,0,65535]},{"op":30,"name":"wait_frame","args":[]},{"op":1,"name":"if","args":[],"off":9883,"cond":{"op":5,"name":"test_flags","args":[[793],[]]},"end":143,"end_off":10729},{"op":56,"name":"set_attr",